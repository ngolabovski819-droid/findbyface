    border: 1px solid rgba(139, 92, 246, 0.2);
    border-radius: 24px;
    background:
      linear-gradient(145deg, rgba(25, 24, 39, 0.96), rgba(15, 15, 24, 0.98));
    box-shadow: 0 24px 80px rgba(0, 0, 0, 0.25);
  }

  .upload-card {
    padding: 22px;
  }

  .card-kicker {
    display: flex;
    justify-content: space-between;
    gap: 16px;
    margin: 0 2px 14px;
    font-size: 12px;
    font-weight: 600;
    color: #d4d4e5;
    letter-spacing: 0.04em;
    text-transform: uppercase;
  }

  .privacy-note {
    color: #7f7f9c;
    font-weight: 500;
    text-transform: none;
    letter-spacing: 0;
  }

  .drop-zone {
    position: relative;
    display: grid;
    min-height: 300px;
    overflow: hidden;
    border: 1px dashed rgba(168, 85, 247, 0.42);
    border-radius: 18px;
    background:
      radial-gradient(circle at 50% 20%, rgba(124, 58, 237, 0.12), transparent 48%),
      rgba(7, 7, 12, 0.55);
    cursor: pointer;
    transition: border-color 180ms ease, background 180ms ease, transform 180ms ease;
  }

  .drop-zone:hover,
  .drop-zone:focus-visible,
  .drop-zone.dragging,
  .drop-zone.pasted {
    border-color: #a855f7;
    outline: none;
    background:
      radial-gradient(circle at 50% 20%, rgba(124, 58, 237, 0.2), transparent 52%),
      rgba(7, 7, 12, 0.7);
  }

  .drop-zone.dragging {
    transform: scale(1.006);
  }

  .drop-zone.pasted {
    animation: paste-pulse 650ms ease;
  }

  @keyframes paste-pulse {
    0%, 100% { box-shadow: 0 0 0 0 rgba(168, 85, 247, 0); }
    45% { box-shadow: 0 0 0 7px rgba(168, 85, 247, 0.14); }
  }

  .empty-state {
    display: flex;
    min-height: 300px;
    flex-direction: column;
    align-items: center;
    justify-content: center;
    padding: 28px;
    text-align: center;
  }

  .upload-icon {
    display: grid;
    width: 62px;
    height: 62px;
    margin-bottom: 18px;
    place-items: center;
    border: 1px solid rgba(168, 85, 247, 0.3);
    border-radius: 18px;
    background: rgba(124, 58, 237, 0.13);
    color: #c4b5fd;
  }

  .upload-icon svg {
    width: 28px;
    stroke: currentColor;
    stroke-width: 1.7;
    stroke-linecap: round;
    stroke-linejoin: round;
  }

  .empty-state strong {
    margin-bottom: 4px;
    font-size: 1.08rem;
  }

  .empty-state span {
    color: #a1a1ba;
    font-size: 14px;
  }

  .empty-state .paste-hint {
    display: inline-flex;
    align-items: center;
    gap: 6px;
    margin-top: 18px;
    padding: 7px 10px;
    border: 1px solid rgba(168, 85, 247, 0.2);
    border-radius: 9px;
    background: rgba(124, 58, 237, 0.08);
    color: #c4b5fd;
    font-size: 11px;
    font-weight: 600;
  }

  .paste-hint kbd {
    min-width: 24px;
    padding: 3px 5px;
    border: 1px solid rgba(255, 255, 255, 0.13);
    border-bottom-color: rgba(255, 255, 255, 0.23);
    border-radius: 5px;
    background: rgba(255, 255, 255, 0.06);
    color: #f5f3ff;
    font: 600 10px/1 'Inter', sans-serif;
  }

  .empty-state small {
    margin-top: 12px;
    color: #696980;
    font-size: 11px;
  }

  .preview-state {
    position: absolute;
    inset: 0;
  }

  .preview-state img {
    width: 100%;
    height: 100%;
    object-fit: contain;
    background: #09090e;
  }

  .preview-overlay {
    position: absolute;
    right: 12px;
    bottom: 12px;
    left: 12px;
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 14px;
    padding: 10px 13px;
    border: 1px solid rgba(255, 255, 255, 0.1);
    border-radius: 10px;
    background: rgba(8, 8, 13, 0.8);
    backdrop-filter: blur(12px);
    color: #fff;
    font-size: 12px;
  }

  .preview-overlay span:first-child {
    overflow: hidden;
    text-overflow: ellipsis;
    white-space: nowrap;
  }

  .preview-overlay span:last-child {
    flex-shrink: 0;
    color: #a78bfa;
  }

  .photo-guidance {
    display: flex;
    justify-content: center;
    gap: 22px;
    margin: 17px 0;
    color: #7f7f9c;
    font-size: 12px;
  }

  .photo-guidance span {
    display: inline-flex;
    align-items: center;
    gap: 6px;
  }

  .photo-guidance svg {
    width: 16px;
    stroke: currentColor;
    stroke-width: 1.4;
    stroke-linecap: round;
    stroke-linejoin: round;
  }

  .usage-note {
    max-width: 560px;
    margin: -2px auto 14px;
    color: #686880;
    font-size: 10px;
    line-height: 1.55;
    text-align: center;
  }

  .search-access-note {
    margin: -5px 0 14px;
    color: #8d8da6;
    font-size: 11px;
    line-height: 1.5;
    text-align: center;
  }
  .search-access-note a {
    color: #c4b5fd;
    font-weight: 700;
    text-decoration: underline;
    text-decoration-color: rgba(196, 181, 253, 0.38);
    text-underline-offset: 3px;
  }

  .search-limit-modal[hidden] { display: none; }
  .search-limit-modal {
    position: fixed;
    inset: 0;
    z-index: 1000;
    display: grid;
    place-items: center;
    padding: 20px;
  }
  .search-limit-backdrop {
    position: absolute;
    inset: 0;
    border: 0;
    background: rgba(3, 3, 8, 0.78);
    backdrop-filter: blur(8px);
    cursor: default;
  }
  .search-limit-card {
    position: relative;
    z-index: 1;
    width: min(430px, 100%);
    padding: 34px 30px 26px;
    border: 1px solid rgba(167, 139, 250, 0.32);
    border-radius: 22px;
    background: linear-gradient(145deg, rgba(28, 24, 42, 0.98), rgba(13, 13, 21, 0.98));
    box-shadow: 0 28px 80px rgba(0, 0, 0, 0.56), 0 0 50px rgba(124, 58, 237, 0.13);
    text-align: center;
  }
  .search-limit-close {
    position: absolute;
    top: 12px;
    right: 14px;
    width: 32px;
    height: 32px;
    border: 0;
    background: transparent;
    color: #8d8da6;
    font-size: 24px;
    cursor: pointer;
  }
  .search-limit-icon {
    display: grid;
    width: 54px;
    height: 54px;
    margin: 0 auto 17px;
    place-items: center;
    border-radius: 17px;
    background: linear-gradient(135deg, #7c3aed, #d946ef);
    box-shadow: 0 10px 30px rgba(124, 58, 237, 0.38);
    color: #fff;
    font: 800 28px/1 'Manrope', sans-serif;
  }
  .search-limit-card h2 { font-size: 1.45rem; }
  .search-limit-card p {
    margin: 11px auto 22px;
    color: #9d9db3;
    font-size: 14px;
    line-height: 1.6;
  }
  .search-limit-signin {
    display: block;
    padding: 13px 18px;
    border-radius: 12px;
    background: linear-gradient(115deg, #7c3aed, #d946ef);
    box-shadow: 0 10px 28px rgba(124, 58, 237, 0.28);
    color: #fff;
    font-size: 14px;
    font-weight: 800;
  }
  .search-limit-card .search-limit-returning {
    margin: 14px auto 0;
    color: #8f8fa7;
    font-size: 13px;
    line-height: 1.45;
  }
  .search-limit-returning a {
    color: #c4b5fd;
    font-weight: 800;
    text-decoration: underline;
    text-decoration-color: rgba(196, 181, 253, 0.5);
    text-underline-offset: 3px;
  }
  .search-limit-returning a:hover { color: #ede9fe; }
  .search-limit-later {
    margin-top: 12px;
    border: 0;
    background: transparent;
    color: #85859e;
    font: 600 12px/1.4 'Inter', sans-serif;
    cursor: pointer;
  }

  .form-error {
    margin: 0 0 14px;
    padding: 11px 13px;
    border: 1px solid rgba(248, 113, 113, 0.28);
    border-radius: 10px;
    background: rgba(127, 29, 29, 0.16);
    color: #fca5a5;
    font-size: 13px;
  }

  #searchTurnstile { margin: 0 0 14px; }

  .search-button {
    width: 100%;
    min-height: 52px;
    border: 0;
    border-radius: 13px;
    background: linear-gradient(115deg, #7c3aed, #d946ef);
    box-shadow: 0 12px 34px rgba(124, 58, 237, 0.25);
    color: white;
    cursor: pointer;
    font: 600 14px/1 'Inter', sans-serif;
    transition: transform 160ms ease, filter 160ms ease, opacity 160ms ease;
  }

  .search-button:hover:not(:disabled) {
    transform: translateY(-1px);
    filter: brightness(1.08);
  }

  .search-button:disabled {
    cursor: not-allowed;
    opacity: 0.42;
    box-shadow: none;
  }

  .search-button {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    gap: 10px;
  }

  .search-button svg {
    width: 19px;
    stroke: currentColor;
    stroke-width: 1.8;
    stroke-linecap: round;
    stroke-linejoin: round;
  }

  /* While a search is running, the drop-zone/guidance/button give way to the scanning
     visual below — same idle/scanning split UploadBox.astro uses on the homepage. */
  #videoSearchForm.is-scanning .drop-zone,
  #videoSearchForm.is-scanning .photo-guidance,
  #videoSearchForm.is-scanning .usage-note,
  #videoSearchForm.is-scanning .search-access-note,
  #videoSearchForm.is-scanning #searchTurnstile,
  #videoSearchForm.is-scanning .search-button {
    display: none;
  }

  .scanning-state { display: none; }
  #videoSearchForm.is-scanning .scanning-state {
    display: flex;
    flex-direction: column;
    align-items: center;
    padding: 20px 4px 8px;
    gap: 14px;
    text-align: center;
  }

  .scan-stage {
    display: flex; align-items: center; justify-content: center;
    gap: 14px; margin-bottom: 6px;
  }

  .scanning-img-box {
    position: relative; width: 150px; height: 200px;
    border-radius: 14px; overflow: hidden;
    border: 1px solid var(--border);
    box-shadow: 0 0 0 1px rgba(124,58,237,0.15), 0 10px 30px rgba(0,0,0,0.4);
  }
  .scanning-img-box img { width: 100%; height: 100%; object-fit: cover; display: block; }

  .scan-line {
    position: absolute; left: 0; right: 0; height: 3px;
    background: linear-gradient(90deg, transparent, #00d4ff, #7c3aed, #00d4ff, transparent);
    box-shadow: 0 0 12px #00d4ff, 0 0 24px rgba(0,212,255,0.4);
    animation: video-scan-line 1.8s ease-in-out infinite; top: 0;
  }
  @keyframes video-scan-line {
    0%   { top: 0%; opacity: 0; }
    10%  { opacity: 1; }
    90%  { opacity: 1; }
    100% { top: 100%; opacity: 0; }
  }

  .scan-bracket {
    position: absolute; width: 22px; height: 22px; pointer-events: none;
    border: 2px solid var(--accent-light);
    filter: drop-shadow(0 0 4px var(--accent-glow));
    animation: video-bracket-pulse 1.6s ease-in-out infinite;
  }
  .scan-bracket.tl { top: 10px; left: 10px; border-right: none; border-bottom: none; border-radius: 6px 0 0 0; }
  .scan-bracket.tr { top: 10px; right: 10px; border-left: none; border-bottom: none; border-radius: 0 6px 0 0; }
  .scan-bracket.bl { bottom: 10px; left: 10px; border-right: none; border-top: none; border-radius: 0 0 0 6px; }
  .scan-bracket.br { bottom: 10px; right: 10px; border-left: none; border-top: none; border-radius: 0 0 6px 0; }
  @keyframes video-bracket-pulse {
    0%, 100% { opacity: 0.45; transform: scale(1); }
    50%      { opacity: 1; transform: scale(1.06); }
  }

  .scan-tag {
    position: absolute; bottom: 6px; left: 50%; transform: translateX(-50%);
    font-size: 10px; font-weight: 600; letter-spacing: 0.04em;
    color: #fff; background: rgba(10,10,15,0.7);
    padding: 2px 9px; border-radius: 999px; backdrop-filter: blur(4px);
    white-space: nowrap;
  }

  .scan-connector {
    position: relative; width: 44px; height: 2px;
    background: linear-gradient(90deg, var(--accent), var(--accent-pink));
    border-radius: 2px; opacity: 0.5;
  }
  .scan-connector .connector-spark {
    position: absolute; top: 50%; left: 0; width: 8px; height: 8px;
    margin-top: -4px; border-radius: 50%;
    background: #fff; box-shadow: 0 0 10px 2px var(--accent-light);
    animation: video-spark-travel 1.1s linear infinite;
  }
  @keyframes video-spark-travel {
    from { left: 0; opacity: 0; }
    15%  { opacity: 1; }
    85%  { opacity: 1; }
    to   { left: 100%; opacity: 0; }
  }

  .face-roulette {
    position: relative; width: 150px; height: 200px;
    border-radius: 14px; overflow: hidden;
    border: 1px solid var(--border);
    background: var(--surface-raised);
    box-shadow: 0 0 0 1px rgba(236,72,153,0.18), 0 10px 30px rgba(0,0,0,0.4);
  }
  .roulette-strip {
    position: absolute; top: 0; left: 0; width: 100%;
    display: flex; flex-direction: column;
    will-change: transform;
  }
  .roulette-face {
    width: 100%; height: 200px; object-fit: cover; display: block; flex: 0 0 auto;
  }
  @keyframes roulette-scroll {
    from { transform: translateY(0); }
    to   { transform: translateY(-100%); }
  }
  .roulette-placeholder {
    position: absolute; inset: 0;
    background: linear-gradient(135deg, var(--surface-raised), var(--surface));
  }
  .roulette-ring {
    position: absolute; inset: 0; pointer-events: none;
    border: 2px solid transparent;
    border-radius: 14px;
    box-shadow: inset 0 0 22px rgba(236,72,153,0.25);
    animation: video-ring-flicker 0.22s steps(2) infinite;
  }
  @keyframes video-ring-flicker {
    0% { box-shadow: inset 0 0 22px rgba(236,72,153,0.25); }
    100% { box-shadow: inset 0 0 28px rgba(124,58,237,0.35); }
  }

  .scanning-title {
    font-size: 1.15rem; font-weight: 800; letter-spacing: 0.01em;
    background: linear-gradient(135deg, var(--accent-light), var(--accent-pink));
    -webkit-background-clip: text; -webkit-text-fill-color: transparent; background-clip: text;
  }
  .scanning-title::after {
    content: ''; display: inline-block;
    animation: video-ellipsis 1.4s steps(4) infinite;
    width: 1em; text-align: left;
  }
  @keyframes video-ellipsis {
    0% { content: ''; } 25% { content: '.'; } 50% { content: '..'; } 75% { content: '...'; }
  }
  .scanning-sub { color: var(--text-muted); font-size: 13px; max-width: 400px; line-height: 1.5; }

  .progress-track {
    width: 100%; max-width: 340px; height: 6px;
    background: rgba(255,255,255,0.08); border-radius: 3px;
    overflow: hidden; position: relative;
  }
  .progress-fill {
    position: absolute; left: 0;
    height: 100%; width: 42%;
    background: linear-gradient(90deg, var(--accent), var(--accent-pink), var(--accent));
    background-size: 200% 100%;
    border-radius: 3px;
    will-change: transform;
    animation: video-progress-bounce 1.6s cubic-bezier(0.4, 0, 0.6, 1) infinite alternate,
               video-progress-shimmer 1.2s linear infinite;
  }
  @keyframes video-progress-bounce {
    from { transform: translateX(-100%); }
    to   { transform: translateX(238%); }
  }
  @keyframes video-progress-shimmer {
    from { background-position: 0% 0; }
    to   { background-position: 200% 0; }
  }

  .scan-counter {
    font-size: 12px; color: var(--text-muted); letter-spacing: 0.02em;
  }
  .scan-counter strong {
    color: var(--accent-light); font-variant-numeric: tabular-nums;
    font-weight: 700;
  }

  .scan-steps {
    display: flex; flex-wrap: wrap; justify-content: center;
    gap: 8px 14px; margin-top: 4px; max-width: 420px;
  }
  .scan-step {
    display: inline-flex; align-items: center; gap: 6px;
    font-size: 12px; color: var(--text-muted);
    opacity: 0.5; transition: opacity 0.3s, color 0.3s;
  }
  .step-mark {
    width: 14px; height: 14px; border-radius: 50%;
    border: 2px solid currentColor; position: relative; flex-shrink: 0;
    transition: all 0.3s;
  }
  .scan-step.active { opacity: 1; color: var(--accent-light); }
  .scan-step.active .step-mark {
    border-color: var(--accent-light);
    box-shadow: 0 0 0 0 var(--accent-glow);
    animation: video-step-ping 1.2s ease-out infinite;
  }
  @keyframes video-step-ping {
    0%   { box-shadow: 0 0 0 0 rgba(168,85,247,0.5); }
    100% { box-shadow: 0 0 0 8px rgba(168,85,247,0); }
  }
  .scan-step.done { opacity: 1; color: var(--success); }
  .scan-step.done .step-mark {
    border-color: var(--success); background: var(--success);
  }
  .scan-step.done .step-mark::after {
    content: ''; position: absolute;
    left: 3px; top: 0px; width: 4px; height: 8px;
    border: solid #0a0a0f; border-width: 0 2px 2px 0;
    transform: rotate(45deg);
  }

  @media (max-width: 480px) {
    .scanning-img-box, .face-roulette { width: 122px; height: 162px; }
    .scan-connector { width: 28px; }
  }

  .validation-card {
    display: grid;
    grid-template-columns: minmax(280px, 0.7fr) minmax(0, 1.3fr);
    gap: 18px;
    align-items: stretch;
    margin-top: 22px;
    padding: 24px 26px 20px;
  }

  .validation-head {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 16px;
    padding: 12px 8px 12px 4px;
  }

  .eyebrow {
    display: block;
    margin-bottom: 5px;
    color: #8b8ba5;
    font-size: 10px;
    font-weight: 700;
    letter-spacing: 0.13em;
    text-transform: uppercase;
  }

  .validation-head h2,
  .results-heading h2 {
    font-size: 1.3rem;
    letter-spacing: -0.02em;
  }

  .validation-head h2 {
    white-space: nowrap;
  }

  .status-mark {
    display: grid;
    width: 38px;
    height: 38px;
    flex: 0 0 auto;
    place-items: center;
    border: 1px solid rgba(74, 222, 128, 0.24);
    border-radius: 50%;
    background: rgba(34, 197, 94, 0.1);
    color: #4ade80;
  }

  .status-mark svg {
    width: 20px;
    stroke: currentColor;
    stroke-width: 2;
    stroke-linecap: round;
    stroke-linejoin: round;
  }

  .metric-grid {
    display: grid;
    grid-template-columns: repeat(4, minmax(0, 1fr));
    gap: 10px;
    margin: 0;
  }

  .metric {
    padding: 15px;
    border: 1px solid rgba(255, 255, 255, 0.06);
    border-radius: 13px;
    background: rgba(255, 255, 255, 0.025);
  }

  .metric strong {
    display: block;
    color: #f5f3ff;
    font-family: 'Manrope', sans-serif;
    font-size: 1.2rem;
    line-height: 1.1;
  }

  .metric span {
    color: #77778e;
    font-size: 10px;
  }

  .pipeline {
    display: grid;
    grid-template-columns: repeat(3, minmax(0, 1fr));
    grid-column: 1 / -1;
    gap: 10px;
    min-width: 0;
  }

  .pipeline-step {
    display: grid;
    grid-template-columns: 34px minmax(0, 1fr);
    align-items: center;
    min-width: 0;
    gap: 11px;
    padding: 16px 13px;
    border: 1px solid rgba(255, 255, 255, 0.06);
    border-radius: 13px;
    background: rgba(255, 255, 255, 0.025);
    transition: border-color 180ms ease, background 180ms ease, transform 180ms ease;
  }

  .pipeline-step:hover {
    transform: translateY(-2px);
    border-color: rgba(168, 85, 247, 0.23);
    background: rgba(124, 58, 237, 0.06);
  }

  .pipeline-step > span {
    display: grid;
    width: 34px;
    height: 34px;
    flex: 0 0 auto;
    place-items: center;
    border: 1px solid rgba(168, 85, 247, 0.28);
    border-radius: 10px;
    background: rgba(124, 58, 237, 0.09);
    color: #c4b5fd;
    font-size: 10px;
    font-weight: 700;
  }

  .pipeline-step strong,
  .pipeline-step small {
    display: block;
  }

  .pipeline-step strong {
    font-size: 13px;
  }

  .pipeline-step small {
    margin-top: 1px;
    color: #727288;
    font-size: 10px;
    line-height: 1.45;
  }

  .pipeline-line {
    display: none;
  }

  .validation-foot {
    grid-column: 1 / -1;
    margin: 0;
    padding-top: 14px;
    border-top: 1px solid rgba(255, 255, 255, 0.06);
    color: #6f6f86;
    font-size: 10px;
    line-height: 1.6;
  }

  .validation-foot code {
    color: #a78bfa;
    font-family: ui-monospace, SFMono-Regular, Menlo, monospace;
  }

  .results-section {
    scroll-margin-top: 92px;
    padding-top: 74px;
  }

  .results-heading {
    display: flex;
    align-items: end;
    justify-content: space-between;
    gap: 20px;
    margin-bottom: 20px;
  }

  .results-heading h2 {
    font-size: clamp(1.7rem, 4vw, 2.35rem);
  }

  .search-meta {
    color: #85859c;
    font-size: 12px;
  }

  .cross-finder-cta {
    display: grid;
    grid-template-columns: 36px minmax(0, 1fr) auto;
    align-items: center;
    gap: 12px;
    margin-bottom: 20px;
    padding: 12px 14px;
    border: 1px solid rgba(168, 85, 247, 0.24);
    border-radius: 14px;
    background: linear-gradient(135deg, rgba(124, 58, 237, 0.09), rgba(236, 72, 153, 0.06));
    color: #f5f3ff;
    text-decoration: none;
    transition: border-color 180ms ease, background 180ms ease, transform 180ms ease;
  }

  .cross-finder-cta:hover {
    border-color: rgba(217, 70, 239, 0.48);
