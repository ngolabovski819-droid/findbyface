<section class="video-search" aria-labelledby="video-search-heading">
  <div class="hero-search-layout">
    <div class="hero-copy">
      <div class="prototype-pill">
        <span class="live-dot"></span>
        Public beta · actively improving
      </div>
      <h1 id="video-search-heading">
        AI pornstar finder by face.
        <span>Search videos from one photo.</span>
      </h1>
      <p class="hero-lede">
        Use this free pornstar face finder with a clear photo, picture, or video
        screenshot. Upload, drop, or paste it to search sampled faces from the
        indexed video library and return the strongest matching appearances.
      </p>
      <ul class="hero-trust" aria-label="Product highlights">
        <li>
          <svg viewBox="0 0 20 20" fill="none" aria-hidden="true">
            <path d="m5 10.3 3 3L15.5 6" />
          </svg>
          Ranked video matches
        </li>
        <li>
          <svg viewBox="0 0 20 20" fill="none" aria-hidden="true">
            <path d="M5.5 9V6.8a4.5 4.5 0 0 1 9 0V9M4 9h12v8H4z" />
          </svg>
          Upload deleted after search
        </li>
        <li>
          <svg viewBox="0 0 20 20" fill="none" aria-hidden="true">
            <path d="M10 2.5 12 7l4.8.5-3.6 3.2 1 4.8-4.2-2.4-4.2 2.4 1-4.8-3.6-3.2L8 7z" />
          </svg>
          Free during beta
        </li>
      </ul>
    </div>

    <form class="upload-card" id="videoSearchForm">
      <div class="card-kicker">
        <span>Query image</span>
        <span class="privacy-note">Deleted after search</span>
      </div>

      <label
        class="drop-zone"
        id="dropZone"
        for="faceImage"
        tabindex="0"
        aria-label="Upload, drop, or paste a face image"
      >
        <input
          id="faceImage"
          name="image"
          type="file"
          accept="image/jpeg,image/png,image/webp"
          hidden
        />

        <div class="empty-state" id="emptyState">
          <div class="upload-icon" aria-hidden="true">
            <svg viewBox="0 0 24 24" fill="none">
              <path d="M12 16V4m0 0L7.5 8.5M12 4l4.5 4.5" />
              <path d="M5 13v5a2 2 0 0 0 2 2h10a2 2 0 0 0 2-2v-5" />
            </svg>
          </div>
          <strong>Drop, paste, or choose a face photo</strong>
          <span>Copy a screenshot, then press Ctrl/⌘ + V</span>
          <span class="paste-hint" aria-hidden="true">
            <kbd>Ctrl</kbd><span>+</span><kbd>V</kbd>
            Paste screenshot
          </span>
          <small>JPEG, PNG or WebP · maximum 8 MB</small>
        </div>

        <div class="preview-state" id="previewState" hidden>
          <img id="imagePreview" alt="Selected face query preview" />
          <div class="preview-overlay">
            <span id="fileName"></span>
            <span>Click to replace</span>
          </div>
        </div>
      </label>

      <div class="photo-guidance" aria-label="Photo guidance">
        <span>
          <svg viewBox="0 0 20 20" fill="none" aria-hidden="true">
            <circle cx="10" cy="7" r="3" />
            <path d="M4.5 17c.5-3.1 2.3-4.7 5.5-4.7s5 1.6 5.5 4.7" />
          </svg>
          One face
        </span>
        <span>
          <svg viewBox="0 0 20 20" fill="none" aria-hidden="true">
            <circle cx="10" cy="10" r="4" />
            <path d="M10 1.5v2M10 16.5v2M1.5 10h2M16.5 10h2M4 4l1.4 1.4M14.6 14.6L16 16M16 4l-1.4 1.4M5.4 14.6L4 16" />
          </svg>
          Even lighting
        </span>
        <span>
          <svg viewBox="0 0 20 20" fill="none" aria-hidden="true">
            <path d="M2.5 5.5h3l1.2-2h6.6l1.2 2h3v11h-15z" />
            <circle cx="10" cy="11" r="3.2" />
          </svg>
          Sharp image
        </span>
      </div>

      <p class="usage-note">
        By searching, you confirm you are 18+ and have the right to use the
        image. Matches are similarity leads, not identity proof.
      </p>

      <p class="search-access-note">
        Guests receive one search per day.
        <a href="/signup/?next=/pornstar-finder-by-face/">Sign up for unlimited searches</a>.
      </p>

      <p class="form-error" id="formError" role="alert" hidden></p>

      <button class="search-button" id="searchButton" type="submit" disabled>
        <span class="button-idle">
          Search indexed videos
          <svg viewBox="0 0 20 20" fill="none" aria-hidden="true">
            <path d="M4 10h12M11.5 5.5 16 10l-4.5 4.5" />
          </svg>
        </span>
        <span class="button-loading" hidden>
          <span class="spinner"></span>
          <span id="loadingLabel">Loading face model…</span>
        </span>
      </button>
    </form>
  </div>

  <aside class="validation-card">
      <div class="validation-head">
        <div>
          <span class="eyebrow">Growing beta index</span>
          <h2>Face-to-video search</h2>
        </div>
        <div class="status-mark" title="Beta system online">
          <svg viewBox="0 0 20 20" fill="none" aria-hidden="true">
            <path d="m5 10.2 3.1 3L15.5 6" />
          </svg>
        </div>
      </div>

      <div class="metric-grid">
        <div class="metric">
          <strong id="indexedVideoCount" aria-live="polite">—</strong>
          <span>indexed videos</span>
        </div>
        <div class="metric">
          <strong>512D</strong>
          <span>face vectors</span>
        </div>
        <div class="metric">
          <strong>8s</strong>
          <span>sample interval</span>
        </div>
        <div class="metric">
          <strong>GPU</strong>
          <span>RTX accelerated</span>
        </div>
      </div>

      <div class="pipeline">
        <div class="pipeline-step">
          <span>01</span>
          <div>
            <strong>Detect</strong>
            <small>Find the single query face</small>
          </div>
        </div>
        <div class="pipeline-line"></div>
        <div class="pipeline-step">
          <span>02</span>
          <div>
            <strong>Embed</strong>
            <small>Create the search vector</small>
          </div>
        </div>
        <div class="pipeline-line"></div>
        <div class="pipeline-step">
          <span>03</span>
          <div>
            <strong>Retrieve</strong>
            <small>Group matching faces by video</small>
          </div>
        </div>
      </div>

      <p class="validation-foot">
        Beta note: ranking thresholds and index coverage are still being
        calibrated. Always review the source video before drawing conclusions.
      </p>
  </aside>

  <section class="results-section" id="resultsSection" aria-live="polite" hidden>
    <div class="results-heading">
      <div>
        <span class="eyebrow">Direct face-to-video retrieval</span>
        <h2 id="resultsTitle">Video matches</h2>
      </div>
      <div class="search-meta" id="searchMeta"></div>
    </div>
    <a class="cross-finder-cta" href="/#onlyfans-finder">
      <span class="cross-finder-icon" aria-hidden="true">
        <svg viewBox="0 0 24 24" fill="none"><circle cx="10" cy="10" r="5" /><path d="m14 14 5 5M8 8.5h4M10 6.5v4" /></svg>
      </span>
      <span class="cross-finder-copy">
        <strong>Looking for similar OnlyFans creators?</strong>
        <small>Run the same kind of face search across creator profiles.</small>
      </span>
      <span class="cross-finder-action">Try OnlyFans Finder <b>→</b></span>
    </a>
    <div class="results-grid" id="resultsGrid"></div>
    <button class="load-more" id="loadMore" type="button" hidden>
      Load more results
    </button>
    <div class="empty-results" id="emptyResults" hidden>
      <div class="empty-result-icon" aria-hidden="true">
        <svg viewBox="0 0 24 24" fill="none">
          <circle cx="11" cy="11" r="6" />
          <path d="m16 16 4 4M8.5 11h5" />
        </svg>
      </div>
      <h3>No indexed videos crossed the threshold</h3>
      <p>Try a clearer, more front-facing photo of the same performer.</p>
    </div>
  </section>
</section>

<div class="search-limit-modal" id="pornstarLimitModal" hidden role="dialog" aria-modal="true" aria-labelledby="pornstarLimitTitle">
  <button class="search-limit-backdrop" id="pornstarLimitBackdrop" type="button" aria-label="Close sign-in prompt"></button>
  <div class="search-limit-card">
    <button class="search-limit-close" id="pornstarLimitClose" type="button" aria-label="Close">×</button>
    <span class="search-limit-icon" aria-hidden="true">∞</span>
    <h2 id="pornstarLimitTitle">Unlock unlimited searches</h2>
    <p>You’ve used today’s free Pornstar Finder search. Create a free account with any email to continue without a daily limit.</p>
    <a class="search-limit-signin" id="pornstarLimitSignIn" href="/signup/?next=/pornstar-finder-by-face/">Create free account</a>
    <button class="search-limit-later" id="pornstarLimitLater" type="button">Maybe later</button>
  </div>
</div>

<script>
  type VideoResult = {
    videoId: number;
    externalId: string;
    title: string;
    sourceUrl?: string;
    thumbnailUrl?: string;
    durationSeconds?: number;
    similarity: number;
    robustSimilarity: number;
    supportingEmbeddings: number;
  };

  type SearchResponse = {
    ok: boolean;
    code?: string;
    error?: string;
    indexedVideos?: number;
    elapsedSeconds?: number;
    results?: VideoResult[];
  };

  const form = document.querySelector<HTMLFormElement>('#videoSearchForm')!;
  const input = document.querySelector<HTMLInputElement>('#faceImage')!;
  const dropZone = document.querySelector<HTMLElement>('#dropZone')!;
  const emptyState = document.querySelector<HTMLElement>('#emptyState')!;
  const previewState = document.querySelector<HTMLElement>('#previewState')!;
  const imagePreview = document.querySelector<HTMLImageElement>('#imagePreview')!;
  const fileName = document.querySelector<HTMLElement>('#fileName')!;
  const searchButton = document.querySelector<HTMLButtonElement>('#searchButton')!;
  const formError = document.querySelector<HTMLElement>('#formError')!;
  const idleContent = searchButton.querySelector<HTMLElement>('.button-idle')!;
  const loadingContent = searchButton.querySelector<HTMLElement>('.button-loading')!;
  const loadingLabel = document.querySelector<HTMLElement>('#loadingLabel')!;
  const resultsSection = document.querySelector<HTMLElement>('#resultsSection')!;
  const resultsTitle = document.querySelector<HTMLElement>('#resultsTitle')!;
  const searchMeta = document.querySelector<HTMLElement>('#searchMeta')!;
  const resultsGrid = document.querySelector<HTMLElement>('#resultsGrid')!;
  const loadMore = document.querySelector<HTMLButtonElement>('#loadMore')!;
  const emptyResults = document.querySelector<HTMLElement>('#emptyResults')!;
  const limitModal = document.querySelector<HTMLElement>('#pornstarLimitModal')!;
  const limitBackdrop = document.querySelector<HTMLButtonElement>('#pornstarLimitBackdrop')!;
  const limitClose = document.querySelector<HTMLButtonElement>('#pornstarLimitClose')!;
  const limitLater = document.querySelector<HTMLButtonElement>('#pornstarLimitLater')!;
  const limitSignIn = document.querySelector<HTMLAnchorElement>('#pornstarLimitSignIn')!;
  const indexedVideoCount = document.querySelector<HTMLElement>('#indexedVideoCount')!;

  const RESULTS_PAGE_SIZE = 24;
  const HISTORY_KEY = 'fbf_pornstar_history';
  const GUEST_DAY_KEY = 'fbf_pornstar_guest_search_day';
  let selectedFile: File | null = null;
  let previewUrl = '';
  let searching = false;
  let allResults: VideoResult[] = [];
  let visibleResultCount = 0;

  function displayIndexedVideoCount(value: number): void {
    if (!Number.isSafeInteger(value) || value < 0) return;
    indexedVideoCount.textContent = new Intl.NumberFormat().format(value);
    indexedVideoCount.title = `${value.toLocaleString()} videos currently indexed`;
  }

  async function refreshIndexedVideoCount(): Promise<void> {
    try {
      const response = await fetch('/api/video-index-stats');
      if (!response.ok) return;
      const payload = await response.json() as { indexedVideos?: number };
      if (typeof payload.indexedVideos === 'number') {
        displayIndexedVideoCount(payload.indexedVideos);
      }
    } catch {
      // Keep the last known count when the network is temporarily unavailable.
    }
  }

  void refreshIndexedVideoCount();
  const indexCountTimer = window.setInterval(() => {
    if (document.visibilityState === 'visible') void refreshIndexedVideoCount();
  }, 30_000);

  function currentUser(): { access_token?: string } | null {
    try {
      return JSON.parse(localStorage.getItem('fbf_user') || 'null');
    } catch {
      return null;
    }
  }

  function todayUtc(): string {
    return new Date().toISOString().slice(0, 10);
  }

  function openLimitModal(): void {
    limitModal.hidden = false;
    document.body.style.overflow = 'hidden';
    limitSignIn.focus();
  }

  function closeLimitModal(): void {
    limitModal.hidden = true;
    document.body.style.overflow = '';
  }

  limitBackdrop.addEventListener('click', closeLimitModal);
  limitClose.addEventListener('click', closeLimitModal);
  limitLater.addEventListener('click', closeLimitModal);

  function savePornstarHistory(payload: SearchResponse): void {
    const results = (payload.results ?? []).slice(0, 10).map(result => ({
      videoId: result.videoId,
      externalId: result.externalId,
      title: result.title,
      sourceUrl: result.sourceUrl,
      thumbnailUrl: result.thumbnailUrl,
      durationSeconds: result.durationSeconds,
      similarity: result.similarity,
      robustSimilarity: result.robustSimilarity,
      supportingEmbeddings: result.supportingEmbeddings,
    }));
    try {
      const stored = JSON.parse(localStorage.getItem(HISTORY_KEY) || '[]');
      const history = Array.isArray(stored) ? stored : [];
      history.unshift({
        date: new Date().toISOString(),
        count: payload.results?.length ?? 0,
        indexedVideos: payload.indexedVideos ?? 0,
        elapsedSeconds: payload.elapsedSeconds ?? 0,
        results,
      });
      localStorage.setItem(HISTORY_KEY, JSON.stringify(history.slice(0, 25)));
    } catch {
      // Search results still work if browser storage is unavailable.
    }
  }

  function showError(message: string): void {
    formError.textContent = message;
    formError.hidden = false;
  }

  function clearError(): void {
    formError.textContent = '';
    formError.hidden = true;
  }

  function selectFile(file: File): void {
    const allowed = ['image/jpeg', 'image/png', 'image/webp'];
    clearError();
    if (!allowed.includes(file.type)) {
      showError('Choose a JPEG, PNG, or WebP image.');
      return;
    }
    if (file.size > 8 * 1024 * 1024) {
      showError('Use an image smaller than 8 MB.');
      return;
    }
    if (previewUrl) URL.revokeObjectURL(previewUrl);
    previewUrl = URL.createObjectURL(file);
    selectedFile = file;
    imagePreview.src = previewUrl;
    fileName.textContent = file.name;
    emptyState.hidden = true;
    previewState.hidden = false;
    searchButton.disabled = false;
  }

  input.addEventListener('change', () => {
    const file = input.files?.[0];
    if (file) selectFile(file);
  });

  for (const eventName of ['dragenter', 'dragover']) {
    dropZone.addEventListener(eventName, (event) => {
      event.preventDefault();
      dropZone.classList.add('dragging');
    });
  }
  for (const eventName of ['dragleave', 'drop']) {
    dropZone.addEventListener(eventName, (event) => {
      event.preventDefault();
      dropZone.classList.remove('dragging');
    });
  }
  dropZone.addEventListener('drop', (event) => {
    const file = event.dataTransfer?.files?.[0];
    if (file) selectFile(file);
  });

  dropZone.addEventListener('keydown', (event) => {
    if (event.key !== 'Enter' && event.key !== ' ') return;
    event.preventDefault();
    input.click();
  });

  document.addEventListener('paste', (event) => {
    const imageItem = Array.from(event.clipboardData?.items ?? []).find(
      (item) => item.kind === 'file' && item.type.startsWith('image/'),
    );
    const clipboardFile = imageItem?.getAsFile();
    if (!clipboardFile) return;

    event.preventDefault();
    const extension =
      clipboardFile.type === 'image/png'
        ? 'png'
        : clipboardFile.type === 'image/webp'
          ? 'webp'
          : 'jpg';
    const pastedFile = new File(
      [clipboardFile],
      `pasted-screenshot-${Date.now()}.${extension}`,
      { type: clipboardFile.type },
    );
    selectFile(pastedFile);
    dropZone.classList.remove('pasted');
    window.requestAnimationFrame(() => dropZone.classList.add('pasted'));
    window.setTimeout(() => dropZone.classList.remove('pasted'), 700);
  });

  function formatDuration(value?: number): string {
    if (!value || value < 0) return 'Duration unavailable';
    const total = Math.round(value);
    const hours = Math.floor(total / 3600);
    const minutes = Math.floor((total % 3600) / 60);
    const seconds = total % 60;
    return hours > 0
      ? `${hours}:${String(minutes).padStart(2, '0')}:${String(seconds).padStart(2, '0')}`
      : `${minutes}:${String(seconds).padStart(2, '0')}`;
  }

  function thumbnailSource(value?: string): string {
    if (!value?.startsWith('http')) return '/favicon.svg';
    // These catalog thumbnails are already public CDN image URLs. The site's
    // generic weserv.nl proxy rejects this source with HTTP 403, while the
    // source CDN serves the images directly.
    return value;
  }

  function resultCard(result: VideoResult, rank: number): HTMLElement {
    const card = document.createElement('article');
    card.className = 'video-result-card';

    const media = document.createElement(result.sourceUrl ? 'a' : 'div');
    media.className = 'result-media';
    if (media instanceof HTMLAnchorElement && result.sourceUrl?.startsWith('https://')) {
      media.href = result.sourceUrl;
      media.target = '_blank';
      media.rel = 'noopener noreferrer';
    }

    const image = document.createElement('img');
    image.src = thumbnailSource(result.thumbnailUrl);
    image.alt = '';
    image.loading = rank > 3 ? 'lazy' : 'eager';
    // Some CDN77 video-frame thumbnails reject requests with no Referer.
    // Send only this site's origin, never the full search page URL.
    image.referrerPolicy = 'origin';
    media.appendChild(image);

    const rankBadge = document.createElement('span');
    rankBadge.className = 'rank-badge';
    rankBadge.textContent = `#${rank}`;
    media.appendChild(rankBadge);

    const duration = document.createElement('span');
    duration.className = 'duration-badge';
    duration.textContent = formatDuration(result.durationSeconds);
    media.appendChild(duration);
    card.appendChild(media);

    const body = document.createElement('div');
    body.className = 'result-body';

    const title = document.createElement('h3');
    title.textContent = result.title;
    body.appendChild(title);

    const scoreRow = document.createElement('div');
    scoreRow.className = 'score-row';
    const score = document.createElement('div');
    score.className = 'match-score';
    const scoreLabel = document.createElement('span');
    scoreLabel.textContent = 'Best cosine';
    const scoreValue = document.createElement('strong');
    scoreValue.textContent = result.similarity.toFixed(3);
    score.append(scoreLabel, scoreValue);

    const evidence = document.createElement('div');
    evidence.className = 'evidence-count';
    const evidenceValue = document.createElement('strong');
    evidenceValue.textContent = String(result.supportingEmbeddings);
    const evidenceLabel = document.createElement('span');
    evidenceLabel.textContent = result.supportingEmbeddings === 1 ? 'supporting face' : 'supporting faces';
    evidence.append(evidenceValue, evidenceLabel);
    scoreRow.append(score, evidence);
    body.appendChild(scoreRow);

    const meter = document.createElement('div');
    meter.className = 'score-meter';
    const fill = document.createElement('span');
    fill.style.width = `${Math.max(4, Math.min(100, result.similarity * 100))}%`;
    meter.appendChild(fill);
    body.appendChild(meter);

    if (result.sourceUrl?.startsWith('https://')) {
      const open = document.createElement('a');
      open.className = 'open-result';
      open.href = result.sourceUrl;
      open.target = '_blank';
      open.rel = 'noopener noreferrer';
      open.textContent = 'Open source video';
      const arrow = document.createElement('span');
      arrow.textContent = '↗';
      open.appendChild(arrow);
      body.appendChild(open);
    }

    card.appendChild(body);
    return card;
  }

  function renderNextResultsPage(): void {
    const nextCount = Math.min(
      visibleResultCount + RESULTS_PAGE_SIZE,
      allResults.length,
    );
    for (let index = visibleResultCount; index < nextCount; index += 1) {
      resultsGrid.appendChild(resultCard(allResults[index], index + 1));
    }
    visibleResultCount = nextCount;
    loadMore.hidden = visibleResultCount >= allResults.length;
    if (!loadMore.hidden) {
      loadMore.textContent = `Load more (${allResults.length - visibleResultCount} remaining)`;
    }
  }

  function renderResults(payload: SearchResponse): void {
    allResults = payload.results ?? [];
    visibleResultCount = 0;
    resultsGrid.replaceChildren();
    emptyResults.hidden = allResults.length > 0;
    resultsGrid.hidden = allResults.length === 0;
    resultsTitle.textContent = allResults.length === 1
      ? '1 matching video'
      : `${allResults.length} matching videos`;
    searchMeta.textContent = `${payload.indexedVideos ?? 0} indexed · ${(payload.elapsedSeconds ?? 0).toFixed(1)}s query`;
    renderNextResultsPage();
    resultsSection.hidden = false;
    resultsSection.scrollIntoView({ behavior: 'smooth', block: 'start' });
  }

  loadMore.addEventListener('click', renderNextResultsPage);

  function setSearching(value: boolean): void {
    searching = value;
    input.disabled = value;
    searchButton.disabled = value || !selectedFile;
    idleContent.hidden = value;
    loadingContent.hidden = !value;
  }

  form.addEventListener('submit', async (event) => {
    event.preventDefault();
    if (!selectedFile || searching) return;
    const user = currentUser();
    if (!user?.access_token && localStorage.getItem(GUEST_DAY_KEY) === todayUtc()) {
      openLimitModal();
      return;
    }
    clearError();
    setSearching(true);
    resultsSection.hidden = true;

    const labels = [
      'Loading face model…',
      'Creating face embedding…',
      'Searching indexed frames…',
    ];
    let labelIndex = 0;
    loadingLabel.textContent = labels[0];
    const labelTimer = window.setInterval(() => {
      labelIndex = Math.min(labelIndex + 1, labels.length - 1);
      loadingLabel.textContent = labels[labelIndex];
    }, 1800);

    const controller = new AbortController();
    const timeout = window.setTimeout(() => controller.abort(), 65_000);
    try {
      const body = new FormData();
      body.append('image', selectedFile);
      const headers: HeadersInit = {};
      if (user?.access_token) headers.Authorization = `Bearer ${user.access_token}`;
      const response = await fetch('/api/video-face-search', {
        method: 'POST',
        headers,
        body,
        signal: controller.signal,
      });
      const payload = await response.json() as SearchResponse;
      if (response.status === 429 && payload.code === 'guest_daily_limit') {
        localStorage.setItem(GUEST_DAY_KEY, todayUtc());
        openLimitModal();
        return;
      }
      if (!response.ok || !payload.ok) {
        throw new Error(payload.error || 'The local face search failed.');
      }
      if (!user?.access_token) localStorage.setItem(GUEST_DAY_KEY, todayUtc());
      if (typeof payload.indexedVideos === 'number') {
        displayIndexedVideoCount(payload.indexedVideos);
      }
      savePornstarHistory(payload);
      renderResults(payload);
    } catch (error) {
      const message = error instanceof DOMException && error.name === 'AbortError'
        ? 'The search timed out. Confirm the local Python worker is available.'
        : error instanceof Error
          ? error.message
          : 'The local face search failed.';
      showError(message);
    } finally {
      window.clearInterval(labelTimer);
      window.clearTimeout(timeout);
      setSearching(false);
    }
  });

  window.addEventListener('beforeunload', () => {
    window.clearInterval(indexCountTimer);
    if (previewUrl) URL.revokeObjectURL(previewUrl);
  });
</script>

<style>
  .video-search {
    width: min(1180px, calc(100% - 40px));
    margin: 0 auto;
    padding: 96px 0 40px;
  }

  .video-search h1,
  .video-search h2,
  .video-search h3 {
    font-family: 'Manrope', sans-serif;
  }

  .hero-search-layout {
    display: grid;
    grid-template-columns: minmax(0, 0.88fr) minmax(470px, 1.12fr);
    gap: clamp(32px, 5vw, 68px);
    min-height: calc(100svh - 118px);
    align-items: center;
  }

  .hero-copy {
    max-width: 550px;
    margin: 0;
    text-align: left;
  }

  .prototype-pill {
    display: inline-flex;
    align-items: center;
    gap: 9px;
    margin-bottom: 22px;
    padding: 7px 13px;
    border: 1px solid rgba(168, 85, 247, 0.28);
    border-radius: 999px;
    background: rgba(124, 58, 237, 0.08);
    color: #c4b5fd;
    font-size: 12px;
    font-weight: 600;
    letter-spacing: 0.04em;
    text-transform: uppercase;
  }

  .live-dot {
    width: 7px;
    height: 7px;
    border-radius: 50%;
    background: #4ade80;
    box-shadow: 0 0 0 4px rgba(74, 222, 128, 0.12);
  }

  h1 {
    max-width: 680px;
    font-size: clamp(2.75rem, 4.6vw, 4.6rem);
    line-height: 0.99;
    letter-spacing: -0.045em;
  }

  h1 span {
    background: linear-gradient(115deg, #a78bfa 10%, #ec4899 88%);
    -webkit-background-clip: text;
    background-clip: text;
    -webkit-text-fill-color: transparent;
  }

  .hero-lede {
    max-width: 560px;
    margin: 24px 0 0;
    color: #a1a1ba;
    font-size: clamp(1rem, 2vw, 1.12rem);
    line-height: 1.75;
  }

  .hero-trust {
    display: flex;
    justify-content: flex-start;
    gap: 10px;
    margin: 24px 0 0;
    padding: 0;
    list-style: none;
    flex-wrap: wrap;
  }

  .hero-trust li {
    display: inline-flex;
    align-items: center;
    gap: 7px;
    padding: 7px 11px;
    border: 1px solid rgba(255, 255, 255, 0.07);
    border-radius: 999px;
    background: rgba(255, 255, 255, 0.025);
    color: #a5a5bd;
    font-size: 11px;
    font-weight: 600;
  }

  .hero-trust svg {
    width: 14px;
    stroke: #a78bfa;
    stroke-width: 1.7;
    stroke-linecap: round;
    stroke-linejoin: round;
  }

  .hero-search-layout > *,
  .results-grid > * {
    min-width: 0;
  }

  .upload-card,
  .validation-card {
    min-width: 0;
    border: 1px solid rgba(139, 92, 246, 0.2);
    border-radius: 24px;
    background:
      linear-gradient(145deg, rgba(25, 24, 39, 0.96), rgba(15, 15, 24, 0.98));
    box-shadow: 0 24px 80px rgba(0, 0, 0, 0.25);
  }

  .upload-card {
    padding: 22px;
  }

  .card-kicker {
    display: flex;
    justify-content: space-between;
    gap: 16px;
    margin: 0 2px 14px;
    font-size: 12px;
    font-weight: 600;
    color: #d4d4e5;
    letter-spacing: 0.04em;
    text-transform: uppercase;
  }

  .privacy-note {
    color: #7f7f9c;
    font-weight: 500;
    text-transform: none;
    letter-spacing: 0;
  }

  .drop-zone {
    position: relative;
    display: grid;
    min-height: 300px;
    overflow: hidden;
    border: 1px dashed rgba(168, 85, 247, 0.42);
    border-radius: 18px;
    background:
      radial-gradient(circle at 50% 20%, rgba(124, 58, 237, 0.12), transparent 48%),
      rgba(7, 7, 12, 0.55);
    cursor: pointer;
    transition: border-color 180ms ease, background 180ms ease, transform 180ms ease;
  }

  .drop-zone:hover,
  .drop-zone:focus-visible,
  .drop-zone.dragging,
  .drop-zone.pasted {
    border-color: #a855f7;
    outline: none;
    background:
      radial-gradient(circle at 50% 20%, rgba(124, 58, 237, 0.2), transparent 52%),
      rgba(7, 7, 12, 0.7);
  }

  .drop-zone.dragging {
    transform: scale(1.006);
  }

  .drop-zone.pasted {
    animation: paste-pulse 650ms ease;
  }

  @keyframes paste-pulse {
    0%, 100% { box-shadow: 0 0 0 0 rgba(168, 85, 247, 0); }
    45% { box-shadow: 0 0 0 7px rgba(168, 85, 247, 0.14); }
  }

  .empty-state {
    display: flex;
    min-height: 300px;
    flex-direction: column;
    align-items: center;
    justify-content: center;
    padding: 28px;
    text-align: center;
  }

  .upload-icon {
    display: grid;
    width: 62px;
    height: 62px;
    margin-bottom: 18px;
    place-items: center;
    border: 1px solid rgba(168, 85, 247, 0.3);
    border-radius: 18px;
    background: rgba(124, 58, 237, 0.13);
    color: #c4b5fd;
  }

  .upload-icon svg {
    width: 28px;
    stroke: currentColor;
    stroke-width: 1.7;
    stroke-linecap: round;
    stroke-linejoin: round;
  }

  .empty-state strong {
    margin-bottom: 4px;
    font-size: 1.08rem;
  }

  .empty-state span {
    color: #a1a1ba;
    font-size: 14px;
  }

  .empty-state .paste-hint {
    display: inline-flex;
    align-items: center;
    gap: 6px;
    margin-top: 18px;
    padding: 7px 10px;
    border: 1px solid rgba(168, 85, 247, 0.2);
    border-radius: 9px;
    background: rgba(124, 58, 237, 0.08);
    color: #c4b5fd;
    font-size: 11px;
    font-weight: 600;
  }

  .paste-hint kbd {
    min-width: 24px;
    padding: 3px 5px;
    border: 1px solid rgba(255, 255, 255, 0.13);
    border-bottom-color: rgba(255, 255, 255, 0.23);
    border-radius: 5px;
    background: rgba(255, 255, 255, 0.06);
    color: #f5f3ff;
    font: 600 10px/1 'Inter', sans-serif;
  }

  .empty-state small {
    margin-top: 12px;
    color: #696980;
    font-size: 11px;
  }

  .preview-state {
    position: absolute;
    inset: 0;
  }

  .preview-state img {
    width: 100%;
    height: 100%;
    object-fit: contain;
    background: #09090e;
  }

  .preview-overlay {
    position: absolute;
    right: 12px;
    bottom: 12px;
    left: 12px;
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 14px;
    padding: 10px 13px;
    border: 1px solid rgba(255, 255, 255, 0.1);
    border-radius: 10px;
    background: rgba(8, 8, 13, 0.8);
    backdrop-filter: blur(12px);
    color: #fff;
    font-size: 12px;
  }

  .preview-overlay span:first-child {
    overflow: hidden;
    text-overflow: ellipsis;
    white-space: nowrap;
  }

  .preview-overlay span:last-child {
    flex-shrink: 0;
    color: #a78bfa;
  }

  .photo-guidance {
    display: flex;
    justify-content: center;
    gap: 22px;
    margin: 17px 0;
    color: #7f7f9c;
    font-size: 12px;
  }

  .photo-guidance span {
    display: inline-flex;
    align-items: center;
    gap: 6px;
  }

  .photo-guidance svg {
    width: 16px;
    stroke: currentColor;
    stroke-width: 1.4;
    stroke-linecap: round;
    stroke-linejoin: round;
  }

  .usage-note {
    max-width: 560px;
    margin: -2px auto 14px;
    color: #686880;
    font-size: 10px;
    line-height: 1.55;
    text-align: center;
  }

  .search-access-note {
    margin: -5px 0 14px;
    color: #8d8da6;
    font-size: 11px;
    line-height: 1.5;
    text-align: center;
  }
  .search-access-note a {
    color: #c4b5fd;
    font-weight: 700;
    text-decoration: underline;
    text-decoration-color: rgba(196, 181, 253, 0.38);
    text-underline-offset: 3px;
  }

  .search-limit-modal[hidden] { display: none; }
  .search-limit-modal {
    position: fixed;
    inset: 0;
    z-index: 1000;
    display: grid;
    place-items: center;
    padding: 20px;
  }
  .search-limit-backdrop {
    position: absolute;
    inset: 0;
    border: 0;
    background: rgba(3, 3, 8, 0.78);
    backdrop-filter: blur(8px);
    cursor: default;
  }
  .search-limit-card {
    position: relative;
    z-index: 1;
    width: min(430px, 100%);
    padding: 34px 30px 26px;
    border: 1px solid rgba(167, 139, 250, 0.32);
    border-radius: 22px;
    background: linear-gradient(145deg, rgba(28, 24, 42, 0.98), rgba(13, 13, 21, 0.98));
    box-shadow: 0 28px 80px rgba(0, 0, 0, 0.56), 0 0 50px rgba(124, 58, 237, 0.13);
    text-align: center;
  }
  .search-limit-close {
    position: absolute;
    top: 12px;
    right: 14px;
    width: 32px;
    height: 32px;
    border: 0;
    background: transparent;
    color: #8d8da6;
    font-size: 24px;
    cursor: pointer;
  }
  .search-limit-icon {
    display: grid;
    width: 54px;
    height: 54px;
    margin: 0 auto 17px;
    place-items: center;
    border-radius: 17px;
    background: linear-gradient(135deg, #7c3aed, #d946ef);
    box-shadow: 0 10px 30px rgba(124, 58, 237, 0.38);
    color: #fff;
    font: 800 28px/1 'Manrope', sans-serif;
  }
  .search-limit-card h2 { font-size: 1.45rem; }
  .search-limit-card p {
    margin: 11px auto 22px;
    color: #9d9db3;
    font-size: 14px;
    line-height: 1.6;
  }
  .search-limit-signin {
    display: block;
    padding: 13px 18px;
    border-radius: 12px;
    background: linear-gradient(115deg, #7c3aed, #d946ef);
    box-shadow: 0 10px 28px rgba(124, 58, 237, 0.28);
    color: #fff;
    font-size: 14px;
    font-weight: 800;
  }
  .search-limit-later {
    margin-top: 13px;
    border: 0;
    background: transparent;
    color: #85859e;
    font: 600 12px/1.4 'Inter', sans-serif;
    cursor: pointer;
  }

  .form-error {
    margin: 0 0 14px;
    padding: 11px 13px;
    border: 1px solid rgba(248, 113, 113, 0.28);
    border-radius: 10px;
    background: rgba(127, 29, 29, 0.16);
    color: #fca5a5;
    font-size: 13px;
  }

  .search-button {
    width: 100%;
    min-height: 52px;
    border: 0;
    border-radius: 13px;
    background: linear-gradient(115deg, #7c3aed, #d946ef);
    box-shadow: 0 12px 34px rgba(124, 58, 237, 0.25);
    color: white;
    cursor: pointer;
    font: 600 14px/1 'Inter', sans-serif;
    transition: transform 160ms ease, filter 160ms ease, opacity 160ms ease;
  }

  .search-button:hover:not(:disabled) {
    transform: translateY(-1px);
    filter: brightness(1.08);
  }

  .search-button:disabled {
    cursor: not-allowed;
    opacity: 0.42;
    box-shadow: none;
  }

  .button-idle,
  .button-loading {
    display: inline-flex;
    min-width: 0;
    align-items: center;
    justify-content: center;
    gap: 10px;
  }

  .button-idle[hidden],
  .button-loading[hidden] {
    display: none;
  }

  .button-idle svg {
    width: 19px;
    stroke: currentColor;
    stroke-width: 1.8;
    stroke-linecap: round;
    stroke-linejoin: round;
  }

  .spinner {
    width: 17px;
    height: 17px;
    border: 2px solid rgba(255, 255, 255, 0.35);
    border-top-color: #fff;
    border-radius: 50%;
    animation: spin 0.75s linear infinite;
  }

  @keyframes spin {
    to { transform: rotate(360deg); }
  }

  .validation-card {
    display: grid;
    grid-template-columns: minmax(280px, 0.7fr) minmax(0, 1.3fr);
    gap: 18px;
    align-items: stretch;
    margin-top: 22px;
    padding: 24px 26px 20px;
  }

  .validation-head {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 16px;
    padding: 12px 8px 12px 4px;
  }

  .eyebrow {
    display: block;
    margin-bottom: 5px;
    color: #8b8ba5;
    font-size: 10px;
    font-weight: 700;
    letter-spacing: 0.13em;
    text-transform: uppercase;
  }

  .validation-head h2,
  .results-heading h2 {
    font-size: 1.3rem;
    letter-spacing: -0.02em;
  }

  .validation-head h2 {
    white-space: nowrap;
  }

  .status-mark {
    display: grid;
    width: 38px;
    height: 38px;
    flex: 0 0 auto;
    place-items: center;
    border: 1px solid rgba(74, 222, 128, 0.24);
    border-radius: 50%;
    background: rgba(34, 197, 94, 0.1);
    color: #4ade80;
  }

  .status-mark svg {
    width: 20px;
    stroke: currentColor;
    stroke-width: 2;
    stroke-linecap: round;
    stroke-linejoin: round;
  }

  .metric-grid {
    display: grid;
    grid-template-columns: repeat(4, minmax(0, 1fr));
    gap: 10px;
    margin: 0;
  }

  .metric {
    padding: 15px;
    border: 1px solid rgba(255, 255, 255, 0.06);
    border-radius: 13px;
    background: rgba(255, 255, 255, 0.025);
  }

  .metric strong {
    display: block;
    color: #f5f3ff;
    font-family: 'Manrope', sans-serif;
    font-size: 1.2rem;
    line-height: 1.1;
  }

  .metric span {
    color: #77778e;
    font-size: 10px;
  }

  .pipeline {
    display: grid;
    grid-template-columns: repeat(3, minmax(0, 1fr));
    grid-column: 1 / -1;
    gap: 10px;
    min-width: 0;
  }

  .pipeline-step {
    display: grid;
    grid-template-columns: 34px minmax(0, 1fr);
    align-items: center;
    min-width: 0;
    gap: 11px;
    padding: 16px 13px;
    border: 1px solid rgba(255, 255, 255, 0.06);
    border-radius: 13px;
    background: rgba(255, 255, 255, 0.025);
    transition: border-color 180ms ease, background 180ms ease, transform 180ms ease;
  }

  .pipeline-step:hover {
    transform: translateY(-2px);
    border-color: rgba(168, 85, 247, 0.23);
    background: rgba(124, 58, 237, 0.06);
  }

  .pipeline-step > span {
    display: grid;
    width: 34px;
    height: 34px;
    flex: 0 0 auto;
    place-items: center;
    border: 1px solid rgba(168, 85, 247, 0.28);
    border-radius: 10px;
    background: rgba(124, 58, 237, 0.09);
    color: #c4b5fd;
    font-size: 10px;
    font-weight: 700;
  }

  .pipeline-step strong,
  .pipeline-step small {
    display: block;
  }

  .pipeline-step strong {
    font-size: 13px;
  }

  .pipeline-step small {
    margin-top: 1px;
    color: #727288;
    font-size: 10px;
    line-height: 1.45;
  }

  .pipeline-line {
    display: none;
  }

  .validation-foot {
    grid-column: 1 / -1;
    margin: 0;
    padding-top: 14px;
    border-top: 1px solid rgba(255, 255, 255, 0.06);
    color: #6f6f86;
    font-size: 10px;
    line-height: 1.6;
  }

  .validation-foot code {
    color: #a78bfa;
    font-family: ui-monospace, SFMono-Regular, Menlo, monospace;
  }

  .results-section {
    scroll-margin-top: 92px;
    padding-top: 74px;
  }

  .results-heading {
    display: flex;
    align-items: end;
    justify-content: space-between;
    gap: 20px;
    margin-bottom: 20px;
  }

  .results-heading h2 {
    font-size: clamp(1.7rem, 4vw, 2.35rem);
  }

  .search-meta {
    color: #85859c;
    font-size: 12px;
  }

  .cross-finder-cta {
    display: grid;
    grid-template-columns: 36px minmax(0, 1fr) auto;
    align-items: center;
    gap: 12px;
    margin-bottom: 20px;
    padding: 12px 14px;
    border: 1px solid rgba(168, 85, 247, 0.24);
    border-radius: 14px;
    background: linear-gradient(135deg, rgba(124, 58, 237, 0.09), rgba(236, 72, 153, 0.06));
    color: #f5f3ff;
    text-decoration: none;
    transition: border-color 180ms ease, background 180ms ease, transform 180ms ease;
  }

  .cross-finder-cta:hover {
    border-color: rgba(217, 70, 239, 0.48);
    background: linear-gradient(135deg, rgba(124, 58, 237, 0.15), rgba(236, 72, 153, 0.1));
    transform: translateY(-1px);
  }

  .cross-finder-icon {
    display: grid;
    width: 36px;
    height: 36px;
    place-items: center;
    border-radius: 10px;
    background: rgba(139, 92, 246, 0.14);
    color: #c4b5fd;
  }

  .cross-finder-icon svg { width: 18px; stroke: currentColor; stroke-width: 1.8; }
  .cross-finder-copy { display: grid; gap: 2px; min-width: 0; }
  .cross-finder-copy strong { font-size: 13px; }
  .cross-finder-copy small { color: #9393aa; font-size: 11px; line-height: 1.4; }
  .cross-finder-action { color: #d8b4fe; font-size: 12px; font-weight: 800; white-space: nowrap; }

  .results-grid {
    display: grid;
    grid-template-columns: repeat(3, minmax(0, 1fr));
    gap: 18px;
  }

  .load-more {
    display: block;
    margin: 24px auto 0;
    padding: 11px 18px;
    border: 1px solid rgba(168, 85, 247, 0.45);
    border-radius: 10px;
    color: #f5f3ff;
    background: rgba(124, 58, 237, 0.16);
    cursor: pointer;
  }

  .load-more:hover {
    border-color: rgba(217, 70, 239, 0.75);
    background: rgba(168, 85, 247, 0.24);
  }

  .load-more[hidden] {
    display: none;
  }

  :global(.video-result-card) {
    overflow: hidden;
    border: 1px solid rgba(139, 92, 246, 0.17);
    border-radius: 17px;
    background: #12121a;
    transition: transform 180ms ease, border-color 180ms ease;
  }

  :global(.video-result-card:hover) {
    transform: translateY(-3px);
    border-color: rgba(168, 85, 247, 0.44);
  }

  :global(.result-media) {
    position: relative;
    display: block;
    aspect-ratio: 16 / 9;
    overflow: hidden;
    background: #08080d;
  }

  :global(.result-media img) {
    width: 100%;
    height: 100%;
    object-fit: cover;
    transition: transform 300ms ease;
  }

  :global(.video-result-card:hover .result-media img) {
    transform: scale(1.025);
  }

  :global(.rank-badge),
  :global(.duration-badge) {
    position: absolute;
    top: 10px;
    padding: 4px 8px;
    border: 1px solid rgba(255, 255, 255, 0.13);
    border-radius: 7px;
    background: rgba(8, 8, 13, 0.78);
    color: #f5f5fa;
    font-size: 10px;
    font-weight: 700;
    backdrop-filter: blur(10px);
  }

  :global(.rank-badge) { left: 10px; }
  :global(.duration-badge) { right: 10px; }

  :global(.result-body) {
    padding: 16px;
  }

  :global(.result-body h3) {
    display: -webkit-box;
    min-height: 42px;
    overflow: hidden;
    -webkit-box-orient: vertical;
    -webkit-line-clamp: 2;
    font-family: 'Inter', sans-serif;
    font-size: 14px;
    font-weight: 600;
    line-height: 1.45;
  }

  :global(.score-row) {
    display: flex;
    justify-content: space-between;
    gap: 18px;
    margin-top: 16px;
  }

  :global(.match-score span),
  :global(.match-score strong),
  :global(.evidence-count span),
  :global(.evidence-count strong) {
    display: block;
  }

  :global(.match-score span),
  :global(.evidence-count span) {
    color: #727289;
    font-size: 9px;
    text-transform: uppercase;
    letter-spacing: 0.08em;
  }

  :global(.match-score strong) {
    color: #c4b5fd;
    font-family: 'Manrope', sans-serif;
    font-size: 1.1rem;
  }

  :global(.evidence-count) {
    text-align: right;
  }

  :global(.evidence-count strong) {
    font-size: 1rem;
  }

  :global(.score-meter) {
    height: 3px;
    margin-top: 12px;
    overflow: hidden;
    border-radius: 99px;
    background: rgba(255, 255, 255, 0.06);
  }

  :global(.score-meter span) {
    display: block;
    height: 100%;
    border-radius: inherit;
    background: linear-gradient(90deg, #7c3aed, #ec4899);
  }

  :global(.open-result) {
    display: flex;
    align-items: center;
    justify-content: space-between;
    margin-top: 15px;
    padding-top: 13px;
    border-top: 1px solid rgba(255, 255, 255, 0.06);
    color: #aaaac0;
    font-size: 11px;
    font-weight: 600;
    transition: color 160ms ease;
  }

  :global(.open-result:hover) {
    color: #d8b4fe;
  }

  :global(.open-result span) {
    font-size: 14px;
  }

  .empty-results {
    padding: 54px 20px;
    border: 1px dashed rgba(139, 92, 246, 0.2);
    border-radius: 18px;
    text-align: center;
    background: rgba(18, 18, 26, 0.65);
  }

  .empty-result-icon {
    display: grid;
    width: 48px;
    height: 48px;
    margin: 0 auto 14px;
    place-items: center;
    border-radius: 14px;
    background: rgba(124, 58, 237, 0.1);
    color: #a78bfa;
  }

  .empty-result-icon svg {
    width: 23px;
    stroke: currentColor;
    stroke-width: 1.7;
    stroke-linecap: round;
  }

  .empty-results h3 {
    font-size: 1.05rem;
  }

  .empty-results p {
    margin-top: 5px;
    color: #818198;
    font-size: 13px;
  }

  @media (max-width: 1100px) {
    .validation-card {
      grid-template-columns: minmax(220px, 0.7fr) minmax(0, 1.3fr);
    }

    .metric-grid {
      grid-template-columns: repeat(2, minmax(0, 1fr));
    }
