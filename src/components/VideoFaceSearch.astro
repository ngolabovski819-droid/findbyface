---

<section class="video-search" aria-labelledby="video-search-heading">
  <div class="hero-search-layout">
    <div class="hero-copy">
      <div class="prototype-pill">
        <span class="live-dot"></span>
        {C.betaPill}
      </div>
      <h1 id="video-search-heading">
        {C.h1}
        <span>{C.h1Span}</span>
      </h1>
      <p class="hero-lede">
        {C.lede}
      </p>
      <ul class="hero-trust" aria-label={C.highlightsAria}>
        <li>
          <svg viewBox="0 0 20 20" fill="none" aria-hidden="true">
            <path d="m5 10.3 3 3L15.5 6" />
          </svg>
          {C.trustRanked}
        </li>
        <li>
          <svg viewBox="0 0 20 20" fill="none" aria-hidden="true">
            <path d="M5.5 9V6.8a4.5 4.5 0 0 1 9 0V9M4 9h12v8H4z" />
          </svg>
          {C.trustDeleted}
        </li>
        <li>
          <svg viewBox="0 0 20 20" fill="none" aria-hidden="true">
            <path d="M10 2.5 12 7l4.8.5-3.6 3.2 1 4.8-4.2-2.4-4.2 2.4 1-4.8-3.6-3.2L8 7z" />
          </svg>
          {C.trustFree}
        </li>
      </ul>
    </div>

    <form class="upload-card" id="videoSearchForm">
      <div class="card-kicker">
        <span>{C.queryImage}</span>
        <span class="privacy-note">{C.deletedAfter}</span>
      </div>

      <label
        class="drop-zone"
        id="dropZone"
        for="faceImage"
        tabindex="0"
        aria-label={C.dropAria}
      >
        <input
          id="faceImage"
          name="image"
          type="file"
          accept="image/jpeg,image/png,image/webp"
          hidden
        />

        <div class="empty-state" id="emptyState">
          <div class="upload-icon" aria-hidden="true">
            <svg viewBox="0 0 24 24" fill="none">
              <path d="M12 16V4m0 0L7.5 8.5M12 4l4.5 4.5" />
              <path d="M5 13v5a2 2 0 0 0 2 2h10a2 2 0 0 0 2-2v-5" />
            </svg>
          </div>
          <strong>{C.dropTitle}</strong>
          <span>{C.dropSub}</span>
          <span class="paste-hint" aria-hidden="true">
            <kbd>Ctrl</kbd><span>+</span><kbd>V</kbd>
            {C.pasteHint}
          </span>
          <small>{C.dropFormats}</small>
        </div>

        <div class="preview-state" id="previewState" hidden>
          <img id="imagePreview" alt={C.previewAlt} />
          <div class="preview-overlay">
            <span id="fileName"></span>
            <span>{C.clickReplace}</span>
          </div>
        </div>
      </label>

      <div class="scanning-state" id="scanningState">
        <div class="scan-stage">
          <div class="scanning-img-box">
            <img id="scanningImg" alt={C.scanningAlt} />
            <div class="scan-line"></div>
            <span class="scan-bracket tl"></span>
            <span class="scan-bracket tr"></span>
            <span class="scan-bracket bl"></span>
            <span class="scan-bracket br"></span>
            <span class="scan-tag">{C.yourPhoto}</span>
          </div>
          <div class="scan-connector">
            <span class="connector-core"></span>
            <span class="connector-spark"></span>
          </div>
          <div class="face-roulette" id="faceRoulette" aria-hidden="true">
            {rouletteSrcs.length > 0
              ? (
                  <div
                    class="roulette-strip"
                    style={`height:${rouletteSrcs.length * 100}%;animation:roulette-scroll ${Math.max(2, rouletteSrcs.length * 0.11).toFixed(2)}s steps(${rouletteSrcs.length}) infinite;`}
                  >
                    {rouletteSrcs.map((src) => (
                      <img
                        src={src}
                        class="roulette-face"
                        loading="eager"
                        decoding="async"
                        referrerpolicy="no-referrer"
                        alt=""
                      />
                    ))}
                  </div>
                )
              : <div class="roulette-placeholder"></div>}
            <span class="roulette-ring"></span>
            <span class="scan-tag">{C.matching}</span>
          </div>
        </div>

        <p class="scanning-title">{C.scanningTitle}</p>
        <p class="scanning-sub" id="scanningSub">{C.loadingModel}</p>

        <div class="progress-track">
          <div class="progress-fill"></div>
        </div>

        <p class="scan-counter" id="scanCounter" set:html={C.scanCounter} />

        <div class="scan-steps" id="scanSteps">
          <span class="scan-step active" data-step="0"><i class="step-mark"></i>{C.stepDetect}</span>
          <span class="scan-step" data-step="1"><i class="step-mark"></i>{C.stepLandmarks}</span>
          <span class="scan-step" data-step="2"><i class="step-mark"></i>{C.stepFrames}</span>
          <span class="scan-step" data-step="3"><i class="step-mark"></i>{C.stepRanking}</span>
        </div>
      </div>

      <div class="photo-guidance" aria-label={C.guidanceAria}>
        <span>
          <svg viewBox="0 0 20 20" fill="none" aria-hidden="true">
            <circle cx="10" cy="7" r="3" />
            <path d="M4.5 17c.5-3.1 2.3-4.7 5.5-4.7s5 1.6 5.5 4.7" />
          </svg>
          {C.oneFace}
        </span>
        <span>
          <svg viewBox="0 0 20 20" fill="none" aria-hidden="true">
            <circle cx="10" cy="10" r="4" />
            <path d="M10 1.5v2M10 16.5v2M1.5 10h2M16.5 10h2M4 4l1.4 1.4M14.6 14.6L16 16M16 4l-1.4 1.4M5.4 14.6L4 16" />
          </svg>
          {C.evenLighting}
        </span>
        <span>
          <svg viewBox="0 0 20 20" fill="none" aria-hidden="true">
            <path d="M2.5 5.5h3l1.2-2h6.6l1.2 2h3v11h-15z" />
            <circle cx="10" cy="11" r="3.2" />
          </svg>
          {C.sharpImage}
        </span>
      </div>

      <p class="usage-note">
        {C.usageNote}
      </p>

      <p class="search-access-note">
        {C.guestsNote}
        <a href={`${langPrefix}/signup/?next=${pagePath}`}>{C.signupUnlimited}</a>.
      </p>

      <p class="form-error" id="formError" role="alert" hidden></p>

      <div id="searchTurnstile"></div>

      <button class="search-button" id="searchButton" type="submit" disabled>
        {C.searchButton}
        <svg viewBox="0 0 20 20" fill="none" aria-hidden="true">
          <path d="M4 10h12M11.5 5.5 16 10l-4.5 4.5" />
        </svg>
      </button>
    </form>
  </div>

  <aside class="validation-card">
      <div class="validation-head">
        <div>
          <span class="eyebrow">{C.betaIndex}</span>
          <h2>{C.faceToVideo}</h2>
        </div>
        <div class="status-mark" title={C.betaOnline}>
          <svg viewBox="0 0 20 20" fill="none" aria-hidden="true">
            <path d="m5 10.2 3.1 3L15.5 6" />
          </svg>
        </div>
      </div>

      <div class="metric-grid">
        <div class="metric">
          <strong id="indexedVideoCount" aria-live="polite">—</strong>
          <span>{C.indexedVideos}</span>
        </div>
        <div class="metric">
          <strong>512D</strong>
          <span>{C.faceVectors}</span>
        </div>
        <div class="metric">
          <strong>8s</strong>
          <span>{C.sampleInterval}</span>
        </div>
        <div class="metric">
          <strong>GPU</strong>
          <span>{C.rtx}</span>
        </div>
      </div>

      <div class="pipeline">
        <div class="pipeline-step">
          <span>01</span>
          <div>
            <strong>{C.p1}</strong>
            <small>{C.p1s}</small>
          </div>
        </div>
        <div class="pipeline-line"></div>
        <div class="pipeline-step">
          <span>02</span>
          <div>
            <strong>{C.p2}</strong>
            <small>{C.p2s}</small>
          </div>
        </div>
        <div class="pipeline-line"></div>
        <div class="pipeline-step">
          <span>03</span>
          <div>
            <strong>{C.p3}</strong>
            <small>{C.p3s}</small>
          </div>
        </div>
      </div>

      <p class="validation-foot">
        {C.validationFoot}
      </p>
  </aside>

  <section class="results-section" id="resultsSection" aria-live="polite" hidden>
    <div class="results-heading">
      <div>
        <span class="eyebrow">{C.retrievalEyebrow}</span>
        <h2 id="resultsTitle">{C.videoMatches}</h2>
      </div>
      <div class="search-meta" id="searchMeta"></div>
    </div>
    <a class="cross-finder-cta" href={`${langPrefix}/#onlyfans-finder`}>
      <span class="cross-finder-icon" aria-hidden="true">
        <svg viewBox="0 0 24 24" fill="none"><circle cx="10" cy="10" r="5" /><path d="m14 14 5 5M8 8.5h4M10 6.5v4" /></svg>
      </span>
      <span class="cross-finder-copy">
        <strong>{C.crossTitle}</strong>
        <small>{C.crossSub}</small>
      </span>
      <span class="cross-finder-action">{C.crossAction} <b>→</b></span>
    </a>
    <div class="results-grid" id="resultsGrid"></div>
    <button class="load-more" id="loadMore" type="button" hidden>
      {C.loadMoreResults}
    </button>
    <div class="empty-results" id="emptyResults" hidden>
      <div class="empty-result-icon" aria-hidden="true">
        <svg viewBox="0 0 24 24" fill="none">
          <circle cx="11" cy="11" r="6" />
          <path d="m16 16 4 4M8.5 11h5" />
        </svg>
      </div>
      <h3>{C.emptyTitle}</h3>
      <p>{C.emptySub}</p>
    </div>
  </section>
</section>

<div class="search-limit-modal" id="pornstarLimitModal" hidden role="dialog" aria-modal="true" aria-labelledby="pornstarLimitTitle">
  <button class="search-limit-backdrop" id="pornstarLimitBackdrop" type="button" aria-label={C.closePrompt}></button>
  <div class="search-limit-card">
    <button class="search-limit-close" id="pornstarLimitClose" type="button" aria-label={C.close}>×</button>
    <span class="search-limit-icon" aria-hidden="true">∞</span>
    <h2 id="pornstarLimitTitle">{C.limitTitle}</h2>
    <p id="pornstarLimitText">{C.limitText}</p>
    <a class="search-limit-signin" id="pornstarLimitSignIn" href={`${langPrefix}/signup/?next=${pagePath}`}>{C.createFreeAccount}</a>
    <p class="search-limit-returning">
      <span id="pornstarLimitReturningText">{C.alreadyAccount}</span>
      <a id="pornstarLimitLogin" href={`${langPrefix}/login/?next=${pagePath}`}>{C.logIn}</a>
    </p>
    <button class="search-limit-later" id="pornstarLimitLater" type="button">{C.maybeLater}</button>
  </div>
</div>
<script type="application/json" id="i18nVideoFaceSearch" set:html={JSON.stringify(CLIENT)} />

<script is:inline>
  // See src/pages/contact.astro for why this ready-queue exists instead of an immediate call
  // or a DOMContentLoaded listener — Cloudflare's async script isn't guaranteed to be loaded
  // by either point, so onload=onTurnstileLoad (Cloudflare's own ready-signal) is what's used.
  window.__turnstileReady = window.__turnstileReady || [];
  window.onTurnstileLoad = window.onTurnstileLoad || function () {
    window.__turnstileReady.splice(0).forEach(function (fn) { fn(); });
  };
</script>
<script is:inline src="https://challenges.cloudflare.com/turnstile/v0/api.js?render=explicit&onload=onTurnstileLoad" async defer></script>
<script>
  import { currentAccountId, newSearchHistoryId, saveAccountSearchHistoryForOwner, scopedSearchHistoryKey } from '../lib/accountSearchHistory';

  // Locale strings server-rendered into the JSON block above (see frontmatter CLIENT).
  const T = JSON.parse(document.getElementById('i18nVideoFaceSearch')!.textContent!) as Record<string, string>;
  const fmtT = (s: string, v: Record<string, string | number> = {}) =>
    s.replace(/\{(\w+)\}/g, (_, k: string) => String(v[k] ?? ''));
  const langPrefix = T.langPrefix;
  const pagePath = T.pagePath;

  type VideoResult = {
    videoId: number;
    externalId: string;
    title: string;
    sourceUrl?: string;
    thumbnailUrl?: string;
    durationSeconds?: number;
    similarity: number;
    robustSimilarity: number;
    supportingEmbeddings: number;
  };

  type SearchResponse = {
    ok: boolean;
    code?: string;
    error?: string;
    indexedVideos?: number;
    elapsedSeconds?: number;
    results?: VideoResult[];
    searchProof?: string;
  };

  type AuthUser = {
    id?: string;
    name?: string;
    email?: string;
    avatar?: string;
    access_token?: string;
    refresh_token?: string;
    expires_at?: number;
  };

  const TURNSTILE_SITE_KEY = import.meta.env.PUBLIC_TURNSTILE_SITE_KEY;
  let turnstileWidgetId: string | undefined;
  function renderTurnstile(): void {
    const turnstile = (window as typeof window & { turnstile?: any }).turnstile;
    if (!turnstile || !TURNSTILE_SITE_KEY || turnstileWidgetId) return;
    turnstileWidgetId = turnstile.render('#searchTurnstile', { sitekey: TURNSTILE_SITE_KEY, language: document.documentElement.lang || 'en' });
  }
  if ((window as typeof window & { turnstile?: any }).turnstile) renderTurnstile();
  else (window as any).__turnstileReady.push(renderTurnstile);

  const form = document.querySelector<HTMLFormElement>('#videoSearchForm')!;
  const input = document.querySelector<HTMLInputElement>('#faceImage')!;
  const dropZone = document.querySelector<HTMLElement>('#dropZone')!;
  const emptyState = document.querySelector<HTMLElement>('#emptyState')!;
  const previewState = document.querySelector<HTMLElement>('#previewState')!;
  const imagePreview = document.querySelector<HTMLImageElement>('#imagePreview')!;
  const fileName = document.querySelector<HTMLElement>('#fileName')!;
  const searchButton = document.querySelector<HTMLButtonElement>('#searchButton')!;
  const formError = document.querySelector<HTMLElement>('#formError')!;
  const scanningImg = document.querySelector<HTMLImageElement>('#scanningImg')!;
  const scanningSub = document.querySelector<HTMLElement>('#scanningSub')!;
  const resultsSection = document.querySelector<HTMLElement>('#resultsSection')!;
  const resultsTitle = document.querySelector<HTMLElement>('#resultsTitle')!;
  const searchMeta = document.querySelector<HTMLElement>('#searchMeta')!;
  const resultsGrid = document.querySelector<HTMLElement>('#resultsGrid')!;
  const loadMore = document.querySelector<HTMLButtonElement>('#loadMore')!;
  const emptyResults = document.querySelector<HTMLElement>('#emptyResults')!;
  const limitModal = document.querySelector<HTMLElement>('#pornstarLimitModal')!;
  const limitBackdrop = document.querySelector<HTMLButtonElement>('#pornstarLimitBackdrop')!;
  const limitClose = document.querySelector<HTMLButtonElement>('#pornstarLimitClose')!;
  const limitLater = document.querySelector<HTMLButtonElement>('#pornstarLimitLater')!;
  const limitSignIn = document.querySelector<HTMLAnchorElement>('#pornstarLimitSignIn')!;
  const limitTitle = document.querySelector<HTMLElement>('#pornstarLimitTitle')!;
  const limitText = document.querySelector<HTMLElement>('#pornstarLimitText')!;
  const limitReturningText = document.querySelector<HTMLElement>('#pornstarLimitReturningText')!;
  const limitLogin = document.querySelector<HTMLAnchorElement>('#pornstarLimitLogin')!;
  const indexedVideoCount = document.querySelector<HTMLElement>('#indexedVideoCount')!;

  const RESULTS_PAGE_SIZE = 24;
  const HISTORY_KEY = 'fbf_pornstar_history';
  const GUEST_DAY_KEY = 'fbf_pornstar_guest_search_day';
  let selectedFile: File | null = null;
  let previewUrl = '';
  let searching = false;
  let allResults: VideoResult[] = [];
  let visibleResultCount = 0;

  function displayIndexedVideoCount(value: number): void {
    if (!Number.isSafeInteger(value) || value < 0) return;
    indexedVideoCount.textContent = new Intl.NumberFormat().format(value);
    indexedVideoCount.title = `${value.toLocaleString()} videos currently indexed`;
  }

  async function refreshIndexedVideoCount(): Promise<void> {
    try {
      const response = await fetch('/api/video-index-stats');
      if (!response.ok) return;
      const payload = await response.json() as { indexedVideos?: number };
      if (typeof payload.indexedVideos === 'number') {
        displayIndexedVideoCount(payload.indexedVideos);
      }
    } catch {
      // Keep the last known count when the network is temporarily unavailable.
    }
  }

  void refreshIndexedVideoCount();
  const indexCountTimer = window.setInterval(() => {
    if (document.visibilityState === 'visible') void refreshIndexedVideoCount();
  }, 30_000);

  function currentUser(): AuthUser | null {
    try {
      return JSON.parse(localStorage.getItem('fbf_user') || 'null');
    } catch {
      return null;
    }
  }

  function tokenExpiry(token?: string): number {
    if (!token) return 0;
    try {
      const encoded = token.split('.')[1].replace(/-/g, '+').replace(/_/g, '/');
      const payload = JSON.parse(atob(encoded)) as { exp?: number };
      return Number(payload.exp || 0) * 1000;
    } catch {
      return 0;
    }
  }

  async function refreshUser(user: AuthUser): Promise<AuthUser | null> {
    const ownerId = user.id;
    const refreshToken = user.refresh_token;
    if (!ownerId || !refreshToken) return null;
    try {
      const response = await fetch('/api/auth/refresh', {
        method: 'POST',
        headers: { 'Content-Type': 'application/json' },
        body: JSON.stringify({ refresh_token: refreshToken }),
      });
      const payload = await response.json();
      const current = currentUser();
      if (current?.id !== ownerId || current.refresh_token !== refreshToken) {
        return current?.access_token ? current : null;
      }
      if (!response.ok || !payload.access_token || payload.user?.id !== ownerId) return null;
      const refreshed: AuthUser = {
        ...current,
        ...payload.user,
        access_token: payload.access_token,
        refresh_token: payload.refresh_token || refreshToken,
        expires_at: Date.now() + Number(payload.expires_in || 3600) * 1000,
      };
      localStorage.setItem('fbf_user', JSON.stringify(refreshed));
      localStorage.removeItem(GUEST_DAY_KEY);
      return refreshed;
    } catch {
      const current = currentUser();
      return current?.id !== ownerId || current.refresh_token !== refreshToken
        ? current
        : null;
    }
  }

  async function resolveUserForSearch(): Promise<{
    user: AuthUser | null;
    expired: boolean;
  }> {
    const stored = currentUser();
    if (!stored?.access_token) return { user: null, expired: false };
    const expiresAt = Number(stored.expires_at || tokenExpiry(stored.access_token));
    if (expiresAt > Date.now() + 60_000) return { user: stored, expired: false };
    const refreshed = await refreshUser(stored);
    if (refreshed) return { user: refreshed, expired: false };
    const accountId = stored.id;
    localStorage.removeItem('fbf_user');
    if (accountId) {
      localStorage.removeItem(scopedSearchHistoryKey('fbf_history', accountId));
      localStorage.removeItem(scopedSearchHistoryKey(HISTORY_KEY, accountId));
      localStorage.removeItem(scopedSearchHistoryKey('fbf_search_queries', accountId));
    }
    return { user: null, expired: true };
  }

  function todayUtc(): string {
    return new Date().toISOString().slice(0, 10);
  }

  function openLimitModal(mode: 'guest' | 'expired' = 'guest'): void {
    if (mode === 'expired') {
      limitTitle.textContent = T.expiredTitle;
      limitText.textContent = T.expiredText;
      limitSignIn.textContent = T.logIn;
      limitSignIn.href = `${langPrefix}/login/?next=${pagePath}`;
      limitReturningText.textContent = T.newTo;
      limitLogin.textContent = T.createFreeAccount;
      limitLogin.href = `${langPrefix}/signup/?next=${pagePath}`;
    } else {
      limitTitle.textContent = T.limitTitle;
      limitText.textContent = T.limitText;
      limitSignIn.textContent = T.createFreeAccount;
      limitSignIn.href = `${langPrefix}/signup/?next=${pagePath}`;
      limitReturningText.textContent = T.alreadyAccount;
      limitLogin.textContent = T.logIn;
      limitLogin.href = `${langPrefix}/login/?next=${pagePath}`;
    }
    limitModal.hidden = false;
    document.body.style.overflow = 'hidden';
    limitSignIn.focus();
  }

  function closeLimitModal(): void {
    limitModal.hidden = true;
    document.body.style.overflow = '';
  }

  limitBackdrop.addEventListener('click', closeLimitModal);
  limitClose.addEventListener('click', closeLimitModal);
  limitLater.addEventListener('click', closeLimitModal);

  function savePornstarHistory(payload: SearchResponse, ownerAccountId = currentAccountId()): void {
    if (!ownerAccountId || currentAccountId() !== ownerAccountId) return;
    const results = (payload.results ?? []).slice(0, 10).map(result => ({
      videoId: result.videoId,
      externalId: result.externalId,
      title: result.title,
      sourceUrl: result.sourceUrl,
      thumbnailUrl: result.thumbnailUrl,
      durationSeconds: result.durationSeconds,
      similarity: result.similarity,
      robustSimilarity: result.robustSimilarity,
      supportingEmbeddings: result.supportingEmbeddings,
    }));
    const clientSearchId = newSearchHistoryId('video_face');
    const entry = {
      id: clientSearchId,
      date: new Date().toISOString(),
      count: payload.results?.length ?? 0,
      indexedVideos: payload.indexedVideos ?? 0,
      elapsedSeconds: payload.elapsedSeconds ?? 0,
      results,
    };
    try {
      const cacheKey = scopedSearchHistoryKey(HISTORY_KEY, ownerAccountId);
      const stored = JSON.parse(localStorage.getItem(cacheKey) || '[]');
      const history = Array.isArray(stored) ? stored : [];
      history.unshift(entry);
      localStorage.setItem(cacheKey, JSON.stringify(history.slice(0, 25)));
    } catch {
      // Search results still work if browser storage is unavailable.
    }
    void saveAccountSearchHistoryForOwner(ownerAccountId, {
      clientSearchId,
      searchType: 'video_face',
      label: T.historyLabel,
      resultCount: entry.count,
      filters: {
        indexedVideos: entry.indexedVideos,
        elapsedSeconds: entry.elapsedSeconds,
      },
      results,
      createdAt: entry.date,
    });
  }

  function showError(message: string): void {
    formError.textContent = message;
    formError.hidden = false;
  }

  function clearError(): void {
    formError.textContent = '';
    formError.hidden = true;
  }

  function selectFile(file: File): void {
    const allowed = ['image/jpeg', 'image/png', 'image/webp'];
    clearError();
    if (!allowed.includes(file.type)) {
      showError(T.badType);
      return;
    }
    if (file.size > 8 * 1024 * 1024) {
      showError(T.tooLarge);
      return;
    }
    if (previewUrl) URL.revokeObjectURL(previewUrl);
    previewUrl = URL.createObjectURL(file);
    selectedFile = file;
    imagePreview.src = previewUrl;
    fileName.textContent = file.name;
    emptyState.hidden = true;
    previewState.hidden = false;
    searchButton.disabled = false;
  }

  input.addEventListener('change', () => {
    const file = input.files?.[0];
    if (file) selectFile(file);
  });

  for (const eventName of ['dragenter', 'dragover']) {
    dropZone.addEventListener(eventName, (event) => {
      event.preventDefault();
      dropZone.classList.add('dragging');
    });
  }
  for (const eventName of ['dragleave', 'drop']) {
    dropZone.addEventListener(eventName, (event) => {
      event.preventDefault();
      dropZone.classList.remove('dragging');
    });
  }
  dropZone.addEventListener('drop', (event) => {
    const file = event.dataTransfer?.files?.[0];
    if (file) selectFile(file);
  });

  dropZone.addEventListener('keydown', (event) => {
    if (event.key !== 'Enter' && event.key !== ' ') return;
    event.preventDefault();
    input.click();
  });

  document.addEventListener('paste', (event) => {
    const imageItem = Array.from(event.clipboardData?.items ?? []).find(
      (item) => item.kind === 'file' && item.type.startsWith('image/'),
    );
    const clipboardFile = imageItem?.getAsFile();
    if (!clipboardFile) return;

    event.preventDefault();
    const extension =
      clipboardFile.type === 'image/png'
        ? 'png'
        : clipboardFile.type === 'image/webp'
          ? 'webp'
          : 'jpg';
    const pastedFile = new File(
      [clipboardFile],
      `pasted-screenshot-${Date.now()}.${extension}`,
      { type: clipboardFile.type },
    );
    selectFile(pastedFile);
    dropZone.classList.remove('pasted');
    window.requestAnimationFrame(() => dropZone.classList.add('pasted'));
    window.setTimeout(() => dropZone.classList.remove('pasted'), 700);
  });

  function formatDuration(value?: number): string {
    if (!value || value < 0) return T.durationUnavailable;
    const total = Math.round(value);
    const hours = Math.floor(total / 3600);
    const minutes = Math.floor((total % 3600) / 60);
    const seconds = total % 60;
    return hours > 0
      ? `${hours}:${String(minutes).padStart(2, '0')}:${String(seconds).padStart(2, '0')}`
      : `${minutes}:${String(seconds).padStart(2, '0')}`;
  }

  function thumbnailSource(value?: string): string {
    if (!value?.startsWith('http')) return '/favicon.png';
    // These catalog thumbnails are already public CDN image URLs. The site's
    // generic weserv.nl proxy rejects this source with HTTP 403, while the
    // source CDN serves the images directly.
    return value;
  }

  function resultCard(result: VideoResult, rank: number): HTMLElement {
    const card = document.createElement('article');
    card.className = 'video-result-card';

    const media = document.createElement(result.sourceUrl ? 'a' : 'div');
    media.className = 'result-media';
    if (media instanceof HTMLAnchorElement && result.sourceUrl?.startsWith('https://')) {
      media.href = result.sourceUrl;
      media.target = '_blank';
      media.rel = 'noopener noreferrer';
    }

    const image = document.createElement('img');
    image.src = thumbnailSource(result.thumbnailUrl);
    image.alt = '';
    image.loading = rank > 3 ? 'lazy' : 'eager';
    // Some CDN77 video-frame thumbnails reject requests with no Referer.
    // Send only this site's origin, never the full search page URL.
    image.referrerPolicy = 'origin';
    media.appendChild(image);

    const rankBadge = document.createElement('span');
    rankBadge.className = 'rank-badge';
    rankBadge.textContent = `#${rank}`;
    media.appendChild(rankBadge);

    const duration = document.createElement('span');
    duration.className = 'duration-badge';
    duration.textContent = formatDuration(result.durationSeconds);
    media.appendChild(duration);
    card.appendChild(media);

    const body = document.createElement('div');
    body.className = 'result-body';

    const title = document.createElement('h3');
    title.textContent = result.title;
    body.appendChild(title);

    const scoreRow = document.createElement('div');
    scoreRow.className = 'score-row';
    const score = document.createElement('div');
    score.className = 'match-score';
    const scoreLabel = document.createElement('span');
    scoreLabel.textContent = T.bestCosine;
    const scoreValue = document.createElement('strong');
    scoreValue.textContent = result.similarity.toFixed(3);
    score.append(scoreLabel, scoreValue);

    const evidence = document.createElement('div');
    evidence.className = 'evidence-count';
    const evidenceValue = document.createElement('strong');
    evidenceValue.textContent = String(result.supportingEmbeddings);
    const evidenceLabel = document.createElement('span');
    evidenceLabel.textContent = result.supportingEmbeddings === 1 ? T.supportOne : T.supportMany;
    evidence.append(evidenceValue, evidenceLabel);
    scoreRow.append(score, evidence);
    body.appendChild(scoreRow);

    const meter = document.createElement('div');
    meter.className = 'score-meter';
    const fill = document.createElement('span');
    fill.style.width = `${Math.max(4, Math.min(100, result.similarity * 100))}%`;
    meter.appendChild(fill);
    body.appendChild(meter);

    if (result.sourceUrl?.startsWith('https://')) {
      const open = document.createElement('a');
      open.className = 'open-result';
      open.href = result.sourceUrl;
      open.target = '_blank';
      open.rel = 'noopener noreferrer';
      open.textContent = T.openSource;
      const arrow = document.createElement('span');
      arrow.textContent = '↗';
      open.appendChild(arrow);
      body.appendChild(open);
    }

    card.appendChild(body);
    return card;
  }

  function renderNextResultsPage(): void {
    const nextCount = Math.min(
      visibleResultCount + RESULTS_PAGE_SIZE,
      allResults.length,
    );
    for (let index = visibleResultCount; index < nextCount; index += 1) {
      resultsGrid.appendChild(resultCard(allResults[index], index + 1));
    }
    visibleResultCount = nextCount;
    loadMore.hidden = visibleResultCount >= allResults.length;
    if (!loadMore.hidden) {
      loadMore.textContent = fmtT(T.loadMoreRemaining, { n: allResults.length - visibleResultCount });
    }
  }

  function renderResults(payload: SearchResponse): void {
    allResults = payload.results ?? [];
    visibleResultCount = 0;
    resultsGrid.replaceChildren();
    emptyResults.hidden = allResults.length > 0;
    resultsGrid.hidden = allResults.length === 0;
    resultsTitle.textContent = allResults.length === 1
      ? T.matchOne
      : fmtT(T.matchMany, { n: allResults.length });
    searchMeta.textContent = fmtT(T.searchMeta, { n: payload.indexedVideos ?? 0, s: (payload.elapsedSeconds ?? 0).toFixed(1) });
    renderNextResultsPage();
    resultsSection.hidden = false;
    resultsSection.scrollIntoView({ behavior: 'smooth', block: 'start' });
  }

  loadMore.addEventListener('click', renderNextResultsPage);

  // ── Scanning visual FX (staged steps + live counter) — mirrors UploadBox.astro's, since
  // the homepage's version of this search flow already had it and this page didn't.
  let _scanFX: { stepTimer?: number; counterRAF?: number } = {};

  function startScanFX(): void {
    stopScanFX();

    const steps = Array.from(document.querySelectorAll('#scanSteps .scan-step')) as HTMLElement[];
    let si = 0;
    steps.forEach((s, i) => {
      s.classList.toggle('active', i === 0);
      s.classList.remove('done');
    });
    _scanFX.stepTimer = window.setInterval(() => {
      if (si < steps.length - 1) si++;
      steps.forEach((s, i) => {
        s.classList.toggle('active', i === si);
        s.classList.toggle('done', i < si);
      });
    }, 1500);

    const counterEl = document.getElementById('scanCounter')?.querySelector('strong') as HTMLElement | null;
    if (counterEl) {
      const target = 2_413_000 + Math.floor(Math.random() * 90000);
      const start = performance.now();
      const dur = 6500;
      const tick = (now: number) => {
        const t = Math.min((now - start) / dur, 1);
        const eased = 1 - Math.pow(1 - t, 3);
        counterEl.textContent = Math.floor(eased * target).toLocaleString();
        if (t < 1) _scanFX.counterRAF = requestAnimationFrame(tick);
      };
      _scanFX.counterRAF = requestAnimationFrame(tick);
    }
  }

  function stopScanFX(): void {
    if (_scanFX.stepTimer) clearInterval(_scanFX.stepTimer);
    if (_scanFX.counterRAF) cancelAnimationFrame(_scanFX.counterRAF);
    _scanFX = {};
  }

  function setSearching(value: boolean): void {
    searching = value;
    input.disabled = value;
    searchButton.disabled = value || !selectedFile;
    form.classList.toggle('is-scanning', value);
    if (value) {
      scanningImg.src = imagePreview.src;
      startScanFX();
    } else {
      stopScanFX();
    }
  }

  form.addEventListener('submit', async (event) => {
    event.preventDefault();
    if (!selectedFile || searching) return;
    const initiatingOwnerId = currentAccountId();
    const auth = await resolveUserForSearch();
    const user = auth.user;
    if (auth.expired && initiatingOwnerId && currentAccountId() === null) {
      openLimitModal('expired');
      return;
    }
    if (currentAccountId() !== initiatingOwnerId || (user?.id || null) !== initiatingOwnerId) {
      window.location.reload();
      return;
    }
    const searchOwnerId = initiatingOwnerId;
    const requestAccessToken = user?.access_token || null;
    if (!user?.access_token && localStorage.getItem(GUEST_DAY_KEY) === todayUtc()) {
      openLimitModal('guest');
      return;
    }
    clearError();
    setSearching(true);
    resultsSection.hidden = true;

    const labels = [
      T.progress1,
      T.progress2,
      T.progress3,
    ];
    let labelIndex = 0;
    scanningSub.textContent = labels[0];
    const labelTimer = window.setInterval(() => {
      labelIndex = Math.min(labelIndex + 1, labels.length - 1);
      scanningSub.textContent = labels[labelIndex];
    }, 1800);

    const controller = new AbortController();
    const timeout = window.setTimeout(() => controller.abort(), 65_000);
    try {
      const body = new FormData();
      body.append('image', selectedFile);
      const turnstileToken = turnstileWidgetId
        ? (window as typeof window & { turnstile?: any }).turnstile?.getResponse(turnstileWidgetId)
        : undefined;
      if (turnstileToken) body.append('turnstileToken', turnstileToken);
      const headers: HeadersInit = {};
      if (user?.access_token) headers.Authorization = `Bearer ${user.access_token}`;
      const response = await fetch('/api/video-face-search', {
        method: 'POST',
        headers,
        body,
        signal: controller.signal,
      });
      const payload = await response.json() as SearchResponse;
      if (currentAccountId() !== searchOwnerId) {
        window.location.reload();
        return;
      }
      if (response.status === 401 && payload.code === 'session_expired') {
        const accountId = user?.id;
        const activeUser = currentUser();
        if (accountId && (activeUser?.id !== accountId || activeUser.access_token !== requestAccessToken)) {
          window.location.reload();
          return;
        }
        if (accountId && currentAccountId() === accountId) {
          localStorage.removeItem('fbf_user');
          localStorage.removeItem(scopedSearchHistoryKey('fbf_history', accountId));
          localStorage.removeItem(scopedSearchHistoryKey(HISTORY_KEY, accountId));
          localStorage.removeItem(scopedSearchHistoryKey('fbf_search_queries', accountId));
        }
        openLimitModal('expired');
        return;
      }
      if (response.status === 429 && payload.code === 'guest_daily_limit') {
        localStorage.setItem(GUEST_DAY_KEY, todayUtc());
        openLimitModal('guest');
        return;
      }
      if (!response.ok || !payload.ok) {
        throw new Error(payload.error || T.searchFailed);
      }
      if (!user?.access_token) localStorage.setItem(GUEST_DAY_KEY, todayUtc());
      if (typeof payload.indexedVideos === 'number') {
        displayIndexedVideoCount(payload.indexedVideos);
      }
      savePornstarHistory(payload, searchOwnerId);
      renderResults(payload);
      if (typeof payload.searchProof === 'string') {
        try { sessionStorage.setItem('fbf_search_proof_pornstar', payload.searchProof); } catch { /* storage can be unavailable */ }
        window.dispatchEvent(new CustomEvent('fbf:search-complete', {
          detail: { finder: 'pornstar', searchProof: payload.searchProof },
        }));
      }
    } catch (error) {
      const message = error instanceof DOMException && error.name === 'AbortError'
        ? T.searchTimeout
        : error instanceof Error
          ? error.message
          : 'The local face search failed.';
      showError(message);
    } finally {
      window.clearInterval(labelTimer);
      window.clearTimeout(timeout);
      setSearching(false);
      if (turnstileWidgetId) (window as typeof window & { turnstile?: any }).turnstile?.reset(turnstileWidgetId);
    }
  });

  window.addEventListener('beforeunload', () => {
    window.clearInterval(indexCountTimer);
    if (previewUrl) URL.revokeObjectURL(previewUrl);
  });
</script>

<style>
