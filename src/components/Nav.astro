---
const pathname = Astro.url.pathname;
const isHome = pathname === '/' || pathname === '';
const isSearch = pathname.startsWith('/onlyfans-search');
const isVideoSearch =
  pathname.startsWith('/pornstar-finder-by-face') ||
  pathname.startsWith('/video-search');
const isDiscover = pathname.startsWith('/ai-discover');
const isPromote = pathname.startsWith('/promote');
---

<header class="nav">
  <div class="nav-inner">
    <a href="/" class="nav-logo">
      <span class="logo-find">find</span><span class="logo-byface">byface</span>
    </a>

    <nav class="nav-links" id="navLinks">
      <a href="/" class={isHome ? 'active' : ''}>Home</a>
      {/* Discover is under development — hidden from nav until ready */}
      {false && <a href="/ai-discover/" class={isDiscover ? 'active' : ''}>Discover</a>}
      <a href="/onlyfans-search/" class={isSearch ? 'active' : ''}>OnlyFans Search</a>
      <a href="/pornstar-finder-by-face/" class={`nav-feature-link ${isVideoSearch ? 'active' : ''}`}>
        <span>Pornstar Finder</span><small class="nav-new-badge">New</small>
      </a>
      <a href="/promote/" class={isPromote ? 'active' : ''}>Promote Your OnlyFans</a>
      <div class="mobile-auth-actions" id="mobileAuthActions">
        <a href="/login/" class="mobile-login">Log in</a>
        <a href="/signup/" class="mobile-signup">Sign up free</a>
      </div>
    </nav>

    <div class="nav-right">
      <!-- Signed-out state (default, overridden by JS if signed in) -->
      <div class="auth-actions" id="authActions">
        <a href="/login/" class="login-btn">Log in</a>
        <a href="/signup/" class="signup-btn">Sign up</a>
      </div>
      <!-- Signed-in state (hidden until JS sets it) -->
      <div class="user-menu" id="userMenu" style="display:none">
        <button class="user-trigger" id="userTrigger" aria-haspopup="true" aria-expanded="false">
          <span class="user-avatar" id="userAvatar"></span>
          <span class="user-name" id="userName"></span>
          <svg class="user-chevron" width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round"><polyline points="6 9 12 15 18 9"></polyline></svg>
        </button>
        <div class="user-dropdown" id="userDropdown">
          <div class="dd-header">
            <span class="dd-avatar" id="ddAvatar"></span>
            <div class="dd-meta">
              <span class="dd-name" id="ddName"></span>
              <span class="dd-plan">Free Plan</span>
            </div>
          </div>
          <a href="/dashboard/" class="dd-item">
            <svg width="17" height="17" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><rect x="3" y="3" width="7" height="7"></rect><rect x="14" y="3" width="7" height="7"></rect><rect x="14" y="14" width="7" height="7"></rect><rect x="3" y="14" width="7" height="7"></rect></svg>
            Dashboard
          </a>
          <a href="/settings/" class="dd-item">
            <svg width="17" height="17" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><circle cx="12" cy="12" r="3"></circle><path d="M19.4 15a1.65 1.65 0 0 0 .33 1.82l.06.06a2 2 0 0 1-2.83 2.83l-.06-.06a1.65 1.65 0 0 0-1.82-.33 1.65 1.65 0 0 0-1 1.51V21a2 2 0 0 1-4 0v-.09A1.65 1.65 0 0 0 9 19.4a1.65 1.65 0 0 0-1.82.33l-.06.06a2 2 0 0 1-2.83-2.83l.06-.06a1.65 1.65 0 0 0 .33-1.82 1.65 1.65 0 0 0-1.51-1H3a2 2 0 0 1 0-4h.09A1.65 1.65 0 0 0 4.6 9a1.65 1.65 0 0 0-.33-1.82l-.06-.06a2 2 0 0 1 2.83-2.83l.06.06a1.65 1.65 0 0 0 1.82.33H9a1.65 1.65 0 0 0 1-1.51V3a2 2 0 0 1 4 0v.09a1.65 1.65 0 0 0 1 1.51 1.65 1.65 0 0 0 1.82-.33l.06-.06a2 2 0 0 1 2.83 2.83l-.06.06a1.65 1.65 0 0 0-.33 1.82V9a1.65 1.65 0 0 0 1.51 1H21a2 2 0 0 1 0 4h-.09a1.65 1.65 0 0 0-1.51 1z"></path></svg>
            Settings
          </a>
          <div class="dd-divider"></div>
          <button class="dd-item dd-logout" id="signOutBtn">
            <svg width="17" height="17" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M9 21H5a2 2 0 0 1-2-2V5a2 2 0 0 1 2-2h4"></path><polyline points="16 17 21 12 16 7"></polyline><line x1="21" y1="12" x2="9" y2="12"></line></svg>
            Logout
          </button>
        </div>
      </div>
      <button class="hamburger" id="hamburger" aria-label="Open menu" aria-expanded="false" aria-controls="navLinks">
        <span></span>
        <span></span>
        <span></span>
      </button>
    </div>
  </div>
</header>

<script>
  const hamburger = document.getElementById('hamburger');
  const navLinks = document.getElementById('navLinks');
  hamburger?.addEventListener('click', () => {
    const open = navLinks?.classList.toggle('open') ?? false;
    hamburger.setAttribute('aria-expanded', String(open));
  });
  navLinks?.querySelectorAll('a').forEach(link => link.addEventListener('click', () => {
    navLinks.classList.remove('open');
    hamburger?.setAttribute('aria-expanded', 'false');
  }));

  // Auth state hydration
  const authActions = document.getElementById('authActions')!;
  const mobileAuthActions = document.getElementById('mobileAuthActions')!;
  const userMenu  = document.getElementById('userMenu')!;
  const userTrigger = document.getElementById('userTrigger')!;
  const userDropdown = document.getElementById('userDropdown')!;
  const userAvatar = document.getElementById('userAvatar')!;
  const userName  = document.getElementById('userName')!;
  const ddAvatar  = document.getElementById('ddAvatar')!;
  const ddName    = document.getElementById('ddName')!;
  const signOutBtn = document.getElementById('signOutBtn')!;

  function setAvatar(el: HTMLElement, user: { name?: string; email: string; avatar?: string }): void {
    if (user.avatar) {
      el.innerHTML = `<img src="${user.avatar}" alt="" referrerpolicy="no-referrer" />`;
    } else {
      el.textContent = (user.name || user.email || '?')[0].toUpperCase();
    }
  }

  function loadAuthState(): void {
    try {
      const raw = localStorage.getItem('fbf_user');
      if (!raw) return;
      const user = JSON.parse(raw) as { name: string; email: string; avatar?: string };
      authActions.style.display = 'none';
      mobileAuthActions.style.display = 'none';
      setAvatar(userAvatar, user);
      setAvatar(ddAvatar, user);
      userName.textContent = user.name?.split(' ')[0] || user.email.split('@')[0];
      ddName.textContent = user.name || user.email;
      userMenu.style.display = 'block';
    } catch { /* not signed in */ }
  }

  function closeDropdown(): void {
    userDropdown.classList.remove('open');
    userTrigger.setAttribute('aria-expanded', 'false');
  }

  userTrigger?.addEventListener('click', (e) => {
    e.stopPropagation();
    const open = userDropdown.classList.toggle('open');
    userTrigger.setAttribute('aria-expanded', String(open));
  });
  document.addEventListener('click', (e) => {
    if (!userMenu.contains(e.target as Node)) closeDropdown();
  });
  document.addEventListener('keydown', (e) => {
    if (e.key === 'Escape') closeDropdown();
  });

  signOutBtn?.addEventListener('click', () => {
    localStorage.removeItem('fbf_user');
    localStorage.removeItem('fbf_searches');
    localStorage.removeItem('fbf_history');
    localStorage.removeItem('fbf_pornstar_history');
    window.location.href = '/';
  });

  loadAuthState();
</script>

<style>
  .nav {
    position: fixed;
    top: 0; left: 0; right: 0;
    z-index: 100;
    background: rgba(10,10,15,0.85);
    backdrop-filter: blur(12px);
    -webkit-backdrop-filter: blur(12px);
    border-bottom: 1px solid var(--border);
  }

  .nav-inner {
    max-width: 1200px;
    margin: 0 auto;
    padding: 0 20px;
    height: 64px;
    display: flex;
    align-items: center;
    gap: 24px;
  }

  .nav-logo {
    font-family: 'Syne', sans-serif;
    font-weight: 800;
    font-size: 1.25rem;
    display: flex;
    align-items: center;
    flex-shrink: 0;
    letter-spacing: -0.02em;
  }

  .logo-find {
    color: #ffffff;
  }

  .logo-byface {
    background: linear-gradient(135deg, #7c3aed, #ec4899);
    -webkit-background-clip: text;
    -webkit-text-fill-color: transparent;
    background-clip: text;
  }

  .nav-links {
    display: flex;
    gap: 4px;
    flex: 1;
    justify-content: center;
  }

  .nav-links a {
    padding: 6px 16px;
    border-radius: 8px;
    font-size: 14px;
    font-weight: 500;
    color: var(--text-muted);
    transition: color 0.2s, background 0.2s;
  }

  .nav-links a:hover { color: var(--text); background: rgba(124,58,237,0.1); }
  .nav-links a.active { color: var(--text); }
  .nav-links .nav-feature-link { display: inline-flex; align-items: center; gap: 6px; }
  .nav-new-badge {
    padding: 2px 5px;
    border: 1px solid rgba(244,114,182,0.32);
    border-radius: 999px;
    background: linear-gradient(135deg, rgba(124,58,237,0.22), rgba(236,72,153,0.22));
    color: #f0abfc;
    font-size: 8px;
    font-weight: 900;
    line-height: 1;
    letter-spacing: 0.07em;
    text-transform: uppercase;
    box-shadow: 0 0 14px rgba(236,72,153,0.14);
  }

  .nav-right {
    display: flex;
    align-items: center;
    gap: 12px;
    margin-left: auto;
  }

  .auth-actions { display: flex; align-items: center; gap: 8px; }
  .login-btn,
  .signup-btn {
    padding: 8px 16px;
    border-radius: 999px;
    font-size: 13px;
    font-weight: 700;
    white-space: nowrap;
    transition: background 0.2s, border-color 0.2s, transform 0.2s;
  }
  .login-btn { border: 1px solid var(--border); color: var(--text); background: rgba(255,255,255,0.025); }
  .login-btn:hover { border-color: rgba(167,139,250,0.55); background: rgba(124,58,237,0.11); }
  .signup-btn { border: 1px solid transparent; background: linear-gradient(135deg, var(--accent), var(--accent-pink)); color: #fff; box-shadow: 0 6px 20px rgba(124,58,237,0.24); }
  .signup-btn:hover { transform: translateY(-1px); box-shadow: 0 8px 24px rgba(124,58,237,0.35); }
  .mobile-auth-actions { display: none; }

  .user-menu { position: relative; }

  .user-trigger {
    display: flex; align-items: center; gap: 8px;
    background: rgba(124,58,237,0.12);
    border: 1px solid var(--border);
    border-radius: 999px; padding: 4px 12px 4px 4px;
    cursor: pointer; font-family: inherit;
    transition: background 0.2s, border-color 0.2s;
  }
  .user-trigger:hover { background: rgba(124,58,237,0.2); border-color: var(--accent); }

  .user-avatar {
    width: 30px; height: 30px; border-radius: 50%;
    background: linear-gradient(135deg, #7c3aed, #ec4899);
    display: flex; align-items: center; justify-content: center;
    font-size: 12px; font-weight: 700; color: #fff; flex-shrink: 0;
    overflow: hidden;
  }
  .user-avatar img, .dd-avatar img { width: 100%; height: 100%; object-fit: cover; display: block; }
  .user-name { font-size: 13px; font-weight: 600; color: var(--text); }
  .user-chevron { color: var(--text-muted); transition: transform 0.2s; }
  .user-trigger[aria-expanded="true"] .user-chevron { transform: rotate(180deg); }

  .user-dropdown {
    position: absolute; top: calc(100% + 10px); right: 0;
    width: 244px;
    background: var(--surface-raised);
    border: 1px solid var(--border);
    border-radius: var(--radius);
    box-shadow: 0 16px 48px rgba(0,0,0,0.5);
    padding: 8px;
    opacity: 0; visibility: hidden; transform: translateY(-6px);
    transition: opacity 0.18s ease, transform 0.18s ease, visibility 0.18s;
    z-index: 200;
  }
  .user-dropdown.open { opacity: 1; visibility: visible; transform: translateY(0); }

  .dd-header {
    display: flex; align-items: center; gap: 11px;
    padding: 8px 10px 12px;
  }
  .dd-avatar {
    width: 42px; height: 42px; border-radius: 50%;
    background: linear-gradient(135deg, #7c3aed, #ec4899);
    display: flex; align-items: center; justify-content: center;
    font-size: 16px; font-weight: 700; color: #fff; flex-shrink: 0;
    overflow: hidden;
  }
  .dd-meta { display: flex; flex-direction: column; min-width: 0; }
  .dd-name {
    font-size: 14px; font-weight: 700; color: var(--text);
    white-space: nowrap; overflow: hidden; text-overflow: ellipsis;
  }
  .dd-plan {
    font-size: 12px; font-weight: 600;
    background: linear-gradient(135deg, #7c3aed, #ec4899);
    -webkit-background-clip: text; -webkit-text-fill-color: transparent; background-clip: text;
  }

  .dd-item {
    display: flex; align-items: center; gap: 11px;
    width: 100%;
    padding: 10px 11px;
    border-radius: 9px;
    font-size: 14px; font-weight: 500;
    color: var(--text);
    background: none; border: none; cursor: pointer;
    font-family: inherit; text-align: left;
    transition: background 0.15s, color 0.15s;
  }
  .dd-item svg { color: var(--text-muted); transition: color 0.15s; flex-shrink: 0; }
  .dd-item:hover { background: rgba(124,58,237,0.14); }
  .dd-item:hover svg { color: var(--accent-light); }

  .dd-divider { height: 1px; background: var(--border); margin: 6px 4px; }

  .dd-logout { color: #f87171; }
  .dd-logout svg { color: #f87171; }
  .dd-logout:hover { background: rgba(248,113,113,0.12); }
  .dd-logout:hover svg { color: #f87171; }

  .hamburger {
    display: none;
    flex-direction: column;
    gap: 5px;
    background: none;
    border: none;
    cursor: pointer;
    padding: 4px;
  }

  .hamburger span {
    display: block;
    width: 22px;
    height: 2px;
    background: var(--text);
    border-radius: 2px;
  }

  @media (max-width: 960px) {
    .hamburger { display: flex; }
    .auth-actions { display: none; }
    .nav-links {
      display: none;
      position: absolute;
      top: 64px; left: 0; right: 0;
      background: var(--surface);
      flex-direction: column;
      padding: 16px 20px;
      border-bottom: 1px solid var(--border);
      gap: 4px;
    }
    .nav-links.open { display: flex; }
    .nav-links .nav-feature-link { justify-content: flex-start; }
    .mobile-auth-actions {
      display: grid;
      grid-template-columns: 1fr 1fr;
      gap: 9px;
      margin-top: 8px;
      padding-top: 14px;
      border-top: 1px solid var(--border);
    }
    .nav-links .mobile-auth-actions a { padding: 10px 12px; text-align: center; font-weight: 700; }
    .nav-links .mobile-login { border: 1px solid var(--border); color: var(--text); }
    .nav-links .mobile-signup { background: linear-gradient(135deg, var(--accent), var(--accent-pink)); color: #fff; }
  }
</style>
