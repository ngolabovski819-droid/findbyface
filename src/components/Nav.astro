---
import { localeOf, localizePath, routeKey } from '../i18n/routes';
import { t } from '../i18n/ui';

const pathname = Astro.url.pathname;
const lang = localeOf(pathname);
// Active-state matching runs on the ENGLISH route key so it works for both
// locales ('/es/batalla/' -> '/battle/').
const key = routeKey(pathname);
const isHome = key === '/';
const isOnlyFansFinder = key.startsWith('/onlyfans-finder-by-face');
const isVideoSearch =
  key.startsWith('/pornstar-finder-by-face') ||
  key.startsWith('/video-search');
const isDiscover = key.startsWith('/ai-discover');
const isSearch = key.startsWith('/onlyfans-search');
const isBattle = key.startsWith('/battle');

const lp = (p: string) => localizePath(p, lang);
---

<header class="nav">
  <div class="nav-inner">
    <a href={lang === 'es' ? '/es/' : '/'} class="nav-logo">
      <img class="nav-logo-mark" src="/findbyface-logo.png" alt="" width="34" height="34" />
      <span class="logo-find">find</span><span class="logo-byface">byface</span>
    </a>

    <nav class="nav-links" id="navLinks">
      <a href={lang === 'es' ? '/es/' : '/'} class={isHome ? 'active' : ''}>{t(lang, 'nav.home')}</a>
      {/* Discover is under development — hidden from nav until ready */}
      {false && <a href="/ai-discover/" class={isDiscover ? 'active' : ''}>{t(lang, 'nav.discover')}</a>}
      <a href={lp('/onlyfans-finder-by-face/')} class={isOnlyFansFinder ? 'active' : ''}>{t(lang, 'nav.onlyfansFinder')}</a>
      <a href={lp('/pornstar-finder-by-face/')} class={`nav-feature-link ${isVideoSearch ? 'active' : ''}`}>
        <span>{t(lang, 'nav.pornstarFinder')}</span><small class="nav-new-badge">{t(lang, 'nav.new')}</small>
      </a>
      <a href={lp('/onlyfans-search/')} class={isSearch ? 'active' : ''}>{t(lang, 'nav.search')}</a>
      <a href={lp('/battle/')} class={`nav-feature-link ${isBattle ? 'active' : ''}`}>
        <span>{t(lang, 'nav.battle')}</span><small class="nav-new-badge">{t(lang, 'nav.new')}</small>
      </a>
      <div class="mobile-auth-actions" id="mobileAuthActions">
        <a href={lp('/login/')} class="mobile-login">{t(lang, 'nav.login')}</a>
        <a href={lp('/signup/')} class="mobile-signup">{t(lang, 'nav.signupFree')}</a>
      </div>
    </nav>

    <div class="nav-right">
      <a href={lp('/wishlist/')} class="nav-wishlist-btn" id="navWishlistBtn" aria-label={t(lang, 'nav.wishlist')}>
        <svg viewBox="0 0 24 24" aria-hidden="true"><path d="M12 21s-6.6-4.06-9.33-7.86C.86 10.64 1.1 7.28 3.6 5.34c2.2-1.7 5.02-1.24 6.7.86L12 8.1l1.7-1.9c1.68-2.1 4.5-2.56 6.7-.86 2.5 1.94 2.74 5.3 0.93 7.8C18.6 16.94 12 21 12 21Z"/></svg>
        <span class="nav-wishlist-count" id="navWishlistCount" hidden>0</span>
      </a>
      <!-- Signed-out state (default, overridden by JS if signed in) -->
      <div class="auth-actions" id="authActions">
        <a href={lp('/login/')} class="login-btn">{t(lang, 'nav.login')}</a>
        <a href={lp('/signup/')} class="signup-btn">{t(lang, 'nav.signup')}</a>
      </div>
      <!-- Signed-in state (hidden until JS sets it) -->
      <div class="user-menu" id="userMenu" style="display:none">
        <button class="user-trigger" id="userTrigger" aria-haspopup="true" aria-expanded="false">
          <span class="user-avatar" id="userAvatar"></span>
          <span class="user-name" id="userName"></span>
          <svg class="user-chevron" width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round"><polyline points="6 9 12 15 18 9"></polyline></svg>
        </button>
        <div class="user-dropdown" id="userDropdown">
          <div class="dd-header">
            <span class="dd-avatar" id="ddAvatar"></span>
            <div class="dd-meta">
              <span class="dd-name" id="ddName"></span>
              <span class="dd-plan">{t(lang, 'nav.freePlan')}</span>
            </div>
          </div>
          <a href={lp('/dashboard/')} class="dd-item">
            <svg width="17" height="17" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><rect x="3" y="3" width="7" height="7"></rect><rect x="14" y="3" width="7" height="7"></rect><rect x="14" y="14" width="7" height="7"></rect><rect x="3" y="14" width="7" height="7"></rect></svg>
            {t(lang, 'nav.dashboard')}
          </a>
          <a href={lp('/settings/')} class="dd-item">
            <svg width="17" height="17" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><circle cx="12" cy="12" r="3"></circle><path d="M19.4 15a1.65 1.65 0 0 0 .33 1.82l.06.06a2 2 0 0 1-2.83 2.83l-.06-.06a1.65 1.65 0 0 0-1.82-.33 1.65 1.65 0 0 0-1 1.51V21a2 2 0 0 1-4 0v-.09A1.65 1.65 0 0 0 9 19.4a1.65 1.65 0 0 0-1.82.33l-.06.06a2 2 0 0 1-2.83-2.83l.06-.06a1.65 1.65 0 0 0 .33-1.82 1.65 1.65 0 0 0-1.51-1H3a2 2 0 0 1 0-4h.09A1.65 1.65 0 0 0 4.6 9a1.65 1.65 0 0 0-.33-1.82l-.06-.06a2 2 0 0 1 2.83-2.83l.06.06a1.65 1.65 0 0 0 1.82.33H9a1.65 1.65 0 0 0 1-1.51V3a2 2 0 0 1 4 0v.09a1.65 1.65 0 0 0 1 1.51 1.65 1.65 0 0 0 1.82-.33l.06-.06a2 2 0 0 1 2.83 2.83l-.06.06a1.65 1.65 0 0 0-.33 1.82V9a1.65 1.65 0 0 0 1.51 1H21a2 2 0 0 1 0 4h-.09a1.65 1.65 0 0 0-1.51 1z"></path></svg>
            {t(lang, 'nav.settings')}
          </a>
          <div class="dd-divider"></div>
          <button class="dd-item dd-logout" id="signOutBtn">
            <svg width="17" height="17" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M9 21H5a2 2 0 0 1-2-2V5a2 2 0 0 1 2-2h4"></path><polyline points="16 17 21 12 16 7"></polyline><line x1="21" y1="12" x2="9" y2="12"></line></svg>
            {t(lang, 'nav.logout')}
          </button>
        </div>
      </div>
      <button class="hamburger" id="hamburger" aria-label={t(lang, 'nav.openMenu')} aria-expanded="false" aria-controls="navLinks">
        <span></span>
        <span></span>
        <span></span>
      </button>
    </div>
  </div>
</header>

<script>
  import { currentAccountId, scopedSearchHistoryKey } from '../lib/accountSearchHistory';
  import { getWishlist } from '../lib/wishlist';

  const wishlistCount = document.getElementById('navWishlistCount')!;
  function renderWishlistCount(): void {
    const count = getWishlist().length;
    wishlistCount.textContent = String(count > 99 ? '99+' : count);
    wishlistCount.hidden = count === 0;
  }
  renderWishlistCount();
  window.addEventListener('fbf:wishlist-changed', renderWishlistCount);
  window.addEventListener('storage', event => { if (event.key === 'fbf_user') renderWishlistCount(); });

  const hamburger = document.getElementById('hamburger');
  const navLinks = document.getElementById('navLinks');
  hamburger?.addEventListener('click', () => {
    const open = navLinks?.classList.toggle('open') ?? false;
    hamburger.setAttribute('aria-expanded', String(open));
  });
  navLinks?.querySelectorAll('a').forEach(link => link.addEventListener('click', () => {
    navLinks.classList.remove('open');
    hamburger?.setAttribute('aria-expanded', 'false');
  }));

  // Auth state hydration
  const authActions = document.getElementById('authActions')!;
  const mobileAuthActions = document.getElementById('mobileAuthActions')!;
  const userMenu  = document.getElementById('userMenu')!;
  const userTrigger = document.getElementById('userTrigger')!;
  const userDropdown = document.getElementById('userDropdown')!;
  const userAvatar = document.getElementById('userAvatar')!;
  const userName  = document.getElementById('userName')!;
  const ddAvatar  = document.getElementById('ddAvatar')!;
  const ddName    = document.getElementById('ddName')!;
  const signOutBtn = document.getElementById('signOutBtn')!;

  function defaultAvatarStyle(seed: string): number {
    const uuidHex = seed.replace(/-/g, '');
    if (/^[a-f\d]{32}$/i.test(uuidHex)) return Number.parseInt(uuidHex.slice(0, 2), 16) % 8 + 1;
    let hash = 2166136261;
    for (let index = 0; index < seed.length; index += 1) {
      hash ^= seed.charCodeAt(index);
      hash = Math.imul(hash, 16777619);
    }
    return (hash >>> 0) % 8 + 1;
  }

  function setAvatar(el: HTMLElement, user: { id?: string; name?: string; email: string; avatar?: string }): void {
    const avatar = user.avatar && /^\/api\/player-avatar\?style=[1-8]$/.test(user.avatar)
      ? user.avatar
      : `/api/player-avatar?style=${defaultAvatarStyle(user.id || user.email)}`;
    el.innerHTML = `<img src="${avatar}" alt="" />`;
  }

  type StoredUser = {
    id?: string;
    name?: string;
    email: string;
    avatar?: string;
    access_token?: string;
    refresh_token?: string;
    expires_at?: number;
  };

  function tokenExpiry(token?: string): number {
    if (!token) return 0;
    try {
      const encoded = token.split('.')[1].replace(/-/g, '+').replace(/_/g, '/');
      const payload = JSON.parse(atob(encoded)) as { exp?: number };
      return Number(payload.exp || 0) * 1000;
    } catch {
      return 0;
    }
  }

  function readCurrentStoredUser(): StoredUser | null {
    try {
      const value = JSON.parse(localStorage.getItem('fbf_user') || 'null');
      return value && typeof value === 'object' ? value as StoredUser : null;
    } catch {
      return null;
    }
  }

  async function refreshStoredUser(user: StoredUser): Promise<StoredUser | null> {
    const ownerId = user.id;
    const refreshToken = user.refresh_token;
    if (!ownerId || !refreshToken) return null;
    try {
      const response = await fetch('/api/auth/refresh', {
        method: 'POST',
        headers: { 'Content-Type': 'application/json' },
        body: JSON.stringify({ refresh_token: refreshToken }),
      });
      const payload = await response.json();
      const current = readCurrentStoredUser();
      if (current?.id !== ownerId || current.refresh_token !== refreshToken) {
        return current?.access_token ? current : null;
      }
      if (!response.ok || !payload.access_token || payload.user?.id !== ownerId) return null;
      const refreshed: StoredUser = {
        ...current,
        ...payload.user,
        access_token: payload.access_token,
        refresh_token: payload.refresh_token || refreshToken,
        expires_at: Date.now() + Number(payload.expires_in || 3600) * 1000,
      };
      localStorage.setItem('fbf_user', JSON.stringify(refreshed));
      localStorage.removeItem('fbf_pornstar_guest_search_day');
      return refreshed;
    } catch {
      const current = readCurrentStoredUser();
      return current?.id !== ownerId || current.refresh_token !== refreshToken
        ? current
        : null;
    }
  }

  async function loadAuthState(): Promise<void> {
    try {
      const raw = localStorage.getItem('fbf_user');
      if (!raw) return;
      let user = JSON.parse(raw) as StoredUser;
      const expiresAt = Number(user.expires_at || tokenExpiry(user.access_token));
      if (!user.access_token || expiresAt <= Date.now() + 60_000) {
        const refreshed = await refreshStoredUser(user);
        if (!refreshed) {
          const accountId = currentAccountId();
          localStorage.removeItem('fbf_user');
          if (accountId) {
            localStorage.removeItem(scopedSearchHistoryKey('fbf_history', accountId));
            localStorage.removeItem(scopedSearchHistoryKey('fbf_pornstar_history', accountId));
            localStorage.removeItem(scopedSearchHistoryKey('fbf_search_queries', accountId));
          }
          return;
        }
        user = refreshed;
      }
      renderStoredUser(user);
    } catch { /* not signed in */ }
  }

  function renderStoredUser(user: StoredUser): void {
    authActions.style.display = 'none';
    mobileAuthActions.style.display = 'none';
    setAvatar(userAvatar, user);
    setAvatar(ddAvatar, user);
    userName.textContent = user.name?.split(' ')[0] || user.email.split('@')[0];
    ddName.textContent = user.name || user.email;
    userMenu.style.display = 'block';
  }

  window.addEventListener('fbf:profile-updated', () => {
    try {
      const user = JSON.parse(localStorage.getItem('fbf_user') || 'null') as StoredUser | null;
      if (user) renderStoredUser(user);
    } catch { /* noop */ }
  });

  function closeDropdown(): void {
    userDropdown.classList.remove('open');
    userTrigger.setAttribute('aria-expanded', 'false');
  }

  userTrigger?.addEventListener('click', (e) => {
    e.stopPropagation();
    const open = userDropdown.classList.toggle('open');
    userTrigger.setAttribute('aria-expanded', String(open));
  });
  document.addEventListener('click', (e) => {
    if (!userMenu.contains(e.target as Node)) closeDropdown();
  });
  document.addEventListener('keydown', (e) => {
    if (e.key === 'Escape') closeDropdown();
  });

  signOutBtn?.addEventListener('click', () => {
    const accountId = currentAccountId();
    localStorage.removeItem('fbf_user');
    localStorage.removeItem('fbf_searches');
    if (accountId) {
      localStorage.removeItem(scopedSearchHistoryKey('fbf_history', accountId));
      localStorage.removeItem(scopedSearchHistoryKey('fbf_pornstar_history', accountId));
      localStorage.removeItem(scopedSearchHistoryKey('fbf_search_queries', accountId));
    }
    localStorage.removeItem('fbf_history');
    localStorage.removeItem('fbf_pornstar_history');
    localStorage.removeItem('fbf_search_queries');
    window.location.href = document.documentElement.lang === 'es' ? '/es/' : '/';
  });

  void loadAuthState();
</script>

<style>
  .nav {
    position: fixed;
    top: 0; left: 0; right: 0;
    z-index: 100;
    background: rgba(10,10,15,0.85);
    backdrop-filter: blur(12px);
    -webkit-backdrop-filter: blur(12px);
    border-bottom: 1px solid var(--border);
  }

  .nav-inner {
    max-width: 1200px;
    margin: 0 auto;
    padding: 0 20px;
    height: 64px;
    display: flex;
    align-items: center;
    gap: 24px;
  }

  .nav-logo {
    font-family: 'Manrope', sans-serif;
    font-weight: 800;
    font-size: 1.25rem;
    display: flex;
    align-items: center;
    flex-shrink: 0;
    letter-spacing: -0.02em;
    gap: 0;
  }

  .nav-logo-mark {
    width: 34px;
    height: 34px;
    border-radius: 9px;
    object-fit: cover;
    flex-shrink: 0;
    margin-right: 8px;
  }

  .logo-find {
    color: #ffffff;
  }

  .logo-byface {
    background: linear-gradient(135deg, #7c3aed, #ec4899);
    -webkit-background-clip: text;
    -webkit-text-fill-color: transparent;
    background-clip: text;
  }

  .nav-links {
    display: flex;
    gap: 4px;
    flex: 1;
    justify-content: center;
  }

  .nav-links a {
    padding: 6px 16px;
    border-radius: 8px;
    font-size: 14px;
    font-weight: 500;
    color: var(--text-muted);
    transition: color 0.2s, background 0.2s;
  }

  .nav-links a:hover { color: var(--text); background: rgba(124,58,237,0.1); }
  .nav-links a.active { color: var(--text); }
  .nav-links .nav-feature-link { display: inline-flex; align-items: center; gap: 6px; }
  .nav-new-badge {
    padding: 2px 5px;
    border: 1px solid rgba(244,114,182,0.32);
    border-radius: 999px;
    background: linear-gradient(135deg, rgba(124,58,237,0.22), rgba(236,72,153,0.22));
    color: #f0abfc;
    font-size: 8px;
    font-weight: 900;
    line-height: 1;
    letter-spacing: 0.07em;
    text-transform: uppercase;
    box-shadow: 0 0 14px rgba(236,72,153,0.14);
  }

  .nav-right {
    display: flex;
    align-items: center;
    gap: 12px;
    margin-left: auto;
  }

  .nav-wishlist-btn {
    position: relative;
    display: grid;
    place-items: center;
    width: 36px;
    height: 36px;
    flex-shrink: 0;
    border-radius: 50%;
    border: 1px solid var(--border);
    background: rgba(255,255,255,0.025);
    color: var(--text-muted);
    transition: border-color 0.2s, background 0.2s, color 0.2s, transform 0.15s;
  }
  .nav-wishlist-btn:hover { border-color: rgba(244,63,94,0.5); background: rgba(244,63,94,0.1); color: #fb7185; transform: scale(1.05); }
  .nav-wishlist-btn svg { width: 18px; height: 18px; fill: currentColor; }
  .nav-wishlist-count {
    position: absolute;
    top: -4px;
    right: -4px;
    display: grid;
    place-items: center;
    min-width: 17px;
    height: 17px;
    padding: 0 4px;
    border-radius: 999px;
    border: 2px solid var(--bg);
    background: linear-gradient(135deg, #fb7185, #e11d48);
    color: #fff;
    font-size: 10px;
    font-weight: 800;
    line-height: 1;
  }
  .nav-wishlist-count[hidden] { display: none; }

  .auth-actions { display: flex; align-items: center; gap: 8px; }
  .login-btn,
  .signup-btn {
    padding: 8px 16px;
    border-radius: 999px;
    font-size: 13px;
    font-weight: 700;
    white-space: nowrap;
    transition: background 0.2s, border-color 0.2s, transform 0.2s;
  }
  .login-btn { border: 1px solid var(--border); color: var(--text); background: rgba(255,255,255,0.025); }
  .login-btn:hover { border-color: rgba(167,139,250,0.55); background: rgba(124,58,237,0.11); }
  .signup-btn { border: 1px solid transparent; background: linear-gradient(135deg, var(--accent), var(--accent-pink)); color: #fff; box-shadow: 0 6px 20px rgba(124,58,237,0.24); }
  .signup-btn:hover { transform: translateY(-1px); box-shadow: 0 8px 24px rgba(124,58,237,0.35); }
  .mobile-auth-actions { display: none; }

  .user-menu { position: relative; }

  .user-trigger {
    display: flex; align-items: center; gap: 8px;
    background: rgba(124,58,237,0.12);
    border: 1px solid var(--border);
    border-radius: 999px; padding: 4px 12px 4px 4px;
    cursor: pointer; font-family: inherit;
    transition: background 0.2s, border-color 0.2s;
  }
  .user-trigger:hover { background: rgba(124,58,237,0.2); border-color: var(--accent); }

  .user-avatar {
    width: 30px; height: 30px; border-radius: 50%;
    background: linear-gradient(135deg, #7c3aed, #ec4899);
    display: flex; align-items: center; justify-content: center;
    font-size: 12px; font-weight: 700; color: #fff; flex-shrink: 0;
    overflow: hidden;
  }
  .user-avatar img, .dd-avatar img { width: 100%; height: 100%; object-fit: cover; display: block; }
  .user-name { font-size: 13px; font-weight: 600; color: var(--text); }
  .user-chevron { color: var(--text-muted); transition: transform 0.2s; }
  .user-trigger[aria-expanded="true"] .user-chevron { transform: rotate(180deg); }

  .user-dropdown {
    position: absolute; top: calc(100% + 10px); right: 0;
    width: 244px;
    background: var(--surface-raised);
    border: 1px solid var(--border);
    border-radius: var(--radius);
    box-shadow: 0 16px 48px rgba(0,0,0,0.5);
    padding: 8px;
    opacity: 0; visibility: hidden; transform: translateY(-6px);
    transition: opacity 0.18s ease, transform 0.18s ease, visibility 0.18s;
    z-index: 200;
  }
  .user-dropdown.open { opacity: 1; visibility: visible; transform: translateY(0); }

  .dd-header {
    display: flex; align-items: center; gap: 11px;
    padding: 8px 10px 12px;
  }
  .dd-avatar {
    width: 42px; height: 42px; border-radius: 50%;
    background: linear-gradient(135deg, #7c3aed, #ec4899);
    display: flex; align-items: center; justify-content: center;
    font-size: 16px; font-weight: 700; color: #fff; flex-shrink: 0;
    overflow: hidden;
  }
  .dd-meta { display: flex; flex-direction: column; min-width: 0; }
  .dd-name {
    font-size: 14px; font-weight: 700; color: var(--text);
    white-space: nowrap; overflow: hidden; text-overflow: ellipsis;
  }
  .dd-plan {
    font-size: 12px; font-weight: 600;
    background: linear-gradient(135deg, #7c3aed, #ec4899);
    -webkit-background-clip: text; -webkit-text-fill-color: transparent; background-clip: text;
  }

  .dd-item {
    display: flex; align-items: center; gap: 11px;
    width: 100%;
    padding: 10px 11px;
    border-radius: 9px;
    font-size: 14px; font-weight: 500;
    color: var(--text);
    background: none; border: none; cursor: pointer;
    font-family: inherit; text-align: left;
    transition: background 0.15s, color 0.15s;
  }
  .dd-item svg { color: var(--text-muted); transition: color 0.15s; flex-shrink: 0; }
  .dd-item:hover { background: rgba(124,58,237,0.14); }
  .dd-item:hover svg { color: var(--accent-light); }

  .dd-divider { height: 1px; background: var(--border); margin: 6px 4px; }

  .dd-logout { color: #f87171; }
  .dd-logout svg { color: #f87171; }
  .dd-logout:hover { background: rgba(248,113,113,0.12); }
  .dd-logout:hover svg { color: #f87171; }

  .hamburger {
    display: none;
    flex-direction: column;
    gap: 5px;
    background: none;
    border: none;
    cursor: pointer;
    padding: 4px;
  }

  .hamburger span {
    display: block;
    width: 22px;
    height: 2px;
    background: var(--text);
    border-radius: 2px;
  }

  @media (max-width: 960px) {
    .hamburger { display: flex; }
    .auth-actions { display: none; }
    .nav-links {
      display: none;
      position: absolute;
      top: 64px; left: 0; right: 0;
      background: var(--surface);
      flex-direction: column;
      padding: 16px 20px;
      border-bottom: 1px solid var(--border);
      gap: 4px;
    }
    .nav-links.open { display: flex; }
    .nav-links .nav-feature-link { justify-content: flex-start; }
    .mobile-auth-actions {
      display: grid;
      grid-template-columns: 1fr 1fr;
      gap: 9px;
      margin-top: 8px;
      padding-top: 14px;
      border-top: 1px solid var(--border);
