---
// Shared page body for /onlyfans-search/ (EN) and /es/buscador-de-onlyfans/ (ES).
import Base from '../../layouts/Base.astro';
import { SEARCH_SEO, SEARCH_SEO_ES } from '../../config/seo-meta';
import RankingAttributionBar from '../RankingAttributionBar.astro';
import { localeOf } from '../../i18n/routes';
import { absUrl } from '../../lib/site';
import { categories } from '../../config/categories';
import { categoryContent } from '../../config/categoryContent';
import { getSearchSeed } from '../../lib/searchSeed';
import { renderSearchCard } from '../../lib/searchResultCard';
import { fmt } from '../../i18n/ui';

// NOTE: this page is prerendered (see src/pages/onlyfans-search.astro), so it cannot read
// ?q=/&price=/&sort= at render time — the markup below ships the *default* control state
// and the client restores a deep link's filters from window.location on load. Don't
// reintroduce Astro.url.searchParams reads here; they'd silently always be empty.

const lang = localeOf(Astro.url.pathname);
const langPrefix = lang === 'es' ? '/es' : '';
const SEO = lang === 'es' ? SEARCH_SEO_ES : SEARCH_SEO;
const pagePath = lang === 'es' ? '/es/buscador-de-onlyfans/' : '/onlyfans-search/';
const finderHref = lang === 'es' ? '/es/buscador-de-onlyfans-por-cara/' : '/onlyfans-finder-by-face/';

const enC = {
  h1: 'OnlyFans Search Engine',
  sub: 'Search and filter from millions of creators',
  loading: 'Loading...',
  howWorks: 'How search works',
  close: 'Close',
  howIntro: "More than a name lookup — search reads what creators actually wrote about themselves, across millions of live profiles.",
  tip1t: 'Search in plain words', tip1p: "Type what you're into the way you'd say it — “petite goth”, “fitness mom”, “yoga”. Matches cover usernames, display names and full profile bios, so creators' own words about themselves are all searchable.",
  tip2t: 'Stack terms with commas', tip2p: 'Widen any search by separating terms with commas — “blonde, latina” finds creators matching either one. Up to five terms in a single search.',
  tip3t: 'Categories & creators, instantly', tip3p: 'As you type, suggestions split into matching categories and creator profiles. Categories answer to all their names — “kpop” finds Korean, “ginger” finds Redhead — so one tap can jump you straight to a curated page. Arrow keys navigate, Enter selects.',
  tip4t: 'Ranked by real engagement', tip4p: 'Results are ordered by live fan-favorite counts pulled from OnlyFans — never hand-picked, never pay-to-rank. The few sponsored slots that exist are always labeled.',
  tip5t: 'Filters that combine', tip5p: "Verified-only, price caps (free, under $5, under $10), active bundle discounts, and popular or newest sorting — every filter stacks with any search you've typed.",
  tip6t: 'Instant, then live', tip6p: "The first page of creators is built into the page itself, so there's nothing to wait for. Every keystroke after that queries the same live database the whole site runs on.",
  tip7t: 'Recent searches', tip7p: 'Your last searches are saved for one-tap reuse. Sign in to keep them synced across every device.',
  tip8t: 'Feed view', tip8p: 'Switch to Feed for a full-screen, swipeable view — one creator per slide, tap the photo edges to flip through their pics, and share any profile as a direct link.',
  tip9t: 'New tab, always', tip9p: 'Clicking any creator card opens their OnlyFans profile in a new tab, so your results stay right where you left them.',
  ctaHtml: '<strong>Sign up free</strong> to sync your search history across every device and unlock unlimited searches.',
  createAccount: 'Create free account',
  placeholder: 'Search by name, category, location...',
  searchCreatorsAria: 'Search creators',
  clearSearch: 'Clear search',
  byPhotoAria: 'Search by photo (face match)',
  byPhoto: 'Search by photo',
  suggestionsAria: 'Search suggestions',
  recentSearches: 'Recent searches',
  clearAll: 'Clear all',
  closeFilters: 'Close filters',
  filters: 'Filters',
  verifiedOnly: 'Verified only',
  price: 'Price',
  any: 'Any', free: 'Free', underN: 'Under ${n}',
  sort: 'Sort', popular: 'Popular', newest: 'Newest',
  hasBundles: 'Has bundles',
  applyFilters: 'Apply Filters',
  resultsViewAria: 'Results view', grid: 'Grid', feed: 'Feed',
  loadMore: 'Load More',
  backToGrid: 'Back to grid view',
  openFilters: 'Open filters',
  prevCreator: 'Previous creator', nextCreator: 'Next creator',
};
const esC: typeof enC = {
  h1: 'Motor de Búsqueda de OnlyFans',
  sub: 'Busca y filtra entre millones de creadoras',
  loading: 'Cargando...',
  howWorks: 'Cómo funciona la búsqueda',
  close: 'Cerrar',
  howIntro: 'Más que buscar nombres — la búsqueda lee lo que las creadoras escribieron sobre sí mismas, entre millones de perfiles en vivo.',
  tip1t: 'Busca con tus palabras', tip1p: 'Escribe lo que buscas tal como lo dirías — “gótica petite”, “mamá fitness”, “yoga”. Las coincidencias cubren usuarios, nombres y biografías completas, así que las propias palabras de las creadoras son buscables.',
  tip2t: 'Combina términos con comas', tip2p: 'Amplía cualquier búsqueda separando términos con comas — “blonde, latina” encuentra creadoras que coincidan con cualquiera. Hasta cinco términos en una sola búsqueda.',
  tip3t: 'Categorías y creadoras, al instante', tip3p: 'Mientras escribes, las sugerencias se dividen en categorías coincidentes y perfiles de creadoras. Las categorías responden a todos sus nombres — “kpop” encuentra Coreanas, “blonde” encuentra Rubias — así saltas directo a una página curada. Las flechas navegan, Enter selecciona.',
  tip4t: 'Clasificado por interacción real', tip4p: 'Los resultados se ordenan por número de favoritos reales extraídos de OnlyFans — nunca a dedo, nunca por pago. Los pocos espacios patrocinados que existen siempre van etiquetados.',
  tip5t: 'Filtros que se combinan', tip5p: 'Solo verificadas, topes de precio (gratis, menos de $5, menos de $10), packs con descuento activo, y orden por populares o más nuevas — cada filtro se suma a cualquier búsqueda que escribas.',
  tip6t: 'Instantáneo, y luego en vivo', tip6p: 'La primera página de creadoras viene integrada en la página misma, así que no hay nada que esperar. Cada tecla después consulta la misma base de datos en vivo que usa todo el sitio.',
  tip7t: 'Búsquedas recientes', tip7p: 'Tus últimas búsquedas se guardan para reutilizarlas con un toque. Inicia sesión para sincronizarlas en todos tus dispositivos.',
  tip8t: 'Vista Feed', tip8p: 'Cambia a Feed para una vista deslizable a pantalla completa — una creadora por slide, toca los bordes de la foto para pasar sus fotos, y comparte cualquier perfil con un enlace directo.',
  tip9t: 'Siempre en pestaña nueva', tip9p: 'Al hacer clic en cualquier tarjeta, el perfil de OnlyFans se abre en una pestaña nueva, así tus resultados quedan justo donde los dejaste.',
  ctaHtml: '<strong>Regístrate gratis</strong> para sincronizar tu historial de búsqueda en todos tus dispositivos y desbloquear búsquedas ilimitadas.',
  createAccount: 'Crear cuenta gratis',
  placeholder: 'Busca por nombre, categoría, ubicación...',
  searchCreatorsAria: 'Buscar creadoras',
  clearSearch: 'Borrar búsqueda',
  byPhotoAria: 'Buscar por foto (coincidencia facial)',
  byPhoto: 'Buscar por foto',
  suggestionsAria: 'Sugerencias de búsqueda',
  recentSearches: 'Búsquedas recientes',
  clearAll: 'Borrar todo',
  closeFilters: 'Cerrar filtros',
  filters: 'Filtros',
  verifiedOnly: 'Solo verificadas',
  price: 'Precio',
  any: 'Cualquiera', free: 'Gratis', underN: 'Menos de ${n}',
  sort: 'Ordenar', popular: 'Populares', newest: 'Más nuevas',
  hasBundles: 'Con packs',
  applyFilters: 'Aplicar filtros',
  resultsViewAria: 'Vista de resultados', grid: 'Cuadrícula', feed: 'Feed',
  loadMore: 'Cargar más',
  backToGrid: 'Volver a la cuadrícula',
  openFilters: 'Abrir filtros',
  prevCreator: 'Creadora anterior', nextCreator: 'Siguiente creadora',
};
const C = lang === 'es' ? esC : enC;

const enClient = {
  sponsored: 'Sponsored',
  free: 'FREE',
  viewProfile: 'View Profile',
  loading: 'Loading...',
  loadMore: C.loadMore,
  noMatchesFor: 'No creator matches for “{q}”',
  sponsoredBelow: 'Sponsored profiles are shown below.',
  tryAnother: 'Try another creator name, username, or category.',
  noCreatorsDot: 'No creators found.',
  creatorsFound: '{n} creators found',
  noCreators: 'No creators found',
  loadError: 'Error loading results — please try again.',
  addWishlist: 'Add to wishlist',
  removeWishlist: 'Remove from wishlist',
  sharedWithYou: '💌 Shared with you',
  prevPhoto: 'Previous photo',
  nextPhoto: 'Next photo',
  ad: 'Ad',
  shareProfile: "Share {name}'s profile",
  viewProfileOf: "View {name}'s profile",
  loadingMore: 'Loading more…',
  thatsEveryone: "That's everyone — adjust filters for more",
  feedError: 'Something went wrong loading more — scroll to retry',
  sharedNotFound: "Couldn't find that shared profile — showing the feed instead",
  checkOut: 'Check out {name} on findbyface',
  linkCopied: 'Link copied to clipboard',
  wishlistFullRemove: 'Wishlist full ({limit}/{limit}) — remove something to add another',
  wishlistFullSignup: 'Wishlist full ({limit}/{limit}) — sign up free for space for {n}',
};
const esClient: typeof enClient = {
  sponsored: 'Patrocinado',
  free: 'GRATIS',
  viewProfile: 'Ver perfil',
  loading: 'Cargando...',
  loadMore: C.loadMore,
  noMatchesFor: 'No hay creadoras que coincidan con “{q}”',
  sponsoredBelow: 'Los perfiles patrocinados se muestran abajo.',
  tryAnother: 'Prueba con otro nombre, usuario o categoría.',
  noCreatorsDot: 'No se encontraron creadoras.',
  creatorsFound: '{n} creadoras encontradas',
  noCreators: 'No se encontraron creadoras',
  loadError: 'Error al cargar resultados — inténtalo de nuevo.',
  addWishlist: 'Agregar a favoritos',
  removeWishlist: 'Quitar de favoritos',
  sharedWithYou: '💌 Compartido contigo',
  prevPhoto: 'Foto anterior',
  nextPhoto: 'Siguiente foto',
  ad: 'Anuncio',
  shareProfile: 'Compartir el perfil de {name}',
  viewProfileOf: 'Ver el perfil de {name}',
  loadingMore: 'Cargando más…',
  thatsEveryone: 'Eso es todo — ajusta los filtros para ver más',
  feedError: 'Algo salió mal al cargar más — desplázate para reintentar',
  sharedNotFound: 'No encontramos ese perfil compartido — mostrando el feed',
  checkOut: 'Mira a {name} en findbyface',
  linkCopied: 'Enlace copiado al portapapeles',
  wishlistFullRemove: 'Favoritos lleno ({limit}/{limit}) — quita algo para agregar otro',
  wishlistFullSignup: 'Favoritos lleno ({limit}/{limit}) — regístrate gratis para espacio de {n}',
};
const CLIENT = lang === 'es' ? esClient : enClient;

// ── Prerendered first page ────────────────────────────────────────────────────────────
// The default, unfiltered result grid is baked into this HTML at build time (see
// src/lib/searchSeed.ts) instead of being fetched by the client on load. It used to cost
// every visitor a round trip to /api/search before a single creator appeared — on the
// site's most-requested query, since it's what everyone sees before typing anything.
//
// Only this first paint is static. The moment a visitor types, filters, sorts or clicks
// Load More, the page queries /api/search live, so search itself is as fresh as ever.
// These 20 cards are as old as the last deploy, same as the category pages.
const seed = await getSearchSeed();
const seedCreators = seed.creators;
const seedCardsHtml = seedCreators.map((c, i) => renderSearchCard(c, i, CLIENT)).join('');
const seedHasMore = seed.hasMore;
const seedCountLabel = seed.total
  ? fmt(CLIENT.creatorsFound, { n: seed.total.toLocaleString() })
  : CLIENT.noCreators;

// Long-form SEO body content below the interactive search UI. Voice per
// PROGRAMMATIC-SEO-VOICE.md. "Browse by category" pulls from the SAME
// categoryContent.ts pilot set used by the Nav dropdown, so it grows on its
// own as more categories get written — no separate list to maintain here.
const browseCategories = Object.keys(categoryContent)
  .map(slug => categories.find(c => c.slug === slug))
  .filter((c): c is NonNullable<typeof c> => c !== undefined);

const enSeo = {
  aboutHeading: 'About OnlyFans Search',
  about: [
    "This is honestly the main search engine for the whole site, not one category, not one type, just search whatever you're actually looking for and let the results sort themselves out. Type a name, a username, or even just a category word and it'll pull matches instantly.",
    "It pulls from the same live database every other page here uses, so results reflect real, current creators, not some cached list from months ago. If you'd rather browse by type instead of typing something specific, the categories below are a good shortcut.",
  ],
  browseHeading: 'Browse by category',
  sections: [
    {
      heading: 'How results here get ranked',
      paragraphs: [
        "Same system as every category page on the site, real engagement, mostly favorites and subscriber activity pulled straight from OnlyFans. Nothing about the main search works differently, it's just the ungated version without a category filter already applied.",
        'Sort by Newest instead of Popular if you want to see who\'s freshly added rather than who\'s already blown up, that\'s a real toggle up in the filters, not just cosmetic.',
      ],
    },
    {
      heading: 'What the filters actually mean',
      paragraphs: [
        "Verified just confirms the account is legit on OnlyFans, it's not a quality signal on its own, plenty of great unverified creators show up here too. Price filters are exactly what they say, Free for $0 accounts, or a price ceiling if you're working with a budget.",
        "Bundles just means the creator's currently running some kind of discount package, worth checking if you're comparing a few accounts on price.",
      ],
    },
  ],
  faqHeading: 'Frequently asked questions',
  faq: [
    {
      question: 'How many creators are actually searchable here?',
      answer: "Millions honestly, the full catalog behind findbyface, not some trimmed-down sample. New profiles get added regularly too, so it's not a static snapshot.",
    },
    {
      question: 'Is this search free to use?',
      answer: "Yeah, completely. No signup needed to search, you only hit a wall if you're using face search past the free limit, plain text search here isn't capped.",
    },
    {
      question: 'How are results sorted by default?',
      answer: 'Popular, which is real engagement pulled from OnlyFans, not paid placement. Switch to Newest in the filters if you want to see recently added creators instead.',
    },
    {
      question: 'What does the Verified filter actually mean?',
      answer: "It confirms OnlyFans has verified the account is who it says it is. It's not a ranking or quality score, just an identity check, plenty of unverified creators are still worth checking out.",
    },
    {
      question: 'Can I search by photo instead of typing?',
      answer: "Yeah, there's a face-search shortcut right in the search bar. Upload a photo instead and it'll rank creators by how close they actually look, usually in under 2 seconds.",
    },
    {
      question: 'Does it save my search history?',
      answer: 'Locally yeah, your last searches show up for quick reuse. Sign in free if you want that synced across your devices instead of stuck on one browser.',
    },
    {
      question: "What's the difference between this and browsing a category page?",
      answer: "Category pages are pre-filtered to one niche, this is the full unfiltered search, type anything, name, category word, whatever, and it'll match across everything at once.",
    },
  ],
};

const esSeo: typeof enSeo = {
  aboutHeading: 'Sobre la Búsqueda de OnlyFans',
  about: [
    'Este es honestamente el buscador principal de todo el sitio, no una categoría, no un tipo, solo busca lo que realmente estás buscando y deja que los resultados se acomoden solos. Escribe un nombre, un usuario, o hasta una palabra de categoría y va a mostrar coincidencias al instante.',
    'Saca de la misma base de datos en vivo que usa cada otra página aquí, así que los resultados reflejan creadoras reales y actuales, no una lista guardada de hace meses. Si prefieres navegar por tipo en vez de escribir algo específico, las categorías de abajo son un buen atajo.',
  ],
  browseHeading: 'Explora por categoría',
  sections: [
    {
      heading: 'Cómo se ordenan los resultados aquí',
      paragraphs: [
        'El mismo sistema que cada página de categoría del sitio, interacción real, sobre todo favoritos y actividad de suscriptores sacada directo de OnlyFans. Nada funciona diferente en la búsqueda principal, es solo la versión sin filtro de categoría ya aplicado.',
        'Ordena por Más nuevas en vez de Populares si quieres ver quién se agregó recién en vez de quién ya explotó, eso es un toggle real en los filtros, no solo algo visual.',
      ],
    },
    {
      heading: 'Qué significan realmente los filtros',
      paragraphs: [
        'Verificada solo confirma que la cuenta es legítima en OnlyFans, no es una señal de calidad por sí sola, aquí también aparecen muy buenas creadoras sin verificar. Los filtros de precio son exactamente lo que dicen, Gratis para cuentas de $0, o un tope de precio si estás con presupuesto ajustado.',
        'Packs solo significa que la creadora tiene activo algún tipo de oferta con descuento ahora mismo, vale la pena revisarlo si estás comparando precio entre varias cuentas.',
      ],
    },
  ],
  faqHeading: 'Preguntas frecuentes',
  faq: [
    {
      question: '¿Cuántas creadoras se pueden buscar realmente aquí?',
      answer: 'Millones honestamente, el catálogo completo detrás de findbyface, no una muestra recortada. También se agregan perfiles nuevos seguido, así que no es una foto estática.',
    },
    {
      question: '¿Esta búsqueda es gratis?',
      answer: 'Sí, completamente. No necesitas registrarte para buscar, solo topas con un límite si usas la búsqueda facial más allá del límite gratis, la búsqueda de texto aquí no tiene tope.',
    },
    {
      question: '¿Cómo se ordenan los resultados por defecto?',
      answer: 'Por Populares, que es interacción real sacada de OnlyFans, no colocación pagada. Cambia a Más nuevas en los filtros si quieres ver creadoras agregadas recientemente.',
    },
    {
      question: '¿Qué significa realmente el filtro Verificada?',
      answer: 'Confirma que OnlyFans verificó que la cuenta es quien dice ser. No es un puntaje de ranking ni de calidad, solo una verificación de identidad, muchas creadoras sin verificar igual valen la pena.',
    },
    {
      question: '¿Puedo buscar por foto en vez de escribir?',
      answer: 'Sí, hay un atajo de búsqueda facial justo en la barra de búsqueda. Sube una foto en su lugar y va a ordenar a las creadoras por qué tanto se parecen, normalmente en menos de 2 segundos.',
    },
    {
      question: '¿Guarda mi historial de búsqueda?',
      answer: 'Localmente sí, tus últimas búsquedas aparecen para reutilizarlas rápido. Inicia sesión gratis si quieres eso sincronizado en tus dispositivos en vez de quedarte atado a un solo navegador.',
    },
    {
      question: '¿Cuál es la diferencia entre esto y navegar una página de categoría?',
      answer: 'Las páginas de categoría ya vienen filtradas a un nicho, esto es la búsqueda completa sin filtrar, escribe lo que sea, nombre, palabra de categoría, lo que sea, y va a buscar coincidencias en todo a la vez.',
    },
  ],
};

const SEOC = lang === 'es' ? esSeo : enSeo;

const seoFaqJsonLd = {
  '@context': 'https://schema.org',
  '@type': 'FAQPage',
  inLanguage: lang,
  mainEntity: SEOC.faq.map(item => ({
    '@type': 'Question',
    name: item.question,
    acceptedAnswer: { '@type': 'Answer', text: item.answer },
  })),
};
---

<Base title={SEO.title} description={SEO.description} canonical={absUrl(pagePath)}>
  <Fragment slot="head">
    <script type="application/ld+json" set:html={JSON.stringify(seoFaqJsonLd)} />
  </Fragment>

  <div class="search-page">

    <div class="search-header">
      <h1>{C.h1}</h1>
      <p class="search-sub">{C.sub}</p>
      <p class="results-meta" id="resultsCount">{seedCreators.length ? seedCountLabel : C.loading}</p>
    </div>

    <!-- Compact "how it works" guide -->
    <div class="help-backdrop" id="helpBackdrop" hidden></div>
    <div class="help-modal" id="helpModal" role="dialog" aria-modal="true" aria-labelledby="helpModalTitle" hidden>
      <div class="help-modal-head">
        <h2 id="helpModalTitle">{C.howWorks}</h2>
        <button class="help-close-btn" id="helpCloseBtn" type="button" aria-label={C.close}>×</button>
      </div>
      <p class="help-intro">{C.howIntro}</p>
      <ul class="help-tips">
        <li><span class="help-ico">🗣️</span><div><strong>{C.tip1t}</strong><p>{C.tip1p}</p></div></li>
        <li><span class="help-ico">➕</span><div><strong>{C.tip2t}</strong><p>{C.tip2p}</p></div></li>
        <li><span class="help-ico">🏷️</span><div><strong>{C.tip3t}</strong><p>{C.tip3p}</p></div></li>
        <li><span class="help-ico">📈</span><div><strong>{C.tip4t}</strong><p>{C.tip4p}</p></div></li>
        <li><span class="help-ico">🎚️</span><div><strong>{C.tip5t}</strong><p>{C.tip5p}</p></div></li>
        <li><span class="help-ico">⚡</span><div><strong>{C.tip6t}</strong><p>{C.tip6p}</p></div></li>
        <li><span class="help-ico">⏱️</span><div><strong>{C.tip7t}</strong><p>{C.tip7p}</p></div></li>
        <li><span class="help-ico">📱</span><div><strong>{C.tip8t}</strong><p>{C.tip8p}</p></div></li>
        <li><span class="help-ico">↗️</span><div><strong>{C.tip9t}</strong><p>{C.tip9p}</p></div></li>
      </ul>
      <div class="help-cta" id="helpCta" hidden>
        <p set:html={C.ctaHtml} />
        <a href={`${langPrefix}/signup/?next=${pagePath}`} class="help-cta-btn">{C.createAccount} <span>→</span></a>
      </div>
    </div>

    <!-- Search bar with history dropdown -->
    <div class="search-hero" id="searchHero">
      <div class="search-wrap" id="searchWrap">
        <svg class="search-icon" width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><circle cx="11" cy="11" r="8"/><path d="M21 21l-4.35-4.35"/></svg>
        <input
          type="text"
          id="searchInput"
          class="search-main-input"
          placeholder={C.placeholder}
          value=""
          autocomplete="off"
          role="combobox"
          aria-label={C.searchCreatorsAria}
          aria-autocomplete="list"
          aria-haspopup="listbox"
          aria-controls="searchDropdown"
          aria-expanded="false"
        />
        <button class="search-clear-btn" id="searchClearBtn" aria-label={C.clearSearch} style="display:none">
          <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round"><line x1="18" y1="6" x2="6" y2="18"/><line x1="6" y1="6" x2="18" y2="18"/></svg>
        </button>
        <span class="search-divider" aria-hidden="true"></span>
        <a href={finderHref} class="search-face-btn" aria-label={C.byPhotoAria} title={C.byPhoto}>
          <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M23 19a2 2 0 0 1-2 2H3a2 2 0 0 1-2-2V8a2 2 0 0 1 2-2h4l2-3h6l2 3h4a2 2 0 0 1 2 2z"/><circle cx="12" cy="13" r="4"/></svg>
        </a>
        <button class="help-trigger" id="helpTrigger" type="button" aria-haspopup="dialog" aria-controls="helpModal" aria-label={C.howWorks}>?</button>
      </div>

      <!-- Dropdown -->
      <div class="search-dropdown" id="searchDropdown" role="listbox" aria-label={C.suggestionsAria} style="display:none">
        <div class="dd-ad-slot" id="ddAdSlot" style="display:none"></div>
        <div class="dd-header">
          <span class="dd-label">{C.recentSearches}</span>
          <button class="dd-clear-all" id="clearAllBtn" type="button" style="display:none">{C.clearAll}</button>
        </div>
        <div class="dd-history" id="historyList"></div>
      </div>
    </div>

    <!-- Mode tab -->
    <div class="search-layout">
      <button class="filters-backdrop" id="filtersBackdrop" type="button" aria-label={C.closeFilters} tabindex="-1"></button>

      <aside class="filters" id="filtersPanel">
        <div class="filters-title-row">
          <h3 class="filters-title">{C.filters}</h3>
          <button class="filters-close-btn" id="filtersCloseBtn" type="button" aria-label={C.closeFilters}>×</button>
        </div>

        <div class="filter-group">
          <label class="filter-label toggle-label">
            <span>{C.verifiedOnly}</span>
            <label class="toggle">
              <input type="checkbox" id="verifiedToggle" />
              <span class="toggle-slider"></span>
            </label>
          </label>
        </div>

        <div class="filter-group">
          <span class="filter-label">{C.price}</span>
          <div class="pill-group" id="priceOptions">
            {(['', '0', '5', '10'] as const).map(p => (
              <button class={`pill ${p === '' ? 'active' : ''}`} data-price={p}>
                {p === '' ? C.any : p === '0' ? C.free : C.underN.replace('{n}', p)}
              </button>
            ))}
          </div>
        </div>

        <div class="filter-group">
          <span class="filter-label">{C.sort}</span>
          <div class="pill-group" id="sortOptions">
            <button class="pill active" data-sort="">{C.popular}</button>
            <button class="pill" data-sort="newest">{C.newest}</button>
          </div>
        </div>

        <div class="filter-group">
          <label class="filter-label toggle-label">
            <span>{C.hasBundles}</span>
            <label class="toggle">
              <input type="checkbox" id="bundlesToggle" />
              <span class="toggle-slider"></span>
            </label>
          </label>
        </div>

        <button class="apply-btn" id="applyBtn">{C.applyFilters}</button>
      </aside>

      <div class="results-area">
        <div class="results-top-bar">
          <RankingAttributionBar align="left" />
          <div class="results-top-actions">
            <div class="view-toggle" id="viewToggle" role="tablist" aria-label={C.resultsViewAria}>
              <button type="button" class="view-toggle-btn active" data-view="grid" role="tab" aria-selected="true">
                <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><rect x="3" y="3" width="7" height="7" rx="1.5"/><rect x="14" y="3" width="7" height="7" rx="1.5"/><rect x="3" y="14" width="7" height="7" rx="1.5"/><rect x="14" y="14" width="7" height="7" rx="1.5"/></svg>
                {C.grid}
              </button>
              <button type="button" class="view-toggle-btn" data-view="feed" role="tab" aria-selected="false">
                <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><rect x="7" y="2" width="10" height="20" rx="3"/><path d="M11 6h2"/></svg>
                {C.feed}
              </button>
            </div>
            <button class="filters-toggle-btn" id="filtersToggleBtn" type="button" aria-expanded="false" aria-controls="filtersPanel">
              <svg width="15" height="15" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><line x1="4" y1="6" x2="20" y2="6"/><line x1="4" y1="12" x2="20" y2="12"/><line x1="4" y1="18" x2="20" y2="18"/><circle cx="9" cy="6" r="1.6" fill="currentColor" stroke="none"/><circle cx="16" cy="12" r="1.6" fill="currentColor" stroke="none"/><circle cx="10" cy="18" r="1.6" fill="currentColor" stroke="none"/></svg>
              {C.filters}
            </button>
          </div>
        </div>
        <div
          class="results-grid"
          id="resultsGrid"
          data-seeded={seedCreators.length ? 'true' : 'false'}
          data-seed-has-more={seedHasMore ? 'true' : 'false'}
          set:html={seedCardsHtml}
        />
        <div class="load-more-wrap" id="loadMoreWrap" style={seedHasMore ? 'display:flex' : 'display:none'}>
          <button class="load-more-btn" id="loadMoreBtn">{C.loadMore}</button>
        </div>

        <!-- Feed view: hidden until toggled. Centered "reel" — full-height slides, one
             creator each, vertical scroll-snap moves between creators; tap left/right halves
             of the photo to cycle that creator's own photos. -->
        <div class="feed-viewport" id="feedViewport" hidden>
          <button class="feed-exit-btn" id="feedExitBtn" type="button" aria-label={C.backToGrid}>
            <svg width="17" height="17" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.4" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><line x1="18" y1="6" x2="6" y2="18"/><line x1="6" y1="6" x2="18" y2="18"/></svg>
          </button>
          <button class="feed-filters-fab" id="feedFiltersFab" type="button" aria-label={C.openFilters}>
            <svg width="17" height="17" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><line x1="4" y1="6" x2="20" y2="6"/><line x1="4" y1="12" x2="20" y2="12"/><line x1="4" y1="18" x2="20" y2="18"/><circle cx="9" cy="6" r="1.6" fill="currentColor" stroke="none"/><circle cx="16" cy="12" r="1.6" fill="currentColor" stroke="none"/><circle cx="10" cy="18" r="1.6" fill="currentColor" stroke="none"/></svg>
          </button>
          <div class="feed-scroll" id="feedScroll"></div>
          <p class="feed-status" id="feedStatus" hidden></p>

          <!-- Mouse-driven desktops only (see the hover:hover media query) — touch already
               has scroll/swipe, so these would just be visual clutter on mobile. -->
          <div class="feed-nav-rail">
            <button type="button" class="feed-nav-btn" id="feedNavUp" aria-label={C.prevCreator}>
              <svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M12 19V5M5 12l7-7 7 7"/></svg>
            </button>
            <button type="button" class="feed-nav-btn" id="feedNavDown" aria-label={C.nextCreator}>
              <svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M12 5v14M5 12l7 7 7-7"/></svg>
            </button>
          </div>
        </div>
      </div>
    </div>

    <div class="seo-body">
      <section class="seo-section seo-about">
        <h2>{SEOC.aboutHeading}</h2>
        {SEOC.about.map(p => <p>{p}</p>)}
      </section>

      {browseCategories.length > 0 && (
        <section class="seo-section seo-browse">
          <h2>{SEOC.browseHeading}</h2>
          <div class="browse-grid">
            {browseCategories.map(cat => (
              <a
                href={lang === 'es' ? `/es/categorias/${cat.slugEs ?? cat.slug}/` : `/categories/${cat.slug}/`}
                class="browse-card"
              >
                {cat.emoji && <span aria-hidden="true">{cat.emoji}</span>}
                {lang === 'es' ? cat.labelEs : cat.label}
              </a>
            ))}
          </div>
        </section>
      )}

      {SEOC.sections.map(s => (
        <section class="seo-section">
          <h2>{s.heading}</h2>
          {s.paragraphs.map(p => <p>{p}</p>)}
        </section>
      ))}

      <section class="seo-section seo-faq">
        <h2>{SEOC.faqHeading}</h2>
        <div class="faq-list">
          {SEOC.faq.map(item => (
            <details class="faq-item">
              <summary>{item.question}</summary>
              <p>{item.answer}</p>
            </details>
          ))}
        </div>
      </section>
    </div>
  </div>
</Base>

<script type="application/json" id="i18nSearchPage" set:html={JSON.stringify(CLIENT)} />

<script>
  import { currentAccountId, newSearchHistoryId, saveAccountSearchHistoryForOwner } from '../../lib/accountSearchHistory';
  import { pushHistory } from '../../lib/searchHistory';
  import { initSearchDropdown } from '../../lib/searchDropdown';
  import { initCardClickThrough } from '../../lib/cardClickThrough';
  import { creatorCardDataAttributes } from '../../lib/creatorCardUi';
  import { renderSearchCard, proxyImg, safeProfileHref, escapeHtml } from '../../lib/searchResultCard';
  import { WISHLIST_LIMIT_ACCOUNT, isInWishlist, toggleWishlist } from '../../lib/wishlist';

  const T = JSON.parse(document.getElementById('i18nSearchPage')!.textContent!) as Record<string, string>;
  const fmtT = (s: string, v: Record<string, string | number> = {}) =>
    s.replace(/\{(\w+)\}/g, (_, k: string) => String(v[k] ?? ''));

  // ── DOM refs ──────────────────────────────────────────────────────────────
  const searchHero     = document.getElementById('searchHero')!;
  const searchInput    = document.getElementById('searchInput') as HTMLInputElement;
  const searchClearBtn = document.getElementById('searchClearBtn') as HTMLButtonElement;
  const dropdown       = document.getElementById('searchDropdown')!;
  const ddAdSlot       = document.getElementById('ddAdSlot')!;
  const historyList    = document.getElementById('historyList')!;
  const clearAllBtn    = document.getElementById('clearAllBtn') as HTMLButtonElement;

  // ── Help modal ("How search works") ─────────────────────────────────────────
  const helpTrigger  = document.getElementById('helpTrigger') as HTMLButtonElement;
  const helpModal    = document.getElementById('helpModal')!;
  const helpBackdrop = document.getElementById('helpBackdrop')!;
  const helpCloseBtn = document.getElementById('helpCloseBtn') as HTMLButtonElement;
  const helpCta      = document.getElementById('helpCta')!;

  helpCta.hidden = Boolean(currentAccountId()); // signed-in visitors already have the benefit

  function openHelp(): void {
    helpModal.hidden = false;
    helpBackdrop.hidden = false;
    helpCloseBtn.focus();
  }
  function closeHelp(): void {
    helpModal.hidden = true;
    helpBackdrop.hidden = true;
    helpTrigger.focus();
  }
  helpTrigger.addEventListener('click', openHelp);
  helpCloseBtn.addEventListener('click', closeHelp);
  helpBackdrop.addEventListener('click', closeHelp);
  document.addEventListener('keydown', e => { if (e.key === 'Escape' && !helpModal.hidden) closeHelp(); });

  initCardClickThrough();
  initSearchDropdown({
    wrapper: searchHero,
    input: searchInput,
    dropdown,
    adSlot: ddAdSlot,
    historyList,
    clearAllBtn,
    onSelect(q) {
      searchInput.value = q;
      activeFilters.q = q;
      refreshVisibleView(true);
    },
  });

  // ── Clear button ──────────────────────────────────────────────────────────
  searchInput.addEventListener('input', () => {
    searchClearBtn.style.display = searchInput.value ? 'flex' : 'none';
  });
  if (searchInput.value) searchClearBtn.style.display = 'flex';

  searchClearBtn.addEventListener('click', () => {
    searchInput.value = '';
    searchClearBtn.style.display = 'none';
    activeFilters.q = '';
    searchInput.dispatchEvent(new Event('input', { bubbles: true }));
    searchInput.focus();
    refreshVisibleView(false);
  });

  // ── Search / filter logic ─────────────────────────────────────────────────
  let currentPage = 1;
  let resultsController: AbortController | null = null;
  let resultsRequestId = 0;
  let isLoadingMore = false;
  let hasMoreResults = false;

  const qs = new URLSearchParams(window.location.search);
  let activeFilters = {
    q:        qs.get('q') ?? '',
    verified: qs.get('verified') ?? '',
    price:    qs.get('price') ?? '',
    sort:     qs.get('sort') ?? '',
    bundles:  qs.get('bundles') ?? '',
  };

  const verifiedToggle = document.getElementById('verifiedToggle') as HTMLInputElement;
  const bundlesToggle  = document.getElementById('bundlesToggle') as HTMLInputElement;
  const resultsGrid    = document.getElementById('resultsGrid')!;
  const resultsCount   = document.getElementById('resultsCount')!;
  const loadMoreWrap   = document.getElementById('loadMoreWrap')!;
  const loadMoreBtn    = document.getElementById('loadMoreBtn') as HTMLButtonElement;
  const applyBtn       = document.getElementById('applyBtn')!;

  // ── Mobile filters drawer — desktop keeps the sticky sidebar untouched; these buttons
  // only render (via CSS) under the 1000px breakpoint. ────────────────────────────────
  const filtersPanel      = document.getElementById('filtersPanel')!;
  const filtersBackdrop   = document.getElementById('filtersBackdrop')!;
  const filtersToggleBtn  = document.getElementById('filtersToggleBtn') as HTMLButtonElement;
  const filtersCloseBtn   = document.getElementById('filtersCloseBtn') as HTMLButtonElement;

  function openFilters(): void {
    filtersPanel.classList.add('filters-open');
    filtersBackdrop.classList.add('filters-open');
    filtersToggleBtn.setAttribute('aria-expanded', 'true');
  }
  function closeFilters(): void {
    filtersPanel.classList.remove('filters-open');
    filtersBackdrop.classList.remove('filters-open');
    filtersToggleBtn.setAttribute('aria-expanded', 'false');
  }
  filtersToggleBtn.addEventListener('click', openFilters);
  filtersCloseBtn.addEventListener('click', closeFilters);
  filtersBackdrop.addEventListener('click', closeFilters);
  document.addEventListener('keydown', e => { if (e.key === 'Escape') closeFilters(); });

  document.querySelectorAll('#priceOptions .pill').forEach(btn => {
    btn.addEventListener('click', () => {
      document.querySelectorAll('#priceOptions .pill').forEach(b => b.classList.remove('active'));
      btn.classList.add('active');
      activeFilters.price = (btn as HTMLElement).dataset.price ?? '';
    });
  });

  document.querySelectorAll('#sortOptions .pill').forEach(btn => {
    btn.addEventListener('click', () => {
      document.querySelectorAll('#sortOptions .pill').forEach(b => b.classList.remove('active'));
      btn.classList.add('active');
      activeFilters.sort = (btn as HTMLElement).dataset.sort ?? '';
    });
  });

  // Enter key = explicit submit → save to history
  applyBtn.addEventListener('click', () => {
    const q = searchInput.value.trim();
    activeFilters.q        = q;
    activeFilters.verified = verifiedToggle.checked ? 'true' : '';
    activeFilters.bundles  = bundlesToggle.checked ? 'true' : '';
    if (q) {
      try { pushHistory(q); } catch { /* browser storage must not block applying filters */ }
    }
    dropdown.style.display = 'none';
    closeFilters();
    refreshVisibleView(true);
  });

  loadMoreBtn.addEventListener('click', () => fetchCreators(true));

  // Markup lives in src/lib/searchResultCard.ts so these appended cards stay identical to
  // the ones the server baked into the grid — they share the same grid, so any drift shows.
  const renderCard = (c: any, index: number): string =>
    renderSearchCard(c, index, T as unknown as { sponsored: string; free: string; viewProfile: string });

  async function fetchCreators(append = false, saveToAccountHistory = false) {
    const searchOwnerId = saveToAccountHistory ? currentAccountId() : null;
    if (append && isLoadingMore) return;
    if (append) isLoadingMore = true;
    else {
      resultsController?.abort();
      isLoadingMore = false;
    }

    const controller = new AbortController();
    resultsController = controller;
    const requestId = ++resultsRequestId;

    if (!append) {
      currentPage = 1;
      resultsGrid.innerHTML = `<p class="loading-msg">${T.loading}</p>`;
    }

    loadMoreBtn.textContent = T.loading;
    loadMoreBtn.disabled = true;

    const params = new URLSearchParams();
    params.set('scope', 'onlyfans-search'); // pins the 3 sponsored creators — see src/config/placements.ts
    if (activeFilters.q)        params.set('q',        activeFilters.q);
    if (activeFilters.verified) params.set('verified',  activeFilters.verified);
    if (activeFilters.price)    params.set('price',     activeFilters.price);
    if (activeFilters.sort)     params.set('sort',      activeFilters.sort);
    if (activeFilters.bundles)  params.set('bundles',   activeFilters.bundles);
    params.set('page',      String(currentPage));
    params.set('page_size', '20');

    try {
      const resp = await fetch(`/api/search?${params}`, { signal: controller.signal });
      if (!resp.ok) throw new Error(`Search failed with ${resp.status}`);
      const data = await resp.json();
      if (requestId !== resultsRequestId) return;

      if (!append && saveToAccountHistory && activeFilters.q) {
        const organicResults = Array.isArray(data.creators)
          ? data.creators
            .filter((creator: any) => !creator?.sponsored)
            .slice(0, 10)
            .map((creator: any) => ({
              username: creator.username,
              name: creator.name || creator.username,
              avatar: creator.avatar,
              subscribePrice: creator.subscribePrice ?? creator.subscribeprice,
              profileUrl: creator.profileUrl,
            }))
          : [];
        void saveAccountSearchHistoryForOwner(searchOwnerId, {
          clientSearchId: newSearchHistoryId('directory'),
          searchType: 'directory',
          query: activeFilters.q,
          label: activeFilters.q,
          resultCount: Math.max(0, Number(data.organicTotal ?? 0)),
          filters: {
            verified: activeFilters.verified === 'true',
            price: activeFilters.price || null,
            sort: activeFilters.sort || 'popular',
            bundles: activeFilters.bundles === 'true',
          },
          results: organicResults,
        });
      }

      if (!append) resultsGrid.innerHTML = '';
      const noOrganicMatches = !append
        && Boolean(activeFilters.q)
        && Number(data.organicTotal ?? 0) === 0;

      if (noOrganicMatches) {
        const notice = document.createElement('div');
        notice.className = 'no-search-matches';
        const title = document.createElement('strong');
        title.textContent = fmtT(T.noMatchesFor, { q: activeFilters.q });
        const detail = document.createElement('span');
        detail.textContent = Number(data.sponsoredCount ?? 0) > 0
          ? T.sponsoredBelow
          : T.tryAnother;
        notice.append(title, detail);
        resultsGrid.append(notice);
      }

      if (!data.creators?.length && !append && !noOrganicMatches) {
        resultsGrid.innerHTML = `<p class="loading-msg">${T.noCreatorsDot}</p>`;
      } else {
        data.creators?.forEach((c: any, i: number) =>
          resultsGrid.insertAdjacentHTML('beforeend', renderCard(c, append ? 999 : i))
        );
      }

      hasMoreResults = Boolean(data.hasMore);
      currentPage++;

      const displayedTotal = activeFilters.q ? Number(data.organicTotal ?? 0) : Number(data.total ?? 0);
      resultsCount.textContent = displayedTotal
        ? fmtT(T.creatorsFound, { n: displayedTotal.toLocaleString() })
        : T.noCreators;

      loadMoreWrap.style.display = hasMoreResults ? 'flex' : 'none';
      loadMoreBtn.textContent = T.loadMore;
      loadMoreBtn.disabled = false;

      const urlObj = new URL(window.location.href);
      if (activeFilters.q) urlObj.searchParams.set('q', activeFilters.q);
      else urlObj.searchParams.delete('q');
      if (activeFilters.sort) urlObj.searchParams.set('sort', activeFilters.sort);
      else urlObj.searchParams.delete('sort');
      if (activeFilters.verified) urlObj.searchParams.set('verified', activeFilters.verified);
      else urlObj.searchParams.delete('verified');
      if (activeFilters.price) urlObj.searchParams.set('price', activeFilters.price);
      else urlObj.searchParams.delete('price');
      if (activeFilters.bundles) urlObj.searchParams.set('bundles', activeFilters.bundles);
      else urlObj.searchParams.delete('bundles');
      urlObj.searchParams.delete('history');
      window.history.replaceState({}, '', urlObj.toString());
    } catch (error) {
      if (error instanceof DOMException && error.name === 'AbortError') return;
      resultsGrid.innerHTML = `<p class="loading-msg">${T.loadError}</p>`;
      loadMoreBtn.textContent = T.loadMore;
      loadMoreBtn.disabled = false;
    } finally {
      if (requestId === resultsRequestId) {
        resultsController = null;
        isLoadingMore = false;
      }
    }
  }

  // ── Feed view (vertical, TikTok/Shorts-style) ───────────────────────────────
  // Its own render/fetch/scroll cycle rather than reusing renderCard()/fetchCreators():
  // the interaction model (tap-zones for a creator's own photos, scroll-snap for the next
  // creator, a right-side action rail) is different enough from a grid tile that sharing
  // one function would mean branching most of its body anyway.
  const viewToggle       = document.getElementById('viewToggle')!;
  const feedViewport     = document.getElementById('feedViewport')!;
  const feedScroll       = document.getElementById('feedScroll')!;
  const feedStatus       = document.getElementById('feedStatus')!;
  const feedFiltersFab   = document.getElementById('feedFiltersFab') as HTMLButtonElement;
  const feedExitBtn      = document.getElementById('feedExitBtn') as HTMLButtonElement;
  const feedNavUp        = document.getElementById('feedNavUp') as HTMLButtonElement;
  const feedNavDown      = document.getElementById('feedNavDown') as HTMLButtonElement;

  let feedNavScrollTimer: ReturnType<typeof setTimeout> | undefined;
  let feedPage = 1;
  let feedLoading = false;
  let feedHasMore = true;
  let feedRequestId = 0;
  let feedLoadedOnce = false;
  let feedObserver: IntersectionObserver | null = null;
  // Set from a ?view=feed&u=<username> deep link (see the bottom of this script). Consumed
  // once by enterFeedMode() the first time Feed is entered; feedSkipUsername stays set for
  // the rest of the session so the normal paginated load never re-inserts the same creator
  // as a duplicate slide right after the hand-placed "shared" one.
  let pendingSharedUsername: string | null = null;
  let feedSkipUsername: string | null = null;

  feedFiltersFab.addEventListener('click', openFilters);
  feedExitBtn.addEventListener('click', () => setViewMode('grid'));
  document.addEventListener('keydown', e => { if (e.key === 'Escape' && !feedViewport.hidden) setViewMode('grid'); });

  function feedParams(page: number): URLSearchParams {
    const params = new URLSearchParams();
    params.set('scope', 'onlyfans-search');
    if (activeFilters.q)        params.set('q',        activeFilters.q);
    if (activeFilters.verified) params.set('verified',  activeFilters.verified);
    if (activeFilters.price)    params.set('price',     activeFilters.price);
    if (activeFilters.sort)     params.set('sort',      activeFilters.sort);
    if (activeFilters.bundles)  params.set('bundles',   activeFilters.bundles);
    params.set('page', String(page));
    params.set('page_size', '8'); // small batches — the feed loads continuously, never 20 at once
    return params;
  }

  function feedHeartMarkup(active: boolean): string {
    const path = 'M12 21s-6.6-4.06-9.33-7.86C.86 10.64 1.1 7.28 3.6 5.34c2.2-1.7 5.02-1.24 6.7.86L12 8.1l1.7-1.9c1.68-2.1 4.5-2.56 6.7-.86 2.5 1.94 2.74 5.3 0.93 7.8C18.6 16.94 12 21 12 21Z';
    return `<button type="button" class="feed-heart${active ? ' active' : ''}" aria-label="${active ? T.removeWishlist : T.addWishlist}">
      <svg viewBox="0 0 24 24" class="heart-svg" aria-hidden="true">
        <path class="heart-outline" d="${path}"/>
        <path class="heart-fill" d="${path}"/>
      </svg>
    </button>`;
  }

  function feedImages(c: any): string[] {
    const raw = [c.avatar, c.header, ...(Array.isArray(c.galleryImages) ? c.galleryImages : [])];
    const seen = new Set<string>();
    const out: string[] = [];
    raw.forEach((value: unknown) => {
      const trimmed = typeof value === 'string' ? value.trim() : '';
      if (trimmed && !seen.has(trimmed)) { seen.add(trimmed); out.push(trimmed); }
    });
    return out.length ? out : ['/no-image.png'];
  }

  function feedSlideMarkup(c: any, opts: { shared?: boolean } = {}): string {
    const images = feedImages(c);
    const price = c.subscribePrice ?? c.subscribeprice;
    const priceIsFree = (!price || isNaN(price));
    const priceLabel = priceIsFree ? T.free : `$${parseFloat(price).toFixed(2)}`;
    const profileUrl = safeProfileHref(c.profileUrl, c.username);
    const isSponsored = Boolean(c.sponsored) || profileUrl.startsWith('/go/');
    const rel = isSponsored ? 'noopener nofollow sponsored' : 'noopener nofollow';
    const safeName = escapeHtml(c.name || c.username);
    const safeUsername = escapeHtml(c.username);
    const progressSegs = images.length > 1
      ? `<div class="feed-progress">${images.map((_, i) => `<button type="button" class="feed-progress-seg${i === 0 ? ' active' : ''}" data-photo-index="${i}" aria-label="Photo ${i + 1} of ${images.length}"></button>`).join('')}</div>`
      : '';
    const sharedBadge = opts.shared ? `<span class="feed-shared-badge">${T.sharedWithYou}</span>` : '';

    return `<section class="feed-slide" data-username="${escapeHtml(c.username)}" data-images='${escapeHtml(JSON.stringify(images))}' data-index="0">
      <div class="feed-slide-bg" style="background-image:url('${escapeHtml(proxyImg(images[0], 60, 80))}')"></div>
      <div class="feed-slide-media">
        ${progressSegs}
        ${sharedBadge}
        <img class="feed-photo" src="${escapeHtml(proxyImg(images[0], 640, 853))}" alt="${safeName}" loading="lazy" decoding="async" referrerpolicy="no-referrer"
          onerror="this.style.visibility='hidden';this.closest('.feed-slide-media').classList.add('feed-img-fallback');">
        <button type="button" class="feed-tap-zone feed-tap-prev" aria-label="${T.prevPhoto}"></button>
        <button type="button" class="feed-tap-zone feed-tap-next" aria-label="${T.nextPhoto}"></button>
      </div>
      <div class="feed-overlay">
        <div class="feed-info">
          <p class="feed-name">${safeName}</p>
          <p class="feed-username">@${safeUsername}${isSponsored ? ` <span class="feed-ad-tag">${T.ad}</span>` : ''}</p>
          <p class="feed-price ${priceIsFree ? 'price-free' : ''}">${priceLabel}</p>
        </div>
        <div class="feed-actions">
          <button type="button" class="feed-share-btn" aria-label="${fmtT(T.shareProfile, { name: safeName })}">
            <svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><circle cx="18" cy="5" r="3"/><circle cx="6" cy="12" r="3"/><circle cx="18" cy="19" r="3"/><path d="m8.6 10.5 6.8-3.9M8.6 13.5l6.8 3.9"/></svg>
          </button>
          ${feedHeartMarkup(isInWishlist(c.username))}
          <a href="${escapeHtml(profileUrl)}" class="feed-view-btn" target="_blank" rel="${rel}" aria-label="${fmtT(T.viewProfileOf, { name: safeName })}">
            <svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M18 13v6a2 2 0 0 1-2 2H5a2 2 0 0 1-2-2V8a2 2 0 0 1 2-2h6"/><path d="M15 3h6v6"/><path d="M10 14 21 3"/></svg>
          </a>
        </div>
      </div>
    </section>`;
  }

  function updateFeedSlidePhoto(slide: HTMLElement, index: number): void {
    let images: string[] = [];
    try { images = JSON.parse(slide.dataset.images || '[]'); } catch { images = []; }
    if (images.length < 2) return;
    // Clamped, not wrapped: tapping "previous" on the first photo should just stay put, not
    // silently jump to the last photo — that read as "it loaded the wrong picture" in
    // testing, since nothing on screen signals a wrap happened.
    const clamped = Math.min(Math.max(index, 0), images.length - 1);
    if (clamped === Number(slide.dataset.index || 0)) return;
    slide.dataset.index = String(clamped);
    const media = slide.querySelector<HTMLElement>('.feed-slide-media');
    media?.classList.remove('feed-img-fallback');
    const img = slide.querySelector<HTMLImageElement>('.feed-photo');
    if (img) {
      img.style.visibility = 'visible';
      img.src = proxyImg(images[clamped], 640, 853);
    }
    const bg = slide.querySelector<HTMLElement>('.feed-slide-bg');
    if (bg) bg.style.backgroundImage = `url('${proxyImg(images[clamped], 60, 80)}')`;
    slide.querySelectorAll('.feed-progress-seg').forEach((seg, i) => seg.classList.toggle('active', i === clamped));
  }

  function observeFeedSentinel(): void {
    feedObserver?.disconnect();
    const lastSlide = feedScroll.lastElementChild;
    if (!lastSlide || !feedHasMore) return;
    feedObserver = new IntersectionObserver(entries => {
      if (entries.some(entry => entry.isIntersecting)) loadFeedPage();
    }, { root: feedScroll, rootMargin: '600px 0px' });
    feedObserver.observe(lastSlide);
  }

  async function loadFeedPage(): Promise<void> {
    if (feedLoading || !feedHasMore) return;
    feedLoading = true;
    const requestId = ++feedRequestId;
    feedStatus.hidden = false;
    feedStatus.textContent = T.loadingMore;

    try {
      const resp = await fetch(`/api/search?${feedParams(feedPage)}`);
      if (!resp.ok) throw new Error(`Feed search failed: ${resp.status}`);
      const data = await resp.json();
      if (requestId !== feedRequestId) return;

      const creators = Array.isArray(data.creators) ? data.creators : [];
      creators
        .filter((c: any) => (c.username || '').toLowerCase() !== feedSkipUsername)
        .forEach((c: any) => feedScroll.insertAdjacentHTML('beforeend', feedSlideMarkup(c)));
      feedHasMore = Boolean(data.hasMore);
      feedPage++;

      if (feedHasMore) {
        feedStatus.hidden = true;
      } else {
        feedStatus.hidden = false;
        feedStatus.textContent = feedScroll.children.length ? T.thatsEveryone : T.noCreators;
      }
      observeFeedSentinel();
      updateFeedNavButtons();
    } catch {
      feedStatus.hidden = false;
      feedStatus.textContent = T.feedError;
    } finally {
      if (requestId === feedRequestId) feedLoading = false;
    }
  }

  function resetFeed(): void {
    feedObserver?.disconnect();
    feedScroll.innerHTML = '';
    feedPage = 1;
    feedHasMore = true;
    feedLoading = false;
    feedStatus.hidden = true;
  }

  // Resolves a specific shared username to full card data (price, sponsored flag, gallery
  // images) via the same /api/search endpoint every other slide uses — searching by their
  // exact username as the query, independent of whatever activeFilters.q the surrounding
  // feed is using, so locating them never depends on what the sharer happened to be typing.
  async function resolveSharedCreator(username: string): Promise<any | null> {
    try {
      const params = new URLSearchParams({ scope: 'onlyfans-search', q: username, page: '1', page_size: '10' });
      const resp = await fetch(`/api/search?${params}`);
      if (!resp.ok) return null;
      const data = await resp.json();
      const creators = Array.isArray(data.creators) ? data.creators : [];
      const needle = username.toLowerCase();
      return creators.find((c: any) => (c.username || '').toLowerCase() === needle) ?? null;
    } catch {
      return null;
    }
  }

  async function loadFeedWithSharedTarget(username: string): Promise<void> {
    feedSkipUsername = username.toLowerCase();
    const target = await resolveSharedCreator(username);
    if (target) {
      feedScroll.insertAdjacentHTML('beforeend', feedSlideMarkup(target, { shared: true }));
      observeFeedSentinel();
      updateFeedNavButtons();
    } else {
      const toast = document.createElement('div');
      toast.className = 'wishlist-toast';
      toast.setAttribute('role', 'status');
      toast.textContent = T.sharedNotFound;
      document.body.append(toast);
      window.setTimeout(() => toast.remove(), 3200);
    }
    await loadFeedPage(); // continue with the normal (filtered) feed underneath
  }

  function enterFeedMode(): void {
    feedViewport.hidden = false;
    resultsGrid.hidden = true;
    loadMoreWrap.style.display = 'none';
    if (!feedLoadedOnce) {
      feedLoadedOnce = true;
      if (pendingSharedUsername) {
        const username = pendingSharedUsername;
        pendingSharedUsername = null;
        loadFeedWithSharedTarget(username);
      } else {
        loadFeedPage();
      }
    }
  }
  function exitFeedMode(): void {
    feedViewport.hidden = true;
    resultsGrid.hidden = false;
    loadMoreWrap.style.display = hasMoreResults ? 'flex' : 'none';
  }

  // Deliberately NOT persisted across page loads: an immersive full-viewport takeover is
  // surprising enough as a default that every visit should start on Grid and require an
  // explicit click into Feed, not silently resume wherever a previous visit left off.
  function setViewMode(mode: 'grid' | 'feed'): void {
    viewToggle.querySelectorAll<HTMLButtonElement>('.view-toggle-btn').forEach(btn => {
      const active = btn.dataset.view === mode;
      btn.classList.toggle('active', active);
      btn.setAttribute('aria-selected', String(active));
    });
    if (mode === 'feed') enterFeedMode(); else exitFeedMode();
  }

  viewToggle.querySelectorAll<HTMLButtonElement>('.view-toggle-btn').forEach(btn => {
    btn.addEventListener('click', () => setViewMode(btn.dataset.view === 'feed' ? 'feed' : 'grid'));
  });

  // A filter/search change should refresh whichever view is currently visible, not just grid.
  function refreshVisibleView(saveHistory: boolean): void {
    fetchCreators(false, saveHistory);
    if (!feedViewport.hidden) {
      feedLoadedOnce = true;
      resetFeed();
      loadFeedPage();
    }
  }

  // Tap-zones (photo prev/next) and the wishlist heart, delegated once on the scroll
  // container so newly-loaded slides need no per-slide listener setup.
  feedScroll.addEventListener('click', event => {
    const target = event.target as HTMLElement;
    const slide = target.closest<HTMLElement>('.feed-slide');
    if (!slide) return;

    // Segments are individually clickable — jump straight to that exact photo, same as
    // tapping a specific Stories segment, rather than only stepping one at a time.
    const segBtn = target.closest<HTMLElement>('.feed-progress-seg');
    if (segBtn) {
      updateFeedSlidePhoto(slide, Number(segBtn.dataset.photoIndex ?? 0));
      return;
    }

    if (target.closest('.feed-tap-prev')) {
      updateFeedSlidePhoto(slide, Number(slide.dataset.index || 0) - 1);
      return;
    }
    if (target.closest('.feed-tap-next')) {
      updateFeedSlidePhoto(slide, Number(slide.dataset.index || 0) + 1);
      return;
    }

    const shareBtn = target.closest<HTMLElement>('.feed-share-btn');
    if (shareBtn) {
      const username = slide.dataset.username || '';
      const name = slide.querySelector('.feed-name')?.textContent?.trim() || username;
      // Shares a link back to OUR feed (deep-linked to this creator, filters preserved), not
      // the raw /go/ redirect — a share should bring someone onto findbyface to discover the
      // rest of the feed, not just hand away a bare OnlyFans referral link. "View Profile"
      // inside that landing is still the one path that goes through /go/ click tracking.
      const shareUrl = new URL('/onlyfans-search/', window.location.origin);
      shareUrl.searchParams.set('view', 'feed');
      shareUrl.searchParams.set('u', username);
      if (activeFilters.q)        shareUrl.searchParams.set('q', activeFilters.q);
      if (activeFilters.verified) shareUrl.searchParams.set('verified', activeFilters.verified);
      if (activeFilters.price)    shareUrl.searchParams.set('price', activeFilters.price);
      if (activeFilters.sort)     shareUrl.searchParams.set('sort', activeFilters.sort);
      if (activeFilters.bundles)  shareUrl.searchParams.set('bundles', activeFilters.bundles);
      const link = shareUrl.toString();

      if (navigator.share) {
        navigator.share({ title: name, text: fmtT(T.checkOut, { name }), url: link }).catch(() => { /* user cancelled the native share sheet — not an error */ });
      } else {
        navigator.clipboard.writeText(link).then(() => {
          const toast = document.createElement('div');
          toast.className = 'wishlist-toast';
          toast.setAttribute('role', 'status');
          toast.textContent = T.linkCopied;
          document.body.append(toast);
          window.setTimeout(() => toast.remove(), 2400);
        }).catch(() => { /* clipboard unavailable — nothing more to fall back to */ });
      }
      return;
    }

    const heartBtn = target.closest<HTMLElement>('.feed-heart');
    if (!heartBtn) return;
    const username = slide.dataset.username;
    if (!username) return;

    const entry = {
      username,
      name: slide.querySelector('.feed-name')?.textContent?.trim() || username,
      avatar: slide.querySelector<HTMLImageElement>('.feed-photo')?.src || '',
      price: slide.querySelector('.feed-price')?.textContent?.trim() || '',
      profileUrl: slide.querySelector<HTMLAnchorElement>('.feed-view-btn')?.href || '',
      addedAt: Date.now(),
    };
    const result = toggleWishlist(username, entry);

    if (result.blocked) {
      const toast = document.createElement('div');
      toast.className = 'wishlist-toast';
      toast.setAttribute('role', 'status');
      toast.textContent = currentAccountId()
        ? fmtT(T.wishlistFullRemove, { limit: result.limit })
        : fmtT(T.wishlistFullSignup, { limit: result.limit, n: WISHLIST_LIMIT_ACCOUNT });
      document.body.append(toast);
      window.setTimeout(() => toast.remove(), 3200);
      return;
    }

    heartBtn.classList.toggle('active', result.added);
    heartBtn.setAttribute('aria-label', result.added ? T.removeWishlist : T.addWishlist);
    if (result.added) {
      heartBtn.classList.remove('bursting');
      void heartBtn.offsetWidth; // restart the animation cleanly on rapid re-likes
      heartBtn.classList.add('bursting');
      for (let i = 0; i < 7; i++) {
        const spark = document.createElement('span');
        spark.className = 'heart-spark';
        const angle = (360 / 7) * i + (Math.random() * 18 - 9);
        const distance = 18 + Math.random() * 8;
        spark.style.setProperty('--angle', `${angle}deg`);
        spark.style.setProperty('--distance', `${distance}px`);
        heartBtn.append(spark);
        spark.addEventListener('animationend', () => spark.remove(), { once: true });
      }
    }
    window.dispatchEvent(new CustomEvent('fbf:wishlist-changed'));
  });

  // Desktop keyboard + nav-rail support — Up/Down move between creators (the scroll-snap
  // axis), Left/Right cycle the currently-visible creator's own photos (the tap-zone axis).
  function feedSlides(): HTMLElement[] {
    return Array.from(feedScroll.children) as HTMLElement[];
  }
  function currentFeedSlideIndex(slides: HTMLElement[]): number {
    return slides.findIndex(slide => {
      const rect = slide.getBoundingClientRect();
      return rect.top >= -10 && rect.top < window.innerHeight / 2;
    });
  }
  function currentFeedSlide(): HTMLElement | null {
    const slides = feedSlides();
    const index = currentFeedSlideIndex(slides);
    return slides[index === -1 ? 0 : index] ?? null;
  }
  function goToAdjacentSlide(direction: 1 | -1): void {
    const slides = feedSlides();
    const currentIndex = currentFeedSlideIndex(slides);
    const nextIndex = Math.min(Math.max((currentIndex === -1 ? 0 : currentIndex) + direction, 0), slides.length - 1);
    slides[nextIndex]?.scrollIntoView({ behavior: 'smooth', block: 'start' });
  }
  function updateFeedNavButtons(): void {
    const slides = feedSlides();
    const currentIndex = currentFeedSlideIndex(slides);
    const index = currentIndex === -1 ? 0 : currentIndex;
    feedNavUp.disabled = index <= 0;
    feedNavDown.disabled = index >= slides.length - 1 && !feedHasMore;
  }

  feedNavUp.addEventListener('click', () => goToAdjacentSlide(-1));
  feedNavDown.addEventListener('click', () => goToAdjacentSlide(1));
  feedScroll.addEventListener('scroll', () => {
    window.clearTimeout(feedNavScrollTimer);
    feedNavScrollTimer = window.setTimeout(updateFeedNavButtons, 120);
  }, { passive: true });

  document.addEventListener('keydown', event => {
    if (feedViewport.hidden) return;
    const active = document.activeElement;
    if (active instanceof HTMLElement && (active.tagName === 'INPUT' || active.tagName === 'TEXTAREA')) return;

    if (event.key === 'ArrowDown' || event.key === 'ArrowUp') {
      event.preventDefault();
      goToAdjacentSlide(event.key === 'ArrowDown' ? 1 : -1);
      return;
    }

    if (event.key === 'ArrowLeft' || event.key === 'ArrowRight') {
      const slide = currentFeedSlide();
      if (!slide) return;
      event.preventDefault();
      const delta = event.key === 'ArrowRight' ? 1 : -1;
      updateFeedSlidePhoto(slide, Number(slide.dataset.index || 0) + delta);
    }
  });

  // ── First paint ───────────────────────────────────────────────────────────
  // The server bakes the default, unfiltered page 1 straight into #resultsGrid, so the
  // common case (someone landing on /onlyfans-search with no query) has creators on
  // screen already and must NOT re-fetch what it is looking at. Anything filtered still
  // takes the normal live path.
  const hasActiveFilters = Boolean(
    activeFilters.q || activeFilters.verified || activeFilters.price
    || activeFilters.sort || activeFilters.bundles,
  );
  const seeded = resultsGrid.dataset.seeded === 'true';

  if (seeded && !hasActiveFilters) {
    // Adopt what the server already rendered: page 1 is on screen, so Load More asks for 2.
    currentPage = 2;
    hasMoreResults = resultsGrid.dataset.seedHasMore === 'true';
    loadMoreWrap.style.display = hasMoreResults ? 'flex' : 'none';
  } else {
    // This page is prerendered, so its markup can't carry ?q=/&price= state the way the
    // SSR version did — restore the controls from the URL here before querying, or a
    // shared/deep link would show filtered results next to empty-looking filter controls.
    if (activeFilters.q) {
      searchInput.value = activeFilters.q;
      searchClearBtn.style.display = 'flex';
    }
    verifiedToggle.checked = activeFilters.verified === 'true';
    bundlesToggle.checked  = activeFilters.bundles === 'true';
    document.querySelectorAll<HTMLElement>('#priceOptions .pill').forEach(pill => {
      pill.classList.toggle('active', (pill.dataset.price ?? '') === activeFilters.price);
    });
    document.querySelectorAll<HTMLElement>('#sortOptions .pill').forEach(pill => {
      pill.classList.toggle('active', (pill.dataset.sort ?? '') === (activeFilters.sort === 'newest' ? 'newest' : ''));
    });

    const shouldSaveDashboardRerun = qs.get('history') === '1' && Boolean(activeFilters.q);
    fetchCreators(false, shouldSaveDashboardRerun);
  }

  // ?view=feed&u=<username> — a Feed share link. Land straight in Feed with that creator's
  // slide already in place (see loadFeedWithSharedTarget), instead of requiring a manual
  // toggle click plus a scroll-hunt through the normal feed to find them again.
  const sharedUsername = qs.get('u')?.trim();
  if (qs.get('view') === 'feed' && sharedUsername) {
    pendingSharedUsername = sharedUsername;
    setViewMode('feed');
  }
</script>

<style>
