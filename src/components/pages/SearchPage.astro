  }
  .help-cta[hidden] { display: none; }
  .help-cta p { font-size: 12.5px; color: var(--text-muted); margin-bottom: 10px; line-height: 1.5; }
  .help-cta strong { color: var(--text); }
  .help-cta-btn {
    display: inline-flex;
    align-items: center;
    gap: 7px;
    padding: 9px 16px;
