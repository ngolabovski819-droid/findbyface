---

<Base
  title={C.title}
  description={C.description}
  canonical={absUrl(`${langPrefix}/dashboard/`)}
  robots="noindex,follow"
>
  <section class="dashboard-page">
    <div class="dashboard-gate" id="dashGate">
      <div class="gate-glow" aria-hidden="true"></div>
      <div class="gate-card">
        <span class="gate-icon" aria-hidden="true">
          <svg viewBox="0 0 24 24" fill="none"><rect x="4" y="10" width="16" height="11" rx="3"/><path d="M8 10V7a4 4 0 0 1 8 0v3M12 14v3"/></svg>
        </span>
        <span class="gate-kicker">{C.gateKicker}</span>
        <h1 id="gateTitle">{C.gateTitle}</h1>
        <p id="gateMessage">{C.gateMessage}</p>
        <a href={`${langPrefix}/login/?next=${langPrefix}/dashboard/`} class="primary-button" id="gateButton">{C.gateLogin} <span>→</span></a>
        <p class="gate-signup">{C.gateNew} <a href={`${langPrefix}/signup/?next=${langPrefix}/dashboard/`}>{C.gateCreate}</a></p>
        <a href={`${langPrefix}/signup/?next=${langPrefix}/dashboard/`} class="gate-secondary" id="gateSecondary" hidden>{C.gateDifferentEmail}</a>
      </div>
    </div>

    <div class="dashboard-main" id="dashMain" hidden>
      <header class="dashboard-header">
        <div>
          <span class="page-kicker"><i></i> {C.headerKicker}</span>
          <h1><span id="greeting">{C.welcomeBack}</span>, <span class="gradient-text" id="dashName">{C.there}</span></h1>
          <p>{C.headerSub}</p>
        </div>
        <div class="header-actions">
          <a href={settingsHref} class="secondary-button">
            <svg viewBox="0 0 24 24" fill="none"><circle cx="12" cy="12" r="3"/><path d="M19.4 15a1.7 1.7 0 0 0 .34 1.86l.03.03-2.88 2.88-.03-.03A1.7 1.7 0 0 0 15 19.4a1.7 1.7 0 0 0-1 1.55V21h-4v-.05a1.7 1.7 0 0 0-1-1.55 1.7 1.7 0 0 0-1.86.34l-.03.03-2.88-2.88.03-.03A1.7 1.7 0 0 0 4.6 15a1.7 1.7 0 0 0-1.55-1H3v-4h.05A1.7 1.7 0 0 0 4.6 9a1.7 1.7 0 0 0-.34-1.86l-.03-.03 2.88-2.88.03.03A1.7 1.7 0 0 0 9 4.6a1.7 1.7 0 0 0 1-1.55V3h4v.05A1.7 1.7 0 0 0 15 4.6a1.7 1.7 0 0 0 1.86-.34l.03-.03 2.88 2.88-.03.03A1.7 1.7 0 0 0 19.4 9a1.7 1.7 0 0 0 1.55 1H21v4h-.05a1.7 1.7 0 0 0-1.55 1Z"/></svg>
            {C.settings}
          </a>
          <a href={homeHref} class="primary-button">{C.newSearch} <span>＋</span></a>
        </div>
      </header>

      <section class="overview-grid" aria-label={C.overviewAria}>
        <article class="account-overview">
          <div class="account-avatar" id="accountAvatar">F</div>
          <div class="account-copy">
            <span class="account-label">{C.signedInAccount}</span>
            <strong id="accountEmail">—</strong>
            <div class="account-badges"><span>{C.freePlan}</span><span class="active-badge"><i></i> {C.unlimitedSearches}</span></div>
          </div>
          <a href={settingsHref} aria-label={C.manageAccount}>→</a>
        </article>

        <article class="metric-card">
          <span class="metric-icon purple"><svg viewBox="0 0 24 24" fill="none"><circle cx="11" cy="11" r="7"/><path d="m16 16 4 4M8 11h6M11 8v6"/></svg></span>
          <div><span>{C.totalSearches}</span><strong id="totalSearches">0</strong><small id="searchMix">{C.noActivity}</small></div>
        </article>
        <article class="metric-card">
          <span class="metric-icon pink"><svg viewBox="0 0 24 24" fill="none"><path d="M4 5h16v14H4zM8 9h8M8 13h5"/><circle cx="17.5" cy="15.5" r="2.5"/></svg></span>
          <div><span>{C.loadedMatches}</span><strong id="totalMatches">0</strong><small>{C.acrossLoaded}</small></div>
        </article>
        <article class="metric-card">
          <span class="metric-icon green"><svg viewBox="0 0 24 24" fill="none"><path d="M4 19V9M10 19V5M16 19v-7M22 19H2"/></svg></span>
          <div><span>{C.loadedWeek}</span><strong id="weeklySearches">0</strong><small id="lastActivity">{C.withinLoaded}</small></div>
        </article>
      </section>

      <section class="quick-start-section">
        <div class="section-heading-row">
          <div><span class="section-kicker">{C.quickStart}</span><h2>{C.whatFind}</h2></div>
          <span class="section-note">{C.allUnlimited}</span>
        </div>
        <div class="tool-grid">
          <a href={homeHref} class="tool-card featured">
            <span class="tool-icon"><svg viewBox="0 0 24 24" fill="none"><path d="M12 16V4m0 0L7.5 8.5M12 4l4.5 4.5M5 14v5h14v-5"/></svg></span>
            <div><span class="tool-status live"><i></i> {C.allIndexes}</span><h3>{C.searchEverywhere}</h3><p>{C.searchEverywhereSub}</p></div><b>→</b>
          </a>
          <a href={finderHref} class="tool-card">
            <span class="tool-icon heart"><svg viewBox="0 0 24 24" fill="none"><path d="M20.8 4.6a5.4 5.4 0 0 0-7.7 0L12 5.7l-1.1-1.1a5.4 5.4 0 0 0-7.7 7.7L12 21l8.8-8.7a5.4 5.4 0 0 0 0-7.7Z"/></svg></span>
            <div><span class="tool-status live"><i></i> {C.live}</span><h3>{C.ofFinder}</h3><p>{C.ofFinderSub}</p></div><b>→</b>
          </a>
          <a href={pornstarHref} class="tool-card">
            <span class="tool-icon video"><svg viewBox="0 0 24 24" fill="none"><rect x="3" y="5" width="18" height="14" rx="3"/><path d="m10 9 5 3-5 3Z"/></svg></span>
            <div><span class="tool-status beta">{C.beta}</span><h3>{C.psFinder}</h3><p>{C.psFinderSub}</p></div><b>→</b>
          </a>
          <a href={searchHref} class="tool-card">
            <span class="tool-icon search"><svg viewBox="0 0 24 24" fill="none"><circle cx="10.5" cy="10.5" r="6.5"/><path d="m15.5 15.5 5 5"/></svg></span>
            <div><span class="tool-status">{C.directory}</span><h3>{C.searchByName}</h3><p>{C.searchByNameSub}</p></div><b>→</b>
          </a>
        </div>
      </section>

      <div class="workspace-grid">
        <section class="activity-panel">
          <div class="activity-head">
            <div><span class="section-kicker">{C.yourActivity}</span><h2>{C.searchHistory} <span id="historyTotalBadge">0</span></h2><p>{C.savedPrivately} <span id="historyLoadSummary">{C.loadingHistory}</span></p></div>
            <div class="activity-actions">
              <button type="button" id="exportHistoryBtn" class="icon-button" title={C.exportTitle} disabled>
                <svg viewBox="0 0 24 24" fill="none"><path d="M12 4v11m0 0 4-4m-4 4-4-4M5 18v2h14v-2"/></svg><span>{C.exportLoaded}</span>
              </button>
              <button type="button" id="clearHistoryBtn" class="icon-button danger-action" title={C.clearTitle} disabled>
                <svg viewBox="0 0 24 24" fill="none"><path d="M4 7h16M9 7V4h6v3M7 7l1 13h8l1-13M10 11v5M14 11v5"/></svg><span>{C.clear}</span>
              </button>
            </div>
          </div>

          <div class="activity-toolbar">
            <div class="history-tabs" role="tablist" aria-label={C.filterAria}>
              <button class="history-tab active" type="button" data-filter="all">{C.all} <span id="allTabCount">0</span></button>
              <button class="history-tab" type="button" data-filter="directory">{C.names} <span id="directoryTabCount">0</span></button>
              <button class="history-tab" type="button" data-filter="onlyfans">{C.creatorFace} <span id="creatorTabCount">0</span></button>
              <button class="history-tab" type="button" data-filter="pornstar">{C.videoFace} <span id="videoTabCount">0</span></button>
            </div>
            <label class="history-search">
              <svg viewBox="0 0 24 24" fill="none"><circle cx="10.5" cy="10.5" r="6.5"/><path d="m15.5 15.5 5 5"/></svg>
              <input type="search" id="historySearch" placeholder={C.searchHistoryPlaceholder} autocomplete="off" />
            </label>
          </div>

          <div class="history-list" id="historyList"></div>
          <button class="history-load-more" id="historyLoadMore" type="button" hidden>{C.loadOlder}</button>
          <div class="history-empty" id="historyEmpty">
            <span><svg viewBox="0 0 24 24" fill="none"><circle cx="11" cy="11" r="7"/><path d="m16 16 4 4M8 11h6"/></svg></span>
            <h3 id="emptyTitle">{C.emptyTitle}</h3>
            <p id="emptyMessage">{C.emptyMessage}</p>
            <a href={homeHref} class="primary-button">{C.startFirst} <span>→</span></a>
          </div>
        </section>

        <aside class="dashboard-sidebar">
          <section class="side-card usage-card">
            <div class="side-card-head"><span class="side-icon"><svg viewBox="0 0 24 24" fill="none"><path d="M4 19V9M10 19V5M16 19v-7M22 19H2"/></svg></span><div><span>{C.toolUsage}</span><strong>{C.searchMix}</strong></div></div>
            <div class="usage-bar"><span id="creatorUsageBar"></span><span id="videoUsageBar"></span></div>
            <div class="usage-legend"><span><i class="creator-dot"></i>{C.creatorSearches} <b id="creatorUsageValue">0%</b></span><span><i class="video-dot"></i>{C.videoSearches} <b id="videoUsageValue">0%</b></span></div>
          </section>

          <section class="side-card privacy-card">
            <div class="privacy-status"><i></i><span>{C.privateWorkspace}</span></div>
            <h3>{C.photosNeverSaved}</h3>
            <p>{C.privacyBody}</p>
            <div class="privacy-links"><a href={settingsHref}>{C.manageSaved} <span>→</span></a><a href={privacyHref}>{C.readPrivacy} <span>→</span></a></div>
          </section>

          <section class="side-card tips-card">
            <span class="section-kicker">{C.betterResults}</span><h3>{C.photoChecklist}</h3>
            <ul><li><span>✓</span>{C.check1}</li><li><span>✓</span>{C.check2}</li><li><span>✓</span>{C.check3}</li><li><span>✓</span>{C.check4}</li></ul>
            <a href={`${finderHref}#how-it-works`}>{C.seeHow}</a>
          </section>
        </aside>
      </div>
    </div>

    <div class="dashboard-toast" id="dashboardToast" role="status" aria-live="polite" hidden>
      <span id="toastMessage">{C.toastDefault}</span>
    </div>
  </section>
</Base>

<script type="application/json" id="i18nDashboardPage" set:html={JSON.stringify(CLIENT)} />

<script>
  import {
    clearAccountSearchHistoryForOwner,
    currentAccountId,
    deleteAccountSearchHistoryForOwner,
    importBrowserHistoryToAccountForOwner,
    loadAccountSearchHistoryForOwner,
    scopedSearchHistoryKey,
  } from '../../lib/accountSearchHistory';

  const T = JSON.parse(document.getElementById('i18nDashboardPage').textContent);
  const fmtT = (s, v = {}) => String(s).replace(/\{(\w+)\}/g, (_, k) => String(v[k] ?? ''));

  const CREATOR_HISTORY_KEY = 'fbf_history';
  const VIDEO_HISTORY_KEY = 'fbf_pornstar_history';
  let creatorHistory = [];
  let videoHistory = [];
  let directoryHistory = [];
  let activeFilter = 'all';
  let historyQuery = '';
  let toastTimer;
  let accountHistoryOffset = 0;
  let accountHistoryTotal = 0;
  let accountHistoryHasMore = false;
  let accountHistoryLoading = false;
  let accountHistoryMutation = false;
  let initialHistorySyncComplete = false;
  let dashboardAccountId = null;
  const expandedEntries = new Set();

  function escapeHtml(value) {
    return String(value ?? '').replace(/[&<>"']/g, character => ({ '&': '&amp;', '<': '&lt;', '>': '&gt;', '"': '&quot;', "'": '&#39;' }[character]));
  }

  function proxyImg(url, width, height) {
    if (!url) return '/no-image.png';
    const value = String(url);
    if (value.startsWith('/') && !value.startsWith('//')) return value;
    const safe = safeHttpUrl(value);
    return safe
      ? `https://images.weserv.nl/?url=${encodeURIComponent(safe.replace(/^https?:\/\//, ''))}&w=${width}&h=${height}&fit=cover&output=webp`
      : '/no-image.png';
  }

  function safeHttpUrl(value) {
    try {
      const url = new URL(String(value));
      return url.protocol === 'https:' || url.protocol === 'http:' ? url.toString() : null;
    } catch {
      return null;
    }
  }

  function relativeTime(iso) {
    const timestamp = new Date(iso).getTime();
    if (!Number.isFinite(timestamp)) return T.unknownDate;
    const minutes = Math.max(0, Math.floor((Date.now() - timestamp) / 60000));
    if (minutes < 1) return T.justNow;
    if (minutes < 60) return fmtT(T.minAgo, { n: minutes });
    const hours = Math.floor(minutes / 60);
    if (hours < 24) return fmtT(hours === 1 ? T.hourAgo : T.hoursAgo, { n: hours });
    const days = Math.floor(hours / 24);
    if (days < 7) return fmtT(days === 1 ? T.dayAgo : T.daysAgo, { n: days });
    return new Date(iso).toLocaleDateString(T.dateLocale, { month: 'short', day: 'numeric', year: 'numeric' });
  }

  function exactDate(iso) {
    const date = new Date(iso);
    return Number.isFinite(date.getTime())
      ? date.toLocaleString(T.dateLocale, { month: 'short', day: 'numeric', year: 'numeric', hour: 'numeric', minute: '2-digit' })
      : T.unknownDate;
  }

  function duration(value) {
    if (!value || value < 0) return '';
    const total = Math.round(value);
    const hours = Math.floor(total / 3600);
    const minutes = Math.floor((total % 3600) / 60);
    const seconds = total % 60;
    return hours ? `${hours}:${String(minutes).padStart(2, '0')}:${String(seconds).padStart(2, '0')}` : `${minutes}:${String(seconds).padStart(2, '0')}`;
  }

  function readArray(key) {
    try {
      const value = JSON.parse(localStorage.getItem(key) || '[]');
      return Array.isArray(value) ? value : [];
    } catch { return []; }
  }

  function combinedHistory() {
    return [
      ...directoryHistory.map((entry, index) => ({ ...entry, source: 'directory', key: `directory-${entry.id || entry.clientSearchId || index}` })),
      ...creatorHistory.map((entry, index) => ({ ...entry, source: 'onlyfans', key: `onlyfans-${entry.id || entry.date || index}` })),
      ...videoHistory.map((entry, index) => ({ ...entry, source: 'pornstar', key: `pornstar-${entry.id || entry.date || index}` })),
    ].sort((a, b) => new Date(b.date || 0).getTime() - new Date(a.date || 0).getTime());
  }

  function historyControlsLocked() {
    return !initialHistorySyncComplete || accountHistoryLoading || accountHistoryMutation;
  }

  function syncHistoryControls() {
    const locked = historyControlsLocked();
    const clearButton = document.getElementById('clearHistoryBtn');
    const exportButton = document.getElementById('exportHistoryBtn');
    const loadMore = document.getElementById('historyLoadMore');
    if (clearButton instanceof HTMLButtonElement) clearButton.disabled = locked;
    if (exportButton instanceof HTMLButtonElement) exportButton.disabled = locked;
    if (loadMore instanceof HTMLButtonElement) {
      loadMore.disabled = locked;
      loadMore.hidden = !accountHistoryHasMore;
    }
    document.querySelectorAll('.delete-entry').forEach(button => {
      if (button instanceof HTMLButtonElement) button.disabled = locked || !button.getAttribute('data-delete-id');
    });
  }

  function mapAccountItem(item) {
    const source = item.searchType === 'directory'
      ? 'directory'
      : item.searchType === 'creator_face' ? 'onlyfans' : 'pornstar';
    const filters = item.filters && typeof item.filters === 'object' ? { ...item.filters } : {};
    return {
      id: item.id,
      clientSearchId: item.clientSearchId,
      source,
      query: item.query || '',
      label: item.label || item.query || (source === 'onlyfans' ? T.creatorFaceSearch : T.pornstarFaceSearch),
      count: Number(item.resultCount || 0),
      date: item.createdAt,
      results: Array.isArray(item.results) ? item.results : [],
      filters,
      indexedVideos: Number(filters.indexedVideos || 0),
      elapsedSeconds: Number(filters.elapsedSeconds || 0),
    };
  }

  async function loadAccountHistory(append = false) {
    if (accountHistoryLoading || accountHistoryMutation) return false;
    accountHistoryLoading = true;
    const loadMore = document.getElementById('historyLoadMore');
    loadMore.textContent = T.loading;
    syncHistoryControls();
    const requestOffset = append ? accountHistoryOffset : 0;
    try {
      const page = await loadAccountSearchHistoryForOwner(dashboardAccountId, { limit: 50, offset: requestOffset });
      if (!page) {
        showToast(T.syncFailed);
        return false;
      }
      const mapped = page.items.map(mapAccountItem);
      const existing = append ? combinedHistory() : [];
      const byId = new Map(existing.filter(entry => entry.id).map(entry => [entry.id, entry]));
      mapped.forEach(entry => byId.set(entry.id, entry));
      const accountEntries = Array.from(byId.values());
      directoryHistory = accountEntries.filter(entry => entry.source === 'directory');
      creatorHistory = accountEntries.filter(entry => entry.source === 'onlyfans');
      videoHistory = accountEntries.filter(entry => entry.source === 'pornstar');
      accountHistoryTotal = Math.max(0, Number(page.total || 0));
      accountHistoryOffset = Number(page.nextOffset ?? requestOffset + page.items.length);
      accountHistoryHasMore = Boolean(page.hasMore);
      renderHistory();
      return true;
    } catch {
      showToast(T.syncFailed);
      return false;
    } finally {
      accountHistoryLoading = false;
      loadMore.textContent = T.loadOlder;
      syncHistoryControls();
    }
  }

  function renderCreatorResults(results) {
    if (!results.length) return `<p class="preview-unavailable">${escapeHtml(T.noSavedPreview)}</p>`;
    // No display cap — creator_face history stores the FULL result set of a search (up
    // to ~103 entries) and the whole point of keeping it is being able to revisit it.
    // The grid only renders when a row is expanded and every img is loading=lazy.
    return `<div class="saved-result-grid creator-result-grid">${results.map((result, index) => {
      const image = proxyImg(result.avatar, 220, 293);
      const priceValue = result.subscribePrice ?? result.subscribeprice;
      const isFree = !priceValue || Number.isNaN(Number(priceValue));
      const price = isFree ? T.free : `$${Number(priceValue).toFixed(2)}`;
      const profileUrl = safeHttpUrl(result.profileUrl)
        || `https://onlyfans.com/${encodeURIComponent(result.username || '')}`;
      return `<a class="saved-creator-card" href="${escapeHtml(profileUrl)}" target="_blank" rel="noopener nofollow">
        <span class="saved-media"><img src="${escapeHtml(image)}" alt="" loading="lazy" decoding="async" referrerpolicy="no-referrer" onerror="this.onerror=null;this.src='/no-image.png';"><b>#${index + 1}</b>${result.matchPct ? `<em>${fmtT(T.matchPct, { n: Number(result.matchPct) })}</em>` : ''}</span>
        <span class="saved-card-body"><strong>${escapeHtml(result.name || result.username || T.creator)}</strong><small class="${isFree ? 'free-price' : ''}">${price}</small></span>
      </a>`;
    }).join('')}</div>`;
  }

  function renderVideoResults(results) {
    if (!results.length) return `<p class="preview-unavailable">${escapeHtml(T.noSavedPreview)}</p>`;
    return `<div class="saved-result-grid video-result-grid">${results.slice(0, 10).map((result, index) => {
      const href = safeHttpUrl(result.sourceUrl) || '';
      const match = Math.round(Math.max(0, Math.min(1, Number(result.similarity || 0))) * 100);
      const videoDuration = duration(Number(result.durationSeconds || 0));
      const thumbnail = safeHttpUrl(result.thumbnailUrl);
      const tag = href ? 'a' : 'div';
      const link = href ? ` href="${escapeHtml(href)}" target="_blank" rel="noopener nofollow"` : '';
      return `<${tag} class="saved-video-card"${link}><span class="saved-video-media">${thumbnail ? `<img src="${escapeHtml(thumbnail)}" alt="" loading="lazy" referrerpolicy="origin">` : ''}<b>#${index + 1}</b>${videoDuration ? `<small>${videoDuration}</small>` : ''}<em>${fmtT(T.matchPct, { n: match })}</em></span><strong>${escapeHtml(result.title || T.videoMatch)}</strong></${tag}>`;
    }).join('')}</div>`;
  }

  function historyPreview(entry) {
    if (entry.source === 'directory') return `<span class="preview-placeholder">${escapeHtml(T.searchAgain)}</span>`;
    const results = Array.isArray(entry.results) ? entry.results : [];
    if (!results.length) return `<span class="preview-placeholder">${escapeHtml(T.noPreview)}</span>`;
    if (entry.source === 'onlyfans') {
      return `<span class="preview-stack">${results.slice(0, 3).map(result => `<img src="${escapeHtml(proxyImg(result.avatar, 72, 72))}" alt="" loading="lazy" referrerpolicy="no-referrer" onerror="this.src='/no-image.png'">`).join('')}</span>`;
    }
    return `<span class="preview-stack video-preview-stack">${results.slice(0, 3).map(result => {
      const thumbnail = safeHttpUrl(result.thumbnailUrl);
      return thumbnail ? `<img src="${escapeHtml(thumbnail)}" alt="" loading="lazy" referrerpolicy="origin">` : '<span></span>';
    }).join('')}</span>`;
  }

  function directoryRerunUrl(entry) {
    const params = new URLSearchParams();
    const filters = entry.filters && typeof entry.filters === 'object' ? entry.filters : {};
    params.set('q', String(entry.query || entry.label || ''));
    params.set('history', '1');
    if (filters.verified === true || filters.verified === 'true') params.set('verified', 'true');
    if (typeof filters.price === 'string' && filters.price) params.set('price', filters.price);
    if (typeof filters.sort === 'string' && filters.sort) params.set('sort', filters.sort);
    if (filters.bundles === true || filters.bundles === 'true') params.set('bundles', 'true');
    return `${T.rerunBase}?${params.toString()}`;
  }

  function renderHistoryEntry(entry) {
    const isDirectory = entry.source === 'directory';
    const isCreator = entry.source === 'onlyfans';
    const results = Array.isArray(entry.results) ? entry.results : [];
    const open = expandedEntries.has(entry.key);
    const sourceLabel = isDirectory ? T.nameSearch : isCreator ? T.creatorFace : T.videoFace;
    const title = isDirectory ? (entry.query || entry.label || T.creatorSearch) : isCreator ? (entry.label || T.creatorFaceSearch) : T.pornstarFaceSearch;
    const detail = isDirectory
      ? `<a class="rerun-directory-search" href="${escapeHtml(directoryRerunUrl(entry))}">${escapeHtml(fmtT(T.searchForAgain, { q: entry.query || entry.label || '' }))}</a>`
      : isCreator ? renderCreatorResults(results) : renderVideoResults(results);
    return `<article class="history-entry ${open ? 'open' : ''}" data-key="${escapeHtml(entry.key)}">
      <div class="history-row">
        <button class="history-expand" type="button" data-expand="${escapeHtml(entry.key)}" aria-expanded="${open}">
          <span class="history-source-icon ${isCreator || isDirectory ? 'creator' : 'video'}">${isCreator || isDirectory
            ? '<svg viewBox="0 0 24 24" fill="none"><path d="M20.8 4.6a5.4 5.4 0 0 0-7.7 0L12 5.7l-1.1-1.1a5.4 5.4 0 0 0-7.7 7.7L12 21l8.8-8.7a5.4 5.4 0 0 0 0-7.7Z"/></svg>'
            : '<svg viewBox="0 0 24 24" fill="none"><rect x="3" y="5" width="18" height="14" rx="3"/><path d="m10 9 5 3-5 3Z"/></svg>'}</span>
          <span class="history-main"><span class="history-title-line"><strong>${escapeHtml(title)}</strong><i class="source-chip ${isCreator || isDirectory ? 'creator' : 'video'}">${sourceLabel}</i></span><span class="history-meta"><time title="${escapeHtml(exactDate(entry.date))}">${relativeTime(entry.date)}</time><i></i><span>${Number(entry.count || 0).toLocaleString()} ${Number(entry.count || 0) === 1 ? T.matchOne : T.matchMany}</span>${!isCreator && !isDirectory && entry.elapsedSeconds ? `<i></i><span>${Number(entry.elapsedSeconds).toFixed(1)}s</span>` : ''}</span></span>
          ${historyPreview(entry)}
          <span class="expand-chevron"><svg viewBox="0 0 24 24" fill="none"><path d="m7 9 5 5 5-5"/></svg></span>
        </button>
        <button class="delete-entry" type="button" data-delete-id="${escapeHtml(entry.id || '')}" title="${escapeHtml(T.removeItem)}" aria-label="${escapeHtml(T.removeItem)}" ${historyControlsLocked() || !entry.id ? 'disabled' : ''}><svg viewBox="0 0 24 24" fill="none"><path d="M4 7h16M9 7V4h6v3M7 7l1 13h8l1-13M10 11v5M14 11v5"/></svg></button>
      </div>
      <div class="history-details" ${open ? '' : 'hidden'}><div class="history-details-head"><span>${escapeHtml(T.savedPreview)}</span><small>${results.length ? escapeHtml(fmtT(T.showingTop, { n: Math.min(results.length, 10) })) : escapeHtml(T.previewUnavailable)}</small></div>${detail}</div>
    </article>`;
  }

  function updateOverview() {
    const entries = combinedHistory();
    const loadedCount = entries.length;
    const totalSearchCount = initialHistorySyncComplete ? accountHistoryTotal : loadedCount;
    const totalMatches = entries.reduce((sum, entry) => sum + Number(entry.count || 0), 0);
    const weekAgo = Date.now() - 7 * 24 * 60 * 60 * 1000;
    const weekly = entries.filter(entry => new Date(entry.date || 0).getTime() >= weekAgo).length;
    document.getElementById('totalSearches').textContent = totalSearchCount.toLocaleString();
    document.getElementById('totalMatches').textContent = totalMatches.toLocaleString();
    document.getElementById('weeklySearches').textContent = weekly.toLocaleString();
    document.getElementById('searchMix').textContent = loadedCount ? fmtT(T.mixLoaded, { d: directoryHistory.length, c: creatorHistory.length, v: videoHistory.length }) : T.noActivity;
    document.getElementById('lastActivity').textContent = loadedCount ? fmtT(T.latestLoaded, { t: relativeTime(entries[0].date) }) : T.noLoadedActivity;
    document.getElementById('historyTotalBadge').textContent = totalSearchCount.toLocaleString();
    document.getElementById('allTabCount').textContent = totalSearchCount.toLocaleString();
    document.getElementById('directoryTabCount').textContent = directoryHistory.length.toLocaleString();
    document.getElementById('creatorTabCount').textContent = creatorHistory.length.toLocaleString();
    document.getElementById('videoTabCount').textContent = videoHistory.length.toLocaleString();
    document.getElementById('directoryTabCount').title = T.loadedNameTitle;
    document.getElementById('creatorTabCount').title = T.loadedCreatorTitle;
    document.getElementById('videoTabCount').title = T.loadedVideoTitle;
    const loadSummary = document.getElementById('historyLoadSummary');
    loadSummary.textContent = !initialHistorySyncComplete
      ? T.loadingHistory
      : loadedCount < accountHistoryTotal
        ? fmtT(T.loadedOfTotal, { a: loadedCount.toLocaleString(), b: accountHistoryTotal.toLocaleString() })
        : fmtT(T.allLoaded, { n: accountHistoryTotal.toLocaleString() });
    const creatorPercent = loadedCount ? Math.round(((directoryHistory.length + creatorHistory.length) / loadedCount) * 100) : 0;
    const videoPercent = entries.length ? 100 - creatorPercent : 0;
    document.getElementById('creatorUsageBar').style.width = `${creatorPercent}%`;
    document.getElementById('videoUsageBar').style.width = `${videoPercent}%`;
    document.getElementById('creatorUsageValue').textContent = `${creatorPercent}%`;
    document.getElementById('videoUsageValue').textContent = `${videoPercent}%`;
  }

  function renderHistory() {
    const allEntries = combinedHistory();
    const visibleEntries = allEntries.filter(entry => {
      if (activeFilter !== 'all' && entry.source !== activeFilter) return false;
      if (!historyQuery) return true;
      const searchable = `${entry.query || ''} ${entry.label || ''} ${entry.source === 'directory' ? 'name directory' : entry.source === 'onlyfans' ? 'creator onlyfans face' : 'pornstar video face'} ${exactDate(entry.date)}`.toLowerCase();
      return searchable.includes(historyQuery);
    });
    const list = document.getElementById('historyList');
    const empty = document.getElementById('historyEmpty');
    list.innerHTML = visibleEntries.map(renderHistoryEntry).join('');
    list.hidden = visibleEntries.length === 0;
    empty.hidden = visibleEntries.length > 0;
    if (allEntries.length && !visibleEntries.length) {
      document.getElementById('emptyTitle').textContent = T.noMatchingHistory;
      document.getElementById('emptyMessage').textContent = T.tryAnotherKeyword;
    } else {
      document.getElementById('emptyTitle').textContent = T.emptyTitle;
      document.getElementById('emptyMessage').textContent = T.emptyMessage;
    }
    updateOverview();
    syncHistoryControls();
  }

  function showToast(message) {
    const toast = document.getElementById('dashboardToast');
    document.getElementById('toastMessage').textContent = message;
    toast.hidden = false;
    window.clearTimeout(toastTimer);
    toastTimer = window.setTimeout(() => { toast.hidden = true; }, 5000);
  }

  function findHistoryEntryById(id) {
    for (const collection of [directoryHistory, creatorHistory, videoHistory]) {
      const index = collection.findIndex(entry => entry.id === id);
      if (index >= 0) return { collection, index, entry: collection[index] };
    }
    return null;
  }

  async function deleteHistoryEntry(id) {
    if (!id || historyControlsLocked()) return;
    const match = findHistoryEntryById(id);
    if (!match) return;

    accountHistoryMutation = true;
    const [removed] = match.collection.splice(match.index, 1);
    accountHistoryTotal = Math.max(0, accountHistoryTotal - 1);
    accountHistoryOffset = Math.max(0, accountHistoryOffset - 1);
    accountHistoryHasMore = accountHistoryOffset < accountHistoryTotal;
    expandedEntries.delete(`directory-${id}`);
    expandedEntries.delete(`onlyfans-${id}`);
    expandedEntries.delete(`pornstar-${id}`);
    renderHistory();

    try {
      const deleted = await deleteAccountSearchHistoryForOwner(dashboardAccountId, id);
      if (!deleted) {
        match.collection.splice(Math.min(match.index, match.collection.length), 0, removed);
        accountHistoryTotal += 1;
        accountHistoryOffset += 1;
        accountHistoryHasMore = accountHistoryOffset < accountHistoryTotal;
        showToast(T.removeFailed);
      } else {
        showToast(T.removed);
      }
    } catch {
      match.collection.splice(Math.min(match.index, match.collection.length), 0, removed);
      accountHistoryTotal += 1;
      accountHistoryOffset += 1;
      accountHistoryHasMore = accountHistoryOffset < accountHistoryTotal;
      showToast(T.removeFailed);
    } finally {
      accountHistoryMutation = false;
      renderHistory();
    }
  }

  function initDashboard() {
    let user = null;
    try { user = JSON.parse(localStorage.getItem('fbf_user') || 'null'); } catch { /* noop */ }
    const gate = document.getElementById('dashGate');
    const main = document.getElementById('dashMain');
    if (!user) {
      let pendingEmail = null;
      try { pendingEmail = localStorage.getItem('fbf_pending_email'); } catch { /* noop */ }
      const pendingCookie = document.cookie.split(';').some(value => value.trim() === 'fbf_pending_signup=1');
      const pendingStatus = new URLSearchParams(window.location.search).get('status') === 'pending' || pendingCookie;
      if (pendingEmail || pendingStatus) {
        document.getElementById('gateTitle').textContent = T.confirmEmail;
        document.getElementById('gateMessage').textContent = pendingEmail
          ? fmtT(T.sentLinkTo, { email: pendingEmail })
          : T.openLink;
        const gateButton = document.getElementById('gateButton');
        gateButton.textContent = T.verifiedContinue;
        gateButton.href = T.loginPendingHref;
        const secondary = document.getElementById('gateSecondary');
        secondary.hidden = false;
        secondary.addEventListener('click', () => {
          localStorage.removeItem('fbf_pending_email');
          document.cookie = 'fbf_pending_signup=; Path=/; Max-Age=0; SameSite=Lax; Secure';
        });
      }
      gate.hidden = false;
      main.hidden = true;
      return;
    }

    gate.hidden = true;
    main.hidden = false;
    dashboardAccountId = currentAccountId();
    if (!dashboardAccountId || dashboardAccountId !== user.id) {
      localStorage.removeItem('fbf_user');
      window.location.reload();
      return;
    }
    creatorHistory = readArray(scopedSearchHistoryKey(CREATOR_HISTORY_KEY));
    videoHistory = readArray(scopedSearchHistoryKey(VIDEO_HISTORY_KEY));
    const displayName = String(user.name || user.email || T.there);
    const firstName = displayName.includes('@') ? displayName.split('@')[0] : displayName.split(' ')[0];
    const hour = new Date().getHours();
    document.getElementById('greeting').textContent = hour < 12 ? T.goodMorning : hour < 18 ? T.goodAfternoon : T.goodEvening;
    document.getElementById('dashName').textContent = firstName;
    document.getElementById('accountEmail').textContent = user.email || T.signedInUser;
    const avatar = document.getElementById('accountAvatar');
    if (user.avatar) avatar.innerHTML = `<img src="${escapeHtml(user.avatar)}" alt="" referrerpolicy="no-referrer">`;
    else avatar.textContent = firstName.charAt(0).toUpperCase();
    renderHistory();
    void (async () => {
      try {
        await importBrowserHistoryToAccountForOwner(dashboardAccountId);
      } catch {
        showToast(T.importFailed);
      }
      const synced = await loadAccountHistory(false);
      initialHistorySyncComplete = synced;
      renderHistory();
    })();

    document.querySelectorAll('.history-tab').forEach(button => button.addEventListener('click', () => {
      activeFilter = button.getAttribute('data-filter') || 'all';
      document.querySelectorAll('.history-tab').forEach(tab => tab.classList.toggle('active', tab === button));
      renderHistory();
    }));
    document.getElementById('historySearch').addEventListener('input', event => {
      historyQuery = event.currentTarget.value.trim().toLowerCase();
      renderHistory();
    });
    document.getElementById('historyList').addEventListener('click', event => {
      const target = event.target instanceof Element ? event.target : null;
      const deleteButton = target?.closest('[data-delete-id]');
      if (deleteButton instanceof HTMLButtonElement) {
        if (deleteButton.disabled) return;
        void deleteHistoryEntry(deleteButton.getAttribute('data-delete-id'));
        return;
      }
      const expandButton = target?.closest('[data-expand]');
      if (!expandButton) return;
      const key = expandButton.getAttribute('data-expand');
      if (expandedEntries.has(key)) expandedEntries.delete(key); else expandedEntries.add(key);
      renderHistory();
      requestAnimationFrame(() => document.querySelector(`[data-key="${CSS.escape(key)}"]`)?.scrollIntoView({ behavior: 'smooth', block: 'nearest' }));
    });
    document.getElementById('exportHistoryBtn').addEventListener('click', () => {
      if (historyControlsLocked()) return;
      const payload = {
        exportedAt: new Date().toISOString(),
        scope: 'loaded-history',
        loadedCount: combinedHistory().length,
        accountTotal: accountHistoryTotal,
        directorySearches: directoryHistory,
        creatorSearches: creatorHistory,
        videoSearches: videoHistory,
      };
      const blob = new Blob([JSON.stringify(payload, null, 2)], { type: 'application/json' });
      const url = URL.createObjectURL(blob);
      const link = document.createElement('a');
      link.href = url;
      link.download = `findbyface-history-${new Date().toISOString().slice(0, 10)}.json`;
      link.click();
      URL.revokeObjectURL(url);
      showToast(T.exportDownloaded);
    });
    document.getElementById('clearHistoryBtn').addEventListener('click', async () => {
      if (historyControlsLocked()) return;
      if (!window.confirm(T.confirmClear)) return;
      accountHistoryMutation = true;
      syncHistoryControls();
      try {
        if (!(await clearAccountSearchHistoryForOwner(dashboardAccountId))) {
          showToast(T.clearFailed);
          return;
        }
        directoryHistory = [];
        creatorHistory = [];
        videoHistory = [];
        localStorage.removeItem(scopedSearchHistoryKey('fbf_search_queries'));
        localStorage.removeItem(scopedSearchHistoryKey(CREATOR_HISTORY_KEY));
        localStorage.removeItem(scopedSearchHistoryKey(VIDEO_HISTORY_KEY));
        accountHistoryOffset = 0;
        accountHistoryTotal = 0;
        accountHistoryHasMore = false;
        expandedEntries.clear();
        showToast(T.cleared);
      } catch {
        showToast(T.clearFailed);
      } finally {
        accountHistoryMutation = false;
        renderHistory();
      }
    });
    document.getElementById('historyLoadMore').addEventListener('click', () => void loadAccountHistory(true));

    window.addEventListener('storage', event => {
      if (event.key === 'fbf_user' && currentAccountId() !== dashboardAccountId) {
        window.location.reload();
      }
    });
  }

  initDashboard();
</script>

