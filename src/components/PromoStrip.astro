---
// Site-wide promo strip, sits directly under the sticky header (see Base.astro).
// The number shown is the REAL live count of $0-subscription creators from the
// database — deliberately not a fabricated "N people viewing right now" figure,
// per the no-invented-stats rule in TOOLS-REFERENCE.md. If the count can't be
// fetched, the strip still renders with copy that needs no number.
// Dismissal is remembered in localStorage so it doesn't nag on every page.
import { localeOf, localizePath } from '../i18n/routes';
import { fetchFreeCreatorCount } from '../lib/creatorFetch';

const lang = localeOf(Astro.url.pathname);
const freeHref = lang === 'es' ? '/es/categorias/gratis/' : '/categories/free/';
const isOnFreePage = Astro.url.pathname.replace(/\/$/, '') === freeHref.replace(/\/$/, '');

const count = isOnFreePage ? null : await fetchFreeCreatorCount();
const countLabel = count ? count.toLocaleString(lang === 'es' ? 'es' : 'en') : null;

const copy = lang === 'es'
  ? {
      withCount: `${countLabel} creadoras de OnlyFans gratis ahora mismo`,
      noCount: 'Explora creadoras de OnlyFans totalmente gratis',
      cta: 'Ver gratis',
      dismiss: 'Cerrar aviso',
    }
  : {
      withCount: `${countLabel} free OnlyFans creators available right now`,
      noCount: 'Browse OnlyFans creators that are completely free',
      cta: 'Browse free',
      dismiss: 'Dismiss',
    };
---

{!isOnFreePage && (
  <div class="promo-strip" id="promoStrip" hidden data-promo-key="free-v1">
    <div class="promo-inner">
      <span class="promo-dot" aria-hidden="true"></span>
      <p class="promo-text">{countLabel ? copy.withCount : copy.noCount}</p>
      <a class="promo-cta" href={freeHref}>
        {copy.cta}
        <svg width="13" height="13" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.6" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><line x1="5" y1="12" x2="19" y2="12"/><polyline points="12 5 19 12 12 19"/></svg>
      </a>
      <button type="button" class="promo-close" id="promoClose" aria-label={copy.dismiss}>
        <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.4" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><line x1="18" y1="6" x2="6" y2="18"/><line x1="6" y1="6" x2="18" y2="18"/></svg>
      </button>
    </div>
  </div>
)}

<script>
  // Rendered hidden and revealed here, so a previously-dismissed strip never
  // flashes in before JS can hide it.
  const strip = document.getElementById('promoStrip');
  if (strip) {
    const key = `fbf_promo_dismissed_${strip.dataset.promoKey}`;
    let dismissed = false;
    try { dismissed = localStorage.getItem(key) === '1'; } catch { /* private mode */ }

    if (!dismissed) {
      strip.hidden = false;
      document.body.classList.add('has-promo-strip');
    }

    document.getElementById('promoClose')?.addEventListener('click', () => {
      strip.hidden = true;
      document.body.classList.remove('has-promo-strip');
      try { localStorage.setItem(key, '1'); } catch { /* private mode */ }
    });
  }
</script>

<style>
  .promo-strip {
    position: fixed;
    top: 64px;
    left: 0;
    right: 0;
    z-index: 99; /* just under .nav (100) so the mobile menu overlays it */
    border-bottom: 1px solid var(--border);
    background:
      linear-gradient(90deg, rgba(124,58,237,0.16), rgba(236,72,153,0.14)),
      rgba(10,10,15,0.92);
    -webkit-backdrop-filter: blur(12px);
    backdrop-filter: blur(12px);
  }
  .promo-strip[hidden] { display: none; }

  .promo-inner {
    position: relative;
    max-width: 1200px;
    margin: 0 auto;
    padding: 4px 20px;
    display: flex;
    align-items: center;
    justify-content: center;
    gap: 9px;
  }

  .promo-dot {
    width: 6px;
    height: 6px;
    flex-shrink: 0;
    border-radius: 50%;
    background: var(--success);
    box-shadow: 0 0 0 0 rgba(34,197,94,0.55);
    animation: promoPulse 2.4s ease-out infinite;
  }
  @keyframes promoPulse {
    0%   { box-shadow: 0 0 0 0 rgba(34,197,94,0.5); }
    70%  { box-shadow: 0 0 0 6px rgba(34,197,94,0); }
    100% { box-shadow: 0 0 0 0 rgba(34,197,94,0); }
  }

  .promo-text {
    font-size: 12px;
    font-weight: 600;
    color: var(--text);
    line-height: 1.3;
  }

  .promo-cta {
    display: inline-flex;
    align-items: center;
    gap: 4px;
    flex-shrink: 0;
    padding: 2px 10px;
    border-radius: 999px;
    background: linear-gradient(135deg, var(--accent), var(--accent-pink));
    color: #fff;
    font-size: 11.5px;
    font-weight: 700;
    white-space: nowrap;
    box-shadow: 0 2px 9px rgba(124,58,237,0.26);
    transition: transform 0.18s, box-shadow 0.18s, filter 0.18s;
  }
  .promo-cta:hover {
    transform: translateY(-1px);
    filter: brightness(1.07);
    box-shadow: 0 4px 12px rgba(124,58,237,0.4);
  }
  .promo-cta svg { width: 11px; height: 11px; }

  .promo-close {
    position: absolute;
    right: 12px;
    display: grid;
    place-items: center;
    width: 20px;
    height: 20px;
    padding: 0;
    border: none;
    border-radius: 50%;
    background: transparent;
    color: var(--text-muted);
    cursor: pointer;
    transition: color 0.18s, background 0.18s;
  }
  .promo-close:hover { color: var(--text); background: rgba(255,255,255,0.07); }
  .promo-close svg { width: 12px; height: 12px; }

  @media (max-width: 760px) {
    .promo-inner { gap: 7px; padding: 4px 34px 4px 14px; }
    .promo-text { font-size: 11.5px; }
    .promo-cta { padding: 2px 9px; font-size: 11px; }
    .promo-close { right: 6px; }
  }
  @media (max-width: 420px) {
    .promo-text { font-size: 11px; }
  }
</style>
