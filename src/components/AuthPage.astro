---
import Base from '../layouts/Base.astro';
import { localeOf } from '../i18n/routes';
import { absUrl } from '../lib/site';

interface Props {
  mode: 'login' | 'signup';
}

const { mode } = Astro.props;
const isSignup = mode === 'signup';
const lang = localeOf(Astro.url.pathname);
const langPrefix = lang === 'es' ? '/es' : '';

const enC = {
  pageTitle: isSignup ? 'Sign up — findbyface' : 'Log in — findbyface',
  pageDesc: isSignup ? 'Create a free findbyface account.' : 'Log in to your findbyface account.',
  title: isSignup ? 'Create your free account' : 'Welcome back',
  subtitle: isSignup
    ? 'Use any email address to unlock unlimited searches and keep your history.'
    : 'Use your email and password, or choose the optional Google shortcut.',
  email: 'Email address',
  emailPlaceholder: 'you@example.com',
  password: 'Password',
  passwordPlaceholder: isSignup ? 'At least 8 characters' : 'Enter your password',
  show: 'Show',
  showPassword: 'Show password',
  confirmPassword: 'Confirm password',
  confirmPlaceholder: 'Repeat your password',
  submit: isSignup ? 'Create account' : 'Log in',
  verifyTitle: 'Verify your email address',
  sentLinkTo: 'We sent a confirmation link to',
  openEmail: 'Open that email and click the verification link to activate your account. If it is not in your inbox, check your spam or junk folder.',
  verifiedLogin: 'I’ve verified my email — log in',
  useDifferentEmail: 'Use a different email address',
  verificationNote: 'Email verification is required before your first login.',
  orGoogle: 'or use Google (optional)',
  continueGoogle: 'Continue with Google',
  switchQuestion: isSignup ? 'Already have an account?' : 'New to findbyface?',
  switchCta: isSignup ? 'Log in' : 'Create one free',
  legalHtml: `By continuing, you agree to our <a href="/terms-of-use/">Terms</a> and <a href="/privacy-policy/">Privacy Policy</a>.`,
};

const esC: typeof enC = {
  pageTitle: isSignup ? 'Registrarse — findbyface' : 'Iniciar sesión — findbyface',
  pageDesc: isSignup ? 'Crea una cuenta gratis de findbyface.' : 'Inicia sesión en tu cuenta de findbyface.',
  title: isSignup ? 'Crea tu cuenta gratis' : 'Bienvenido de nuevo',
  subtitle: isSignup
    ? 'Usa cualquier correo para desbloquear búsquedas ilimitadas y guardar tu historial.'
    : 'Usa tu correo y contraseña, o elige el atajo opcional de Google.',
  email: 'Correo electrónico',
  emailPlaceholder: 'tu@ejemplo.com',
  password: 'Contraseña',
  passwordPlaceholder: isSignup ? 'Mínimo 8 caracteres' : 'Ingresa tu contraseña',
  show: 'Mostrar',
  showPassword: 'Mostrar contraseña',
  confirmPassword: 'Confirmar contraseña',
  confirmPlaceholder: 'Repite tu contraseña',
  submit: isSignup ? 'Crear cuenta' : 'Iniciar sesión',
  verifyTitle: 'Verifica tu correo electrónico',
  sentLinkTo: 'Enviamos un enlace de confirmación a',
  openEmail: 'Abre ese correo y haz clic en el enlace de verificación para activar tu cuenta. Si no está en tu bandeja de entrada, revisa la carpeta de spam.',
  verifiedLogin: 'Ya verifiqué mi correo — iniciar sesión',
  useDifferentEmail: 'Usar otro correo electrónico',
  verificationNote: 'Se requiere verificar el correo antes de tu primer inicio de sesión.',
  orGoogle: 'o usa Google (opcional)',
  continueGoogle: 'Continuar con Google',
  switchQuestion: isSignup ? '¿Ya tienes una cuenta?' : '¿Nuevo en findbyface?',
  switchCta: isSignup ? 'Iniciar sesión' : 'Crea una gratis',
  legalHtml: `Al continuar, aceptas nuestros <a href="/es/terminos-de-uso/">Términos</a> y nuestra <a href="/es/politica-de-privacidad/">Política de Privacidad</a>.`,
};

const C = lang === 'es' ? esC : enC;

// Strings + locale plumbing for the define:vars client script below.
const enClient = {
  checkInbox: 'Check your inbox',
  confirmToActivate: 'Confirm your email address to activate your FindByFace account.',
  emailYouEntered: 'the email address you entered',
  show: 'Show',
  hide: 'Hide',
  showPassword: 'Show password',
  hidePassword: 'Hide password',
  verifiedFinish: 'Email verified. Log in with your email and password to finish.',
  openVerificationFirst: 'Open the verification email first, then log in here.',
  confirmationFailed: 'That verification link could not be completed. Try logging in, or return to signup for a fresh link.',
  enterBoth: 'Enter your email and password.',
  passwordTooShort: 'Use at least 8 characters for your password.',
  passwordsMismatch: 'Your passwords do not match.',
  creatingAccount: 'Creating account…',
  loggingIn: 'Logging in…',
  rateLimited: 'Our confirmation-email service has reached its temporary sending limit. Use Google sign-in now, or try email signup again later.',
  authFailed: 'Authentication failed.',
  verifyThenLogin: 'Verify your email using the link we sent, then try logging in again.',
  submit: enC.submit,
};

const esClient: typeof enClient = {
  checkInbox: 'Revisa tu bandeja de entrada',
  confirmToActivate: 'Confirma tu correo para activar tu cuenta de FindByFace.',
  emailYouEntered: 'el correo que ingresaste',
  show: 'Mostrar',
  hide: 'Ocultar',
  showPassword: 'Mostrar contraseña',
  hidePassword: 'Ocultar contraseña',
  verifiedFinish: 'Correo verificado. Inicia sesión con tu correo y contraseña para terminar.',
  openVerificationFirst: 'Abre primero el correo de verificación y luego inicia sesión aquí.',
  confirmationFailed: 'Ese enlace de verificación no se pudo completar. Intenta iniciar sesión o vuelve al registro para recibir un enlace nuevo.',
  enterBoth: 'Ingresa tu correo y contraseña.',
  passwordTooShort: 'Usa al menos 8 caracteres en tu contraseña.',
  passwordsMismatch: 'Tus contraseñas no coinciden.',
  creatingAccount: 'Creando cuenta…',
  loggingIn: 'Iniciando sesión…',
  rateLimited: 'Nuestro servicio de correos de confirmación alcanzó su límite temporal de envío. Usa Google ahora o intenta el registro por correo más tarde.',
  authFailed: 'La autenticación falló.',
  verifyThenLogin: 'Verifica tu correo con el enlace que enviamos y luego intenta iniciar sesión de nuevo.',
  submit: esC.submit,
};

const CLIENT = lang === 'es' ? esClient : enClient;
---

<Base
  title={C.pageTitle}
  description={C.pageDesc}
  canonical={absUrl(`${langPrefix}/${mode}/`)}
  robots="noindex,follow"
>
  <main class="auth-page">
    <div class="auth-glow auth-glow-one"></div>
    <div class="auth-glow auth-glow-two"></div>

    <section class="auth-shell" aria-labelledby="authTitle">
      <div class="auth-brand" aria-hidden="true">
        <span class="auth-brand-find">find</span><span>byface</span>
      </div>

      <div class="auth-card" id="authCard">
        <header class="auth-card-head">
          <span class={`auth-heading-icon ${isSignup ? 'signup' : ''}`}>
            {isSignup ? (
              <svg viewBox="0 0 24 24" fill="none"><path d="M15 19v-1.5a4 4 0 0 0-4-4H6a4 4 0 0 0-4 4V19M8.5 9.5a3.5 3.5 0 1 0 0-7 3.5 3.5 0 0 0 0 7ZM18 8v6M15 11h6" /></svg>
            ) : (
              <svg viewBox="0 0 24 24" fill="none"><path d="M10 17l5-5-5-5M15 12H3M14 3h5a2 2 0 0 1 2 2v14a2 2 0 0 1-2 2h-5" /></svg>
            )}
          </span>
          <div>
            <h1 id="authTitle">{C.title}</h1>
            <p id="authSubtitle">{C.subtitle}</p>
          </div>
        </header>

        <form class="auth-form" id="authForm" novalidate>
          <label>
            <span>{C.email}</span>
            <span class="auth-input-wrap">
              <svg viewBox="0 0 24 24" fill="none" aria-hidden="true"><path d="M4 5h16v14H4zM4 7l8 6 8-6" /></svg>
              <input id="authEmail" name="email" type="email" inputmode="email" autocomplete="email" placeholder={C.emailPlaceholder} required />
            </span>
          </label>

          <label>
            <span>{C.password}</span>
            <span class="auth-input-wrap">
              <svg viewBox="0 0 24 24" fill="none" aria-hidden="true"><rect x="5" y="10" width="14" height="11" rx="2" /><path d="M8 10V7a4 4 0 0 1 8 0v3" /></svg>
              <input id="authPassword" name="password" type="password" autocomplete={isSignup ? 'new-password' : 'current-password'} placeholder={C.passwordPlaceholder} minlength="8" required />
              <button class="password-toggle" id="passwordToggle" type="button" aria-label={C.showPassword}>{C.show}</button>
            </span>
          </label>

          {isSignup && (
            <label>
              <span>{C.confirmPassword}</span>
              <span class="auth-input-wrap">
                <svg viewBox="0 0 24 24" fill="none" aria-hidden="true"><path d="m5 12 4 4L19 6" /></svg>
                <input id="authConfirm" name="confirmPassword" type="password" autocomplete="new-password" placeholder={C.confirmPlaceholder} minlength="8" required />
              </span>
            </label>
          )}

          <div class="auth-message" id="authMessage" role="alert" hidden></div>

          <button class="auth-submit" id="authSubmit" type="submit">
            <span>{C.submit}</span>
            <svg viewBox="0 0 24 24" fill="none" aria-hidden="true"><path d="M5 12h14M13 6l6 6-6 6" /></svg>
          </button>
        </form>

        {isSignup && (
          <div class="auth-confirmation" id="authConfirmation" role="status" hidden>
            <span class="confirmation-icon" aria-hidden="true">
              <svg viewBox="0 0 24 24" fill="none"><path d="M4 5h16v14H4zM4 7l8 6 8-6" /><path d="m8.5 15 2 2 4.5-5" /></svg>
            </span>
            <h2>{C.verifyTitle}</h2>
            <p>{C.sentLinkTo} <strong id="confirmationEmail"></strong>.</p>
            <p>{C.openEmail}</p>
            <a class="confirmation-login" id="confirmationLogin" href={`${langPrefix}/login/?status=pending&next=${langPrefix}/dashboard/`}>{C.verifiedLogin}</a>
            <a class="confirmation-restart" href={`${langPrefix}/signup/`} id="confirmationRestart">{C.useDifferentEmail}</a>
          </div>
        )}

        {isSignup && (
          <div class="verification-note">
            <svg viewBox="0 0 24 24" fill="none" aria-hidden="true"><circle cx="12" cy="12" r="9" /><path d="M12 10v6M12 7h.01" /></svg>
            <span>{C.verificationNote}</span>
          </div>
        )}

        <div class="auth-divider"><span>{C.orGoogle}</span></div>

        <a class="google-auth" id="googleAuth" href="#">
          <span class="google-g" aria-hidden="true">G</span>
          {C.continueGoogle}
        </a>

        <p class="auth-switch">
          {C.switchQuestion}
          <a id="authSwitchLink" href={`${langPrefix}${isSignup ? '/login/' : '/signup/'}`}>{C.switchCta}</a>
        </p>
      </div>

      <p class="auth-legal" set:html={C.legalHtml} />
    </section>
  </main>
</Base>

<script define:vars={{ mode, T: CLIENT, langPrefix }}>
  const form = document.getElementById('authForm');
  const email = document.getElementById('authEmail');
  const password = document.getElementById('authPassword');
  const confirm = document.getElementById('authConfirm');
  const submit = document.getElementById('authSubmit');
  const message = document.getElementById('authMessage');
  const toggle = document.getElementById('passwordToggle');
  const google = document.getElementById('googleAuth');
  const card = document.getElementById('authCard');
  const title = document.getElementById('authTitle');
  const subtitle = document.getElementById('authSubtitle');
  const confirmationPanel = document.getElementById('authConfirmation');
  const confirmationEmail = document.getElementById('confirmationEmail');
  const confirmationLogin = document.getElementById('confirmationLogin');
  const confirmationRestart = document.getElementById('confirmationRestart');
  const authSwitchLink = document.getElementById('authSwitchLink');

  const safePath = value => value && value.startsWith('/') && !value.startsWith('//') ? value : `${langPrefix}/dashboard/`;
  const queryReturn = new URLSearchParams(window.location.search).get('next');
  let storedReturn = null;
  let pendingEmail = null;
  try {
    storedReturn = localStorage.getItem('fbf_auth_return');
    pendingEmail = localStorage.getItem('fbf_pending_email');
  } catch { /* private storage may be unavailable */ }
  const returnTo = safePath(queryReturn || storedReturn);

  try { localStorage.setItem('fbf_auth_return', returnTo); } catch { /* noop */ }
  const encodedReturn = encodeURIComponent(returnTo);
  if (authSwitchLink) authSwitchLink.href = `${langPrefix}${mode === 'signup' ? '/login/' : '/signup/'}?next=${encodedReturn}`;
  if (confirmationLogin) confirmationLogin.href = `${langPrefix}/login/?status=pending&next=${encodedReturn}`;
  if (confirmationRestart) confirmationRestart.href = `${langPrefix}/signup/?next=${encodedReturn}`;
  if (mode === 'login' && pendingEmail) email.value = pendingEmail;
  const callbackUrl = `${window.location.origin}/auth/callback`;
  google.href = `https://sirudrqheimbgpkchtwi.supabase.co/auth/v1/authorize?provider=google&redirect_to=${encodeURIComponent(callbackUrl)}`;

  function showPendingConfirmation(emailAddress) {
    if (mode !== 'signup' || !confirmationPanel) return;
    card.classList.add('confirmed');
    title.textContent = T.checkInbox;
    subtitle.textContent = T.confirmToActivate;
    confirmationEmail.textContent = emailAddress || T.emailYouEntered;
    confirmationPanel.hidden = false;
  }

  if (mode === 'signup' && new URLSearchParams(window.location.search).get('status') === 'pending') {
    showPendingConfirmation(pendingEmail);
  }

  confirmationRestart?.addEventListener('click', () => {
    try { localStorage.removeItem('fbf_pending_email'); } catch { /* noop */ }
    document.cookie = 'fbf_pending_signup=; Path=/; Max-Age=0; SameSite=Lax; Secure';
  });

  toggle.addEventListener('click', () => {
    const reveal = password.type === 'password';
    password.type = reveal ? 'text' : 'password';
    if (confirm) confirm.type = reveal ? 'text' : 'password';
    toggle.textContent = reveal ? T.hide : T.show;
    toggle.setAttribute('aria-label', reveal ? T.hidePassword : T.showPassword);
  });

  function showMessage(text, kind = 'error') {
    message.textContent = text;
    message.dataset.kind = kind;
    message.hidden = false;
  }

  function storeSession(payload) {
    localStorage.setItem('fbf_user', JSON.stringify({
      ...payload.user,
      access_token: payload.access_token,
      refresh_token: payload.refresh_token,
      expires_at: Date.now() + Number(payload.expires_in || 3600) * 1000,
    }));
    localStorage.removeItem('fbf_pornstar_guest_search_day');
    localStorage.removeItem('fbf_auth_return');
    localStorage.removeItem('fbf_pending_email');
    document.cookie = 'fbf_pending_signup=; Path=/; Max-Age=0; SameSite=Lax; Secure';
  }

  const pageStatus = new URLSearchParams(window.location.search).get('status');
  if (mode === 'login' && pageStatus === 'verified') {
    showMessage(T.verifiedFinish, 'success');
  } else if (mode === 'login' && pageStatus === 'pending') {
    showMessage(T.openVerificationFirst, 'success');
  } else if (mode === 'login' && pageStatus === 'confirmation_failed') {
    showMessage(T.confirmationFailed);
  }

  form.addEventListener('submit', async event => {
    event.preventDefault();
    message.hidden = true;
    const emailValue = email.value.trim();
    const passwordValue = password.value;

    if (!emailValue || !passwordValue) {
      showMessage(T.enterBoth);
      return;
    }
    if (mode === 'signup' && passwordValue.length < 8) {
      showMessage(T.passwordTooShort);
      return;
    }
    if (mode === 'signup' && confirm?.value !== passwordValue) {
      showMessage(T.passwordsMismatch);
      return;
    }

    submit.disabled = true;
    submit.classList.add('loading');
    submit.querySelector('span').textContent = mode === 'signup' ? T.creatingAccount : T.loggingIn;
    try {
      const response = await fetch(`/api/auth/${mode === 'signup' ? 'register' : 'login'}`, {
        method: 'POST',
        headers: { 'Content-Type': 'application/json' },
        body: JSON.stringify({ email: emailValue, password: passwordValue }),
      });
      const payload = await response.json();
      if (!response.ok) {
        if (payload.code === 'email_rate_limited') {
          showMessage(T.rateLimited);
          google?.focus();
          return;
        }
        throw new Error(payload.error || T.authFailed);
      }

      // Email/password registration always requires the user-facing verification step.
      // Do not treat a session-shaped signup response like a completed login.
      if (mode === 'signup') {
        try { localStorage.setItem('fbf_pending_email', emailValue); } catch { /* query status is the fallback */ }
        history.replaceState(null, '', `${langPrefix}/signup/?status=pending&next=${encodedReturn}`);
        showPendingConfirmation(emailValue);
        return;
      }

      storeSession(payload);
      window.location.href = returnTo;
    } catch (error) {
      const errorText = error instanceof Error ? error.message : T.authFailed;
      showMessage(/email not confirmed/i.test(errorText)
        ? T.verifyThenLogin
        : errorText);
    } finally {
      submit.disabled = false;
      submit.classList.remove('loading');
      const text = submit.querySelector('span');
      if (text) text.textContent = T.submit;
    }
  });
</script>

<style>
  .auth-page {
    position: relative;
    display: grid;
    min-height: 100svh;
    overflow: hidden;
    place-items: center;
    padding: 104px 20px 48px;
    background: radial-gradient(circle at 50% 12%, rgba(124,58,237,0.12), transparent 34%), #09090f;
  }
  .auth-glow { position: absolute; width: 360px; height: 360px; border-radius: 50%; filter: blur(100px); opacity: .16; pointer-events: none; }
  .auth-glow-one { top: 8%; left: -160px; background: #7c3aed; }
  .auth-glow-two { right: -180px; bottom: 2%; background: #ec4899; }
  .auth-shell { position: relative; z-index: 1; width: min(410px, 100%); }
  .auth-brand { display: flex; justify-content: center; margin-bottom: 22px; font: 800 1.55rem/1 'Manrope', sans-serif; letter-spacing: -.04em; background: linear-gradient(135deg,#a78bfa,#ec4899); -webkit-background-clip: text; background-clip: text; color: transparent; }
  .auth-brand-find { color: #fff; -webkit-text-fill-color: #fff; }
  .auth-card { overflow: hidden; border: 1px solid rgba(148,163,184,.17); border-radius: 18px; background: rgba(20,20,30,.94); box-shadow: 0 28px 80px rgba(0,0,0,.44); backdrop-filter: blur(18px); }
  .auth-card-head { display: flex; gap: 13px; align-items: center; padding: 22px 22px 20px; border-bottom: 1px solid rgba(148,163,184,.12); }
  .auth-heading-icon { display: grid; width: 38px; height: 38px; flex: 0 0 auto; place-items: center; border-radius: 11px; background: linear-gradient(135deg,#7c3aed,#a855f7); box-shadow: 0 7px 20px rgba(124,58,237,.3); }
  .auth-heading-icon.signup { background: linear-gradient(135deg,#059669,#22c55e); box-shadow: 0 7px 20px rgba(34,197,94,.24); }
  .auth-heading-icon svg { width: 20px; stroke: #fff; stroke-width: 1.8; stroke-linecap: round; stroke-linejoin: round; }
  .auth-card-head h1 { font: 800 1.08rem/1.2 'Manrope', sans-serif; }
  .auth-card-head p { margin-top: 3px; color: #8e8ea7; font-size: 11.5px; line-height: 1.4; }
  .auth-form { display: flex; flex-direction: column; gap: 16px; padding: 21px 22px 4px; }
  .auth-form label > span:first-child { display: block; margin-bottom: 7px; color: #d9d9e5; font-size: 11.5px; font-weight: 700; }
  .auth-input-wrap { position: relative; display: flex; align-items: center; }
  .auth-input-wrap > svg { position: absolute; left: 12px; width: 17px; stroke: #71718a; stroke-width: 1.7; pointer-events: none; }
  .auth-input-wrap input { width: 100%; height: 46px; padding: 0 54px 0 39px; border: 1px solid rgba(148,163,184,.22); border-radius: 10px; outline: none; background: #1c2230; color: #f7f7fb; font: 500 13px/1 'Inter', sans-serif; transition: border-color .18s, box-shadow .18s, background .18s; }
  .auth-input-wrap input::placeholder { color: #666d82; }
  .auth-input-wrap input:focus { border-color: #8b5cf6; background: #1c2131; box-shadow: 0 0 0 3px rgba(124,58,237,.14); }
  .password-toggle { position: absolute; right: 8px; padding: 6px 7px; border: 0; background: transparent; color: #9f91d3; font: 700 10px/1 'Inter', sans-serif; cursor: pointer; }
  .auth-submit { display: flex; width: 100%; min-height: 46px; align-items: center; justify-content: center; gap: 8px; margin-top: 2px; border: 0; border-radius: 10px; background: linear-gradient(115deg,#7c3aed,#d946ef); box-shadow: 0 10px 28px rgba(124,58,237,.27); color: #fff; font: 800 13px/1 'Inter', sans-serif; cursor: pointer; transition: transform .18s, filter .18s, opacity .18s; }
  .auth-submit:hover:not(:disabled) { transform: translateY(-1px); filter: brightness(1.08); }
  .auth-submit:disabled { opacity: .65; cursor: wait; }
  .auth-submit svg { width: 17px; stroke: currentColor; stroke-width: 2; stroke-linecap: round; stroke-linejoin: round; }
  .auth-message { padding: 11px 12px; border: 1px solid rgba(248,113,113,.28); border-radius: 9px; background: rgba(127,29,29,.16); color: #fca5a5; font-size: 12px; line-height: 1.45; }
  .auth-message[data-kind='success'] { border-color: rgba(74,222,128,.28); background: rgba(20,83,45,.17); color: #86efac; }
  .auth-card.confirmed .auth-form,.auth-card.confirmed .verification-note,.auth-card.confirmed .auth-divider,.auth-card.confirmed .google-auth,.auth-card.confirmed .auth-switch { display: none; }
  .auth-confirmation { display: flex; flex-direction: column; align-items: center; gap: 13px; padding: 30px 24px 28px; text-align: center; }
  .auth-confirmation[hidden] { display: none; }
  .confirmation-icon { display: grid; width: 54px; height: 54px; place-items: center; border-radius: 50%; background: rgba(34,197,94,.14); color: #4ade80; box-shadow: 0 0 0 8px rgba(34,197,94,.05); }
  .confirmation-icon svg { width: 28px; stroke: currentColor; stroke-width: 1.7; stroke-linecap: round; stroke-linejoin: round; }
  .auth-confirmation h2 { margin-top: 4px; color: #f7f7fb; font: 800 1.25rem/1.25 'Manrope', sans-serif; }
  .auth-confirmation p { max-width: 340px; color: #a8a8bc; font-size: 12.5px; line-height: 1.6; }
  .auth-confirmation strong { color: #f1f1f7; overflow-wrap: anywhere; }
  .confirmation-login { width: 100%; margin-top: 7px; padding: 14px 16px; border-radius: 10px; background: linear-gradient(115deg,#7c3aed,#d946ef); color: #fff; font-size: 12.5px; font-weight: 800; box-shadow: 0 10px 28px rgba(124,58,237,.27); }
  .confirmation-restart { color: #a78bfa; font-size: 11.5px; font-weight: 700; }
  .verification-note { display: flex; gap: 9px; margin: 16px 22px 0; padding: 11px 12px; border: 1px solid rgba(96,165,250,.25); border-radius: 9px; background: rgba(30,64,175,.14); color: #93c5fd; font-size: 11px; line-height: 1.45; }
  .verification-note svg { width: 17px; flex: 0 0 auto; stroke: currentColor; stroke-width: 1.7; }
  .auth-divider { display: flex; align-items: center; gap: 12px; margin: 20px 22px 15px; color: #6f6f87; font-size: 10.5px; }
  .auth-divider::before,.auth-divider::after { content: ''; height: 1px; flex: 1; background: rgba(148,163,184,.16); }
  .google-auth { display: flex; height: 43px; align-items: center; justify-content: center; gap: 10px; margin: 0 22px; border: 1px solid rgba(148,163,184,.25); border-radius: 10px; color: #f3f3f8; font-size: 12.5px; font-weight: 700; transition: border-color .18s, background .18s; }
  .google-auth:hover { border-color: rgba(167,139,250,.58); background: rgba(124,58,237,.08); }
