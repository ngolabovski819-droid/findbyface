---
import { categories } from '../config/categories';

interface Props {
  activeSlug?: string;
}

const { activeSlug } = Astro.props;
---

<div class="chips-wrapper">
  <div class="chips">
    {categories.map(cat => (
      <a
        href={`/categories/${cat.slug}/`}
        class={`chip ${activeSlug === cat.slug ? 'chip-active' : ''}`}
      >
        {cat.emoji && <span class="chip-emoji" aria-hidden="true">{cat.emoji}</span>}
        <span class="chip-label">{cat.label}</span>
      </a>
    ))}
  </div>
</div>

<style>
  .chips-wrapper {
    overflow-x: auto;
    -ms-overflow-style: none;
    scrollbar-width: none;
    padding: 10px 0 14px;
    /* soft fade on both edges to hint scrollability */
    -webkit-mask-image: linear-gradient(to right, transparent, #000 32px, #000 calc(100% - 32px), transparent);
    mask-image: linear-gradient(to right, transparent, #000 32px, #000 calc(100% - 32px), transparent);
  }

  .chips-wrapper::-webkit-scrollbar { display: none; }

  .chips {
    display: flex;
    gap: 10px;
    min-width: max-content;
    padding: 0 32px;
  }

  .chip {
    position: relative;
    display: inline-flex;
    align-items: center;
    gap: 7px;
    padding: 9px 18px;
    background: linear-gradient(145deg, rgba(26,26,46,0.9), rgba(18,18,26,0.9));
    border: 1px solid var(--border);
    border-radius: 999px;
    font-size: 13.5px;
    font-weight: 600;
    color: var(--text-muted);
    white-space: nowrap;
    letter-spacing: 0.2px;
    cursor: pointer;
    -webkit-backdrop-filter: blur(8px);
    backdrop-filter: blur(8px);
    transition: transform 0.22s cubic-bezier(0.34,1.56,0.64,1),
                color 0.22s ease, border-color 0.22s ease, box-shadow 0.22s ease, background 0.22s ease;
  }

  .chip-emoji { font-size: 14px; line-height: 1; transition: transform 0.22s ease; }

  /* gradient ring that fades in on hover */
  .chip::before {
    content: '';
    position: absolute;
    inset: -1px;
    border-radius: 999px;
    padding: 1px;
    background: linear-gradient(135deg, var(--accent), var(--accent-pink));
    -webkit-mask: linear-gradient(#000 0 0) content-box, linear-gradient(#000 0 0);
    -webkit-mask-composite: xor;
    mask: linear-gradient(#000 0 0) content-box, linear-gradient(#000 0 0);
    mask-composite: exclude;
    opacity: 0;
    transition: opacity 0.22s ease;
    pointer-events: none;
  }

  .chip:hover {
    transform: translateY(-3px);
    color: var(--text);
    border-color: transparent;
    box-shadow: 0 10px 26px rgba(124,58,237,0.28);
  }

  .chip:hover::before { opacity: 1; }
  .chip:hover .chip-emoji { transform: scale(1.18) rotate(-6deg); }

  .chip-active {
    background: linear-gradient(135deg, var(--accent), var(--accent-pink));
    border-color: transparent;
    color: #fff;
    box-shadow: 0 8px 24px rgba(124,58,237,0.4);
  }

  .chip-active::before { opacity: 0; }
  .chip-active:hover { color: #fff; transform: translateY(-3px); }
</style>

