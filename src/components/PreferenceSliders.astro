---
// PreferenceSliders.astro
// Side panel for /ai-discover/. Renders all controls that map 1:1 to
// onlyfans_profiles.face_metrics. Emits state via a global window event
// 'fbf:preferences' on every change (debounced by the page).
//
// All numeric sliders output 0..1 so they slot directly into the search
// payload's `target` object.
---
<aside class="prefs">
  <div class="prefs-header">
    <h2>Build your ideal type</h2>
    <div class="preset-row" id="presetRow">
      <button type="button" data-preset="reset"   class="preset">Reset</button>
      <button type="button" data-preset="random"  class="preset">Random</button>
      <button type="button" data-preset="classic" class="preset">Classic</button>
      <button type="button" data-preset="athletic" class="preset">Athletic</button>
      <button type="button" data-preset="soft"    class="preset">Soft</button>
      <button type="button" data-preset="hunter"  class="preset">Hunter Green</button>
    </div>
  </div>

  <details class="group" open>
    <summary>Eyes</summary>

    <div class="field">
      <label>Eye color</label>
      <div class="swatch-grid" data-key="eyeColor">
        <button type="button" data-value="blue"         style="background:#4a78b8" title="Blue"></button>
        <button type="button" data-value="light-blue"   style="background:#9bc4e0" title="Light Blue"></button>
        <button type="button" data-value="green"        style="background:#5a8a4f" title="Green"></button>
        <button type="button" data-value="hunter-green" style="background:#3a5d3a" title="Hunter Green"></button>
        <button type="button" data-value="hazel"        style="background:#a08056" title="Hazel"></button>
        <button type="button" data-value="amber"        style="background:#c08a3e" title="Amber"></button>
        <button type="button" data-value="light-brown"  style="background:#a07248" title="Light Brown"></button>
        <button type="button" data-value="brown"        style="background:#7a5230" title="Brown"></button>
        <button type="button" data-value="dark-brown"   style="background:#4a311c" title="Dark Brown"></button>
        <button type="button" data-value="gray"         style="background:#8a8a92" title="Gray"></button>
        <button type="button" data-value="violet"       style="background:#7d5aa3" title="Violet"></button>
        <button type="button" data-value=""             class="any" title="Any">Any</button>
      </div>
    </div>

    <div class="field">
      <label>Eye shape</label>
      <div class="pill-row" data-key="eyeShape">
        <button type="button" data-value="">Any</button>
        <button type="button" data-value="almond">Almond</button>
        <button type="button" data-value="round">Round</button>
        <button type="button" data-value="upturned">Upturned</button>
        <button type="button" data-value="downturned">Downturned</button>
      </div>
    </div>

    <div class="field">
      <label>Eye spacing <span class="hint" id="hint-eyeSpacing">average</span></label>
      <input type="range" min="0" max="100" value="50" data-key="eyeSpacing" />
      <div class="scale"><span>Close</span><span>Wide</span></div>
    </div>

    <div class="field">
      <label>Canthal tilt <span class="hint" id="hint-canthalTilt">neutral</span></label>
      <input type="range" min="0" max="100" value="50" data-key="canthalTilt" />
      <div class="scale"><span>Negative</span><span>Positive</span></div>
    </div>
  </details>

  <details class="group">
    <summary>Brows, hair &amp; skin</summary>

    <div class="field">
      <label>Hair color</label>
      <div class="swatch-grid" data-key="hairColor">
        <button type="button" data-value="platinum"     style="background:#e8e0d2" title="Platinum"></button>
        <button type="button" data-value="blonde"       style="background:#d4b16a" title="Blonde"></button>
        <button type="button" data-value="dirty-blonde" style="background:#a4854c" title="Dirty Blonde"></button>
        <button type="button" data-value="light-brown"  style="background:#8a6a3e" title="Light Brown"></button>
        <button type="button" data-value="brown"        style="background:#5a3e22" title="Brown"></button>
        <button type="button" data-value="dark-brown"   style="background:#3a2812" title="Dark Brown"></button>
        <button type="button" data-value="black"        style="background:#15110d" title="Black"></button>
        <button type="button" data-value="auburn"       style="background:#7a3018" title="Auburn"></button>
        <button type="button" data-value="red"          style="background:#b53a1a" title="Red"></button>
        <button type="button" data-value="ginger"       style="background:#d46e2a" title="Ginger"></button>
        <button type="button" data-value="gray"         style="background:#9a9a9e" title="Gray"></button>
        <button type="button" data-value=""             class="any" title="Any">Any</button>
      </div>
    </div>

    <div class="field">
      <label>Hair texture</label>
      <div class="pill-row" data-key="hairTexture">
        <button type="button" data-value="">Any</button>
        <button type="button" data-value="straight">Straight</button>
        <button type="button" data-value="wavy">Wavy</button>
        <button type="button" data-value="curly">Curly</button>
        <button type="button" data-value="coily">Coily</button>
      </div>
    </div>

    <div class="field">
      <label>Skin tone <span class="hint" id="hint-skinTone">medium</span></label>
      <input type="range" min="0" max="100" value="50" data-key="skinTone" />
      <div class="scale"><span>Fair</span><span>Deep</span></div>
    </div>

    <div class="field">
      <label>Eyebrow density</label>
      <input type="range" min="0" max="100" value="50" data-key="eyebrowDensity" />
      <div class="scale"><span>Sparse</span><span>Thick</span></div>
    </div>

    <div class="field">
      <label>Eyebrow position</label>
      <input type="range" min="0" max="100" value="50" data-key="eyebrowPosition" />
      <div class="scale"><span>High</span><span>Low</span></div>
    </div>

    <div class="field">
      <label>Eyebrow tilt</label>
      <input type="range" min="0" max="100" value="50" data-key="eyebrowTilt" />
      <div class="scale"><span>Negative</span><span>Positive</span></div>
    </div>
  </details>

  <details class="group">
    <summary>Face geometry</summary>

    <div class="field">
      <label>Jaw width</label>
      <input type="range" min="0" max="100" value="50" data-key="jawWidth" />
      <div class="scale"><span>Narrow</span><span>Wide</span></div>
    </div>

    <div class="field">
      <label>Cheekbone prominence</label>
      <input type="range" min="0" max="100" value="50" data-key="cheekboneProminence" />
      <div class="scale"><span>Soft</span><span>Sharp</span></div>
    </div>

    <div class="field">
      <label>FWHR (face width-to-height)</label>
      <input type="range" min="0" max="100" value="50" data-key="fwhr" />
      <div class="scale"><span>Long</span><span>Wide</span></div>
    </div>

    <div class="field">
      <label>Midface ratio</label>
      <input type="range" min="0" max="100" value="50" data-key="midfaceRatio" />
      <div class="scale"><span>Short</span><span>Long</span></div>
    </div>

    <div class="field">
      <label>Lower-third width</label>
      <input type="range" min="0" max="100" value="50" data-key="lowerThirdWidth" />
      <div class="scale"><span>Narrow</span><span>Wide</span></div>
    </div>

    <div class="field">
      <label>Gonial angle</label>
      <input type="range" min="0" max="100" value="50" data-key="gonialAngle" />
      <div class="scale"><span>Sharp</span><span>Soft</span></div>
    </div>

    <div class="field">
      <label>Ramus length</label>
      <input type="range" min="0" max="100" value="50" data-key="ramusLength" />
      <div class="scale"><span>Short</span><span>Long</span></div>
    </div>

    <div class="field">
      <label>Chin projection</label>
      <input type="range" min="0" max="100" value="50" data-key="chinProjection" />
      <div class="scale"><span>Recessed</span><span>Strong</span></div>
    </div>

    <div class="field">
      <label>Brow ridge projection</label>
      <input type="range" min="0" max="100" value="50" data-key="browRidge" />
      <div class="scale"><span>Flat</span><span>Pronounced</span></div>
    </div>

    <div class="field">
      <label>Frankfurt-plane recession</label>
      <input type="range" min="0" max="100" value="50" data-key="frankfurtRecession" />
      <div class="scale"><span>Aligned</span><span>Recessed</span></div>
    </div>

    <div class="field">
      <label>Jawline visibility</label>
      <input type="range" min="0" max="100" value="50" data-key="jawlineVisibility" />
      <div class="scale"><span>Soft</span><span>Defined</span></div>
    </div>
  </details>

  <details class="group">
    <summary>Lips</summary>
    <div class="field">
      <label>Lip fullness</label>
      <input type="range" min="0" max="100" value="50" data-key="lipFullness" />
      <div class="scale"><span>Thin</span><span>Full</span></div>
    </div>

    <div class="field">
      <label>Vermillion ratio (upper / lower)</label>
      <input type="range" min="0" max="100" value="50" data-key="vermillionRatio" />
      <div class="scale"><span>Lower-heavy</span><span>Upper-heavy</span></div>
    </div>
  </details>

  <details class="group">
    <summary>Filters</summary>
    <div class="field inline">
      <label><input type="checkbox" data-filter="verified" /> Verified only</label>
    </div>
    <div class="field">
      <label>Max subscribe price</label>
      <div class="pill-row" data-filter="maxPrice">
        <button type="button" data-value="">Any</button>
        <button type="button" data-value="0">Free</button>
        <button type="button" data-value="5">≤ $5</button>
        <button type="button" data-value="10">≤ $10</button>
        <button type="button" data-value="20">≤ $20</button>
      </div>
    </div>
  </details>
</aside>

<style>
  .prefs {
    background: var(--surface);
    border: 1px solid var(--border);
    border-radius: var(--radius-lg);
    padding: 18px;
    max-height: calc(100vh - 96px);
    overflow-y: auto;
    position: sticky;
    top: 80px;
  }
  .prefs-header h2 {
    font-family: 'Manrope', sans-serif;
    font-size: 1.1rem;
    margin-bottom: 12px;
    background: linear-gradient(135deg, #7c3aed, #ec4899);
    -webkit-background-clip: text;
    -webkit-text-fill-color: transparent;
    background-clip: text;
  }
  .preset-row {
    display: flex; flex-wrap: wrap; gap: 6px;
    margin-bottom: 16px;
  }
  .preset {
    background: transparent;
    color: var(--text);
    border: 1px solid var(--border);
    border-radius: 999px;
    padding: 5px 12px;
    font-size: 12px;
    font-weight: 500;
    cursor: pointer;
    transition: all 0.15s;
  }
  .preset:hover {
    border-color: var(--accent);
    background: rgba(124,58,237,0.1);
  }

  .group {
    border-top: 1px solid var(--border);
    padding: 12px 0;
  }
  .group summary {
    font-family: 'Manrope', sans-serif;
    font-weight: 700;
    font-size: 14px;
    cursor: pointer;
    list-style: none;
    color: var(--text);
    padding: 4px 0;
    user-select: none;
  }
  .group summary::-webkit-details-marker { display: none; }
  .group summary::before { content: '▸'; margin-right: 8px; color: var(--accent); transition: transform 0.15s; display: inline-block; }
  .group[open] summary::before { transform: rotate(90deg); }

  .field { margin: 14px 0; }
  .field.inline label { display: flex; align-items: center; gap: 8px; cursor: pointer; }
  .field label {
    display: block;
    font-size: 12px;
    color: var(--text-muted);
    margin-bottom: 6px;
    text-transform: uppercase;
    letter-spacing: 0.05em;
  }
  .field .hint {
    font-style: italic;
    text-transform: none;
    letter-spacing: 0;
    color: var(--accent-light);
    margin-left: 6px;
  }

  input[type="range"] {
    width: 100%;
    -webkit-appearance: none;
    appearance: none;
    height: 4px;
    background: var(--border);
    border-radius: 2px;
    outline: none;
  }
  input[type="range"]::-webkit-slider-thumb {
    -webkit-appearance: none; appearance: none;
    width: 16px; height: 16px;
    background: linear-gradient(135deg, #7c3aed, #ec4899);
    border-radius: 50%;
    cursor: pointer;
    box-shadow: 0 0 0 2px var(--bg);
  }
  input[type="range"]::-moz-range-thumb {
    width: 16px; height: 16px;
    background: linear-gradient(135deg, #7c3aed, #ec4899);
    border-radius: 50%;
    cursor: pointer;
    border: 2px solid var(--bg);
  }

  .scale {
    display: flex; justify-content: space-between;
    font-size: 10px; color: var(--text-muted);
    margin-top: 4px; text-transform: uppercase;
  }

  .swatch-grid {
    display: grid;
    grid-template-columns: repeat(6, 1fr);
    gap: 6px;
  }
  .swatch-grid button {
    aspect-ratio: 1/1;
    border: 2px solid transparent;
    border-radius: 8px;
    cursor: pointer;
    padding: 0;
    font-size: 10px;
    color: #fff;
    text-shadow: 0 1px 2px rgba(0,0,0,0.6);
    transition: all 0.15s;
  }
  .swatch-grid button:hover { transform: scale(1.08); }
  .swatch-grid button.active {
    border-color: #fff;
    box-shadow: 0 0 0 2px var(--accent);
  }
  .swatch-grid button.any {
    background: var(--surface-raised) !important;
    border: 1px dashed var(--border);
    color: var(--text-muted);
  }

  .pill-row {
    display: flex; flex-wrap: wrap; gap: 6px;
  }
  .pill-row button {
    background: transparent;
    color: var(--text);
    border: 1px solid var(--border);
    border-radius: 999px;
    padding: 4px 12px;
    font-size: 12px;
    cursor: pointer;
    transition: all 0.15s;
  }
  .pill-row button:hover { border-color: var(--accent); }
  .pill-row button.active {
    background: var(--accent);
    border-color: var(--accent);
    color: #fff;
  }

  @media (max-width: 900px) {
    .prefs {
      position: static;
      max-height: none;
    }
  }
</style>
