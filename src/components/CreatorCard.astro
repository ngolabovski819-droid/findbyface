---
import { IMG_ONERROR, proxyImg } from '../utils/image';
import { creatorCardImages } from '../lib/creatorCardUi';
import { localeOf } from '../i18n/routes';
import { t } from '../i18n/ui';

interface Props {
  creator: {
    username: string;
    name?: string;
    avatar?: string;
    header?: string;
    subscribePrice?: number;
    subscribeprice?: number;
    isVerified?: boolean;
    isverified?: boolean;
    matchPct?: number;
    favoritedCount?: number;
    favoritedcount?: number;
    profileUrl?: string;
    sponsored?: boolean;
    tags?: string[];
    additionalTagCount?: number;
    galleryImages?: string[];
  };
  index: number;
}

const { creator, index } = Astro.props;
const name = creator.name || creator.username || 'Unknown';
const username = creator.username || '';
const avatar = creator.avatar || '';
const images = creatorCardImages(creator);
const price = creator.subscribePrice ?? creator.subscribeprice;
const isVerified = creator.isVerified ?? creator.isverified;
const matchPct = creator.matchPct;

const imgSrc = avatar?.startsWith('/')
  ? avatar
  : avatar?.startsWith('http')
    ? proxyImg(avatar, 320, 427)
    : '/no-image.png';
const imgSrcset = avatar?.startsWith('http')
  ? [144, 240, 320, 480].map(w => `${proxyImg(avatar, w, Math.round(w * 4 / 3))} ${w}w`).join(', ')
  : '';
const imgSizes = '(max-width:480px) 144px, (max-width:768px) 240px, 320px';

const lang = localeOf(Astro.url.pathname);
const priceIsFree = (!price || isNaN(Number(price)));
const priceLabel = priceIsFree ? t(lang, 'common.free') : `$${parseFloat(String(price)).toFixed(2)}`;
const profileUrl = creator.profileUrl || `https://onlyfans.com/${encodeURIComponent(username)}`;
// GOTCHA: never use rel="noreferrer" on a /go/ link — it zeroes out the Referer that
// route depends on for placement attribution. noopener + nofollow(+sponsored) instead.
const rel = profileUrl.startsWith('/go/') ? 'noopener nofollow sponsored' : 'noopener nofollow';
---

<div
  class="creator-card"
  data-href={profileUrl}
  data-card-username={username}
  data-card-images={JSON.stringify(images)}
  data-card-sponsored={creator.sponsored ? 'true' : 'false'}
  data-card-tags={JSON.stringify(creator.tags ?? [])}
  data-card-extra-tags={creator.additionalTagCount ?? 0}
  data-card-verified={isVerified ? 'true' : 'false'}
>
  <div class="card-img-wrap">
    <img
      src={imgSrc}
      srcset={imgSrcset || undefined}
      sizes={imgSrcset ? imgSizes : undefined}
      alt={`${name} OnlyFans creator`}
      loading={index === 0 ? 'eager' : 'lazy'}
      fetchpriority={index === 0 ? 'high' : undefined}
      decoding="async"
      referrerpolicy="no-referrer"
      data-raw={avatar?.startsWith('http') ? avatar : undefined}
      onerror={IMG_ONERROR}
    />
    {matchPct && <span class="match-badge"><strong>{matchPct}%</strong><span>match</span></span>}
  </div>
  <div class="card-body">
    <p class="creator-name">{name}</p>
    <p class="username">@{username}</p>
    <p class={`price ${priceIsFree ? 'price-free' : ''}`}>{priceLabel}</p>
    <a href={profileUrl} class="view-btn" target="_blank" rel={rel}>
      {t(lang, 'common.viewProfile')}
    </a>
  </div>
</div>

<style is:global>
  .creator-card {
    position: relative;
    background: var(--surface);
    border-radius: var(--radius-lg);
    overflow: hidden;
    border: 1px solid var(--border);
    transition: transform 0.28s cubic-bezier(0.22,1,0.36,1), box-shadow 0.28s ease, border-color 0.28s ease;
  }
  .creator-card[data-href] { cursor: pointer; }

  /* Gradient ring on hover */
  .creator-card::after {
    content: '';
    position: absolute; inset: 0;
    border-radius: var(--radius-lg);
    padding: 1px;
    background: linear-gradient(135deg, var(--accent), var(--accent-pink));
    -webkit-mask: linear-gradient(#fff 0 0) content-box, linear-gradient(#fff 0 0);
    -webkit-mask-composite: xor;
    mask-composite: exclude;
    opacity: 0;
    transition: opacity 0.28s ease;
    pointer-events: none;
  }

  .creator-card:hover {
    transform: translateY(-6px);
    box-shadow: 0 16px 40px rgba(124,58,237,0.28);
    border-color: transparent;
  }
  .creator-card:hover::after { opacity: 1; }

  .creator-card .card-img-wrap {
    aspect-ratio: 3/4;
    overflow: hidden;
    position: relative;
    background: var(--surface-raised);
  }

  .creator-card .card-img-wrap img {
    width: 100%; height: 100%;
    object-fit: cover; display: block;
    transition: transform 0.5s cubic-bezier(0.22,1,0.36,1);
  }
  .creator-card:hover .card-img-wrap img { transform: scale(1.06); }

  /* Bottom scrim for depth */
  .creator-card .card-img-wrap::after {
    content: '';
    position: absolute; left: 0; right: 0; bottom: 0;
    height: 45%;
    background: linear-gradient(to top, rgba(10,10,15,0.55), transparent);
    pointer-events: none;
  }

  .creator-card .match-badge {
    position: absolute; left: 10px; bottom: 10px;
    z-index: 2;
    display: inline-flex; align-items: center; gap: 5px;
    border: 1px solid rgba(255,255,255,0.24);
    background: linear-gradient(135deg, rgba(91,33,182,0.9), rgba(219,39,119,0.86));
    color: #fff;
    padding: 5px 9px; border-radius: 999px;
    box-shadow: 0 5px 18px rgba(46,16,101,0.42), inset 0 1px 0 rgba(255,255,255,0.16);
    backdrop-filter: blur(8px);
  }
  .creator-card .match-badge strong { font-size: 12px; font-weight: 900; line-height: 1; }
  .creator-card .match-badge span {
    color: rgba(255,255,255,0.82); font-size: 9px; font-weight: 700;
    line-height: 1; letter-spacing: 0.06em; text-transform: uppercase;
  }

  .creator-card .card-body { padding: 14px 15px 15px; }

  .creator-card .creator-name {
    font-family: 'Manrope', sans-serif;
    font-weight: 700;
    font-size: 14.5px;
    margin-bottom: 2px;
    display: flex; align-items: center; gap: 4px;
    white-space: nowrap; overflow: hidden; text-overflow: ellipsis;
  }

  .creator-card .username { color: var(--text-muted); font-size: 12px; margin-bottom: 10px; white-space: nowrap; overflow: hidden; text-overflow: ellipsis; }
  .creator-card .price { font-weight: 800; font-size: 15px; margin-bottom: 12px; color: var(--text-muted); }
  .creator-card .price-free { color: var(--success); }

  .creator-card .view-btn {
    display: block; text-align: center;
    background: linear-gradient(135deg, var(--accent), var(--accent-light));
    color: #fff;
    border-radius: 10px; padding: 9px;
    font-size: 13px; font-weight: 700;
    letter-spacing: 0.01em;
    box-shadow: 0 4px 14px rgba(124,58,237,0.25);
    transition: filter 0.2s, transform 0.2s, box-shadow 0.2s;
  }

  .creator-card .view-btn:hover {
    filter: brightness(1.08);
    transform: translateY(-1px);
    box-shadow: 0 6px 20px rgba(124,58,237,0.4);
  }
</style>
