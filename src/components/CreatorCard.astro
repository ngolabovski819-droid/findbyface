---
import { proxyImg } from '../utils/image';

interface Props {
  creator: {
    username: string;
    name?: string;
    avatar?: string;
    subscribePrice?: number;
    subscribeprice?: number;
    isVerified?: boolean;
    isverified?: boolean;
    matchPct?: number;
    favoritedCount?: number;
    favoritedcount?: number;
  };
  index: number;
}

const { creator, index } = Astro.props;
const name = creator.name || creator.username || 'Unknown';
const username = creator.username || '';
const avatar = creator.avatar || '';
const price = creator.subscribePrice ?? creator.subscribeprice;
const isVerified = creator.isVerified ?? creator.isverified;
const matchPct = creator.matchPct;

const imgSrc = avatar?.startsWith('http') ? proxyImg(avatar, 320, 427) : '/no-image.png';
const imgSrcset = avatar?.startsWith('http')
  ? [144, 240, 320, 480].map(w => `${proxyImg(avatar, w, Math.round(w * 4 / 3))} ${w}w`).join(', ')
  : '';
const imgSizes = '(max-width:480px) 144px, (max-width:768px) 240px, 320px';

const priceLabel = (!price || isNaN(Number(price))) ? 'FREE' : `$${parseFloat(String(price)).toFixed(2)}`;
const profileUrl = `https://onlyfans.com/${encodeURIComponent(username)}`;
---

<div class="creator-card">
  <div class="card-img-wrap">
    <img
      src={imgSrc}
      srcset={imgSrcset || undefined}
      sizes={imgSrcset ? imgSizes : undefined}
      alt={`${name} OnlyFans creator`}
      loading={index === 0 ? 'eager' : 'lazy'}
      fetchpriority={index === 0 ? 'high' : undefined}
      decoding="async"
      referrerpolicy="no-referrer"
      onerror="if(this.src!=='/no-image.png'){this.removeAttribute('srcset');this.src='/no-image.png';}"
    />
    {matchPct && <span class="match-badge">{matchPct}% match</span>}
  </div>
  <div class="card-body">
    <p class="creator-name">
      {isVerified && <span class="verified" title="Verified">✓</span>}{name}
    </p>
    <p class="username">@{username}</p>
    <p class={`price ${priceLabel === 'FREE' ? 'price-free' : ''}`}>{priceLabel}</p>
    <a href={profileUrl} class="view-btn" target="_blank" rel="noopener noreferrer">
      View Profile
    </a>
  </div>
</div>

<style is:global>
  .creator-card {
    position: relative;
    background: var(--surface);
    border-radius: var(--radius-lg);
    overflow: hidden;
    border: 1px solid var(--border);
    transition: transform 0.28s cubic-bezier(0.22,1,0.36,1), box-shadow 0.28s ease, border-color 0.28s ease;
  }

  /* Gradient ring on hover */
  .creator-card::after {
    content: '';
    position: absolute; inset: 0;
    border-radius: var(--radius-lg);
    padding: 1px;
    background: linear-gradient(135deg, var(--accent), var(--accent-pink));
    -webkit-mask: linear-gradient(#fff 0 0) content-box, linear-gradient(#fff 0 0);
    -webkit-mask-composite: xor;
    mask-composite: exclude;
    opacity: 0;
    transition: opacity 0.28s ease;
    pointer-events: none;
  }

  .creator-card:hover {
    transform: translateY(-6px);
    box-shadow: 0 16px 40px rgba(124,58,237,0.28);
    border-color: transparent;
  }
  .creator-card:hover::after { opacity: 1; }

  .creator-card .card-img-wrap {
    aspect-ratio: 3/4;
    overflow: hidden;
    position: relative;
    background: var(--surface-raised);
  }

  .creator-card .card-img-wrap img {
    width: 100%; height: 100%;
    object-fit: cover; display: block;
    transition: transform 0.5s cubic-bezier(0.22,1,0.36,1);
  }
  .creator-card:hover .card-img-wrap img { transform: scale(1.06); }

  /* Bottom scrim for depth */
  .creator-card .card-img-wrap::after {
    content: '';
    position: absolute; left: 0; right: 0; bottom: 0;
    height: 45%;
    background: linear-gradient(to top, rgba(10,10,15,0.55), transparent);
    pointer-events: none;
  }

  .creator-card .match-badge {
    position: absolute; top: 10px; right: 10px;
    z-index: 2;
    background: linear-gradient(135deg, var(--accent), var(--accent-pink));
    color: #fff;
    font-size: 11px; font-weight: 800;
    padding: 4px 10px; border-radius: 999px;
    letter-spacing: 0.02em;
    box-shadow: 0 4px 14px rgba(124,58,237,0.45);
  }

  .creator-card .card-body { padding: 14px 15px 15px; }

  .creator-card .creator-name {
    font-family: 'Syne', sans-serif;
    font-weight: 700;
    font-size: 14.5px;
    margin-bottom: 2px;
    display: flex; align-items: center; gap: 4px;
    white-space: nowrap; overflow: hidden; text-overflow: ellipsis;
  }

  .creator-card .verified {
    display: inline-flex; align-items: center; justify-content: center;
    width: 15px; height: 15px; flex: 0 0 15px;
    border-radius: 50%;
    background: linear-gradient(135deg, var(--accent), var(--accent-pink));
    color: #fff; font-size: 9px; font-weight: 900;
  }
  .creator-card .username { color: var(--text-muted); font-size: 12px; margin-bottom: 10px; white-space: nowrap; overflow: hidden; text-overflow: ellipsis; }
  .creator-card .price { font-weight: 800; font-size: 15px; margin-bottom: 12px; color: var(--text-muted); }
  .creator-card .price-free { color: var(--success); }

  .creator-card .view-btn {
    display: block; text-align: center;
    background: linear-gradient(135deg, var(--accent), var(--accent-light));
    color: #fff;
    border-radius: 10px; padding: 9px;
    font-size: 13px; font-weight: 700;
    letter-spacing: 0.01em;
    box-shadow: 0 4px 14px rgba(124,58,237,0.25);
    transition: filter 0.2s, transform 0.2s, box-shadow 0.2s;
  }

  .creator-card .view-btn:hover {
    filter: brightness(1.08);
    transform: translateY(-1px);
    box-shadow: 0 6px 20px rgba(124,58,237,0.4);
  }
</style>
