---
import { getCategoryContent } from '../config/categoryContent';

interface Props {
  slug: string; // always the ENGLISH slug
  locale: 'en' | 'es';
}

const { slug, locale } = Astro.props;
const entry = getCategoryContent(slug, locale);
---

{entry && (
  <div class="category-intro">
    {entry.intro.map(paragraph => <p>{paragraph}</p>)}
  </div>
)}

<style>
  .category-intro {
    max-width: 720px;
    margin: 0 auto 8px;
    text-align: center;
  }
  .category-intro p {
    color: var(--text-muted);
    font-size: 0.98rem;
    line-height: 1.65;
    margin: 0 0 10px;
  }
  .category-intro p:last-child { margin-bottom: 0; }
</style>
