---
// Small trust/attribution line shown alongside ranked-list headings (category pages,
// search results): who built the list, what ranks it, and how fresh it is.
// Date is computed at request time so it always reflects "today" on a live render;
// on edge-cached routes it reflects the moment of the last cache revalidation.
import { localeOf, localizePath } from '../i18n/routes';
import { t } from '../i18n/ui';

interface Props {
  // 'center' (default): standalone block under a heading, centered, own bottom margin.
  // 'left': inline item in a flex row (e.g. next to a Grid/Feed toggle) — no forced margin.
  align?: 'center' | 'left';
}
const { align = 'center' } = Astro.props;
const lang = localeOf(Astro.url.pathname);
const today = new Date().toLocaleDateString(lang === 'es' ? 'es' : 'en-US', { year: 'numeric', month: 'long', day: 'numeric' });
---

<p class={`rank-attribution rank-attribution-${align}`}>
  {t(lang, 'attribution.createdBy')} <a href={localizePath('/blog/author/nick/', lang)}>Nick</a>
  <span class="rank-attribution-sep" aria-hidden="true">·</span>
  {t(lang, 'attribution.rankedBy')} <a href={localizePath('/how-our-search-engine-works/', lang)}>FindRank</a>
  <span class="rank-attribution-sep" aria-hidden="true">·</span>
  {t(lang, 'attribution.noHumanReview')}
  <span class="rank-attribution-sep" aria-hidden="true">·</span>
  {t(lang, 'attribution.updated', { date: today })}
</p>

<style>
  .rank-attribution {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    gap: 6px;
    color: var(--text-muted);
    font-size: 12.5px;
  }

  .rank-attribution-center {
    justify-content: center;
    margin: 0 0 28px;
  }

  .rank-attribution-left {
    justify-content: flex-start;
    margin: 0;
  }

  .rank-attribution a {
    color: var(--text-muted);
    text-decoration: underline;
    text-decoration-color: var(--border);
    text-underline-offset: 2px;
    transition: color 0.2s;
  }

  .rank-attribution a:hover {
    color: var(--accent-light);
  }

  .rank-attribution-sep {
    color: var(--border);
  }
</style>
