---
import { getPublishedFinderComments } from '../lib/finderComments';
import { localeOf, staticRoutes } from '../i18n/routes';
import { absUrl } from '../lib/site';

export interface Props {
  finder: 'onlyfans' | 'pornstar';
}

type Outcome = 'found' | 'close' | 'not_yet';
type Finder = Props['finder'];

interface Story {
  id: string;
  finder: Finder;
  parentId: string | null;
  alias: string;
  outcome: Outcome | null;
  subjectName: string | null;
  body: string;
  createdAt: string;
  helpfulCount: number;
  viewerHelpful: boolean;
  replies: Story[];
}

const { finder } = Astro.props;

let initialStories: Story[] = [];
let nextCursor: string | null = null;
try {
  const voterKey = Astro.cookies.get('fbf_story_voter')?.value;
  const published = await getPublishedFinderComments(finder, 10, voterKey);
  if (Array.isArray(published)) {
    initialStories = published as Story[];
  } else if (published && typeof published === 'object') {
    const result = published as { comments?: Story[]; nextCursor?: string | null };
    initialStories = Array.isArray(result.comments) ? result.comments : [];
    nextCursor = typeof result.nextCursor === 'string' ? result.nextCursor : null;
  }
} catch (error) {
  console.warn(`[SearchStories] Initial ${finder} comments unavailable`, error);
}

const isOnlyFans = finder === 'onlyfans';
const lang = localeOf(Astro.url.pathname);

const enC = {
  subjectLabel: isOnlyFans ? 'Public OnlyFans username (optional)' : 'Public performer stage name (optional)',
  subjectHelp: isOnlyFans
    ? 'Only share a username the creator publicly uses. Never reveal a real name, location, or hidden identity.'
    : 'Use a public stage name only—never a private legal name or location.',
  emptyCopy: isOnlyFans
    ? 'Be the first to share a useful, privacy-conscious OnlyFans search experience.'
    : 'Be the first to share what helped with a performer search.',
  eyebrow: 'Community search stories',
  heading: 'What helped other searchers',
  headingSub: 'Real, moderated experiences. Your uploaded image, search results, and email are never attached to a public story.',
  privacyAria: 'Privacy information',
  privacyChip: 'Photos and results stay private',
  lockedTitle: 'Complete a search to share your experience',
  lockedSub: 'Everyone can read and mark stories helpful. Search first to write your own.',
  startSearch: 'Start a search',
  feedbackLabel: 'Did the finder help?',
  feedbackAria: 'Your private search result',
  outcomeFound: 'Found them',
  outcomeClose: 'Close match',
  outcomeNotYet: 'Not yet',
  feedbackNote: 'This answer is private and is never attached to your photo or public story.',
  shareTitle: 'Help the next searcher',
  shareSub: 'Share what worked—or constructive feedback that can make the finder better.',
  shareCta: 'Share your story',
  formLabel: 'Your search story',
  formTitle: 'What was your experience?',
  closeForm: 'Close story form',
  outcomeLegend: 'Search outcome',
  nickname: 'Public nickname',
  nicknamePlaceholder: 'e.g. PurpleFox82',
  nicknameHelp: 'Use the suggested private nickname or choose your own. Your email is never public.',
  experience: 'Your experience',
  experiencePlaceholder: 'What kind of photo, crop, angle, or screenshot helped? What could work better?',
  charCount: '/600 characters · minimum 60',
  emailLabel: 'Email to verify your story',
  emailHelp: 'We will send one private verification link. No password or public profile is required.',
  humanVerification: 'Human verification',
  notifyReplies: 'Email me when an approved reply is posted',
  rulesHtml: 'First-hand and constructive experiences only. No links, harassment, real names, locations, hidden identities, or personal information. All stories are reviewed before publishing. By submitting, you agree to our <a href="/terms-of-use/">Terms</a> and <a href="/privacy-policy/">Privacy Policy</a>.',
  submitStory: 'Submit for review',
  cancel: 'Cancel',
  successTitle: 'Story received',
  successCopy: 'Your story is awaiting review. We’ll email you when it is approved.',
  anonymous: 'Anonymous searcher',
  publicUsername: 'Public username',
  stageName: 'Stage name',
  helpful: 'Helpful',
  reply: 'Reply',
  report: 'Report',
  repliesAria: 'Replies',
  loadMore: 'Load more stories',
  replyFormTitle: 'Reply to this story',
  closeReplyForm: 'Close reply form',
  yourReply: 'Your reply',
  replyCharCount: '/600 characters · minimum 20',
  emailReplyLabel: 'Email to verify your reply',
  replyRules: 'Be constructive. No personal information, identity claims, harassment, or links. Replies are reviewed before publishing.',
  submitReply: 'Submit reply',
  reportFormTitle: 'Report this comment',
  closeReportForm: 'Close report form',
  reason: 'Reason',
  chooseReason: 'Choose a reason',
  reasonPrivateIdentity: 'Reveals a private or hidden identity',
  reasonPersonalInfo: 'Contains personal information',
  reasonNonConsensual: 'Non-consensual or leaked content',
  reasonHarassment: 'Harassment or abuse',
  reasonSpam: 'Spam or misleading content',
  reasonUnderage: 'Possible underage content',
  reasonOther: 'Something else',
  details: 'Details (optional)',
  sendReport: 'Send report',
};

const esC: typeof enC = {
  subjectLabel: isOnlyFans ? 'Nombre de usuario público de OnlyFans (opcional)' : 'Nombre artístico público (opcional)',
  subjectHelp: isOnlyFans
    ? 'Comparte solo un nombre de usuario que la creadora use públicamente. Nunca reveles un nombre real, ubicación ni identidad oculta.'
    : 'Usa solo un nombre artístico público — nunca un nombre legal privado ni una ubicación.',
  emptyCopy: isOnlyFans
    ? 'Sé la primera persona en compartir una experiencia útil y respetuosa de la privacidad buscando en OnlyFans.'
    : 'Sé la primera persona en compartir qué te ayudó en una búsqueda de actrices.',
  eyebrow: 'Historias de búsqueda de la comunidad',
  heading: 'Qué ayudó a otras personas',
  headingSub: 'Experiencias reales y moderadas. Tu imagen subida, tus resultados y tu correo nunca se vinculan a una historia pública.',
  privacyAria: 'Información de privacidad',
  privacyChip: 'Las fotos y los resultados son privados',
  lockedTitle: 'Completa una búsqueda para compartir tu experiencia',
  lockedSub: 'Cualquiera puede leer y marcar historias como útiles. Busca primero para escribir la tuya.',
  startSearch: 'Iniciar una búsqueda',
  feedbackLabel: '¿Te ayudó el buscador?',
  feedbackAria: 'Tu resultado de búsqueda privado',
  outcomeFound: 'La encontré',
  outcomeClose: 'Casi la encuentro',
  outcomeNotYet: 'Todavía no',
  feedbackNote: 'Esta respuesta es privada y nunca se vincula a tu foto ni a tu historia pública.',
  shareTitle: 'Ayuda a la siguiente persona',
  shareSub: 'Comparte qué funcionó — o comentarios constructivos que mejoren el buscador.',
  shareCta: 'Comparte tu historia',
  formLabel: 'Tu historia de búsqueda',
  formTitle: '¿Cómo fue tu experiencia?',
  closeForm: 'Cerrar formulario',
  outcomeLegend: 'Resultado de la búsqueda',
  nickname: 'Apodo público',
  nicknamePlaceholder: 'p. ej. ZorraMorada82',
  nicknameHelp: 'Usa el apodo privado sugerido o elige el tuyo. Tu correo nunca es público.',
  experience: 'Tu experiencia',
  experiencePlaceholder: '¿Qué tipo de foto, recorte, ángulo o captura te ayudó? ¿Qué podría funcionar mejor?',
  charCount: '/600 caracteres · mínimo 60',
  emailLabel: 'Correo para verificar tu historia',
  emailHelp: 'Enviaremos un único enlace privado de verificación. No se requiere contraseña ni perfil público.',
  humanVerification: 'Verificación humana',
  notifyReplies: 'Avisarme por correo cuando se publique una respuesta aprobada',
  rulesHtml: 'Solo experiencias de primera mano y constructivas. Sin enlaces, acoso, nombres reales, ubicaciones, identidades ocultas ni información personal. Todas las historias se revisan antes de publicarse. Al enviar, aceptas nuestros <a href="/es/terminos-de-uso/">Términos</a> y nuestra <a href="/es/politica-de-privacidad/">Política de Privacidad</a>.',
  submitStory: 'Enviar para revisión',
  cancel: 'Cancelar',
  successTitle: 'Historia recibida',
  successCopy: 'Tu historia está en revisión. Te avisaremos por correo cuando sea aprobada.',
  anonymous: 'Persona anónima',
  publicUsername: 'Usuario público',
  stageName: 'Nombre artístico',
  helpful: 'Útil',
  reply: 'Responder',
  report: 'Reportar',
  repliesAria: 'Respuestas',
  loadMore: 'Cargar más historias',
  replyFormTitle: 'Responder a esta historia',
  closeReplyForm: 'Cerrar formulario de respuesta',
  yourReply: 'Tu respuesta',
  replyCharCount: '/600 caracteres · mínimo 20',
  emailReplyLabel: 'Correo para verificar tu respuesta',
  replyRules: 'Sé constructivo. Sin información personal, afirmaciones de identidad, acoso ni enlaces. Las respuestas se revisan antes de publicarse.',
  submitReply: 'Enviar respuesta',
  reportFormTitle: 'Reportar este comentario',
  closeReportForm: 'Cerrar formulario de reporte',
  reason: 'Motivo',
  chooseReason: 'Elige un motivo',
  reasonPrivateIdentity: 'Revela una identidad privada u oculta',
  reasonPersonalInfo: 'Contiene información personal',
  reasonNonConsensual: 'Contenido no consentido o filtrado',
  reasonHarassment: 'Acoso o abuso',
  reasonSpam: 'Spam o contenido engañoso',
  reasonUnderage: 'Posible contenido de menores',
  reasonOther: 'Otra cosa',
  details: 'Detalles (opcional)',
  sendReport: 'Enviar reporte',
};

const C = lang === 'es' ? esC : enC;
const dateLocale = lang === 'es' ? 'es' : 'en-US';

// Client-script strings (see JSON block below).
const enClient = {
  outcomeFound: enC.outcomeFound,
  outcomeClose: enC.outcomeClose,
  outcomeNotYet: enC.outcomeNotYet,
  anonymous: enC.anonymous,
  publicUsername: enC.publicUsername,
  stageName: enC.stageName,
  helpful: enC.helpful,
  feedbackSaveFailed: 'Feedback could not be saved.',
  feedbackSaved: 'Thanks—your private feedback was saved. Sharing a public story is optional.',
  feedbackSaveError: 'We could not save the private feedback, but sharing a public story is still optional.',
  chooseOutcome: 'Choose your search outcome.',
  writeBetween: 'Write between {min} and 600 characters.',
  invalidEmail: 'Enter a valid email for the verification link.',
  completeHuman: 'Complete the human verification before submitting.',
  submitting: 'Submitting…',
  sendingLink: 'Sending your verification link…',
  submitFailed: 'We could not submit this right now. Please try again.',
  replyAwaiting: 'Your reply is awaiting review.',
  replyVerify: 'Check your inbox to verify your reply. It will then await review.',
  storyAwaiting: 'Your story is awaiting review. We’ll email you when it is approved.',
  storyVerify: 'Click the private verification link to submit your story for review.',
  helpfulFailed: 'Could not update helpful vote.',
  chooseReportReason: 'Choose a report reason.',
  reportFailed: 'Could not send this report.',
  reportThanks: 'Thanks. Our moderation team will review this comment.',
  loadingMore: 'Loading more stories…',
  loadMoreFailed: 'Could not load more stories.',
  moreLoadedOne: '1 more story loaded.',
  moreLoadedMany: '{n} more stories loaded.',
  noMore: 'No more stories.',
  emailVerified: 'Email verified',
  verifyFailedTitle: 'Verification link did not work',
  verifyFailedCopy: 'The link may have expired. Return here after another search and submit again for a new private verification link.',
};

const esClient: typeof enClient = {
  outcomeFound: esC.outcomeFound,
  outcomeClose: esC.outcomeClose,
  outcomeNotYet: esC.outcomeNotYet,
  anonymous: esC.anonymous,
  publicUsername: esC.publicUsername,
  stageName: esC.stageName,
  helpful: esC.helpful,
  feedbackSaveFailed: 'No se pudo guardar tu opinión.',
  feedbackSaved: 'Gracias — tu opinión privada quedó guardada. Compartir una historia pública es opcional.',
  feedbackSaveError: 'No pudimos guardar la opinión privada, pero compartir una historia pública sigue siendo opcional.',
  chooseOutcome: 'Elige el resultado de tu búsqueda.',
  writeBetween: 'Escribe entre {min} y 600 caracteres.',
  invalidEmail: 'Ingresa un correo válido para el enlace de verificación.',
  completeHuman: 'Completa la verificación humana antes de enviar.',
  submitting: 'Enviando…',
  sendingLink: 'Enviando tu enlace de verificación…',
  submitFailed: 'No pudimos enviarlo en este momento. Inténtalo de nuevo.',
  replyAwaiting: 'Tu respuesta está en revisión.',
  replyVerify: 'Revisa tu correo para verificar tu respuesta. Después quedará en revisión.',
  storyAwaiting: 'Tu historia está en revisión. Te avisaremos por correo cuando sea aprobada.',
  storyVerify: 'Haz clic en el enlace privado de verificación para enviar tu historia a revisión.',
  helpfulFailed: 'No se pudo actualizar el voto de útil.',
  chooseReportReason: 'Elige un motivo de reporte.',
  reportFailed: 'No se pudo enviar este reporte.',
  reportThanks: 'Gracias. Nuestro equipo de moderación revisará este comentario.',
  loadingMore: 'Cargando más historias…',
  loadMoreFailed: 'No se pudieron cargar más historias.',
  moreLoadedOne: 'Se cargó 1 historia más.',
  moreLoadedMany: 'Se cargaron {n} historias más.',
  noMore: 'No hay más historias.',
  emailVerified: 'Correo verificado',
  verifyFailedTitle: 'El enlace de verificación no funcionó',
  verifyFailedCopy: 'Puede que el enlace haya expirado. Vuelve aquí tras otra búsqueda y envía de nuevo para recibir un nuevo enlace privado de verificación.',
};

const CLIENT = lang === 'es' ? esClient : enClient;

const turnstileSiteKey = import.meta.env.PUBLIC_TURNSTILE_SITE_KEY || '';
const enPath = isOnlyFans ? '/onlyfans-finder-by-face/' : '/pornstar-finder-by-face/';
const canonical = absUrl(lang === 'es' ? (staticRoutes[enPath] ?? enPath) : enPath);
const applicationId = `${canonical}#web-application`;
const storyFragmentId = (id: string) => `search-story-${id}`;
const storyUrl = (id: string) => `${canonical}#${storyFragmentId(id)}`;
// This is inserted with set:html because JSON-LD must remain machine-readable. Escape the
// HTML-significant characters and JavaScript line separators as defense in depth, even though
// the contribution validator already rejects angle brackets from public story text.
const serializeJsonLd = (value: unknown) => JSON.stringify(value)
  .replace(/</g, '\\u003c')
  .replace(/>/g, '\\u003e')
  .replace(/&/g, '\\u0026')
  .replace(/\u2028/g, '\\u2028')
  .replace(/\u2029/g, '\\u2029');
const commentSchema = (story: Story, parentId: string | null = null): Record<string, unknown> => ({
  '@type': 'Comment',
  '@id': storyUrl(story.id),
  url: storyUrl(story.id),
  text: story.body,
  dateCreated: story.createdAt,
  author: {
    '@type': 'Person',
    name: story.alias || C.anonymous,
  },
  about: { '@id': applicationId },
  parentItem: { '@id': parentId ? storyUrl(parentId) : applicationId },
  interactionStatistic: {
    '@type': 'InteractionCounter',
    interactionType: { '@type': 'LikeAction' },
    userInteractionCount: Math.max(0, Number(story.helpfulCount) || 0),
  },
  ...(Array.isArray(story.replies) && story.replies.length > 0
    ? { comment: story.replies.map((reply) => commentSchema(reply, story.id)) }
    : {}),
});
const commentStructuredData = initialStories.length > 0
  ? serializeJsonLd({
      '@context': 'https://schema.org',
      '@type': 'WebApplication',
      '@id': applicationId,
      comment: initialStories.map((story) => commentSchema(story)),
    })
  : null;
---

<section
  id="search-stories"
  class="search-stories"
  data-search-stories
  data-finder={finder}
  data-next-cursor={nextCursor || ''}
  data-turnstile-site-key={turnstileSiteKey}
  aria-labelledby={`search-stories-title-${finder}`}
>
  {commentStructuredData && <script type="application/ld+json" set:html={commentStructuredData} />}

  <div class="stories-heading">
    <div>
      <span class="stories-eyebrow">{C.eyebrow}</span>
      <h2 id={`search-stories-title-${finder}`}>{C.heading}</h2>
      <p>{C.headingSub}</p>
    </div>
    <div class="privacy-chip" aria-label={C.privacyAria}>
      <svg viewBox="0 0 24 24" aria-hidden="true"><path d="M7 10V7a5 5 0 0 1 10 0v3m-9 0h8a2 2 0 0 1 2 2v7H6v-7a2 2 0 0 1 2-2Z" /></svg>
      {C.privacyChip}
    </div>
  </div>

  <div class="contribute-card">
    <div class="locked-prompt" data-locked-prompt>
      <div class="prompt-icon" aria-hidden="true">✦</div>
      <div>
        <strong>{C.lockedTitle}</strong>
        <p>{C.lockedSub}</p>
      </div>
      <a href={isOnlyFans ? '#onlyfans-face-search' : '#video-search-heading'}>{C.startSearch}</a>
    </div>

    <div class="feedback-step" data-feedback-step hidden>
      <p class="step-label">{C.feedbackLabel}</p>
      <div class="outcome-buttons" role="group" aria-label={C.feedbackAria}>
        <button type="button" data-feedback="found"><span aria-hidden="true">✓</span> {C.outcomeFound}</button>
        <button type="button" data-feedback="close"><span aria-hidden="true">≈</span> {C.outcomeClose}</button>
        <button type="button" data-feedback="not_yet"><span aria-hidden="true">↗</span> {C.outcomeNotYet}</button>
      </div>
      <p class="feedback-note">{C.feedbackNote}</p>
    </div>

    <div class="share-prompt" data-share-prompt hidden>
      <div>
        <strong>{C.shareTitle}</strong>
        <p>{C.shareSub}</p>
      </div>
      <button type="button" class="primary-button" data-open-composer>{C.shareCta}</button>
    </div>

    <form class="story-form" data-story-form hidden novalidate>
      <div class="form-heading">
        <div>
          <span class="step-label">{C.formLabel}</span>
          <h3>{C.formTitle}</h3>
        </div>
        <button type="button" class="icon-button" data-close-form aria-label={C.closeForm}>×</button>
      </div>

      <fieldset>
        <legend>{C.outcomeLegend} <span aria-hidden="true">*</span></legend>
        <div class="choice-row">
          <label><input type="radio" name="outcome" value="found" required /> <span>{C.outcomeFound}</span></label>
          <label><input type="radio" name="outcome" value="close" /> <span>{C.outcomeClose}</span></label>
          <label><input type="radio" name="outcome" value="not_yet" /> <span>{C.outcomeNotYet}</span></label>
        </div>
      </fieldset>

      <label class="field">
        <span>{C.subjectLabel}</span>
        <input name="subjectName" type="text" maxlength="64" autocomplete="off" />
        <small>{C.subjectHelp}</small>
      </label>

      <label class="field">
        <span>{C.nickname}</span>
        <input name="alias" type="text" minlength="3" maxlength="32" autocomplete="nickname" placeholder={C.nicknamePlaceholder} />
        <small>{C.nicknameHelp}</small>
      </label>

      <label class="field">
        <span>{C.experience} <span aria-hidden="true">*</span></span>
        <textarea name="body" minlength="60" maxlength="600" rows="5" required placeholder={C.experiencePlaceholder}></textarea>
        <small class="character-count"><span data-character-count>0</span>{C.charCount}</small>
      </label>

      <div class="email-field" data-email-field hidden>
        <label class="field">
          <span>{C.emailLabel} <span aria-hidden="true">*</span></span>
          <input name="email" type="email" maxlength="254" autocomplete="email" />
          <small>{C.emailHelp}</small>
        </label>
        {turnstileSiteKey && <div class="turnstile-slot" data-turnstile aria-label={C.humanVerification}></div>}
      </div>

      <label class="check-field">
        <input type="checkbox" name="notifyReplies" checked />
        <span>{C.notifyReplies}</span>
      </label>

      <label class="honeypot" aria-hidden="true">
        Company
        <input name="company" type="text" tabindex="-1" autocomplete="off" />
      </label>

      <p class="rules-copy" set:html={C.rulesHtml} />
      <div class="form-actions">
        <button type="submit" class="primary-button" data-submit-story>{C.submitStory}</button>
        <button type="button" class="text-button" data-close-form>{C.cancel}</button>
      </div>
      <p class="form-status" data-form-status role="status" aria-live="polite"></p>
    </form>

    <div class="success-state" data-success-state hidden tabindex="-1">
      <span aria-hidden="true">✓</span>
      <div><strong data-success-title>{C.successTitle}</strong><p data-success-copy>{C.successCopy}</p></div>
    </div>
  </div>

  <div class="stories-list" data-stories-list>
    {initialStories.map((story) => (
      <article id={storyFragmentId(story.id)} class="story-card" data-story-id={story.id}>
        <div class="story-topline">
          <div class="avatar" aria-hidden="true">{(story.alias || 'S').slice(0, 1).toUpperCase()}</div>
          <div class="story-author"><strong>{story.alias || C.anonymous}</strong><time datetime={story.createdAt}>{new Date(story.createdAt).toLocaleDateString(dateLocale, { month: 'short', day: 'numeric', year: 'numeric' })}</time></div>
          {story.outcome && <span class:list={['outcome-badge', `outcome-${story.outcome}`]}>{story.outcome === 'found' ? C.outcomeFound : story.outcome === 'close' ? C.outcomeClose : C.outcomeNotYet}</span>}
        </div>
        {story.subjectName && <p class="subject-name">{isOnlyFans ? C.publicUsername : C.stageName}: <strong>{story.subjectName}</strong></p>}
        <p class="story-body">{story.body}</p>
        <div class="story-actions">
          <button type="button" class:list={['helpful-button', { active: story.viewerHelpful }]} data-helpful aria-pressed={String(Boolean(story.viewerHelpful))}>
            <svg viewBox="0 0 24 24" aria-hidden="true"><path d="M7 10v10H4V10h3Zm3 10V9l3-6c1.7.4 2.3 2 1.8 4L14 10h5a2 2 0 0 1 2 2l-1.2 6a2.5 2.5 0 0 1-2.5 2H10Z" /></svg>
            {C.helpful} <span data-helpful-count>{Math.max(0, Number(story.helpfulCount) || 0)}</span>
          </button>
          <button type="button" class="action-button" data-reply>{C.reply}</button>
          <button type="button" class="action-button" data-report>{C.report}</button>
        </div>
        <div class="inline-slot" data-inline-slot></div>
        {Array.isArray(story.replies) && story.replies.length > 0 && (
          <div class="replies" aria-label={C.repliesAria}>
            {story.replies.map((reply) => (
              <article id={storyFragmentId(reply.id)} class="reply-card" data-story-id={reply.id}>
                <div class="story-topline">
                  <div class="avatar small" aria-hidden="true">{(reply.alias || 'S').slice(0, 1).toUpperCase()}</div>
                  <div class="story-author"><strong>{reply.alias || C.anonymous}</strong><time datetime={reply.createdAt}>{new Date(reply.createdAt).toLocaleDateString(dateLocale, { month: 'short', day: 'numeric', year: 'numeric' })}</time></div>
                </div>
                <p class="story-body">{reply.body}</p>
                <div class="story-actions">
                  <button type="button" class:list={['helpful-button', { active: reply.viewerHelpful }]} data-helpful aria-pressed={String(Boolean(reply.viewerHelpful))}>
                    <svg viewBox="0 0 24 24" aria-hidden="true"><path d="M7 10v10H4V10h3Zm3 10V9l3-6c1.7.4 2.3 2 1.8 4L14 10h5a2 2 0 0 1 2 2l-1.2 6a2.5 2.5 0 0 1-2.5 2H10Z" /></svg>
                    {C.helpful} <span data-helpful-count>{Math.max(0, Number(reply.helpfulCount) || 0)}</span>
                  </button>
                  <button type="button" class="action-button" data-report>{C.report}</button>
                </div>
                <div class="inline-slot" data-inline-slot></div>
              </article>
            ))}
          </div>
        )}
      </article>
    ))}
  </div>
  <p class="sr-status" data-action-status role="status" aria-live="polite"></p>
  <script type="application/json" data-i18n-stories set:html={JSON.stringify(CLIENT)} />

  <div class="empty-stories" data-empty-stories hidden={initialStories.length > 0}>
    <span aria-hidden="true">✦</span>
    <p>{C.emptyCopy}</p>
  </div>

  <div class="load-more-wrap" data-load-more-wrap hidden={!nextCursor}>
    <button type="button" class="secondary-button" data-load-more>{C.loadMore}</button>
    <p data-list-status role="status" aria-live="polite"></p>
  </div>

  <template data-reply-template>
    <form class="inline-form reply-form" novalidate>
      <div class="inline-form-head"><strong>{C.replyFormTitle}</strong><button type="button" data-inline-close aria-label={C.closeReplyForm}>×</button></div>
      <label class="field"><span>{C.nickname}</span><input name="alias" type="text" minlength="3" maxlength="32" autocomplete="nickname" placeholder={C.nicknamePlaceholder} /></label>
      <label class="field"><span>{C.yourReply} <span aria-hidden="true">*</span></span><textarea name="body" minlength="20" maxlength="600" rows="4" required></textarea><small><span data-character-count>0</span>{C.replyCharCount}</small></label>
      <div data-inline-email hidden>
        <label class="field"><span>{C.emailReplyLabel} <span aria-hidden="true">*</span></span><input name="email" type="email" maxlength="254" autocomplete="email" /></label>
        {turnstileSiteKey && <div class="turnstile-slot" data-turnstile aria-label={C.humanVerification}></div>}
      </div>
      <label class="check-field"><input type="checkbox" name="notifyReplies" checked /><span>{C.notifyReplies}</span></label>
      <label class="honeypot" aria-hidden="true">Company<input name="company" type="text" tabindex="-1" autocomplete="off" /></label>
      <p class="rules-copy">{C.replyRules}</p>
      <div class="form-actions"><button type="submit" class="primary-button">{C.submitReply}</button><button type="button" class="text-button" data-inline-close>{C.cancel}</button></div>
      <p class="form-status" data-inline-status role="status" aria-live="polite"></p>
    </form>
  </template>

  <template data-report-template>
    <form class="inline-form report-form" novalidate>
      <div class="inline-form-head"><strong>{C.reportFormTitle}</strong><button type="button" data-inline-close aria-label={C.closeReportForm}>×</button></div>
      <label class="field"><span>{C.reason} <span aria-hidden="true">*</span></span><select name="reason" required><option value="">{C.chooseReason}</option><option value="private_identity">{C.reasonPrivateIdentity}</option><option value="personal_information">{C.reasonPersonalInfo}</option><option value="non_consensual">{C.reasonNonConsensual}</option><option value="harassment">{C.reasonHarassment}</option><option value="spam">{C.reasonSpam}</option><option value="underage">{C.reasonUnderage}</option><option value="other">{C.reasonOther}</option></select></label>
      <label class="field"><span>{C.details}</span><textarea name="detail" maxlength="500" rows="3"></textarea></label>
      <label class="honeypot" aria-hidden="true">Company<input name="company" type="text" tabindex="-1" autocomplete="off" /></label>
      <div class="form-actions"><button type="submit" class="primary-button danger-button">{C.sendReport}</button><button type="button" class="text-button" data-inline-close>{C.cancel}</button></div>
      <p class="form-status" data-inline-status role="status" aria-live="polite"></p>
    </form>
  </template>
</section>

<script>
  type Finder = 'onlyfans' | 'pornstar';
  type Outcome = 'found' | 'close' | 'not_yet';

  // Locale strings server-rendered into the JSON block inside the section (see frontmatter CLIENT).
  const T = JSON.parse(document.querySelector('[data-i18n-stories]')!.textContent!) as Record<string, string>;
  const fmtT = (s: string, v: Record<string, string | number> = {}) =>
    s.replace(/\{(\w+)\}/g, (_, k: string) => String(v[k] ?? ''));
  const dateLocale = document.documentElement.lang === 'es' ? 'es' : 'en-US';
  type ClientStory = {
    id: string;
    finder: Finder;
    parentId: string | null;
    alias: string;
    outcome: Outcome | null;
    subjectName: string | null;
    body: string;
    createdAt: string;
    helpfulCount: number;
    viewerHelpful: boolean;
    replies: ClientStory[];
  };
  type TurnstileApi = {
    render: (container: HTMLElement, options: Record<string, unknown>) => string;
    getResponse: (widgetId: string) => string;
    reset: (widgetId: string) => void;
  };
  type TurnstileWindow = typeof window & {
    turnstile?: TurnstileApi;
    __turnstileReady?: Array<() => void>;
    onTurnstileLoad?: () => void;
  };
  type AnalyticsWindow = typeof window & {
    gtag?: (command: 'event', eventName: string, parameters: Record<string, string>) => void;
  };

  const OUTCOME_LABELS: Record<Outcome, string> = { found: T.outcomeFound, close: T.outcomeClose, not_yet: T.outcomeNotYet };

  document.querySelectorAll<HTMLElement>('[data-search-stories]').forEach((root) => {
    if (root.dataset.initialized === 'true') return;
    root.dataset.initialized = 'true';

    const finder = root.dataset.finder as Finder;
    const turnstileSiteKey = root.dataset.turnstileSiteKey || '';
    const proofKey = `fbf_search_proof_${finder}`;
    const draftKey = `fbf_pending_comment_${finder}`;
    const lockedPrompt = root.querySelector<HTMLElement>('[data-locked-prompt]')!;
    const feedbackStep = root.querySelector<HTMLElement>('[data-feedback-step]')!;
    const sharePrompt = root.querySelector<HTMLElement>('[data-share-prompt]')!;
    const storyForm = root.querySelector<HTMLFormElement>('[data-story-form]')!;
    const emailField = root.querySelector<HTMLElement>('[data-email-field]')!;
    const successState = root.querySelector<HTMLElement>('[data-success-state]')!;
    const list = root.querySelector<HTMLElement>('[data-stories-list]')!;
    const empty = root.querySelector<HTMLElement>('[data-empty-stories]')!;
    const loadMoreWrap = root.querySelector<HTMLElement>('[data-load-more-wrap]')!;
    const loadMoreButton = root.querySelector<HTMLButtonElement>('[data-load-more]')!;
    const listStatus = root.querySelector<HTMLElement>('[data-list-status]')!;
    const actionStatus = root.querySelector<HTMLElement>('[data-action-status]')!;
    const scopeAttribute = root.getAttributeNames().find((name) => name.startsWith('data-astro-cid-')) || '';
    let searchProof = '';
    let feedbackOutcome: Outcome | null = null;
    const turnstileWidgets = new WeakMap<HTMLFormElement, string>();

    function track(eventName: string, parameters: { action?: string; status?: string } = {}): void {
      const analytics = window as AnalyticsWindow;
      if (typeof analytics.gtag !== 'function') return;
      analytics.gtag('event', eventName, {
        finder,
        ...(parameters.action ? { action: parameters.action } : {}),
        ...(parameters.status ? { status: parameters.status } : {}),
      });
    }

    function withTurnstile(callback: (api: TurnstileApi) => void): void {
      if (!turnstileSiteKey) return;
      const turnstileWindow = window as TurnstileWindow;
      if (turnstileWindow.turnstile) {
        callback(turnstileWindow.turnstile);
        return;
      }
      turnstileWindow.__turnstileReady ||= [];
      turnstileWindow.__turnstileReady.push(() => {
        if (turnstileWindow.turnstile) callback(turnstileWindow.turnstile);
      });
      if (!turnstileWindow.onTurnstileLoad) {
        turnstileWindow.onTurnstileLoad = () => {
          const callbacks = turnstileWindow.__turnstileReady?.splice(0) || [];
          callbacks.forEach((ready) => ready());
        };
      }
      if (!document.querySelector<HTMLScriptElement>('script[src*="challenges.cloudflare.com/turnstile"]')) {
        const script = document.createElement('script');
        script.src = 'https://challenges.cloudflare.com/turnstile/v0/api.js?render=explicit&onload=onTurnstileLoad';
        script.async = true;
        script.defer = true;
        document.head.append(script);
      }
    }

    function renderTurnstile(form: HTMLFormElement): void {
      if (!turnstileSiteKey || turnstileWidgets.has(form)) return;
      const slot = form.querySelector<HTMLElement>('[data-turnstile]');
      if (!slot) return;
      withTurnstile((api) => {
        if (turnstileWidgets.has(form) || !form.isConnected) return;
        const widgetId = api.render(slot, { sitekey: turnstileSiteKey, theme: 'dark', language: document.documentElement.lang || 'en' });
        turnstileWidgets.set(form, widgetId);
      });
    }

    function turnstileToken(form: HTMLFormElement): string {
      const widgetId = turnstileWidgets.get(form);
      const api = (window as TurnstileWindow).turnstile;
      return widgetId && api ? api.getResponse(widgetId) : '';
    }

    function resetTurnstile(form: HTMLFormElement): void {
      const widgetId = turnstileWidgets.get(form);
      const api = (window as TurnstileWindow).turnstile;
      if (widgetId && api) api.reset(widgetId);
    }

    function readStoredProof(): string {
      try { return sessionStorage.getItem(proofKey) || ''; } catch { return ''; }
    }

    function currentToken(): string {
      try {
        const user = JSON.parse(localStorage.getItem('fbf_user') || 'null');
        return typeof user?.access_token === 'string' ? user.access_token : '';
      } catch { return ''; }
    }

    function randomAlias(): string {
      const adjectives = ['Purple', 'Bright', 'Quiet', 'Silver', 'Lucky', 'Curious', 'Velvet', 'Cosmic'];
      const animals = ['Fox', 'Owl', 'Panda', 'Otter', 'Falcon', 'Koala', 'Lynx', 'Robin'];
      const bytes = new Uint32Array(3);
      crypto.getRandomValues(bytes);
      return `${adjectives[bytes[0] % adjectives.length]}${animals[bytes[1] % animals.length]}${String(bytes[2] % 100_000_000).padStart(8, '0')}`;
    }

    function setSearchReady(proof: string, showFeedback = true): void {
      if (!proof) return;
      searchProof = proof;
      try { sessionStorage.setItem(proofKey, proof); } catch { /* storage unavailable */ }
      lockedPrompt.hidden = true;
      if (showFeedback && !feedbackOutcome) feedbackStep.hidden = false;
      else sharePrompt.hidden = false;
    }

    function openComposer(parentId?: string): void {
      if (!searchProof) {
        lockedPrompt.scrollIntoView({ behavior: 'smooth', block: 'center' });
        return;
      }
      if (parentId) return;
      track('story_composer_start', { action: 'story' });
      sharePrompt.hidden = true;
      feedbackStep.hidden = true;
      successState.hidden = true;
      storyForm.hidden = false;
      const alias = storyForm.elements.namedItem('alias') as HTMLInputElement;
      if (!alias.value) alias.value = randomAlias();
      const checked = storyForm.querySelector<HTMLInputElement>('input[name="outcome"]:checked');
      if (!checked && feedbackOutcome) {
        const outcome = storyForm.querySelector<HTMLInputElement>(`input[name="outcome"][value="${feedbackOutcome}"]`);
        if (outcome) outcome.checked = true;
      }
      emailField.hidden = Boolean(currentToken());
      const email = storyForm.elements.namedItem('email') as HTMLInputElement;
      email.required = !currentToken();
      if (!currentToken()) renderTurnstile(storyForm);
      requestAnimationFrame(() => (storyForm.elements.namedItem('body') as HTMLTextAreaElement).focus());
    }

    function closeComposer(): void {
      storyForm.hidden = true;
      sharePrompt.hidden = false;
      root.querySelector<HTMLButtonElement>('[data-open-composer]')?.focus();
    }

    async function parseResponse(response: Response): Promise<Record<string, unknown>> {
      try { return await response.json() as Record<string, unknown>; } catch { return {}; }
    }

    function errorMessage(payload: Record<string, unknown>, fallback: string): string {
      return typeof payload.error === 'string' ? payload.error : typeof payload.message === 'string' ? payload.message : fallback;
    }

    async function sendFeedback(outcome: Outcome, button: HTMLButtonElement): Promise<void> {
      if (!searchProof) return;
      root.querySelectorAll<HTMLButtonElement>('[data-feedback]').forEach((item) => { item.disabled = true; });
      try {
        const response = await fetch('/api/finder-comments/feedback', {
          method: 'POST',
          headers: { 'Content-Type': 'application/json' },
          body: JSON.stringify({ finder, outcome, proof: searchProof }),
        });
        if (!response.ok) throw new Error(T.feedbackSaveFailed);
        feedbackOutcome = outcome;
        feedbackStep.hidden = true;
        sharePrompt.hidden = false;
        button.setAttribute('aria-pressed', 'true');
        track('story_feedback_submit', { status: 'success' });
        actionStatus.textContent = T.feedbackSaved;
      } catch {
        feedbackOutcome = outcome;
        feedbackStep.hidden = true;
        sharePrompt.hidden = false;
        track('story_feedback_submit', { status: 'error' });
        actionStatus.textContent = T.feedbackSaveError;
      } finally {
        root.querySelectorAll<HTMLButtonElement>('[data-feedback]').forEach((item) => { item.disabled = false; });
      }
    }

    function payloadFromForm(form: HTMLFormElement, parentId: string | null): Record<string, unknown> {
      const data = new FormData(form);
      return {
        finder,
        parentId,
        outcome: parentId ? undefined : data.get('outcome'),
        subjectName: parentId ? undefined : String(data.get('subjectName') || '').trim() || undefined,
        alias: String(data.get('alias') || '').trim() || randomAlias(),
        body: String(data.get('body') || '').trim(),
        notifyReplies: data.get('notifyReplies') === 'on',
        proof: searchProof,
        company: String(data.get('company') || ''),
      };
    }

    async function submitContribution(form: HTMLFormElement, parentId: string | null, status: HTMLElement): Promise<void> {
      const data = new FormData(form);
      const body = String(data.get('body') || '').trim();
      const minimum = parentId ? 20 : 60;
      if (!parentId && !data.get('outcome')) {
        status.textContent = T.chooseOutcome;
        form.querySelector<HTMLInputElement>('input[name="outcome"]')?.focus();
        return;
      }
      if (body.length < minimum || body.length > 600) {
        status.textContent = fmtT(T.writeBetween, { min: minimum });
        (form.elements.namedItem('body') as HTMLTextAreaElement).focus();
        return;
      }
      const token = currentToken();
      const email = String(data.get('email') || '').trim();
      if (!token && !/^\S+@\S+\.\S+$/.test(email)) {
        status.textContent = T.invalidEmail;
        (form.elements.namedItem('email') as HTMLInputElement)?.focus();
        return;
      }
      const payload = payloadFromForm(form, parentId);
      if (!token) {
        payload.email = email;
        payload.turnstileToken = turnstileToken(form);
        payload.returnTo = `${window.location.pathname}#search-stories-title-${finder}`;
        if (turnstileSiteKey && !payload.turnstileToken) {
          status.textContent = T.completeHuman;
          return;
        }
      }
      const submit = form.querySelector<HTMLButtonElement>('button[type="submit"]')!;
      submit.disabled = true;
      status.textContent = token ? T.submitting : T.sendingLink;
      try {
        const response = await fetch(token ? '/api/finder-comments' : '/api/finder-comments/verify', {
          method: 'POST',
          headers: { 'Content-Type': 'application/json', ...(token ? { Authorization: `Bearer ${token}` } : {}) },
          body: JSON.stringify(payload),
        });
        const result = await parseResponse(response);
        if (!response.ok) throw new Error(errorMessage(result, T.submitFailed));
        if (!token) track('story_verification_requested', { action: parentId ? 'reply' : 'story', status: 'success' });
        track(parentId ? 'story_reply_submit' : 'story_submit', { action: token ? 'submitted' : 'verification_pending', status: 'success' });
        if (!token) {
          try {
            sessionStorage.setItem(draftKey, JSON.stringify({ pending: true, parentId, createdAt: Date.now(), anchor: `search-stories-title-${finder}` }));
          } catch { /* storage unavailable */ }
        }
        form.reset();
        if (parentId) {
          const container = form.parentElement;
          if (container) {
            container.replaceChildren();
            const message = element('p', 'inline-success', token ? T.replyAwaiting : T.replyVerify);
            container.append(message);
          }
        } else {
          storyForm.hidden = true;
          sharePrompt.hidden = true;
          successState.hidden = false;
          root.querySelector<HTMLElement>('[data-success-title]')!.textContent = token ? 'Story received' : 'Check your inbox';
          root.querySelector<HTMLElement>('[data-success-copy]')!.textContent = token
            ? T.storyAwaiting
            : T.storyVerify;
          successState.focus();
        }
      } catch (error) {
        status.textContent = error instanceof Error ? error.message : 'Something went wrong. Please try again.';
        if (!token) track('story_verification_requested', { action: parentId ? 'reply' : 'story', status: 'error' });
        track(parentId ? 'story_reply_submit' : 'story_submit', { action: token ? 'submitted' : 'verification_pending', status: 'error' });
        if (!token) resetTurnstile(form);
      } finally {
        submit.disabled = false;
      }
    }

    function avatarText(alias: string): string { return (alias.trim().charAt(0) || 'S').toUpperCase(); }
    function formatDate(value: string): string {
      const date = new Date(value);
      return Number.isNaN(date.valueOf()) ? '' : date.toLocaleDateString(dateLocale, { month: 'short', day: 'numeric', year: 'numeric' });
    }
    function element<K extends keyof HTMLElementTagNameMap>(name: K, className?: string, text?: string): HTMLElementTagNameMap[K] {
      const node = document.createElement(name);
      if (className) node.className = className;
      if (text !== undefined) node.textContent = text;
      if (scopeAttribute) node.setAttribute(scopeAttribute, '');
      return node;
    }

    function buildStory(story: ClientStory, isReply = false): HTMLElement {
      const article = element('article', isReply ? 'reply-card' : 'story-card');
      article.id = `search-story-${story.id}`;
      article.dataset.storyId = String(story.id);
      const top = element('div', 'story-topline');
      const avatar = element('div', isReply ? 'avatar small' : 'avatar', avatarText(story.alias || ''));
      avatar.setAttribute('aria-hidden', 'true');
      const author = element('div', 'story-author');
      author.append(element('strong', '', story.alias || T.anonymous));
      const time = element('time', '', formatDate(story.createdAt));
      time.dateTime = story.createdAt;
      author.append(time);
      top.append(avatar, author);
      if (!isReply && story.outcome && OUTCOME_LABELS[story.outcome]) {
        top.append(element('span', `outcome-badge outcome-${story.outcome}`, OUTCOME_LABELS[story.outcome]));
      }
      article.append(top);
      if (!isReply && story.subjectName) {
        const subject = element('p', 'subject-name');
        subject.append(`${finder === 'onlyfans' ? T.publicUsername : T.stageName}: `, element('strong', '', story.subjectName));
        article.append(subject);
      }
      article.append(element('p', 'story-body', story.body));
      const actions = element('div', 'story-actions');
      const helpful = element('button', `helpful-button${story.viewerHelpful ? ' active' : ''}`);
      helpful.type = 'button';
      helpful.dataset.helpful = '';
      helpful.setAttribute('aria-pressed', String(Boolean(story.viewerHelpful)));
      helpful.append(`${T.helpful} `, element('span', '', String(Math.max(0, Number(story.helpfulCount) || 0))));
      helpful.querySelector('span')!.dataset.helpfulCount = '';
      actions.append(helpful);
      if (!isReply) {
        const reply = element('button', 'action-button', 'Reply'); reply.type = 'button'; reply.dataset.reply = ''; actions.append(reply);
      }
      const report = element('button', 'action-button', 'Report'); report.type = 'button'; report.dataset.report = ''; actions.append(report);
      article.append(actions);
      const slot = element('div', 'inline-slot'); slot.dataset.inlineSlot = ''; article.append(slot);
      if (!isReply && Array.isArray(story.replies) && story.replies.length) {
        const replies = element('div', 'replies'); replies.setAttribute('aria-label', 'Replies');
        story.replies.forEach((item) => replies.append(buildStory(item, true)));
        article.append(replies);
      }
      return article;
    }

    function closeInlineForms(): void {
      root.querySelectorAll<HTMLElement>('[data-inline-slot]').forEach((slot) => slot.replaceChildren());
    }

    function prepareInlineForm(card: HTMLElement, kind: 'reply' | 'report'): HTMLFormElement | null {
      const slot = card.querySelector<HTMLElement>(':scope > [data-inline-slot]');
      const template = root.querySelector<HTMLTemplateElement>(kind === 'reply' ? '[data-reply-template]' : '[data-report-template]');
      if (!slot || !template) return null;
      closeInlineForms();
      slot.append(template.content.cloneNode(true));
      if (scopeAttribute) slot.querySelectorAll<HTMLElement>('*').forEach((node) => node.setAttribute(scopeAttribute, ''));
      const form = slot.querySelector<HTMLFormElement>('form')!;
      form.querySelectorAll<HTMLButtonElement>('[data-inline-close]').forEach((button) => button.addEventListener('click', () => {
        slot.replaceChildren();
        card.querySelector<HTMLButtonElement>(kind === 'reply' ? '[data-reply]' : '[data-report]')?.focus();
      }));
      form.querySelectorAll<HTMLTextAreaElement>('textarea').forEach((textarea) => textarea.addEventListener('input', () => {
        const count = form.querySelector<HTMLElement>('[data-character-count]'); if (count) count.textContent = String(textarea.value.length);
      }));
      requestAnimationFrame(() => form.querySelector<HTMLElement>('select, textarea, input:not([type="hidden"])')?.focus());
      return form;
    }

    async function toggleHelpful(button: HTMLButtonElement, card: HTMLElement): Promise<void> {
      const commentId = card.dataset.storyId;
      if (!commentId) return;
      const count = button.querySelector<HTMLElement>('[data-helpful-count]');
      button.disabled = true;
      try {
        const response = await fetch('/api/finder-comments/helpful', { method: 'POST', headers: { 'Content-Type': 'application/json' }, body: JSON.stringify({ commentId }) });
        const result = await parseResponse(response);
        if (!response.ok) throw new Error(errorMessage(result, T.helpfulFailed));
        const active = typeof result.helpful === 'boolean' ? result.helpful : !button.classList.contains('active');
        button.classList.toggle('active', active);
        button.setAttribute('aria-pressed', String(active));
        if (count) {
          const previous = Number(count.textContent) || 0;
          count.textContent = String(typeof result.helpfulCount === 'number' ? result.helpfulCount : Math.max(0, previous + (active ? 1 : -1)));
        }
        track('story_helpful_toggle', { action: active ? 'add' : 'remove', status: 'success' });
      } catch (error) {
        button.title = error instanceof Error ? error.message : 'Could not update helpful vote.';
        actionStatus.textContent = button.title;
        track('story_helpful_toggle', { action: 'toggle', status: 'error' });
      } finally { button.disabled = false; }
    }

    root.addEventListener('click', (event) => {
      const target = event.target as HTMLElement;
      const feedbackButton = target.closest<HTMLButtonElement>('[data-feedback]');
      if (feedbackButton) { void sendFeedback(feedbackButton.dataset.feedback as Outcome, feedbackButton); return; }
      if (target.closest('[data-open-composer]')) { openComposer(); return; }
      if (target.closest('[data-close-form]')) { closeComposer(); return; }
      const card = target.closest<HTMLElement>('[data-story-id]');
      if (!card) return;
      const helpful = target.closest<HTMLButtonElement>('[data-helpful]');
      if (helpful) { void toggleHelpful(helpful, card); return; }
      if (target.closest('[data-reply]')) {
        if (!searchProof) { lockedPrompt.scrollIntoView({ behavior: 'smooth', block: 'center' }); return; }
        const form = prepareInlineForm(card, 'reply');
        if (!form) return;
        track('story_reply_start', { action: 'open' });
        const alias = form.elements.namedItem('alias') as HTMLInputElement; alias.value = randomAlias();
        const inlineEmail = form.querySelector<HTMLElement>('[data-inline-email]')!;
        inlineEmail.hidden = Boolean(currentToken());
        (form.elements.namedItem('email') as HTMLInputElement).required = !currentToken();
        if (!currentToken()) renderTurnstile(form);
        form.addEventListener('submit', (submitEvent) => {
          submitEvent.preventDefault();
          void submitContribution(form, card.dataset.storyId || null, form.querySelector<HTMLElement>('[data-inline-status]')!);
        });
        return;
      }
      if (target.closest('[data-report]')) {
        const form = prepareInlineForm(card, 'report');
        if (!form) return;
        form.addEventListener('submit', async (submitEvent) => {
          submitEvent.preventDefault();
          const data = new FormData(form);
          const reason = String(data.get('reason') || '');
          const status = form.querySelector<HTMLElement>('[data-inline-status]')!;
          if (!reason) { status.textContent = T.chooseReportReason; return; }
          const submit = form.querySelector<HTMLButtonElement>('button[type="submit"]')!; submit.disabled = true; status.textContent = 'Sending report…';
          try {
            const response = await fetch('/api/finder-comments/report', { method: 'POST', headers: { 'Content-Type': 'application/json' }, body: JSON.stringify({ commentId: card.dataset.storyId, reason, details: String(data.get('detail') || '').trim() || undefined, website: String(data.get('company') || '') }) });
            const result = await parseResponse(response);
            if (!response.ok) throw new Error(errorMessage(result, T.reportFailed));
            const slot = form.parentElement!; slot.replaceChildren(element('p', 'inline-success', T.reportThanks));
            track('story_report_submit', { status: 'success' });
          } catch (error) {
            status.textContent = error instanceof Error ? error.message : 'Could not send this report.';
            track('story_report_submit', { status: 'error' });
          }
          finally { submit.disabled = false; }
        });
      }
    });

    storyForm.addEventListener('submit', (event) => { event.preventDefault(); void submitContribution(storyForm, null, root.querySelector<HTMLElement>('[data-form-status]')!); });
    const mainBody = storyForm.elements.namedItem('body') as HTMLTextAreaElement;
    mainBody.addEventListener('input', () => { root.querySelector<HTMLElement>('[data-character-count]')!.textContent = String(mainBody.value.length); });

    loadMoreButton?.addEventListener('click', async () => {
      const cursor = root.dataset.nextCursor;
      if (!cursor) return;
      loadMoreButton.disabled = true; listStatus.textContent = T.loadingMore;
      try {
        const response = await fetch(`/api/finder-comments?finder=${encodeURIComponent(finder)}&cursor=${encodeURIComponent(cursor)}`);
        const result = await parseResponse(response);
        if (!response.ok) throw new Error(errorMessage(result, T.loadMoreFailed));
        const comments = Array.isArray(result.comments) ? result.comments as ClientStory[] : [];
        comments.forEach((story) => list.append(buildStory(story)));
        empty.hidden = list.childElementCount > 0;
        root.dataset.nextCursor = typeof result.nextCursor === 'string' ? result.nextCursor : '';
        loadMoreWrap.hidden = !root.dataset.nextCursor;
        listStatus.textContent = comments.length ? (comments.length === 1 ? T.moreLoadedOne : fmtT(T.moreLoadedMany, { n: comments.length })) : T.noMore;
      } catch (error) { listStatus.textContent = error instanceof Error ? error.message : T.loadMoreFailed; }
      finally { loadMoreButton.disabled = false; }
    });

    window.addEventListener('fbf:search-complete', (event: Event) => {
      const detail = (event as CustomEvent<{ finder?: Finder; searchProof?: string }>).detail;
      if (detail?.finder === finder && typeof detail.searchProof === 'string' && detail.searchProof) {
        setSearchReady(detail.searchProof);
        track('story_prompt_view', { action: 'search_complete' });
      }
    });

    searchProof = readStoredProof();
    if (searchProof) setSearchReady(searchProof);

    try {
      const marker = JSON.parse(sessionStorage.getItem(draftKey) || 'null') as { pending?: boolean; createdAt?: number } | null;
      const params = new URLSearchParams(window.location.search);
      const hashParams = new URLSearchParams(window.location.hash.replace(/^#/, ''));
      const verified = ['comment_verified', 'verified', 'finder_comment'].some((key) => params.get(key) === '1' || hashParams.get(key) === '1');
      const verificationState = params.get('comment_verification');
      const verificationFailed = verificationState === 'failed' || verificationState === 'expired' || params.get('comment_error') === 'verification';
      if (verified && (!marker?.createdAt || Date.now() - marker.createdAt < 86_400_000)) {
        lockedPrompt.hidden = true; feedbackStep.hidden = true; sharePrompt.hidden = true; storyForm.hidden = true; successState.hidden = false;
        root.querySelector<HTMLElement>('[data-success-title]')!.textContent = T.emailVerified;
        root.querySelector<HTMLElement>('[data-success-copy]')!.textContent = T.storyAwaiting;
        sessionStorage.removeItem(draftKey);
        root.scrollIntoView({ behavior: 'smooth', block: 'start' });
      } else if (verificationFailed) {
        if (marker?.pending) lockedPrompt.hidden = true;
        feedbackStep.hidden = true; sharePrompt.hidden = Boolean(marker?.pending); storyForm.hidden = true; successState.hidden = false;
        root.querySelector<HTMLElement>('[data-success-title]')!.textContent = T.verifyFailedTitle;
        root.querySelector<HTMLElement>('[data-success-copy]')!.textContent = T.verifyFailedCopy;
        root.scrollIntoView({ behavior: 'smooth', block: 'start' });
      }
    } catch { /* ignore invalid callback marker */ }
  });
</script>

