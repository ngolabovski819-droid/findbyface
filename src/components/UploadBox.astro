  .finder-tab {
    min-width: 0;
    display: grid;
    grid-template-columns: auto 1fr;
    grid-template-rows: auto auto;
    align-items: center;
    column-gap: 9px;
    padding: 11px 14px;
    border: 1px solid transparent;
    border-radius: 13px;
    color: var(--text);
    transition: transform 0.2s, border-color 0.2s, background 0.2s;
  }
  .finder-tab.included {
    border-color: rgba(168,85,247,0.52);
    background: linear-gradient(135deg, rgba(124,58,237,0.24), rgba(236,72,153,0.18));
    box-shadow: inset 0 1px 0 rgba(255,255,255,0.06);
  }
  .finder-tab.disabled { color: var(--text-muted); opacity: 0.7; cursor: not-allowed; }
  .finder-tab-icon {
    grid-row: 1 / span 2;
    display: grid;
    place-items: center;
    width: 32px;
    height: 32px;
    border-radius: 10px;
    background: rgba(124,58,237,0.15);
    color: var(--accent-light);
    font-size: 15px;
  }
  .finder-tab > span:not(.finder-tab-icon) { font-family: 'Manrope', sans-serif; font-weight: 800; font-size: 0.92rem; line-height: 1.2; }
  .finder-tab small { color: var(--text-muted); font-size: 0.68rem; line-height: 1.2; }
  .upload-box {
    width: 100%; max-width: 600px;
    border: 2px dashed var(--border); border-radius: var(--radius-lg);
    background: var(--surface); transition: border-color 0.2s, background 0.2s;
    overflow: hidden; cursor: pointer;
  }
  .upload-box.drag-over { border-color: var(--accent); background: rgba(124,58,237,0.05); }

  .upload-idle {
    display: flex; flex-direction: column; align-items: center;
    padding: 52px 24px; gap: 12px; text-align: center;
  }
  .upload-icon { width: 48px; height: 48px; color: var(--accent); margin-bottom: 8px; }
  .upload-idle h3 { font-size: 1.2rem; }
  .upload-idle p { color: var(--text-muted); font-size: 14px; }
  .upload-hint { font-size: 12px !important; opacity: 0.6; }
  .choose-btn {
    position: relative;
    overflow: hidden;
    background: linear-gradient(135deg, #7c3aed, #ec4899);
    color: #fff; border: none; border-radius: 999px;
    padding: 16px 44px; font-size: 17px; font-weight: 700;
    letter-spacing: 0.2px;
    cursor: pointer; font-family: inherit;
    margin-top: 8px;
    box-shadow: 0 8px 28px rgba(124,58,237,0.45), 0 0 0 rgba(236,72,153,0.5);
    animation: beam-pulse 2.4s ease-in-out infinite, beam-scale 2.4s ease-in-out infinite;
    transition: transform 0.18s ease, box-shadow 0.18s ease;
  }
  .choose-btn::after {
    content: '';
    position: absolute;
    top: 0; left: -130%;
    width: 60%; height: 100%;
    background: linear-gradient(100deg, transparent, rgba(255,255,255,0.55), transparent);
    transform: skewX(-20deg);
    animation: beam-shimmer 2.8s ease-in-out infinite;
  }
  .choose-btn:hover {
    animation-play-state: paused;
    transform: translateY(-2px) scale(1.03);
    box-shadow: 0 12px 36px rgba(124,58,237,0.6), 0 0 24px rgba(236,72,153,0.45);
  }
  .choose-btn:active { animation-play-state: paused; transform: translateY(0) scale(0.99); }

  @keyframes beam-pulse {
    0%, 100% { box-shadow: 0 8px 28px rgba(124,58,237,0.5), 0 0 0 0 rgba(236,72,153,0.55); }
    50% { box-shadow: 0 14px 44px rgba(124,58,237,0.75), 0 0 0 12px rgba(236,72,153,0); }
  }
  @keyframes beam-scale {
    0%, 100% { transform: scale(1); }
    50% { transform: scale(1.08); }
  }
  @keyframes beam-shimmer {
    0% { left: -130%; }
    55%, 100% { left: 160%; }
  }

  .scanning-state {
    display: flex; flex-direction: column; align-items: center;
    padding: 36px 24px; gap: 14px; text-align: center;
  }

  /* Stage: user photo ─ connector ─ rapidly switching face */
  .scan-stage {
    display: flex; align-items: center; justify-content: center;
    gap: 14px; margin-bottom: 6px;
  }

  .scanning-img-box {
    position: relative; width: 150px; height: 200px;
    border-radius: 14px; overflow: hidden;
    border: 1px solid var(--border);
    box-shadow: 0 0 0 1px rgba(124,58,237,0.15), 0 10px 30px rgba(0,0,0,0.4);
  }
  .scanning-img-box img { width: 100%; height: 100%; object-fit: cover; display: block; }

  .scan-line {
    position: absolute; left: 0; right: 0; height: 3px;
    background: linear-gradient(90deg, transparent, #00d4ff, #7c3aed, #00d4ff, transparent);
    box-shadow: 0 0 12px #00d4ff, 0 0 24px rgba(0,212,255,0.4);
    animation: scan 1.8s ease-in-out infinite; top: 0;
  }
  @keyframes scan {
    0%   { top: 0%; opacity: 0; }
    10%  { opacity: 1; }
    90%  { opacity: 1; }
    100% { top: 100%; opacity: 0; }
  }

  /* Animated face-detection corner brackets */
  .scan-bracket {
    position: absolute; width: 22px; height: 22px; pointer-events: none;
    border: 2px solid var(--accent-light);
    filter: drop-shadow(0 0 4px var(--accent-glow));
    animation: bracket-pulse 1.6s ease-in-out infinite;
  }
  .scan-bracket.tl { top: 10px; left: 10px; border-right: none; border-bottom: none; border-radius: 6px 0 0 0; }
  .scan-bracket.tr { top: 10px; right: 10px; border-left: none; border-bottom: none; border-radius: 0 6px 0 0; }
  .scan-bracket.bl { bottom: 10px; left: 10px; border-right: none; border-top: none; border-radius: 0 0 0 6px; }
  .scan-bracket.br { bottom: 10px; right: 10px; border-left: none; border-top: none; border-radius: 0 0 6px 0; }
  @keyframes bracket-pulse {
    0%, 100% { opacity: 0.45; transform: scale(1); }
    50%      { opacity: 1; transform: scale(1.06); }
  }

  .scan-tag {
    position: absolute; bottom: 6px; left: 50%; transform: translateX(-50%);
    font-size: 10px; font-weight: 600; letter-spacing: 0.04em;
    color: #fff; background: rgba(10,10,15,0.7);
    padding: 2px 9px; border-radius: 999px; backdrop-filter: blur(4px);
    white-space: nowrap;
  }

  /* Connector between the two frames */
  .scan-connector {
    position: relative; width: 44px; height: 2px;
    background: linear-gradient(90deg, var(--accent), var(--accent-pink));
    border-radius: 2px; opacity: 0.5;
  }
  .scan-connector .connector-spark {
    position: absolute; top: 50%; left: 0; width: 8px; height: 8px;
    margin-top: -4px; border-radius: 50%;
    background: #fff; box-shadow: 0 0 10px 2px var(--accent-light);
    animation: spark-travel 1.1s linear infinite;
  }
  @keyframes spark-travel {
    from { left: 0; opacity: 0; }
    15%  { opacity: 1; }
    85%  { opacity: 1; }
    to   { left: 100%; opacity: 0; }
  }

  /* Face roulette — rapidly switching creator faces (pure CSS, GPU-composited
     so it keeps flowing even while the main thread runs face detection). */
  .face-roulette {
    position: relative; width: 150px; height: 200px;
    border-radius: 14px; overflow: hidden;
    border: 1px solid var(--border);
    background: var(--surface-raised);
    box-shadow: 0 0 0 1px rgba(236,72,153,0.18), 0 10px 30px rgba(0,0,0,0.4);
  }
  .roulette-strip {
    position: absolute; top: 0; left: 0; width: 100%;
    display: flex; flex-direction: column;
    will-change: transform;
  }
  .roulette-face {
    width: 100%; height: 200px; object-fit: cover; display: block; flex: 0 0 auto;
  }
  @keyframes roulette-scroll {
    from { transform: translateY(0); }
    to   { transform: translateY(-100%); }
  }
  .roulette-placeholder {
    position: absolute; inset: 0;
    background: linear-gradient(135deg, var(--surface-raised), var(--surface));
  }
  .roulette-ring {
    position: absolute; inset: 0; pointer-events: none;
    border: 2px solid transparent;
    border-radius: 14px;
    box-shadow: inset 0 0 22px rgba(236,72,153,0.25);
    animation: ring-flicker 0.22s steps(2) infinite;
  }
  @keyframes ring-flicker {
    0% { box-shadow: inset 0 0 22px rgba(236,72,153,0.25); }
    100% { box-shadow: inset 0 0 28px rgba(124,58,237,0.35); }
  }

  .scanning-title {
    font-size: 1.15rem; font-weight: 800; letter-spacing: 0.01em;
    background: linear-gradient(135deg, var(--accent-light), var(--accent-pink));
    -webkit-background-clip: text; -webkit-text-fill-color: transparent; background-clip: text;
  }
  .scanning-title::after {
    content: ''; display: inline-block;
    animation: ellipsis 1.4s steps(4) infinite;
    width: 1em; text-align: left;
  }
  @keyframes ellipsis {
    0% { content: ''; } 25% { content: '.'; } 50% { content: '..'; } 75% { content: '...'; }
  }
  .scanning-sub { color: var(--text-muted); font-size: 13px; max-width: 400px; line-height: 1.5; }

  .progress-track {
    width: 100%; max-width: 340px; height: 6px;
    background: rgba(255,255,255,0.08); border-radius: 3px;
    overflow: hidden; position: relative;
  }
  .progress-fill {
    position: absolute; left: 0;
    height: 100%; width: 42%;
    background: linear-gradient(90deg, var(--accent), var(--accent-pink), var(--accent));
    background-size: 200% 100%;
    border-radius: 3px;
    will-change: transform;
    animation: progress-bounce 1.6s cubic-bezier(0.4, 0, 0.6, 1) infinite alternate,
               progress-shimmer 1.2s linear infinite;
  }
  @keyframes progress-bounce {
    from { transform: translateX(-100%); }
    to   { transform: translateX(238%); }
  }
  @keyframes progress-shimmer {
    from { background-position: 0% 0; }
    to   { background-position: 200% 0; }
  }

  .scan-counter {
    font-size: 12px; color: var(--text-muted); letter-spacing: 0.02em;
  }
  .scan-counter strong {
    color: var(--accent-light); font-variant-numeric: tabular-nums;
    font-weight: 700;
  }

  /* Staged checklist */
  .scan-steps {
    display: flex; flex-wrap: wrap; justify-content: center;
    gap: 8px 14px; margin-top: 4px; max-width: 420px;
  }
  .scan-step {
    display: inline-flex; align-items: center; gap: 6px;
    font-size: 12px; color: var(--text-muted);
    opacity: 0.5; transition: opacity 0.3s, color 0.3s;
  }
  .step-mark {
    width: 14px; height: 14px; border-radius: 50%;
    border: 2px solid currentColor; position: relative; flex-shrink: 0;
    transition: all 0.3s;
  }
  .scan-step.active { opacity: 1; color: var(--accent-light); }
  .scan-step.active .step-mark {
    border-color: var(--accent-light);
    box-shadow: 0 0 0 0 var(--accent-glow);
    animation: step-ping 1.2s ease-out infinite;
  }
  @keyframes step-ping {
    0%   { box-shadow: 0 0 0 0 rgba(168,85,247,0.5); }
    100% { box-shadow: 0 0 0 8px rgba(168,85,247,0); }
  }
  .scan-step.done { opacity: 1; color: var(--success); }
  .scan-step.done .step-mark {
    border-color: var(--success); background: var(--success);
  }
  .scan-step.done .step-mark::after {
    content: ''; position: absolute;
    left: 3px; top: 0px; width: 4px; height: 8px;
    border: solid #0a0a0f; border-width: 0 2px 2px 0;
    transform: rotate(45deg);
  }

  @media (max-width: 480px) {
    .scanning-img-box, .face-roulette { width: 122px; height: 162px; }
    .scan-connector { width: 28px; }
    .finder-tabs { width: 100%; max-width: 100%; gap: 5px; padding: 5px; overflow: hidden; }
    .finder-tab { display: flex; min-width: 0; overflow: hidden; flex-direction: column; gap: 4px; padding: 9px 3px; text-align: center; }
    .finder-tab-icon { width: 28px; height: 28px; }
    .finder-tab > span:not(.finder-tab-icon) { font-size: 0.78rem; }
    .finder-tab small { max-width: 100%; font-size: 0.58rem; overflow-wrap: anywhere; }
  }

  .done-state {
    display: flex; align-items: center; gap: 16px; padding: 16px 20px;
  }
  .thumbnail-img {
    width: 60px; height: 80px; object-fit: cover;
    border-radius: 8px; border: 1px solid var(--border); flex-shrink: 0;
  }
  .done-info { display: flex; flex-direction: column; gap: 6px; }
  .done-label { color: var(--text-muted); font-size: 12px; }
  .new-search-btn {
    background: transparent; border: 1px solid var(--border);
    color: var(--text); border-radius: 8px; padding: 8px 14px;
    font-size: 13px; font-weight: 500; cursor: pointer; font-family: inherit;
    transition: border-color 0.2s, background 0.2s;
  }
  .new-search-btn:hover { border-color: var(--accent); background: rgba(124,58,237,0.08); }

  .upload-error { color: #f87171; font-size: 14px; text-align: center; }
  .search-divider { color: var(--text-muted); font-size: 13px; }
  .search-bar-inline { display: flex; max-width: 480px; width: 100%; }
  .search-bar-inline input {
    flex: 1; background: var(--surface); border: 1px solid var(--border);
    border-right: none; border-radius: var(--radius) 0 0 var(--radius);
    padding: 12px 16px; color: var(--text); font-size: 14px;
    font-family: inherit; outline: none; transition: border-color 0.2s;
  }
  .search-bar-inline input:focus { border-color: var(--accent); }
  .search-bar-inline input::placeholder { color: var(--text-muted); }
  .search-bar-inline button {
    background: var(--accent); color: #fff; border: none;
    border-radius: 0 var(--radius) var(--radius) 0;
    padding: 12px 20px; font-size: 14px; font-weight: 600;
    cursor: pointer; font-family: inherit; transition: background 0.2s;
  }
  .search-bar-inline button:hover { background: var(--accent-light); }

  /* Recent-searches dropdown for the homepage mini search bar — same visual language as
     /onlyfans-search's .search-dropdown, sized for this smaller inline bar. */
  .home-search-wrap { position: relative; max-width: 480px; width: 100%; }
  .home-search-dropdown {
    position: absolute;
    top: calc(100% + 8px);
    left: 0; right: 0;
    background: #13132a;
    border: 1px solid rgba(124,58,237,0.22);
    border-radius: 16px;
    box-shadow: 0 20px 60px rgba(0,0,0,0.65), 0 0 0 1px rgba(124,58,237,0.06);
    padding: 8px 0 10px;
    z-index: 30;
    overflow: hidden;
  }
  .home-search-dropdown .dd-header {
    display: flex; align-items: center; justify-content: space-between;
    padding: 4px 16px 8px;
    border-bottom: 1px solid rgba(255,255,255,0.05);
    margin-bottom: 4px;
  }
  .home-search-dropdown .dd-label {
    font-size: 11px; font-weight: 700; letter-spacing: 0.08em; text-transform: uppercase;
    color: var(--text-muted); opacity: 0.6;
  }
  .home-search-dropdown .dd-clear-all {
    appearance: none; background: none; border: none; outline: none;
    color: var(--text-muted); font-size: 12px; font-weight: 500; font-family: inherit;
    cursor: pointer; padding: 2px 6px; border-radius: 6px; transition: color 0.15s, background 0.15s;
  }
  .home-search-dropdown .dd-clear-all:hover { color: #f87171; background: rgba(248,113,113,0.08); }
  .home-search-dropdown .dd-history {
    padding: 4px 6px 0;
    max-height: 148px; /* ~3 rows (44px each) + breathing room; rest scrolls */
    overflow-y: auto;
  }

  .face-results { width: 100%; max-width: 1200px; padding: 0 20px; margin: 0 auto; }
  .results-heading { font-size: 1.5rem; margin-bottom: 24px; text-align: center; }
  .results-header .results-heading { margin: 0; text-align: left; }
  .cross-finder-cta {
    display: grid;
    grid-template-columns: 36px minmax(0, 1fr) auto;
    align-items: center;
    gap: 12px;
    margin: 0 0 20px;
    padding: 12px 14px;
    border: 1px solid rgba(168,85,247,0.24);
    border-radius: 14px;
    background: linear-gradient(135deg, rgba(124,58,237,0.09), rgba(236,72,153,0.06));
    color: var(--text);
    text-decoration: none;
    transition: border-color 0.18s ease, background 0.18s ease, transform 0.18s ease;
  }
  .cross-finder-cta:hover {
    border-color: rgba(217,70,239,0.48);
    background: linear-gradient(135deg, rgba(124,58,237,0.15), rgba(236,72,153,0.1));
    transform: translateY(-1px);
  }
  .cross-finder-icon {
    display: grid; width: 36px; height: 36px; place-items: center;
    border-radius: 10px; background: rgba(139,92,246,0.14); color: #c4b5fd;
  }
  .cross-finder-icon svg { width: 18px; stroke: currentColor; stroke-width: 1.8; }
  .cross-finder-copy { display: grid; gap: 2px; min-width: 0; }
  .cross-finder-copy strong { font-size: 13px; }
  .cross-finder-copy small { color: var(--text-muted); font-size: 11px; line-height: 1.4; }
  .cross-finder-action { color: #d8b4fe; font-size: 12px; font-weight: 800; white-space: nowrap; }
  .face-results-grid {
    display: grid;
    grid-template-columns: repeat(4, minmax(0, 1fr));
    gap: 20px;
    align-items: start;
  }
  @media (max-width: 1024px) {
    .face-results-grid { grid-template-columns: repeat(3, minmax(0, 1fr)); }
    .video-results-grid { grid-template-columns: repeat(2, minmax(0, 1fr)); }
  }
  @media (max-width: 680px)  {
    .face-results-grid { grid-template-columns: repeat(2, minmax(0, 1fr)); gap: 14px; }
    .video-results-grid { grid-template-columns: 1fr; gap: 14px; }
    .cross-finder-cta { grid-template-columns: 32px minmax(0, 1fr); gap: 10px; padding: 11px; }
    .cross-finder-icon { width: 32px; height: 32px; }
    .cross-finder-action { grid-column: 2; }
  }
  @media (max-width: 380px)  { .face-results-grid { gap: 10px; } }

  .creator-card {
    background: var(--surface); border-radius: var(--radius-lg);
    overflow: hidden; border: 1px solid var(--border); transition: transform 0.2s, box-shadow 0.2s;
  }
  .creator-card:hover { transform: translateY(-4px); box-shadow: 0 8px 32px var(--accent-glow); }
  .card-img-wrap { aspect-ratio: 3/4; overflow: hidden; position: relative; background: var(--surface-raised); }
  .card-img-wrap img { width: 100%; height: 100%; object-fit: cover; display: block; }
  .match-badge {
    position: absolute; left: 8px; bottom: 8px; z-index: 2;
    display: inline-flex; align-items: center; gap: 5px;
    border: 1px solid rgba(255,255,255,0.24);
    border-radius: 999px; padding: 5px 9px;
    background: linear-gradient(135deg, rgba(91,33,182,0.9), rgba(219,39,119,0.86));
    color: #fff; box-shadow: 0 5px 18px rgba(46,16,101,0.42);
    backdrop-filter: blur(8px);
  }
  .match-badge strong { font-size: 12px; font-weight: 900; line-height: 1; }
  .match-badge span { color: rgba(255,255,255,0.82); font-size: 9px; font-weight: 700; line-height: 1; letter-spacing: 0.06em; text-transform: uppercase; }
  .card-body { padding: 12px 14px; }
  .creator-name { font-family: 'Manrope', sans-serif; font-weight: 700; font-size: 14px; margin-bottom: 2px; white-space: nowrap; overflow: hidden; text-overflow: ellipsis; }
  .username { color: var(--text-muted); font-size: 12px; margin-bottom: 6px; }
  .price { font-weight: 700; font-size: 15px; margin-bottom: 10px; color: var(--text-muted); }
  .price-free { color: var(--success); }
  .view-btn { display: block; text-align: center; background: var(--accent); color: #fff; border-radius: 8px; padding: 8px; font-size: 13px; font-weight: 600; transition: background 0.2s; text-decoration: none; }
  .view-btn:hover { background: var(--accent-light); }

  .creator-card.locked { cursor: pointer; }
  .lock-overlay {
    position: absolute; inset: 0;
    display: flex; align-items: center; justify-content: center;
    background: rgba(0,0,0,0.35); transition: background 0.2s;
  }
  .lock-overlay:hover { background: rgba(0,0,0,0.5); }
  .unlock-btn {
    background: rgba(124,58,237,0.92); color: #fff; border: none;
    border-radius: 999px; padding: 10px 20px; font-size: 13px; font-weight: 700;
    cursor: pointer; font-family: inherit; text-decoration: none;
    box-shadow: 0 4px 16px rgba(124,58,237,0.4); transition: background 0.2s, transform 0.1s;
  }
  .unlock-btn:hover { background: var(--accent); transform: scale(1.04); }
  .locked-body { filter: blur(3px); pointer-events: none; user-select: none; }
  .view-btn-locked {
    display: block; text-align: center; background: var(--accent);
    color: #fff; border-radius: 8px; padding: 8px; font-size: 13px; font-weight: 600;
  }

  .unlock-banner {
    margin-top: 20px; padding: 16px 20px;
    background: rgba(124,58,237,0.12); border: 1px solid rgba(124,58,237,0.3);
    border-radius: var(--radius); display: flex; align-items: center;
    justify-content: space-between; gap: 12px; flex-wrap: wrap;
  }
  .unlock-banner p { color: var(--text); font-size: 14px; margin: 0; }
  .unlock-banner-btn {
    background: var(--accent); color: #fff; border-radius: 999px;
    padding: 9px 20px; font-size: 13px; font-weight: 600;
    text-decoration: none; white-space: nowrap; transition: background 0.2s;
  }
  .unlock-banner-btn:hover { background: var(--accent-light); }

  .face-load-more-wrap {
    display: flex;
    flex-direction: column;
    align-items: center;
    gap: 10px;
    margin-top: 28px;
  }
  .face-load-more-btn {
    background: transparent;
    border: 1px solid var(--border);
    color: var(--text);
    padding: 13px 40px;
    border-radius: 999px;
    font-size: 15px;
    font-weight: 600;
    font-family: inherit;
    cursor: pointer;
    transition: border-color 0.2s, color 0.2s, box-shadow 0.2s, transform 0.2s;
  }
  .face-load-more-btn:hover:not(:disabled) {
    border-color: var(--accent);
    color: var(--accent-light);
    box-shadow: 0 8px 24px rgba(124,58,237,0.2);
    transform: translateY(-2px);
  }
  .face-load-more-btn:disabled { opacity: 0.6; cursor: default; }
  .face-results-count { color: var(--text-muted); font-size: 13px; margin: 0; }

  .results-header {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 14px;
    margin-bottom: 18px;
