<script>
  import { initCardClickThrough } from '../lib/cardClickThrough';
  import { creatorCardDataAttributes } from '../lib/creatorCardUi';

  type HomepageVideoResult = {
    title: string;
    sourceUrl?: string;
    thumbnailUrl?: string;
    durationSeconds?: number;
    similarity: number;
    supportingEmbeddings: number;
  };

  type HomepageVideoResponse = {
    ok: boolean;
    code?: string;
    error?: string;
    indexedVideos?: number;
    elapsedSeconds?: number;
    results?: HomepageVideoResult[];
  };

  // Build Google OAuth URL dynamically so localhost dev doesn't redirect to production
  function getGoogleAuthUrl(): string {
    const redirectTo = `${window.location.origin}/auth/callback`;
    return `https://sirudrqheimbgpkchtwi.supabase.co/auth/v1/authorize?provider=google&redirect_to=${encodeURIComponent(redirectTo)}`;
  }

  // Wire up auth buttons with dynamic URL
  const googleAuthBtn   = document.getElementById('googleAuthBtn') as HTMLAnchorElement | null;
  const unlockBannerBtn = document.getElementById('unlockBannerBtn') as HTMLAnchorElement | null;
  if (googleAuthBtn)   googleAuthBtn.href   = getGoogleAuthUrl();
  if (unlockBannerBtn) unlockBannerBtn.href = getGoogleAuthUrl();

  const uploadBox       = document.getElementById('uploadBox')!;
  const fileInput       = document.getElementById('fileInput') as HTMLInputElement;
  const chooseBtn       = document.getElementById('chooseBtn')!;
  const uploadIdle      = document.getElementById('uploadIdle')!;
  const uploadScanning  = document.getElementById('uploadScanning')!;
  const uploadDone      = document.getElementById('uploadDone')!;
  const scanningImg     = document.getElementById('scanningImg') as HTMLImageElement;
  const thumbnailImg    = document.getElementById('thumbnailImg') as HTMLImageElement;

  const uploadError     = document.getElementById('uploadError')!;
  const faceResults     = document.getElementById('faceResults')!;
  const faceResultsGrid = document.getElementById('faceResultsGrid')!;
  const newSearchBtn    = document.getElementById('newSearchBtn')!;
  const authModal       = document.getElementById('authModal')!;
  const authBackdrop    = document.getElementById('authBackdrop')!;
  const authClose       = document.getElementById('authClose')!;
  const authSkip        = document.getElementById('authSkip')!;
  const unlockBanner    = document.getElementById('unlockBanner')!;
  const unlockBannerText = document.getElementById('unlockBannerText')!;
  const faceLoadMoreWrap = document.getElementById('faceLoadMoreWrap')!;
  const faceLoadMoreBtn  = document.getElementById('faceLoadMoreBtn') as HTMLButtonElement;
  const faceResultsCount = document.getElementById('faceResultsCount')!;
  const copyResultsBtn   = document.getElementById('copyResultsBtn') as HTMLButtonElement;
  const shareCta         = document.getElementById('shareCta')!;
  const onlyfansResultsTab = document.getElementById('onlyfansResultsTab') as HTMLButtonElement;
  const pornstarResultsTab = document.getElementById('pornstarResultsTab') as HTMLButtonElement;
  const onlyfansResultsPanel = document.getElementById('onlyfansResultsPanel')!;
  const pornstarResultsPanel = document.getElementById('pornstarResultsPanel')!;
  const onlyfansResultCount = document.getElementById('onlyfansResultCount')!;
  const pornstarResultCount = document.getElementById('pornstarResultCount')!;
  const onlyfansPanelNotice = document.getElementById('onlyfansPanelNotice')!;
  const pornstarPanelNotice = document.getElementById('pornstarPanelNotice')!;
  const pornstarResultsMeta = document.getElementById('pornstarResultsMeta')!;
  const pornstarResultsGrid = document.getElementById('pornstarResultsGrid')!;
  const searchMode = document.getElementById('onlyfans-finder')?.dataset.searchMode === 'onlyfans'
    ? 'onlyfans'
    : 'all';

  initCardClickThrough();

  // Pagination state for face-search results
  let allFaceResults: Record<string, unknown>[] = [];
  let faceShownCount = 0;
  const FACE_PAGE_SIZE = 12;
  const FREE_REGULAR_RESULT_COUNT = 15;

  function isSignedIn(): boolean {
    try { return !!JSON.parse(localStorage.getItem('fbf_user') || 'null'); } catch { return false; }
  }
  function getSearchCount(): number {
    return parseInt(localStorage.getItem('fbf_searches') || '0');
  }
  function incrementSearchCount(): void {
    if (!isSignedIn()) localStorage.setItem('fbf_searches', String(getSearchCount() + 1));
  }
  function recordSearchHistory(results: Record<string, unknown>[], topName?: string): void {
    if (!isSignedIn()) return;
    try {
      const raw = localStorage.getItem('fbf_history');
      const history = raw ? JSON.parse(raw) as Array<Record<string, unknown>> : [];
      // Store a compact copy of the top matches so they can be re-viewed later
      const saved = results.slice(0, 18).map(c => ({
        username: c.username,
        name: c.name || c.username,
        avatar: c.avatar,
        subscribePrice: c.subscribePrice ?? c.subscribeprice,
        matchPct: c.matchPct,
      }));
      history.unshift({
        id: Date.now(),
        type: 'image',
        label: topName ? `Photo search · top match ${topName}` : 'Photo search',
        count: results.length,
        date: new Date().toISOString(),
        results: saved,
      });
      // Keep most recent 25
      localStorage.setItem('fbf_history', JSON.stringify(history.slice(0, 25)));
    } catch { /* ignore */ }
  }
  function showAuthModal(): void { 
    if (googleAuthBtn)   googleAuthBtn.href   = getGoogleAuthUrl();
    if (unlockBannerBtn) unlockBannerBtn.href = getGoogleAuthUrl();
    authModal.style.display = 'flex'; 
  }
  function hideAuthModal(): void { authModal.style.display = 'none'; }

  authBackdrop.addEventListener('click', hideAuthModal);
  authClose.addEventListener('click', hideAuthModal);
  authSkip.addEventListener('click', hideAuthModal);

  // ── Terms modal ──────────────────────────────────────────────────────────
  const termsModal     = document.getElementById('termsModal')!;
  const termsBackdrop  = document.getElementById('termsBackdrop')!;
  const termsClose     = document.getElementById('termsClose')!;
  const termsCheckbox  = document.getElementById('termsCheckbox') as HTMLInputElement;
  const termsAgreeBtn  = document.getElementById('termsAgreeBtn') as HTMLButtonElement;
  const termsCancelBtn = document.getElementById('termsCancelBtn')!;

  const TERMS_KEY = 'fbf_terms_agreed';
  let _pendingFile: File | null = null;

  function hasAgreedToTerms(): boolean {
    return localStorage.getItem(TERMS_KEY) === '1';
  }

  function showTermsModal(file: File): void {
    _pendingFile = file;
    termsCheckbox.checked = false;
    termsAgreeBtn.disabled = true;
    termsModal.style.display = 'flex';
  }

  function hideTermsModal(): void {
    termsModal.style.display = 'none';
    _pendingFile = null;
  }

  termsCheckbox.addEventListener('change', () => {
    termsAgreeBtn.disabled = !termsCheckbox.checked;
  });

  termsAgreeBtn.addEventListener('click', () => {
    if (!termsCheckbox.checked) return;
    localStorage.setItem(TERMS_KEY, '1');
    termsModal.style.display = 'none';
    if (_pendingFile) { const f = _pendingFile; _pendingFile = null; handleFile(f); }
  });

  termsCancelBtn.addEventListener('click', hideTermsModal);
  termsBackdrop.addEventListener('click', hideTermsModal);
  termsClose.addEventListener('click', hideTermsModal);

  function gatedFileOpen(file: File): void {
    if (hasAgreedToTerms()) { handleFile(file); } else { showTermsModal(file); }
  }

  // ── Upload triggers ───────────────────────────────────────────────────────
  chooseBtn.addEventListener('click', () => fileInput.click());
  fileInput.addEventListener('change', () => { if (fileInput.files?.[0]) gatedFileOpen(fileInput.files[0]); });
  uploadBox.addEventListener('dragover', e => { e.preventDefault(); uploadBox.classList.add('drag-over'); });
  uploadBox.addEventListener('dragleave', () => uploadBox.classList.remove('drag-over'));
  uploadBox.addEventListener('drop', e => {
    e.preventDefault(); uploadBox.classList.remove('drag-over');
    const file = (e as DragEvent).dataTransfer?.files[0];
    if (file?.type.startsWith('image/')) gatedFileOpen(file);
  });
  document.addEventListener('paste', e => {
    const file = e.clipboardData?.files[0];
    if (file?.type.startsWith('image/')) gatedFileOpen(file);
  });
  newSearchBtn.addEventListener('click', () => {
    uploadDone.style.display = 'none';
    uploadIdle.style.display = 'flex';
    faceResults.style.display = 'none';
    uploadError.style.display = 'none';
    fileInput.value = '';
  });

  let _faceapi: any = null;
  let _modelsLoaded = false;

  function setProgressLabel(text: string): void {
    const sub = document.querySelector('.scanning-sub') as HTMLElement | null;
    if (sub) sub.textContent = text;
  }

  // ── Scanning visual FX (staged steps + live counter) ──────────────────────
  // The face roulette + progress bar are pure CSS (GPU-composited) so they keep
  // flowing even while the main thread is busy running face detection.
  let _scanFX: { stepTimer?: number; counterRAF?: number } = {};

  function startScanFX(): void {
    stopScanFX();

    const steps = Array.from(document.querySelectorAll('.scan-step')) as HTMLElement[];
    let si = 0;
    steps.forEach((s, i) => {
      s.classList.toggle('active', i === 0);
      s.classList.remove('done');
    });
    _scanFX.stepTimer = window.setInterval(() => {
      if (si < steps.length - 1) si++;
      steps.forEach((s, i) => {
        s.classList.toggle('active', i === si);
        s.classList.toggle('done', i < si);
      });
    }, 1500);

    const counterEl = document.getElementById('scanCounter')?.querySelector('strong') as HTMLElement | null;
    if (counterEl) {
      const target = 2_413_000 + Math.floor(Math.random() * 90000);
      const start = performance.now();
      const dur = 6500;
      const tick = (now: number) => {
        const t = Math.min((now - start) / dur, 1);
        const eased = 1 - Math.pow(1 - t, 3);
        counterEl.textContent = Math.floor(eased * target).toLocaleString();
        if (t < 1) _scanFX.counterRAF = requestAnimationFrame(tick);
      };
      _scanFX.counterRAF = requestAnimationFrame(tick);
    }
  }

  function stopScanFX(): void {
    if (_scanFX.stepTimer) clearInterval(_scanFX.stepTimer);
    if (_scanFX.counterRAF) cancelAnimationFrame(_scanFX.counterRAF);
    _scanFX = {};
  }

  async function loadFaceApi(): Promise<any> {
    if (_faceapi) return _faceapi;
    if (!(window as any).faceapi) {
      await new Promise<void>((resolve, reject) => {
        const s = document.createElement('script');
        s.src = '/face-api.js';
        s.onload = () => resolve();
        s.onerror = () => reject(new Error('Failed to load face-api.js — check your connection'));
        document.head.appendChild(s);
      });
    }
    _faceapi = (window as any).faceapi;
    if (!_faceapi?.nets) throw new Error('face-api.js loaded but did not initialise correctly');
    return _faceapi;
  }

  function withTimeout<T>(promise: Promise<T>, ms: number, label: string): Promise<T> {
    return Promise.race([
      promise,
      new Promise<T>((_, reject) =>
        setTimeout(() => reject(new Error(`Timed out loading ${label} after ${ms / 1000}s`)), ms)
      ),
    ]);
  }

  async function ensureBackend(faceapi: any): Promise<void> {
    const tf = faceapi?.tf;
    if (!tf) return;
    // The backend (webgl/wasm) must be initialised before any model runs,
    // otherwise face-api throws "backend 'wasm' has not yet been initialized".
    try {
      await tf.setBackend('webgl');
    } catch {
      try { await tf.setBackend('cpu'); } catch { /* fall through to tf.ready() */ }
    }
    await tf.ready();
  }

  async function ensureModels(faceapi: any): Promise<void> {
    if (_modelsLoaded) return;
    await ensureBackend(faceapi);
    await withTimeout(
      Promise.all([
        faceapi.nets.ssdMobilenetv1.loadFromUri('/models'),
        faceapi.nets.faceLandmark68Net.loadFromUri('/models'),
        faceapi.nets.faceRecognitionNet.loadFromUri('/models'),
      ]),
      60000,
      'face detection models'
    );
    _modelsLoaded = true;
  }

  async function detectDescriptor(faceapi: any, img: HTMLImageElement): Promise<Float32Array | null> {
    const result = await faceapi
      .detectSingleFace(img, new faceapi.SsdMobilenetv1Options({ minConfidence: 0.4 }))
      .withFaceLandmarks()
      .withFaceDescriptor();
    return result?.descriptor ?? null;
  }

  function storedAccessToken(): string | null {
    try {
      const user = JSON.parse(localStorage.getItem('fbf_user') || 'null');
      return typeof user?.access_token === 'string' ? user.access_token : null;
    } catch {
      return null;
    }
  }

  async function searchPornstarIndex(file: File): Promise<HomepageVideoResponse> {
    const controller = new AbortController();
    const timeout = window.setTimeout(() => controller.abort(), 65_000);
    try {
      const body = new FormData();
      body.append('image', file);
      const headers: HeadersInit = {};
      const token = storedAccessToken();
      if (token) headers.Authorization = `Bearer ${token}`;
      const response = await fetch('/api/video-face-search', {
        method: 'POST',
        headers,
        body,
        signal: controller.signal,
      });
      const payload = await response.json() as HomepageVideoResponse;
      if (!response.ok || !payload.ok) {
        return {
          ...payload,
          ok: false,
          error: payload.error || 'Pornstar video search is temporarily unavailable.',
        };
      }
      return payload;
    } catch (error) {
      return {
        ok: false,
        error: error instanceof DOMException && error.name === 'AbortError'
          ? 'Pornstar video search timed out. Your OnlyFans results are still available.'
          : 'Pornstar video search is temporarily unavailable. Your OnlyFans results are still available.',
      };
    } finally {
      window.clearTimeout(timeout);
    }
  }

  async function handleFile(file: File): Promise<void> {
    if (!isSignedIn() && getSearchCount() >= 2) { showAuthModal(); return; }
    uploadError.style.display = 'none';

    const dataUrl = await new Promise<string>((resolve, reject) => {
      const reader = new FileReader();
      reader.onload = ev => resolve(String(ev.target?.result ?? ''));
      reader.onerror = reject;
      reader.readAsDataURL(file);
    });

    scanningImg.src = dataUrl;
    thumbnailImg.src = dataUrl;
    uploadIdle.style.display = 'none';
    uploadScanning.style.display = 'flex';
    startScanFX();

    // The homepage searches both live indexes. Dedicated tool pages only call
    // their own index so the result set stays specific to the page's promise.
    const pornstarSearch: Promise<HomepageVideoResponse> = searchMode === 'all'
      ? searchPornstarIndex(file)
      : Promise.resolve({ ok: false, code: 'not_requested' });

    // Yield so the browser paints the scanning UI before heavy face work begins.
    await new Promise(r => requestAnimationFrame(() => requestAnimationFrame(r)));

    try {
      // Phase 1: load models
      setProgressLabel('Loading face detection models (first load may take ~15s)...');
      let faceapi: any;
      try {
        faceapi = await loadFaceApi();
        await ensureModels(faceapi);
      } catch (e: any) {
        throw new Error(`Model load failed: ${e?.message ?? e}`);
      }

      // Phase 2: detect face
      setProgressLabel('Detecting face in your photo...');
      const img = new Image();
      img.src = dataUrl;
      await new Promise<void>((res, rej) => { img.onload = () => res(); img.onerror = () => rej(new Error('Image failed to decode')); });

      let descriptor: Float32Array | null;
      try {
        descriptor = await withTimeout(detectDescriptor(faceapi, img), 30000, 'face detection');
      } catch (e: any) {
        throw new Error(`Face detection failed: ${e?.message ?? e}`);
      }

      if (!descriptor) {
        throw new Error('The OnlyFans matcher could not detect a face in this image.');
      }

      // Phase 3: search API
      setProgressLabel(searchMode === 'onlyfans'
        ? 'Searching OnlyFans creator profiles...'
        : 'Searching creator profiles and indexed videos...');
      let data: any;
      try {
        const resp = await fetch('/api/face-search', {
          method: 'POST',
          headers: { 'Content-Type': 'application/json' },
          body: JSON.stringify({ descriptor: Array.from(descriptor) }),
        });
        if (!resp.ok) {
          const errText = await resp.text().catch(() => `HTTP ${resp.status}`);
          throw new Error(`API ${resp.status}: ${errText.slice(0, 120)}`);
        }
        data = await resp.json();
      } catch (e: any) {
        throw new Error(`Search API failed: ${e?.message ?? e}`);
      }

      const pornstarData = await pornstarSearch;
      incrementSearchCount();
      await new Promise(r => setTimeout(r, 300));
      stopScanFX();
      uploadScanning.style.display = 'none';
      uploadDone.style.display = 'flex';
      setProgressLabel(searchMode === 'onlyfans'
        ? 'Analyzing your image across the OnlyFans creator index.'
        : 'Analyzing your image across creator profiles and indexed adult videos.');
      const results = data.results ?? [];
      const topName = results[0] ? ((results[0].name || results[0].username) as string) : undefined;
      recordSearchHistory(results, topName);
      showResults(results, data.mode, pornstarData);
    } catch (err: any) {
      const pornstarData = await pornstarSearch;
      stopScanFX();
      uploadScanning.style.display = 'none';
      setProgressLabel(searchMode === 'onlyfans'
        ? 'Analyzing your image across the OnlyFans creator index.'
        : 'Analyzing your image across creator profiles and indexed adult videos.');
      const msg = err?.message ?? String(err);
      if (searchMode === 'all' && pornstarData.ok) {
        uploadDone.style.display = 'flex';
        showResults([], undefined, pornstarData, msg.length > 10 ? msg : 'OnlyFans creator search was unavailable.');
      } else {
        uploadIdle.style.display = 'flex';
        uploadError.textContent = msg.length > 10 ? msg : 'Search failed — please try again';
        uploadError.style.display = 'block';
      }
      console.error('[findbyface] handleFile error:', err);
    }
  }

  function proxyImg(url: string, w: number, h: number): string {
    if (!url || url.startsWith('/')) return url;
    return `https://images.weserv.nl/?url=${encodeURIComponent(url.replace(/^https?:\/\//, ''))}&w=${w}&h=${h}&fit=cover&output=webp`;
  }

  function renderCard(
    c: Record<string, unknown>,
    index: number,
    regularResultPosition: number,
    signedIn: boolean,
  ): string {
    const avatar = c.avatar as string;
    const imgSrc = avatar?.startsWith('/') ? avatar : avatar?.startsWith('http') ? proxyImg(avatar, 320, 427) : '/no-image.png';
    const price = (c.subscribePrice ?? c.subscribeprice) as number;
    const priceLabel = (!price || isNaN(Number(price))) ? 'FREE' : `$${parseFloat(String(price)).toFixed(2)}`;
    const matchPct = c.matchPct != null ? (c.matchPct as number) : null;
    const matchBadge = matchPct != null && matchPct > 0
      ? `<span class="match-badge"><strong>${matchPct}%</strong><span>match</span></span>`
      : '';
    const isSponsored = !!c.sponsored;
    const profileUrl = (c.profileUrl as string) || `https://onlyfans.com/${encodeURIComponent(c.username as string)}`;
    const rel = (profileUrl as string).startsWith('/go/') ? 'noopener nofollow sponsored' : 'noopener nofollow';
    // Keep the first 15 regular results visible to signed-out visitors. Sponsored cards
    // are not part of that count and always remain visible and clearly disclosed.
    const locked = !signedIn && !isSponsored && regularResultPosition > FREE_REGULAR_RESULT_COUNT;

    if (locked) {
      return `<div class="creator-card locked" data-href="/signup">
        <div class="card-img-wrap">
          <img src="${imgSrc}" alt="Locked creator" loading="lazy" decoding="async" referrerpolicy="no-referrer"
            style="filter:blur(10px);transform:scale(1.08);"
            onerror="if(this.src!=='/no-image.png'){this.src='/no-image.png';}">
          ${matchBadge}
          <div class="lock-overlay">
            <a class="unlock-btn" href="/signup">🔓 Unlock</a>
          </div>
        </div>
        <div class="card-body locked-body">
          <p class="creator-name">••••• •••••</p>
          <p class="username">@••••••••</p>
          <p class="price">${priceLabel}</p>
          <div class="view-btn-locked">View Profile</div>
        </div>
      </div>`;
    }

    const cardData = creatorCardDataAttributes(c);
    return `<div class="creator-card" data-href="${profileUrl}" ${cardData}>
      <div class="card-img-wrap">
        <img src="${imgSrc}" alt="${(c.name || c.username) as string}" loading="${index === 0 ? 'eager' : 'lazy'}"
          decoding="async" referrerpolicy="no-referrer"
          onerror="if(this.src!=='/no-image.png'){this.src='/no-image.png';}">
        ${matchBadge}
      </div>
      <div class="card-body">
        <p class="creator-name">${(c.name || c.username) as string}</p>
        <p class="username">@${c.username as string}</p>
        <p class="price ${priceLabel === 'FREE' ? 'price-free' : ''}">${priceLabel}</p>
        <a href="${profileUrl}" class="view-btn" target="_blank" rel="${rel}">View Profile</a>
      </div>
    </div>`;
  }

  function formatVideoDuration(value?: number): string {
    if (!value || value < 0) return '';
    const total = Math.round(value);
    const hours = Math.floor(total / 3600);
    const minutes = Math.floor((total % 3600) / 60);
    const seconds = total % 60;
    return hours > 0
      ? `${hours}:${String(minutes).padStart(2, '0')}:${String(seconds).padStart(2, '0')}`
      : `${minutes}:${String(seconds).padStart(2, '0')}`;
  }

  function createVideoResultCard(result: HomepageVideoResult, rank: number): HTMLElement {
    const card = document.createElement('article');
    card.className = 'home-video-card';

    const hasSource = result.sourceUrl?.startsWith('https://');
    const media = document.createElement(hasSource ? 'a' : 'div');
    media.className = 'home-video-media';
    if (media instanceof HTMLAnchorElement && hasSource) {
      media.href = result.sourceUrl!;
      media.target = '_blank';
      media.rel = 'noopener noreferrer';
    }
    const image = document.createElement('img');
    image.src = result.thumbnailUrl?.startsWith('http') ? result.thumbnailUrl : '/favicon.png';
    image.alt = '';
    image.loading = rank > 4 ? 'lazy' : 'eager';
    image.referrerPolicy = 'origin';
    media.appendChild(image);
    const rankBadge = document.createElement('span');
    rankBadge.className = 'home-video-rank';
    rankBadge.textContent = `#${rank}`;
    media.appendChild(rankBadge);
    const duration = formatVideoDuration(result.durationSeconds);
    if (duration) {
      const durationBadge = document.createElement('span');
      durationBadge.className = 'home-video-duration';
      durationBadge.textContent = duration;
      media.appendChild(durationBadge);
    }
    card.appendChild(media);

    const body = document.createElement('div');
    body.className = 'home-video-body';
    const title = document.createElement('h3');
    title.textContent = result.title || 'Indexed video match';
    body.appendChild(title);
    const metrics = document.createElement('p');
    const similarity = Number.isFinite(result.similarity) ? `${(result.similarity * 100).toFixed(1)}% similarity` : 'Ranked match';
    const evidence = `${result.supportingEmbeddings || 0} supporting face${result.supportingEmbeddings === 1 ? '' : 's'}`;
    metrics.textContent = `${similarity} · ${evidence}`;
    body.appendChild(metrics);
    if (hasSource) {
      const source = document.createElement('a');
      source.href = result.sourceUrl!;
      source.target = '_blank';
      source.rel = 'noopener noreferrer';
      source.className = 'home-video-source';
      source.textContent = 'Open source video ↗';
      body.appendChild(source);
    }
    card.appendChild(body);
    return card;
  }

  function renderPornstarResults(payload: HomepageVideoResponse): void {
    const results = payload.results ?? [];
    pornstarResultsGrid.replaceChildren();
    pornstarPanelNotice.style.display = 'none';
    pornstarResultCount.textContent = payload.ok ? `(${results.length})` : '(unavailable)';
    if (!payload.ok) {
      pornstarPanelNotice.textContent = payload.error || 'Pornstar video search is temporarily unavailable.';
      pornstarPanelNotice.style.display = 'block';
      pornstarResultsMeta.textContent = '';
      return;
    }
    pornstarResultsMeta.textContent = `${results.length} video match${results.length === 1 ? '' : 'es'} · ${(payload.indexedVideos ?? 0).toLocaleString()} videos indexed · ${(payload.elapsedSeconds ?? 0).toFixed(1)}s`;
    if (results.length === 0) {
      pornstarPanelNotice.textContent = 'No matching video appearances were found in the current index. Try another clear frame.';
      pornstarPanelNotice.style.display = 'block';
      return;
    }
    results.forEach((result, index) => {
      pornstarResultsGrid.appendChild(createVideoResultCard(result, index + 1));
    });
  }

  function selectResultSource(source: 'onlyfans' | 'pornstars'): void {
    const onlyfansActive = source === 'onlyfans';
    onlyfansResultsPanel.hidden = !onlyfansActive;
    pornstarResultsPanel.hidden = onlyfansActive;
    onlyfansResultsTab.classList.toggle('active', onlyfansActive);
    pornstarResultsTab.classList.toggle('active', !onlyfansActive);
    onlyfansResultsTab.setAttribute('aria-selected', String(onlyfansActive));
    pornstarResultsTab.setAttribute('aria-selected', String(!onlyfansActive));
    copyResultsBtn.style.display = onlyfansActive ? 'inline-flex' : 'none';
  }

  onlyfansResultsTab.addEventListener('click', () => selectResultSource('onlyfans'));
  pornstarResultsTab.addEventListener('click', () => selectResultSource('pornstars'));

  function showResults(
    results: Record<string, unknown>[],
    mode?: string,
    pornstarPayload?: HomepageVideoResponse,
    onlyfansError?: string,
  ): void {
    const heading = document.querySelector('.results-heading') as HTMLElement | null;
    if (heading) {
      heading.textContent = 'Your matches';
    }
    allFaceResults = results;
    faceShownCount = 0;
    faceResultsGrid.innerHTML = '';
    if (shareCta) shareCta.style.display = 'none';
    renderNextFacePage();
    updateCopyBtn();
    onlyfansResultCount.textContent = onlyfansError ? '(unavailable)' : `(${results.length})`;
    onlyfansPanelNotice.style.display = onlyfansError || results.length === 0 ? 'block' : 'none';
    onlyfansPanelNotice.textContent = onlyfansError || (results.length === 0
      ? 'No matching OnlyFans creator profiles were found. Try a clearer, front-facing photo.'
      : '');
    if (searchMode === 'all') {
      renderPornstarResults(pornstarPayload ?? { ok: false, error: 'Pornstar video results were unavailable for this search.' });
      selectResultSource(onlyfansError && pornstarPayload?.ok ? 'pornstars' : 'onlyfans');
    } else {
      selectResultSource('onlyfans');
    }
    faceResults.style.display = 'block';
    faceResults.scrollIntoView({ behavior: 'smooth', block: 'start' });
  }

  function renderNextFacePage(): void {
    const signedIn = isSignedIn();
    const next = allFaceResults.slice(faceShownCount, faceShownCount + FACE_PAGE_SIZE);
    let regularResultPosition = allFaceResults
      .slice(0, faceShownCount)
      .filter(c => !c.sponsored)
      .length;
    const html = next
      .map((c, i) => {
        if (!c.sponsored) regularResultPosition += 1;
        return renderCard(c, faceShownCount + i, regularResultPosition, signedIn);
      })
      .join('');
    faceResultsGrid.insertAdjacentHTML('beforeend', html);
    faceShownCount += next.length;
    updateFaceResultsUI();
  }

  function updateFaceResultsUI(): void {
    const signedIn = isSignedIn();
    const total = allFaceResults.length;

    // Load more button: show while there are more results to reveal
    if (faceShownCount < total) {
      const remaining = total - faceShownCount;
      const nextBatch = Math.min(FACE_PAGE_SIZE, remaining);
      faceLoadMoreBtn.textContent = `Load ${nextBatch} more match${nextBatch === 1 ? '' : 'es'}`;
      faceLoadMoreWrap.style.display = 'flex';
    } else {
      faceLoadMoreWrap.style.display = 'none';
    }
    faceResultsCount.textContent = `Showing ${faceShownCount} of ${total} matches`;

    const shownRegularResults = allFaceResults
      .slice(0, faceShownCount)
      .filter(c => !c.sponsored)
      .length;

    // Unlock banner: shown once a locked regular result has been rendered.
    if (!signedIn && shownRegularResults > FREE_REGULAR_RESULT_COUNT) {
      unlockBannerText.innerHTML = `🔒 <strong>More matches are locked</strong> — sign in free to reveal every lookalike`;
      unlockBanner.style.display = 'flex';
    } else {
      unlockBanner.style.display = 'none';
    }
  }

  faceLoadMoreBtn?.addEventListener('click', () => {
    faceLoadMoreBtn.disabled = true;
    renderNextFacePage();
    faceLoadMoreBtn.disabled = false;
  });

  function buildTop10Text(): string {
    const top = allFaceResults.slice(0, 10);
    const lines = top.map((c, i) => {
      const name = (c.name || c.username) as string;
      const handle = c.username as string;
      const matchPct = c.matchPct != null ? (c.matchPct as number) : null;
      const matchTag = matchPct != null && matchPct > 0 ? ` — ${matchPct}% match` : '';
      return `${i + 1}. ${name} (@${handle})${matchTag}\n   https://onlyfans.com/${handle}`;
    });
    return `My top ${top.length} OnlyFans lookalike matches from findbyface.org:\n\n${lines.join('\n')}\n\nFind yours free at https://findbyface.org`;
  }

  copyResultsBtn?.addEventListener('click', async () => {
    // Gate behind sign-in
    if (!isSignedIn()) {
      authModal.style.display = 'flex';
      return;
    }
    if (allFaceResults.length === 0) return;

    const text = buildTop10Text();
    const labelEl = copyResultsBtn.querySelector('.copy-label') as HTMLElement | null;
    const original = labelEl?.textContent ?? 'Copy top 10';

    try {
      await navigator.clipboard.writeText(text);
    } catch {
      // Fallback for older browsers / insecure contexts
      const ta = document.createElement('textarea');
      ta.value = text;
      ta.style.position = 'fixed';
      ta.style.opacity = '0';
      document.body.appendChild(ta);
      ta.select();
      try { document.execCommand('copy'); } catch { /* ignore */ }
      document.body.removeChild(ta);
    }

    copyResultsBtn.classList.add('copied');
    if (labelEl) labelEl.textContent = 'Copied!';
    if (shareCta) {
      shareCta.style.display = 'flex';
      shareCta.scrollIntoView({ behavior: 'smooth', block: 'nearest' });
    }
    setTimeout(() => {
      copyResultsBtn.classList.remove('copied');
      if (labelEl) labelEl.textContent = original;
    }, 1800);
  });

  function updateCopyBtn(): void {
    if (!copyResultsBtn) return;
    const labelEl = copyResultsBtn.querySelector('.copy-label') as HTMLElement | null;
    if (isSignedIn()) {
      copyResultsBtn.classList.remove('locked');
      if (labelEl) labelEl.textContent = 'Copy top 10';
      copyResultsBtn.title = 'Copy your top 10 closest matches';
    } else {
      copyResultsBtn.classList.add('locked');
      if (labelEl) labelEl.textContent = 'Copy top 10';
      copyResultsBtn.title = 'Sign in free to copy your top 10 matches';
    }
  }
</script>

