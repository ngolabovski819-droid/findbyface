---
import { proxyImg } from '../utils/image';

interface Props {
  searchMode?: 'all' | 'onlyfans';
}

const { searchMode = 'all' } = Astro.props;

const SUPABASE_URL = import.meta.env.SUPABASE_URL?.replace(/\/+$/, '');
const SUPABASE_KEY = import.meta.env.SUPABASE_KEY;

// Avatars that power the "searching through faces" roulette animation.
let rouletteSrcs: string[] = [];
if (SUPABASE_URL && SUPABASE_KEY) {
  try {
    const params = new URLSearchParams({
      select: 'avatar',
      avatar: 'not.is.null',
      order: 'favoritedcount.desc',
      limit: '24',
    });
    const resp = await fetch(`${SUPABASE_URL}/rest/v1/onlyfans_profiles?${params}`, {
      headers: {
        apikey: SUPABASE_KEY,
        Authorization: `Bearer ${SUPABASE_KEY}`,
        'Accept-Profile': 'public',
      },
    });
    if (resp.ok) {
      const raw = await resp.json();
      rouletteSrcs = raw
        .map((r: Record<string, unknown>) => r.avatar as string)
        .filter((a: string) => a?.startsWith('http'))
        .map((a: string) => proxyImg(a, 160, 213));
    }
  } catch { /* roulette is decorative — fail silently */ }
}
