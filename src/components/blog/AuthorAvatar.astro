---
interface Props {
  size?: number;
}

const { size = 64 } = Astro.props;
const gradId = `authorAvatarGrad-${Math.random().toString(36).slice(2, 8)}`;
---

<svg
  class="author-avatar-svg"
  width={size}
  height={size}
  viewBox="0 0 64 64"
  role="img"
  aria-label="Author avatar"
>
  <defs>
    <linearGradient id={gradId} x1="0" y1="0" x2="1" y2="1">
      <stop offset="0%" stop-color="#7c3aed" />
      <stop offset="100%" stop-color="#ec4899" />
    </linearGradient>
  </defs>
  <circle cx="32" cy="32" r="32" fill={`url(#${gradId})`} />

  <!-- crop-corner scan frame -->
  <g stroke="#ffffff" stroke-opacity="0.85" stroke-width="2" stroke-linecap="round" fill="none">
    <path d="M15 21v-4a2 2 0 0 1 2-2h4" />
    <path d="M43 15h4a2 2 0 0 1 2 2v4" />
    <path d="M49 43v4a2 2 0 0 1-2 2h-4" />
    <path d="M21 49h-4a2 2 0 0 1-2-2v-4" />
  </g>

  <!-- abstract face mesh -->
  <g stroke="#ffffff" stroke-opacity="0.9" fill="none">
    <path
      d="M32 18c-8 0-13 6-13 15 0 9 5 15 13 15s13-6 13-15c0-9-5-15-13-15Z"
      stroke-width="1.6"
      stroke-opacity="0.55"
    />
    <path d="M22 30l6-3 4 2.5 4-2.5 6 3" stroke-width="1.1" stroke-opacity="0.5" />
    <path d="M25 40l7 3 7-3" stroke-width="1.1" stroke-opacity="0.5" />
  </g>
  <g fill="#ffffff">
    <circle cx="26" cy="30" r="1.6" />
    <circle cx="38" cy="30" r="1.6" />
    <circle cx="32" cy="41" r="1.4" fill-opacity="0.7" />
  </g>

  <!-- scan beam accent -->
  <line x1="17" y1="26" x2="47" y2="26" stroke="#ffffff" stroke-opacity="0.35" stroke-width="1" />
</svg>

<style>
  .author-avatar-svg {
    display: block;
    border-radius: 50%;
    flex-shrink: 0;
  }
</style>
