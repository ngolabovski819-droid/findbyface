---
import ShareButtons from './ShareButtons.astro';
import { localeOf } from '../../i18n/routes';
import { t } from '../../i18n/ui';

interface Props {
  image?: string;
  title: string;
  publishedLabel: string;
  updatedLabel?: string;
  shareUrl: string;
}

const { image, title, publishedLabel, updatedLabel, shareUrl } = Astro.props;
const lang = localeOf(Astro.url.pathname);
---

<div class="featured-visual">
  {image ? (
    <img src={image} alt={title} loading="eager" fetchpriority="high" />
  ) : (
    <div class="fv-graphic" aria-hidden="true">
      <span class="fv-grid"></span>
      <span class="fv-glow"></span>
      <span class="fv-icon">
        <svg width="46" height="46" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.6" stroke-linecap="round" stroke-linejoin="round"><rect x="2.5" y="4" width="14" height="14" rx="2"/><circle cx="9.5" cy="11" r="2.6"/><circle cx="16.5" cy="16.5" r="4.3" stroke-width="1.8"/><line x1="19.6" y1="19.6" x2="22" y2="22" stroke-width="1.8"/></svg>
      </span>
      <span class="fv-scan-dot fv-dot-1"></span>
      <span class="fv-scan-dot fv-dot-2"></span>
      <span class="fv-scan-dot fv-dot-3"></span>
    </div>
  )}
  <div class="fv-overlay">
    <div class="fv-dates">
      <span>{t(lang, 'blog.published')} {publishedLabel}</span>
      {updatedLabel && <span class="fv-updated">{t(lang, 'blog.updated')} {updatedLabel}</span>}
    </div>
    <ShareButtons url={shareUrl} title={title} />
  </div>
</div>

<style>
  .featured-visual {
    position: relative;
    isolation: isolate;
    margin-bottom: 28px;
    aspect-ratio: 16 / 6;
    border-radius: var(--radius-lg);
    overflow: hidden;
    border: 1px solid var(--border);
    background: var(--surface-raised);
  }

  .featured-visual img { width: 100%; height: 100%; object-fit: cover; display: block; }

  .fv-graphic {
    position: absolute;
    inset: 0;
    background:
      radial-gradient(circle at 30% 35%, rgba(124, 58, 237, 0.32), transparent 55%),
      radial-gradient(circle at 75% 65%, rgba(236, 72, 153, 0.24), transparent 50%),
      linear-gradient(155deg, #17131f 0%, #0d0d15 60%, #120e1a 100%);
  }

  .fv-grid {
    position: absolute;
    inset: 0;
    opacity: 0.22;
    background-image:
      linear-gradient(rgba(177, 105, 255, 0.08) 1px, transparent 1px),
      linear-gradient(90deg, rgba(177, 105, 255, 0.08) 1px, transparent 1px);
    background-size: 28px 28px;
    mask-image: radial-gradient(ellipse at center, #000 40%, transparent 85%);
  }

  .fv-glow {
    position: absolute;
    left: 50%;
    top: 50%;
    width: 240px;
    height: 240px;
    transform: translate(-50%, -50%);
    background: rgba(168, 85, 247, 0.25);
    filter: blur(60px);
    border-radius: 50%;
  }

  .fv-icon {
    position: absolute;
    left: 50%;
    top: 50%;
    transform: translate(-50%, -50%);
    display: grid;
    place-items: center;
    width: 92px;
    height: 92px;
    border-radius: 22px;
    color: #fff;
    background: linear-gradient(135deg, rgba(124, 58, 237, 0.9), rgba(236, 72, 153, 0.85));
    box-shadow: 0 20px 50px rgba(124, 58, 237, 0.35);
  }

  .fv-scan-dot {
    position: absolute;
    width: 6px;
    height: 6px;
    border-radius: 50%;
    background: #fff;
    box-shadow: 0 0 8px rgba(255, 255, 255, 0.6);
    animation: fv-pulse 2.4s ease-in-out infinite;
  }
  .fv-dot-1 { left: 28%; top: 38%; animation-delay: 0s; }
  .fv-dot-2 { left: 68%; top: 30%; animation-delay: 0.6s; }
  .fv-dot-3 { left: 60%; top: 68%; animation-delay: 1.2s; }

  @keyframes fv-pulse { 0%, 100% { opacity: 0.35; } 50% { opacity: 1; } }
  @media (prefers-reduced-motion: reduce) { .fv-scan-dot { animation: none; } }

  .fv-overlay {
    position: absolute;
    left: 0;
    right: 0;
    bottom: 0;
    display: flex;
    align-items: flex-end;
    justify-content: space-between;
    gap: 12px;
    padding: 36px 20px 16px;
    background: linear-gradient(to top, rgba(6, 6, 10, 0.82), transparent);
  }

  .fv-dates {
    display: flex;
    flex-wrap: wrap;
    gap: 4px 12px;
    color: rgba(255, 255, 255, 0.82);
    font-size: 0.76rem;
    font-weight: 600;
  }

  .fv-updated { color: rgba(255, 255, 255, 0.55); }

  @media (max-width: 520px) {
    .featured-visual { aspect-ratio: 4 / 3; }
    .fv-overlay { flex-direction: column; align-items: flex-start; gap: 10px; }
  }
</style>
