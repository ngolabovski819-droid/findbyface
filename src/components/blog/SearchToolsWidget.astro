---
import { localeOf, localizePath } from '../../i18n/routes';
import { t } from '../../i18n/ui';

const lang = localeOf(Astro.url.pathname);
---

<aside class="tools-widget" aria-label={t(lang, 'blog.toolsAria')}>
  <p class="tools-widget-kicker">{t(lang, 'blog.tryIt')}</p>
  <a class="tool-card" href={localizePath('/onlyfans-finder-by-face/', lang)}>
    <span class="tool-icon" aria-hidden="true">
      <svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M9 3H5a2 2 0 0 0-2 2v4M15 3h4a2 2 0 0 1 2 2v4M9 21H5a2 2 0 0 1-2-2v-4M15 21h4a2 2 0 0 0 2-2v-4"/><circle cx="12" cy="12" r="3"/></svg>
    </span>
    <span class="tool-copy">
      <strong>{t(lang, 'blog.toolOF')}</strong>
      <small>{t(lang, 'blog.toolOFsub')}</small>
    </span>
    <span class="tool-arrow" aria-hidden="true">→</span>
  </a>
  <a class="tool-card" href={localizePath('/pornstar-finder-by-face/', lang)}>
    <span class="tool-icon" aria-hidden="true">
      <svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><polygon points="23 7 16 12 23 17 23 7"/><rect x="1" y="5" width="15" height="14" rx="2" ry="2"/></svg>
    </span>
    <span class="tool-copy">
      <strong>{t(lang, 'blog.toolPS')}</strong>
      <small>{t(lang, 'blog.toolPSsub')}</small>
    </span>
    <span class="tool-arrow" aria-hidden="true">→</span>
  </a>
  <p class="tools-widget-note">{t(lang, 'blog.toolsNote')}</p>
</aside>

<style>
  .tools-widget {
    display: grid;
    gap: 12px;
    padding: 22px;
    border: 1px solid var(--border);
    border-radius: var(--radius-lg);
    background: linear-gradient(160deg, rgba(124, 58, 237, 0.1), rgba(236, 72, 153, 0.04), var(--surface));
  }

  .tools-widget-kicker {
    margin: 0;
    font-size: 0.7rem;
    font-weight: 800;
    letter-spacing: 0.09em;
    text-transform: uppercase;
    color: var(--accent-light);
  }

  .tool-card {
    display: flex;
    align-items: center;
    gap: 12px;
    padding: 14px;
    border: 1px solid var(--border);
    border-radius: 14px;
    background: var(--surface);
    transition: transform 0.15s, border-color 0.15s, box-shadow 0.15s;
  }

  .tool-card:hover {
    transform: translateY(-2px);
    border-color: var(--accent);
    box-shadow: 0 10px 26px var(--accent-glow);
  }

  .tool-icon {
    display: grid;
    place-items: center;
    flex: 0 0 40px;
    width: 40px;
    height: 40px;
    border-radius: 11px;
    color: #fff;
    background: linear-gradient(135deg, #7c3aed, #ec4899);
  }

  .tool-copy { display: grid; min-width: 0; }
  .tool-copy strong { font-family: 'Manrope', sans-serif; font-size: 0.88rem; color: var(--text); }
  .tool-copy small { color: var(--text-muted); font-size: 0.74rem; }

  .tool-arrow {
    margin-left: auto;
    color: var(--accent-light);
    font-weight: 700;
    flex-shrink: 0;
  }

  .tools-widget-note {
    margin: 4px 2px 0;
    font-size: 0.72rem;
    color: var(--text-muted);
    line-height: 1.5;
  }
</style>
