---
import Nav from '../components/Nav.astro';
import CreatorCardEnhancements from '../components/CreatorCardEnhancements.astro';

interface Props {
  title: string;
  description?: string;
  canonical?: string;
  robots?: string;
  image?: string;
  imageAlt?: string;
  imageWidth?: number;
  imageHeight?: number;
}

const {
  title,
  description = 'Find lookalike OnlyFans creators instantly. Upload a photo and discover matching creators in seconds.',
  canonical,
  robots,
  image,
  imageAlt,
  imageWidth = 1200,
  imageHeight = 630,
} = Astro.props;

const canonicalUrl = canonical ?? new URL(Astro.url.pathname, 'https://findbyface.org').href;
const socialImageUrl = image ? new URL(image, canonicalUrl).href : null;
---

<!DOCTYPE html>
<html lang="en">
<head>
  <meta charset="UTF-8" />
  <meta name="viewport" content="width=device-width, initial-scale=1.0" />
  <script is:inline>
    // Supabase normally returns implicit-flow credentials to /auth/callback. If its
    // Site URL or an older email template lands on another page, recover the payload
    // before that page can render a signed-out state.
    (() => {
      if (window.location.pathname.startsWith('/auth/callback')) return;
      const hash = window.location.hash.slice(1);
      const params = new URLSearchParams(hash);
      if (params.has('access_token') || params.has('refresh_token') || params.has('error')) {
        window.location.replace(`/auth/callback${window.location.search}${window.location.hash}`);
      }
    })();
  </script>
  <!-- Google tag (gtag.js) -->
  <script async src="https://www.googletagmanager.com/gtag/js?id=G-G3L4HTH15M"></script>
  <script>
    window.dataLayer = window.dataLayer || [];
    function gtag(){dataLayer.push(arguments);}
    gtag('js', new Date());
    gtag('config', 'G-G3L4HTH15M');
  </script>
  <script>
    // Classifies the /api/click-token fetch (src/components/CreatorCardEnhancements.astro)
    // as real-browser vs. scripted traffic — see src/pages/api/click-token.ts for how the
    // verdict is used. Mounted here so it runs on every real page load.
    import { initBotId } from 'botid/client/core';
    initBotId({ protect: [{ path: '/api/click-token', method: 'GET' }] });
  </script>
  <title>{title}</title>
  <meta name="description" content={description} />
  {robots && <meta name="robots" content={robots} />}
  <link rel="canonical" href={canonicalUrl} />

  <!-- Open Graph -->
  <meta property="og:type" content="website" />
  <meta property="og:site_name" content="findbyface" />
  <meta property="og:locale" content="en_US" />
  <meta property="og:url" content={canonicalUrl} />
  <meta property="og:title" content={title} />
  <meta property="og:description" content={description} />
  {socialImageUrl && <meta property="og:image" content={socialImageUrl} />}
  {socialImageUrl && <meta property="og:image:secure_url" content={socialImageUrl} />}
  {socialImageUrl && <meta property="og:image:width" content={String(imageWidth)} />}
  {socialImageUrl && <meta property="og:image:height" content={String(imageHeight)} />}
  {socialImageUrl && imageAlt && <meta property="og:image:alt" content={imageAlt} />}

  <!-- Twitter -->
  <meta name="twitter:card" content={socialImageUrl ? 'summary_large_image' : 'summary'} />
  <meta name="twitter:title" content={title} />
  <meta name="twitter:description" content={description} />
  {socialImageUrl && <meta name="twitter:image" content={socialImageUrl} />}
  {socialImageUrl && imageAlt && <meta name="twitter:image:alt" content={imageAlt} />}

  <link rel="icon" type="image/png" href="/favicon.png?v=2" />
  <link rel="apple-touch-icon" sizes="180x180" href="/apple-touch-icon.png" />
  <link rel="preconnect" href="https://fonts.googleapis.com" />
  <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
  <link rel="preconnect" href="https://images.weserv.nl" crossorigin />
  <link href="https://fonts.googleapis.com/css2?family=Inter:wght@400;500;600;700&family=Manrope:wght@600;700;800&display=swap" rel="stylesheet" />
  <slot name="head" />
</head>
<body>
  <Nav />
  <CreatorCardEnhancements />
  <main>
    <slot />
  </main>
  <footer class="site-footer">
    <div class="footer-inner">
      <a href="/" class="logo-text">
        <img class="footer-logo-mark" src="/findbyface-logo.png" alt="" width="40" height="40" loading="lazy" />
        <span><span style="color:#fff">find</span><span style="background:linear-gradient(135deg,#7c3aed,#ec4899);-webkit-background-clip:text;-webkit-text-fill-color:transparent;background-clip:text;">byface</span></span>
      </a>
      <nav class="footer-links">
        <a href="/about/">About</a>
        <a href="/how-our-search-engine-works/">How Our Search Engine Works</a>
        <a href="/blog/">Blog</a>
        <a href="/onlyfans-search/">Search</a>
        <a href="/onlyfans-finder-by-face/">OnlyFans Finder</a>
        <a href="/pornstar-finder-by-face/">Pornstar Finder</a>
        <a href="/battle/">Creator Battle</a>
        <a href="/categories/top/">Categories</a>
        <a href="/promote/">Promote Your OnlyFans</a>
        <a href="/contact/">Contact</a>
        <a href="/privacy-policy/">Privacy</a>
        <a href="/terms-of-use/">Terms</a>
        <a href="/dmca/">DMCA</a>
        <a href="/sitemap/">Sitemap</a>
      </nav>
      <div class="footer-legal-group">
        <p class="footer-legal">© {new Date().getFullYear()} findbyface.org — For entertainment purposes only. Results are based on visual similarity and are not an indication of identity.</p>
        <p class="footer-legal">All rights reserved. findbyface.org is neither owned nor affiliated with onlyfans.com, which is a registered trademark of Fenix International Limited.</p>
      </div>
    </div>
  </footer>
</body>
</html>

<style is:global>
  :root {
    --bg: #0a0a0f;
    --surface: #12121a;
    --surface-raised: #1a1a2e;
    --accent: #7c3aed;
    --accent-light: #a855f7;
    --accent-pink: #ec4899;
    --accent-glow: rgba(124,58,237,0.25);
    --text: #f0f0f5;
    --text-muted: #8888aa;
    --border: rgba(124,58,237,0.2);
    --success: #22c55e;
    --radius: 12px;
    --radius-lg: 20px;
  }

  *, *::before, *::after { box-sizing: border-box; margin: 0; padding: 0; }

  body {
    background: var(--bg);
    color: var(--text);
    font-family: 'Inter', sans-serif;
    line-height: 1.6;
    min-height: 100vh;
  }

  h1, h2, h3, h4 { font-family: 'Manrope', sans-serif; font-weight: 800; }
  a { color: inherit; text-decoration: none; }

  ::-webkit-scrollbar { width: 6px; }
  ::-webkit-scrollbar-track { background: var(--bg); }
  ::-webkit-scrollbar-thumb { background: var(--accent); border-radius: 3px; }

  .logo-text {
    font-family: 'Manrope', sans-serif;
    font-weight: 800;
    font-size: 1.4rem;
    display: inline-flex;
    align-items: center;
    gap: 10px;
  }

  .footer-logo-mark {
    width: 40px;
    height: 40px;
    border-radius: 10px;
    object-fit: cover;
  }

  .site-footer {
    border-top: 1px solid var(--border);
    margin-top: 80px;
    padding: 48px 20px;
  }

  .footer-inner {
    max-width: 1200px;
    margin: 0 auto;
    display: flex;
    flex-direction: column;
    align-items: center;
    gap: 20px;
    text-align: center;
  }

  .footer-links {
    display: flex;
    gap: 28px;
    flex-wrap: wrap;
    justify-content: center;
  }

  .footer-links a {
    color: var(--text-muted);
    font-size: 14px;
    transition: color 0.2s;
  }

  .footer-links a:hover { color: var(--text); }

  .footer-legal-group {
    display: flex;
    flex-direction: column;
    gap: 6px;
    max-width: 600px;
  }

  .footer-legal {
    color: var(--text-muted);
    font-size: 12px;
    line-height: 1.7;
  }

  /* Shared content / legal pages */
  .prose-page {
    max-width: 820px;
    margin: 0 auto;
    padding: 120px 20px 40px;
  }

  .prose-page .page-head {
    text-align: center;
    margin-bottom: 40px;
  }

  .prose-page .page-head h1 {
    font-size: clamp(2rem, 5vw, 3rem);
    line-height: 1.15;
    margin-bottom: 12px;
  }

  .prose-page .page-head .gradient-text {
    background: linear-gradient(135deg, #7c3aed, #ec4899);
    -webkit-background-clip: text;
    -webkit-text-fill-color: transparent;
    background-clip: text;
  }

  .prose-page .page-head p {
    color: var(--text-muted);
    font-size: 1rem;
    max-width: 560px;
    margin: 0 auto;
  }

  .prose-page .page-updated {
    color: var(--text-muted);
    font-size: 13px;
    margin-top: 8px;
  }

  .prose {
    background: var(--surface);
    border: 1px solid var(--border);
    border-radius: var(--radius-lg);
    padding: 36px 40px;
  }

  .prose h2 {
    font-size: 1.4rem;
    margin: 32px 0 12px;
    color: var(--text);
  }

  .prose h2:first-child { margin-top: 0; }

  .prose h3 {
    font-size: 1.1rem;
    margin: 24px 0 10px;
    color: var(--text);
  }

  .prose p {
    color: var(--text-muted);
    margin-bottom: 14px;
    line-height: 1.75;
  }

  .prose ul, .prose ol {
    color: var(--text-muted);
    margin: 0 0 16px 22px;
    line-height: 1.75;
  }

  .prose li { margin-bottom: 6px; }

  .prose a {
    color: var(--accent-light);
    text-decoration: underline;
    text-underline-offset: 2px;
  }

  .prose a:hover { color: var(--accent-pink); }

  .prose strong { color: var(--text); }

  @media (max-width: 600px) {
    .prose { padding: 24px 20px; }
    .prose-page { padding-top: 96px; }
  }
</style>
