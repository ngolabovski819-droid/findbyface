---
import Nav from '../components/Nav.astro';
import PromoStrip from '../components/PromoStrip.astro';
import CreatorCardEnhancements from '../components/CreatorCardEnhancements.astro';
import { alternatePath, localeOf, localizePath, type Locale } from '../i18n/routes';
import { t, type UIKey } from '../i18n/ui';
import { absUrl } from '../lib/site';
import { slugToCategory } from '../config/categories';

interface Props {
  title: string;
  description?: string;
  canonical?: string;
  robots?: string;
  image?: string;
  imageAlt?: string;
  imageWidth?: number;
  imageHeight?: number;
  lang?: Locale;
  // Counterpart URL path in the other locale, for the hreflang cluster.
  // undefined = look it up in the routes map (static pages — automatic);
  // string    = explicit counterpart (dynamic pages: blog posts, categories);
  // null      = no translation exists → suppress hreflang entirely.
  alternate?: string | null;
}

const lang: Locale = Astro.props.lang ?? localeOf(Astro.url.pathname);

const {
  title,
  description = lang === 'es'
    ? 'Encuentra creadoras de OnlyFans parecidas al instante. Sube una foto y descubre perfiles similares en segundos.'
    : 'Find lookalike OnlyFans creators instantly. Upload a photo and discover matching creators in seconds.',
  canonical,
  robots,
  image,
  imageAlt,
  imageWidth = 1200,
  imageHeight = 630,
} = Astro.props;

const pathWithSlash = Astro.url.pathname.endsWith('/') ? Astro.url.pathname : `${Astro.url.pathname}/`;
const canonicalUrl = canonical ?? absUrl(pathWithSlash);
const socialImageUrl = image ? new URL(image, canonicalUrl).href : null;

// hreflang cluster: en + es + x-default (English). Only emitted when a real
// translation counterpart exists and the page is indexable.
const alt = Astro.props.alternate === undefined
  ? alternatePath(Astro.url.pathname)
  : (Astro.props.alternate ?? undefined);
const altHref = alt ? absUrl(alt) : undefined;
const enHref = lang === 'en' ? canonicalUrl : altHref;
const esHref = lang === 'es' ? canonicalUrl : altHref;
const noindex = robots?.includes('noindex') ?? false;

// Facebook's locale code for "Spanish (Latin America)" is es_LA — this is
// intentionally not an ISO code ('LA' here is not Laos); do not "fix" it.
const ogLocale = lang === 'es' ? 'es_LA' : 'en_US';
const ogLocaleAlt = lang === 'es' ? 'en_US' : 'es_LA';

const lp = (p: string) => localizePath(p, lang);
const footerCategoryHref = (slug: string, slugEs?: string) =>
  lang === 'es' ? `/es/categorias/${slugEs ?? slug}/` : `/categories/${slug}/`;

// Footer category columns — every one of the 38 categories in config/categories.ts
// appears exactly once, grouped for scanability (screenshot-referenced layout).
// English slugs are the stable key; group membership is an editorial call, not derived.
const FOOTER_CATEGORY_GROUPS: { labelKey: UIKey; slugs: string[] }[] = [
  { labelKey: 'footer.catPopular', slugs: ['top', 'free', 'milf', 'models', 'big-tits'] },
  { labelKey: 'footer.catAppearance', slugs: ['blonde', 'redhead', 'petite', 'small-tits', 'white-girls', 'bbw', 'mature'] },
  { labelKey: 'footer.catBackground', slugs: ['latina', 'asian', 'ebony', 'indian', 'korean', 'japanese', 'greek', 'serbian', 'italian', 'dutch', 'trans'] },
  { labelKey: 'footer.catContentType', slugs: ['feet', 'blowjob', 'footjob', 'bondage', 'bbc', 'anal', 'hentai', 'old-young', 'threesome', 'bukkake', 'celebrity', 'strap-on', 'rough-sex', 'solo-male', 'pussy-licking'] },
];

// Footer language switcher targets: counterpart of the current page, falling
// back to the other locale's homepage when no translation exists.
const esTarget = lang === 'es' ? Astro.url.pathname : (alt ?? '/es/');
const enTarget = lang === 'en' ? Astro.url.pathname : (alt ?? '/');
---

<!DOCTYPE html>
<html lang={lang}>
<head>
  <meta charset="UTF-8" />
  <meta name="viewport" content="width=device-width, initial-scale=1.0" />
  <script is:inline>
    // Supabase normally returns implicit-flow credentials to /auth/callback. If its
    // Site URL or an older email template lands on another page, recover the payload
    // before that page can render a signed-out state.
    (() => {
      if (window.location.pathname.startsWith('/auth/callback')) return;
      const hash = window.location.hash.slice(1);
      const params = new URLSearchParams(hash);
      if (params.has('access_token') || params.has('refresh_token') || params.has('error')) {
        window.location.replace(`/auth/callback${window.location.search}${window.location.hash}`);
      }
    })();
  </script>
  <!-- Google tag (gtag.js) -->
  <script async src="https://www.googletagmanager.com/gtag/js?id=G-G3L4HTH15M"></script>
  <script>
    window.dataLayer = window.dataLayer || [];
    function gtag(){dataLayer.push(arguments);}
    gtag('js', new Date());
    gtag('config', 'G-G3L4HTH15M');
  </script>
  <script>
    // Classifies the /api/click-token fetch (src/components/CreatorCardEnhancements.astro)
    // as real-browser vs. scripted traffic — see src/pages/api/click-token.ts for how the
    // verdict is used. Mounted here so it runs on every real page load.
    import { initBotId } from 'botid/client/core';
    initBotId({ protect: [{ path: '/api/click-token', method: 'GET' }] });
  </script>
  <title>{title}</title>
  <meta name="description" content={description} />
  {robots && <meta name="robots" content={robots} />}
  <link rel="canonical" href={canonicalUrl} />
  {!noindex && enHref && esHref && (
    <>
      <link rel="alternate" hreflang="en" href={enHref} />
      <link rel="alternate" hreflang="es" href={esHref} />
      <link rel="alternate" hreflang="x-default" href={enHref} />
    </>
  )}

  <!-- Open Graph -->
  <meta property="og:type" content="website" />
  <meta property="og:site_name" content="findbyface" />
  <meta property="og:locale" content={ogLocale} />
  {altHref && <meta property="og:locale:alternate" content={ogLocaleAlt} />}
  <meta property="og:url" content={canonicalUrl} />
  <meta property="og:title" content={title} />
  <meta property="og:description" content={description} />
  {socialImageUrl && <meta property="og:image" content={socialImageUrl} />}
  {socialImageUrl && <meta property="og:image:secure_url" content={socialImageUrl} />}
  {socialImageUrl && <meta property="og:image:width" content={String(imageWidth)} />}
  {socialImageUrl && <meta property="og:image:height" content={String(imageHeight)} />}
  {socialImageUrl && imageAlt && <meta property="og:image:alt" content={imageAlt} />}

  <!-- Twitter -->
  <meta name="twitter:card" content={socialImageUrl ? 'summary_large_image' : 'summary'} />
  <meta name="twitter:title" content={title} />
  <meta name="twitter:description" content={description} />
  {socialImageUrl && <meta name="twitter:image" content={socialImageUrl} />}
  {socialImageUrl && imageAlt && <meta name="twitter:image:alt" content={imageAlt} />}

  <link rel="icon" type="image/png" href="/favicon.png?v=2" />
  <link rel="apple-touch-icon" sizes="180x180" href="/apple-touch-icon.png" />
  <link rel="preconnect" href="https://fonts.googleapis.com" />
  <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
  <link rel="preconnect" href="https://images.weserv.nl" crossorigin />
  <link href="https://fonts.googleapis.com/css2?family=Inter:wght@400;500;600;700&family=Manrope:wght@600;700;800&display=swap" rel="stylesheet" />
  <slot name="head" />
</head>
<body>
  <Nav />
  <PromoStrip />
  <CreatorCardEnhancements />
  <main>
    <slot />
  </main>
  <footer class="site-footer">
    <div class="footer-inner">
      <a href={lang === 'es' ? '/es/' : '/'} class="logo-text">
        <img class="footer-logo-mark" src="/findbyface-logo.png" alt="" width="40" height="40" loading="lazy" />
        <span><span style="color:#fff">find</span><span style="background:linear-gradient(135deg,#7c3aed,#ec4899);-webkit-background-clip:text;-webkit-text-fill-color:transparent;background-clip:text;">byface</span></span>
      </a>

      <div class="footer-categories">
        {FOOTER_CATEGORY_GROUPS.map(group => (
          <div class="footer-cat-col">
            <h4>{t(lang, group.labelKey)}</h4>
            {group.slugs.map(slug => {
              const cat = slugToCategory(slug);
              if (!cat) return null;
              return (
                <a href={footerCategoryHref(cat.slug, cat.slugEs)}>
                  {lang === 'es' ? cat.labelEs : cat.label}
                </a>
              );
            })}
          </div>
        ))}
      </div>

      <nav class="footer-links">
        <a href={lp('/about/')}>{t(lang, 'footer.about')}</a>
        <a href={lp('/how-our-search-engine-works/')}>{t(lang, 'footer.how')}</a>
        <a href={lp('/blog/')}>{t(lang, 'footer.blog')}</a>
        <a href={lp('/onlyfans-search/')}>{t(lang, 'footer.search')}</a>
        <a href={lp('/onlyfans-finder-by-face/')}>{t(lang, 'footer.onlyfansFinder')}</a>
        <a href={lp('/pornstar-finder-by-face/')}>{t(lang, 'footer.pornstarFinder')}</a>
        <a href={lp('/battle/')}>{t(lang, 'footer.battle')}</a>
        <a href={lp('/promote/')}>{t(lang, 'footer.promote')}</a>
        <a href={lp('/contact/')}>{t(lang, 'footer.contact')}</a>
        <a href={lp('/privacy-policy/')}>{t(lang, 'footer.privacy')}</a>
        <a href={lp('/terms-of-use/')}>{t(lang, 'footer.terms')}</a>
        <a href={lp('/community-guidelines/')}>{t(lang, 'footer.guidelines')}</a>
        <a href={lp('/dmca/')}>{t(lang, 'footer.dmca')}</a>
        <a href={lp('/sitemap/')}>{t(lang, 'footer.sitemap')}</a>
      </nav>
      <div class="lang-menu footer-lang" aria-label="Language / Idioma">
        <button type="button" class="lang-trigger" id="footerLangTrigger" aria-haspopup="true" aria-expanded="false">
          <svg class="lang-globe" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><circle cx="12" cy="12" r="10"/><path d="M2 12h20M12 2a15.3 15.3 0 0 1 4 10 15.3 15.3 0 0 1-4 10 15.3 15.3 0 0 1-4-10 15.3 15.3 0 0 1 4-10z"/></svg>
          <span>{lang === 'es' ? 'Español' : 'English'}</span>
          <svg class="lang-chevron" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.4" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><polyline points="6 9 12 15 18 9"/></svg>
        </button>
        <div class="lang-dropdown" id="footerLangDropdown">
          <a href={enTarget} hreflang="en" lang="en" class={lang === 'en' ? 'active' : ''}>English {lang === 'en' && <span class="lang-check" aria-hidden="true">✓</span>}</a>
          <a href={esTarget} hreflang="es" lang="es" class={lang === 'es' ? 'active' : ''}>Español {lang === 'es' && <span class="lang-check" aria-hidden="true">✓</span>}</a>
        </div>
      </div>
      <div class="footer-legal-group">
        <p class="footer-legal">{t(lang, 'footer.legal1', { year: new Date().getFullYear() })}</p>
        <p class="footer-legal">{t(lang, 'footer.legal2')}</p>
      </div>
    </div>
  </footer>
  <script>
    // Footer language switcher toggle
    const langMenu = document.querySelector('.footer-lang');
    const langTrigger = document.getElementById('footerLangTrigger');
    const langDropdown = document.getElementById('footerLangDropdown');
    if (langMenu && langTrigger && langDropdown) {
      const closeLang = () => {
        langDropdown.classList.remove('open');
        langTrigger.setAttribute('aria-expanded', 'false');
      };
      langTrigger.addEventListener('click', event => {
        event.stopPropagation();
        const open = langDropdown.classList.toggle('open');
        langTrigger.setAttribute('aria-expanded', String(open));
      });
      document.addEventListener('click', event => {
        if (!langMenu.contains(event.target as Node)) closeLang();
      });
      document.addEventListener('keydown', event => {
        if (event.key === 'Escape') closeLang();
      });
    }
  </script>
</body>
</html>

<style is:global>
  :root {
    --bg: #0a0a0f;
    --surface: #12121a;
    --surface-raised: #1a1a2e;
    --accent: #7c3aed;
    --accent-light: #a855f7;
    --accent-pink: #ec4899;
    --accent-glow: rgba(124,58,237,0.25);
    --text: #f0f0f5;
    --text-muted: #8888aa;
    --border: rgba(124,58,237,0.2);
    --success: #22c55e;
    --radius: 12px;
    --radius-lg: 20px;
  }

  *, *::before, *::after { box-sizing: border-box; margin: 0; padding: 0; }

  body {
    background: var(--bg);
    color: var(--text);
    font-family: 'Inter', sans-serif;
    line-height: 1.6;
    min-height: 100vh;
  }

  /* The promo strip is fixed directly under the fixed nav, so it doesn't take up
     flow space on its own — this shifts normal content down by its height so it
     never covers the top of a page. Class is added by PromoStrip.astro only when
     the strip is actually visible (i.e. not previously dismissed). */
  body.has-promo-strip { padding-top: 26px; }
  @media (max-width: 760px) { body.has-promo-strip { padding-top: 25px; } }

  h1, h2, h3, h4 { font-family: 'Manrope', sans-serif; font-weight: 800; }
  a { color: inherit; text-decoration: none; }

  ::-webkit-scrollbar { width: 6px; }
  ::-webkit-scrollbar-track { background: var(--bg); }
  ::-webkit-scrollbar-thumb { background: var(--accent); border-radius: 3px; }

  .logo-text {
    font-family: 'Manrope', sans-serif;
    font-weight: 800;
    font-size: 1.4rem;
    display: inline-flex;
    align-items: center;
    gap: 10px;
  }

  .footer-logo-mark {
    width: 40px;
    height: 40px;
    border-radius: 10px;
    object-fit: cover;
  }

  .site-footer {
    border-top: 1px solid var(--border);
    margin-top: 80px;
    padding: 48px 20px;
  }

  .footer-inner {
    max-width: 1200px;
    margin: 0 auto;
    display: flex;
    flex-direction: column;
    align-items: center;
    gap: 20px;
    text-align: center;
  }

  .footer-categories {
    width: 100%;
    display: grid;
    grid-template-columns: repeat(4, max-content);
    justify-content: center;
    column-gap: 64px;
    row-gap: 0;
    text-align: left;
    padding-bottom: 28px;
    border-bottom: 1px solid var(--border);
  }

  .footer-cat-col h4 {
    font-family: 'Manrope', sans-serif;
    font-size: 12px;
    font-weight: 800;
    letter-spacing: 0.03em;
    text-transform: uppercase;
    color: var(--text);
    margin-bottom: 10px;
  }

  .footer-cat-col {
    display: flex;
    flex-direction: column;
    gap: 7px;
    min-width: 110px;
  }

  .footer-cat-col a {
    color: var(--text-muted);
    font-size: 13px;
    line-height: 1.3;
    white-space: nowrap;
    transition: color 0.2s;
  }

  .footer-cat-col a:hover { color: var(--text); }

  .footer-links {
    display: flex;
    gap: 28px;
    flex-wrap: wrap;
    justify-content: center;
  }

  .footer-links a {
    color: var(--text-muted);
    font-size: 14px;
    transition: color 0.2s;
  }

  .footer-links a:hover { color: var(--text); }

  @media (max-width: 860px) {
    .footer-categories {
      grid-template-columns: repeat(2, max-content);
      justify-content: center;
      justify-items: start;
      column-gap: 48px;
      row-gap: 26px;
      text-align: left;
    }
    .footer-cat-col { align-items: flex-start; }
  }

  /* Footer language switcher — compact globe pill with a drop-UP menu */
  .footer-lang { position: relative; }

  .lang-trigger {
    display: inline-flex;
    align-items: center;
    gap: 7px;
    padding: 7px 13px;
    border: 1px solid var(--border);
    border-radius: 999px;
    background: rgba(255,255,255,0.025);
    color: var(--text);
    font-family: inherit;
    font-size: 13px;
    font-weight: 700;
    white-space: nowrap;
    cursor: pointer;
    transition: border-color 0.2s, background 0.2s;
  }
  .lang-trigger:hover { border-color: rgba(167,139,250,0.55); background: rgba(124,58,237,0.11); }
  .lang-globe { width: 15px; height: 15px; color: var(--text-muted); flex-shrink: 0; }
  .lang-chevron { width: 12px; height: 12px; color: var(--text-muted); transition: transform 0.2s; flex-shrink: 0; }
  .lang-trigger[aria-expanded="true"] .lang-chevron { transform: rotate(180deg); }

  .lang-dropdown {
    position: absolute;
    bottom: calc(100% + 10px);
    left: 50%;
    min-width: 158px;
    padding: 6px;
    border: 1px solid var(--border);
    border-radius: var(--radius);
    background: var(--surface-raised);
    box-shadow: 0 16px 48px rgba(0,0,0,0.5);
    opacity: 0;
    visibility: hidden;
    transform: translate(-50%, 6px);
    transition: opacity 0.18s ease, transform 0.18s ease, visibility 0.18s;
    z-index: 200;
    text-align: left;
  }
  .lang-dropdown.open { opacity: 1; visibility: visible; transform: translate(-50%, 0); }

  .lang-dropdown a {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 14px;
    padding: 9px 11px;
    border-radius: 9px;
    font-size: 13.5px;
    font-weight: 500;
    color: var(--text-muted);
    transition: background 0.15s, color 0.15s;
  }
  .lang-dropdown a:hover { background: rgba(124,58,237,0.14); color: var(--text); }
  .lang-dropdown a.active { color: var(--text); font-weight: 700; }
  .lang-check {
    background: linear-gradient(135deg, var(--accent-light), var(--accent-pink));
    -webkit-background-clip: text;
    -webkit-text-fill-color: transparent;
    background-clip: text;
    font-weight: 900;
  }

  .footer-legal-group {
    display: flex;
    flex-direction: column;
    gap: 6px;
    max-width: 600px;
  }

  .footer-legal {
    color: var(--text-muted);
    font-size: 12px;
    line-height: 1.7;
  }

  /* Shared content / legal pages */
  .prose-page {
    max-width: 820px;
    margin: 0 auto;
    padding: 120px 20px 40px;
  }

  .prose-page .page-head {
    text-align: center;
    margin-bottom: 40px;
  }

  .prose-page .page-head h1 {
    font-size: clamp(2rem, 5vw, 3rem);
    line-height: 1.15;
    margin-bottom: 12px;
  }

  .prose-page .page-head .gradient-text {
    background: linear-gradient(135deg, #7c3aed, #ec4899);
    -webkit-background-clip: text;
    -webkit-text-fill-color: transparent;
    background-clip: text;
  }

  .prose-page .page-head p {
    color: var(--text-muted);
    font-size: 1rem;
    max-width: 560px;
    margin: 0 auto;
  }

  .prose-page .page-updated {
    color: var(--text-muted);
    font-size: 13px;
    margin-top: 8px;
  }

  .prose {
    background: var(--surface);
    border: 1px solid var(--border);
    border-radius: var(--radius-lg);
    padding: 36px 40px;
  }

  .prose h2 {
    font-size: 1.4rem;
    margin: 32px 0 12px;
    color: var(--text);
  }

  .prose h2:first-child { margin-top: 0; }

  .prose h3 {
    font-size: 1.1rem;
    margin: 24px 0 10px;
    color: var(--text);
  }

  .prose p {
    color: var(--text-muted);
    margin-bottom: 14px;
    line-height: 1.75;
  }

  .prose ul, .prose ol {
    color: var(--text-muted);
    margin: 0 0 16px 22px;
    line-height: 1.75;
  }

  .prose li { margin-bottom: 6px; }

  .prose a {
    color: var(--accent-light);
    text-decoration: underline;
    text-underline-offset: 2px;
  }

  .prose a:hover { color: var(--accent-pink); }

  .prose strong { color: var(--text); }

  @media (max-width: 600px) {
    .prose { padding: 24px 20px; }
    .prose-page { padding-top: 96px; }
  }
</style>
