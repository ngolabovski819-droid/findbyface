---
// Deliberately not Base.astro — no marketing Nav/footer/GA4, this is an internal tool surface,
// not a page real visitors should land on organically (see the noindex meta + robots.txt
// Disallow). It reuses Base.astro's CSS custom properties so the brand still feels consistent.
//
// `nav` gates the whole authenticated shell (sidebar + account footer) — only pages reached
// after src/middleware.ts has verified a session pass it. The login page doesn't (there's no
// session yet, nothing to navigate to), and gets a minimal brand-only header instead.
import { panelBase } from '../lib/panelHost';
import { modelOptionsFor, type ModelOption } from '../config/panelClients';

interface Props {
  title: string;
  // Who's logged in (session.name — "Bernard"), not which model is being viewed ("Emily").
  // The sidebar footer is an account-identity widget; conflating it with the active model was
  // a real bug once a guest's own name stopped matching their model's name.
  accountName?: string;
  role?: 'admin' | 'guest';
  nav?: boolean;
  // A guest's own campaign slugs (their token's clientSlugs) — drives both the quick-switcher
  // tabs and whether the "Campaigns" nav link shows up for them. Always empty for admin, who
  // uses that nav link to see every configured client instead of a personal subset.
  clientSlugs?: string[];
  activeModelSlug?: string;
  // Explicit override for the switcher tabs, used only by pages that need admin-facing
  // switching (currently just Activity log, which also offers an "All models" tab) — when set,
  // this replaces the guest-derived modelOptions entirely rather than being merged with them,
  // so a page opts into exactly the tab set it supports instead of every /panel/* page having
  // to understand slugs like 'all' that only Activity log's data layer knows how to resolve.
  modelSwitcherOptions?: ModelOption[];
}
const { title, accountName, role, nav = false, clientSlugs = [], activeModelSlug, modelSwitcherOptions } = Astro.props;

const base = panelBase(Astro.request);
const modelOptions: ModelOption[] = modelSwitcherOptions ?? modelOptionsFor(clientSlugs);
const showModelSwitcher = modelSwitcherOptions ? modelOptions.length > 1 : (role === 'guest' && modelOptions.length > 1);
// Always visible, even for a single-campaign guest — the Campaigns page is a reasonable place
// to land regardless of count, and staying visible means the link doesn't shift around in the
// nav the moment a second campaign gets added. campaigns.astro's own route guard still governs
// what a guest actually SEES there (their own slugs only), this just controls the link itself.

interface NavItem { href: string; label: string; extra?: boolean }
const NAV_ITEMS: NavItem[] = [
  { href: '/', label: 'Dashboard' },
  { href: '/activity/', label: 'Activity log' },
  { href: '/account/', label: 'Account' },
  { href: '/campaigns/', label: 'Campaigns', extra: true },
];

// Astro.url reflects the REWRITTEN path (always /panel/... internally, regardless of which
// host got us here — see middleware.ts) so comparing against a /panel-prefixed target works
// the same whether the visitor is on the subdomain or the findbyface.org/panel/* fallback.
const activePath = Astro.url.pathname.replace(/\/+$/, '') || '/panel';
function isActive(href: string): boolean {
  const target = (href === '/' ? '/panel' : `/panel${href}`).replace(/\/+$/, '');
  return activePath === target;
}

// Where a model-switcher tab should link: the current page, re-based for whichever host we're
// on, with just the ?client= param swapped — so switching models from Activity log keeps you
// on Activity log instead of bouncing to the dashboard.
const innerPath = Astro.url.pathname.replace(/^\/panel/, '') || '/';
const publicPath = `${base}${innerPath}`;
---
<!DOCTYPE html>
<html lang="en">
<head>
  <meta charset="UTF-8" />
  <meta name="viewport" content="width=device-width, initial-scale=1.0" />
  <meta name="robots" content="noindex, nofollow" />
  <title>{title}</title>
  <link rel="icon" type="image/png" href="/favicon.png?v=2" />
  <link rel="preconnect" href="https://fonts.googleapis.com" />
  <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
  <link href="https://fonts.googleapis.com/css2?family=Inter:wght@400;500;600;700&family=Manrope:wght@600;700;800&display=swap" rel="stylesheet" />
</head>
<body>
  {nav ? (
    <div class="panel-shell">
      <div class="sidebar-backdrop" id="sidebarBackdrop"></div>
      <aside class="panel-sidebar" id="panelSidebar">
        <a href={`${base}/`} class="panel-brand">
          <img src="/findbyface-logo.png" alt="" width="28" height="28" />
          <span><span class="brand-find">find</span><span class="brand-byface">byface</span></span>
        </a>
        <span class="panel-tag">Client Panel</span>

        <nav class="panel-nav" aria-label="Panel navigation">
          <span class="nav-group-label">Main</span>
          {NAV_ITEMS.filter(item => !item.extra).map(item => (
            <a href={`${base}${item.href}`} class={`nav-link ${isActive(item.href) ? 'active' : ''}`} aria-current={isActive(item.href) ? 'page' : undefined}>
              {item.href === '/' && <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><rect x="3" y="3" width="7" height="7"></rect><rect x="14" y="3" width="7" height="7"></rect><rect x="14" y="14" width="7" height="7"></rect><rect x="3" y="14" width="7" height="7"></rect></svg>}
              {item.href === '/activity/' && <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M8 6h13M8 12h13M8 18h13"></path><circle cx="3.5" cy="6" r="1"></circle><circle cx="3.5" cy="12" r="1"></circle><circle cx="3.5" cy="18" r="1"></circle></svg>}
              {item.href === '/account/' && <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><circle cx="12" cy="8" r="4"></circle><path d="M4 20c0-4.4 3.6-7 8-7s8 2.6 8 7"></path></svg>}
              <span>{item.label}</span>
            </a>
          ))}

          <span class="nav-group-label">{role === 'admin' ? 'Admin' : 'More'}</span>
          {NAV_ITEMS.filter(item => item.extra).map(item => (
            <a href={`${base}${item.href}`} class={`nav-link ${isActive(item.href) ? 'active' : ''}`} aria-current={isActive(item.href) ? 'page' : undefined}>
              <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M17 21v-2a4 4 0 0 0-4-4H5a4 4 0 0 0-4 4v2"></path><circle cx="9" cy="7" r="4"></circle><path d="M23 21v-2a4 4 0 0 0-3-3.87"></path><path d="M16 3.13a4 4 0 0 1 0 7.75"></path></svg>
              <span>{item.label}</span>
            </a>
          ))}
        </nav>

        <div class="sidebar-footer">
          <div class="footer-avatar">{(accountName ?? '?').charAt(0).toUpperCase()}</div>
          <div class="footer-meta">
            <strong>{accountName ?? 'Account'}</strong>
            {role && <span>{role}</span>}
          </div>
          <button type="button" class="footer-logout" id="panelLogoutBtn" aria-label="Log out">
            <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M9 21H5a2 2 0 0 1-2-2V5a2 2 0 0 1 2-2h4"></path><polyline points="16 17 21 12 16 7"></polyline><line x1="21" y1="12" x2="9" y2="12"></line></svg>
          </button>
        </div>
      </aside>

      <div class="panel-content">
        <header class="mobile-topbar">
          <button type="button" class="hamburger" id="sidebarToggle" aria-label="Open navigation" aria-expanded="false" aria-controls="panelSidebar">
            <span></span><span></span><span></span>
          </button>
          <span class="panel-brand">
            <span><span class="brand-find">find</span><span class="brand-byface">byface</span></span>
          </span>
        </header>
        {showModelSwitcher && (
          <div class="model-switcher">
            <span class="model-switcher-label">Viewing</span>
            <div class="model-tabs" role="tablist">
              {modelOptions.map(m => (
                <a
                  href={`${publicPath}?client=${encodeURIComponent(m.slug)}`}
                  class={`model-tab ${m.slug === activeModelSlug ? 'active' : ''}`}
                  role="tab"
                  aria-selected={m.slug === activeModelSlug ? 'true' : 'false'}
                >{m.displayName}</a>
              ))}
            </div>
          </div>
        )}
        <main class="panel-main">
          <slot />
        </main>
      </div>
    </div>
  ) : (
    <>
      <header class="panel-topbar-minimal">
        <span class="panel-brand">
          <img src="/findbyface-logo.png" alt="" width="30" height="30" />
          <span><span class="brand-find">find</span><span class="brand-byface">byface</span></span>
        </span>
        <span class="panel-tag">Client Panel</span>
      </header>
      <main class="panel-main">
        <slot />
      </main>
    </>
  )}
</body>
</html>

<style is:global>
  :root {
    --bg: #0a0a0f; --surface: #12121a; --surface-raised: #1a1a2e;
    --accent: #7c3aed; --accent-light: #a855f7; --accent-pink: #ec4899;
    --accent-glow: rgba(124,58,237,0.25);
    --text: #f0f0f5; --text-muted: #8888aa; --border: rgba(124,58,237,0.2);
    --success: #22c55e; --radius: 12px; --radius-lg: 20px;
  }
  *, *::before, *::after { box-sizing: border-box; margin: 0; padding: 0; }
  /* Deliberately NOT overflow-x: hidden on html/body. That was tried as a safety net and
     reverted — it doesn't fix overflow, it just hides the symptom: any content pushed past
     the edge becomes invisible AND unreachable (no scroll to get to it), which is worse than
     a page that scrolls sideways. The actual fix belongs at the source — minmax(0, 1fr) on
     grid tracks that hold unbounded content, overflow-wrap on long unbreakable strings (see
     the account page's dt/dd rows and the placement/site list rows) — so there's nothing left
     to hide in the first place. */
  body { background: var(--bg); color: var(--text); font-family: 'Inter', sans-serif; line-height: 1.6; min-height: 100vh; }
  h1, h2, h3, h4 { font-family: 'Manrope', sans-serif; font-weight: 800; }
  a { color: inherit; text-decoration: none; }
  ::-webkit-scrollbar { width: 6px; }
  ::-webkit-scrollbar-track { background: var(--bg); }
  ::-webkit-scrollbar-thumb { background: var(--accent); border-radius: 3px; }

  .panel-brand { display: flex; align-items: center; gap: 9px; font-family: 'Manrope', sans-serif; font-weight: 800; font-size: 1.02rem; }
  .panel-brand img { border-radius: 8px; display: block; }
  .brand-find { color: #fff; }
  .brand-byface { background: linear-gradient(135deg, #7c3aed, #ec4899); -webkit-background-clip: text; -webkit-text-fill-color: transparent; background-clip: text; }
  .panel-tag {
    padding: 3px 9px; border-radius: 999px; width: fit-content;
    border: 1px solid var(--border); background: rgba(124,58,237,0.12);
    color: var(--text-muted); font-size: 11px; font-weight: 700; letter-spacing: 0.02em;
  }

  /* Minimal header — login page only (no session yet, nothing to navigate to) */
  .panel-topbar-minimal {
    display: flex; align-items: center; gap: 12px;
    padding: 16px 24px; border-bottom: 1px solid var(--border);
    background: rgba(10,10,15,0.9); backdrop-filter: blur(12px);
  }

  /* Authenticated shell */
  .panel-shell { display: flex; min-height: 100vh; }
  .panel-sidebar {
    width: 240px; flex-shrink: 0; position: sticky; top: 0; height: 100vh;
    display: flex; flex-direction: column; gap: 4px;
    padding: 18px 14px 14px; background: #0c0b12; border-right: 1px solid var(--border);
    overflow-y: auto;
  }
  .panel-sidebar > .panel-brand { padding: 4px 8px 0; }
  .panel-sidebar > .panel-tag { margin: 8px 8px 6px; }

  .panel-nav { display: flex; flex-direction: column; gap: 2px; margin-top: 8px; flex: 1; }
  .nav-group-label { margin: 14px 10px 6px; color: var(--text-muted); font-size: 0.62rem; font-weight: 800; text-transform: uppercase; letter-spacing: 0.08em; }
  .nav-group-label:first-child { margin-top: 2px; }
  .nav-link { display: flex; align-items: center; gap: 11px; padding: 9px 10px; border-radius: 9px; color: var(--text-muted); font-size: 0.83rem; font-weight: 600; transition: background 0.15s, color 0.15s; }
  .nav-link svg { width: 17px; height: 17px; flex-shrink: 0; }
  .nav-link:hover { background: rgba(255,255,255,0.045); color: var(--text); }
  .nav-link.active { background: rgba(124,58,237,0.18); color: #fff; }
  .nav-link.active svg { color: #c084fc; }

  .sidebar-footer { display: flex; align-items: center; gap: 10px; padding: 12px 8px 4px; border-top: 1px solid var(--border); margin-top: 8px; }
  .footer-avatar { width: 34px; height: 34px; border-radius: 10px; flex-shrink: 0; display: flex; align-items: center; justify-content: center; background: linear-gradient(135deg,#7c3aed,#ec4899); color: #fff; font-weight: 800; font-size: 0.85rem; }
  .footer-meta { display: grid; min-width: 0; flex: 1; }
  .footer-meta strong { font-size: 0.78rem; color: #fff; overflow: hidden; text-overflow: ellipsis; white-space: nowrap; }
  .footer-meta span { font-size: 0.6rem; color: var(--text-muted); text-transform: uppercase; font-weight: 700; letter-spacing: 0.05em; }
  .footer-logout { width: 32px; height: 32px; border-radius: 8px; border: 1px solid var(--border); background: rgba(255,255,255,0.02); color: var(--text-muted); display: flex; align-items: center; justify-content: center; cursor: pointer; flex-shrink: 0; transition: border-color 0.2s, color 0.2s; font-family: inherit; }
  .footer-logout svg { width: 16px; height: 16px; }
  .footer-logout:hover { border-color: rgba(248,113,113,0.4); color: #f87171; }

  .panel-content { flex: 1; min-width: 0; }
  .panel-main { min-height: 100vh; }

  .mobile-topbar { display: none; }

  .model-switcher {
    display: flex; align-items: center; gap: 12px; flex-wrap: wrap;
    padding: 14px 32px; border-bottom: 1px solid var(--border); background: rgba(10,10,15,0.4);
  }
  .model-switcher-label { color: var(--text-muted); font-size: 0.66rem; font-weight: 800; text-transform: uppercase; letter-spacing: 0.06em; }
  .model-tabs { display: flex; gap: 4px; flex-wrap: wrap; padding: 3px; border: 1px solid var(--border); border-radius: 10px; background: #0d0c13; }
  .model-tab { padding: 6px 14px; border-radius: 7px; color: var(--text-muted); font-size: 0.78rem; font-weight: 700; transition: background 0.15s, color 0.15s; }
  .model-tab:hover { background: rgba(255,255,255,0.045); color: var(--text); }
  .model-tab.active { background: rgba(124,58,237,0.22); color: #fff; }
  @media (max-width: 880px) {
    .model-switcher { padding: 12px 20px; }
  }

  @media (max-width: 880px) {
    .panel-sidebar {
      position: fixed; top: 0; left: 0; z-index: 200;
      transform: translateX(-100%); transition: transform 0.25s ease;
      box-shadow: 0 0 60px rgba(0,0,0,0.5);
    }
    .panel-sidebar.open { transform: translateX(0); }
    .sidebar-backdrop {
      display: none; position: fixed; inset: 0; z-index: 190;
      background: rgba(0,0,0,0.55); backdrop-filter: blur(2px);
    }
    .sidebar-backdrop.open { display: block; }
    .mobile-topbar {
      display: flex; align-items: center; gap: 14px;
      padding: 14px 20px; border-bottom: 1px solid var(--border);
      background: rgba(10,10,15,0.9); backdrop-filter: blur(12px);
      position: sticky; top: 0; z-index: 60;
    }
    .hamburger { display: flex; flex-direction: column; gap: 5px; background: none; border: none; cursor: pointer; padding: 4px; }
    .hamburger span { display: block; width: 20px; height: 2px; background: var(--text); border-radius: 2px; }
  }

  /* --- Shared page primitives, reused by every /panel/* page --- */
  .kicker { color: #b767ed; font-size: 0.7rem; font-weight: 800; letter-spacing: 0.11em; text-transform: uppercase; }
  .role-badge { padding: 4px 10px; border-radius: 999px; border: 1px solid var(--border); background: rgba(124,58,237,0.12); color: var(--text-muted); font-size: 0.6rem; font-weight: 800; text-transform: uppercase; letter-spacing: 0.06em; }
  .page-head { margin-bottom: 26px; }
  .page-head h1 { font-size: clamp(1.5rem, 3.4vw, 2.05rem); margin: 8px 0 6px; }
  .page-head p { color: var(--text-muted); font-size: 0.88rem; }
  .panel-card { border: 1px solid var(--border); border-radius: var(--radius-lg); background: rgba(17,16,24,0.9); padding: 22px; min-width: 0; }
  .empty-note { color: var(--text-muted); font-size: 0.78rem; margin-top: 14px; }
  .recent-table { width: 100%; border-collapse: collapse; margin-top: 14px; font-size: 0.78rem; }
  .recent-table th { text-align: left; color: var(--text-muted); font-size: 0.62rem; text-transform: uppercase; letter-spacing: 0.06em; padding: 0 10px 8px 0; border-bottom: 1px solid var(--border); white-space: nowrap; }
  .recent-table td { padding: 8px 10px 8px 0; border-bottom: 1px solid rgba(255,255,255,0.05); color: var(--text); transition: color 0.15s; }
  .recent-table td:not(:first-child) { color: var(--text-muted); }
  .recent-table tbody tr { transition: background-color 0.15s; }
  .recent-table tbody tr:hover { background-color: rgba(255,255,255,0.035); }
  .recent-table tbody tr:hover td { color: var(--text); }
  /* A table's columns don't wrap — on narrow screens let the table itself scroll sideways in
     its own contained box rather than force the whole page wider. This must live here, not
     per-page, since every /panel/* page that renders a .recent-table (dashboard, activity
     log) needs it — it was previously only added to the activity log's own styles, which is
     exactly how the dashboard's copy of this table was missed. */
  @media (max-width: 720px) {
    .recent-table { display: block; overflow-x: auto; white-space: nowrap; }
  }
</style>

<script>
  document.getElementById('panelLogoutBtn')?.addEventListener('click', async () => {
    try {
      await fetch('/api/panel/logout', { method: 'POST' });
    } catch {
      // Server unreachable or a network hiccup — still send them to login below rather than
      // leaving the button looking dead. Nothing more useful to do client-side than that.
    }
    const host = window.location.hostname;
    const onPanelHost = host === 'panel.findbyface.org' || host === 'panel.localhost';
    window.location.href = onPanelHost ? '/login/' : '/panel/login/';
  });

  const sidebar = document.getElementById('panelSidebar');
  const backdrop = document.getElementById('sidebarBackdrop');
  const toggle = document.getElementById('sidebarToggle');

  function closeSidebar(): void {
    sidebar?.classList.remove('open');
    backdrop?.classList.remove('open');
    toggle?.setAttribute('aria-expanded', 'false');
  }
  function openSidebar(): void {
    sidebar?.classList.add('open');
    backdrop?.classList.add('open');
    toggle?.setAttribute('aria-expanded', 'true');
  }

  toggle?.addEventListener('click', () => {
    if (sidebar?.classList.contains('open')) closeSidebar(); else openSidebar();
  });
  backdrop?.addEventListener('click', closeSidebar);
  document.addEventListener('keydown', (event) => { if (event.key === 'Escape') closeSidebar(); });
</script>
