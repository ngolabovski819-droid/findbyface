---
import Base from '../layouts/Base.astro';
import PreferenceSliders from '../components/PreferenceSliders.astro';
import { AI_DISCOVER_SEO } from '../config/seo-meta.ts';

const canonical = 'https://findbyface.org/ai-discover/';
---
<Base title={AI_DISCOVER_SEO.title} description={AI_DISCOVER_SEO.description} canonical={canonical} robots="noindex,nofollow">
  <script slot="head" type="application/ld+json" set:html={JSON.stringify({
    '@context': 'https://schema.org',
    '@type': 'WebApplication',
    name: 'findbyface · Visual Preference Discovery',
    url: canonical,
    applicationCategory: 'LifestyleApplication',
    operatingSystem: 'Any',
    description: AI_DISCOVER_SEO.description,
    offers: { '@type': 'Offer', price: '0', priceCurrency: 'USD' },
  })} />

  <section class="hero">
    <div class="hero-inner">
      <h1>Build your <span class="grad">ideal type</span></h1>
      <p class="lede">
        Dial in the face you have in your head — eye color, jaw, lips, brows — and instantly
        see the OnlyFans creators who match. No photo upload required.
      </p>
    </div>
  </section>

  <section class="page-grid">
    <PreferenceSliders />

    <div class="results-pane">
      <div class="results-header">
        <h2 id="resultCount">Adjust the controls to see matches</h2>
        <span class="status" id="status">Idle</span>
      </div>
      <div class="results-grid" id="resultsGrid"></div>
      <div class="empty" id="emptyState" style="display:none">
        <p>No matches with these constraints. Try widening a filter.</p>
      </div>
      <div class="indexing-banner" id="indexingBanner" style="display:none">
        <strong>Indexing in progress.</strong>
        <span id="indexingMsg">Creator metrics are still being computed for our database.</span>
      </div>
    </div>
  </section>
</Base>

<script is:inline>
  // -------- state -----------------------------------------------------
  // All numeric sliders default to 0.5 (= "average").
  const NUMERIC_KEYS = [
    'jawWidth','cheekboneProminence','fwhr','midfaceRatio','lowerThirdWidth',
    'gonialAngle','ramusLength','chinProjection','browRidge','frankfurtRecession',
    'eyeSpacing','canthalTilt','eyebrowDensity','eyebrowPosition','eyebrowTilt',
    'lipFullness','vermillionRatio','skinTone','jawlineVisibility',
  ];
  const CATEGORICAL_KEYS = ['eyeColor', 'hairColor', 'eyeShape', 'hairTexture'];

  const PRESETS = {
    reset: () => {
      const s = { target: {}, weights: {}, filters: {} };
      NUMERIC_KEYS.forEach(k => s.target[k] = 0.5);
      return s;
    },
    random: () => {
      const s = { target: {}, weights: {}, filters: {} };
      NUMERIC_KEYS.forEach(k => s.target[k] = Math.random());
      return s;
    },
    classic: () => ({
      target: {
        jawWidth: 0.45, cheekboneProminence: 0.6, fwhr: 0.4, midfaceRatio: 0.5,
        lowerThirdWidth: 0.5, gonialAngle: 0.55, ramusLength: 0.5,
        chinProjection: 0.55, browRidge: 0.4, frankfurtRecession: 0.3,
        eyeSpacing: 0.5, canthalTilt: 0.6, eyebrowDensity: 0.5,
        eyebrowPosition: 0.45, eyebrowTilt: 0.55,
        lipFullness: 0.6, vermillionRatio: 0.5, skinTone: 0.4, jawlineVisibility: 0.55,
        eyeColor: 'blue', hairColor: 'blonde', eyeShape: 'almond',
      },
      weights: {}, filters: {},
    }),
    athletic: () => ({
      target: {
        jawWidth: 0.65, cheekboneProminence: 0.7, fwhr: 0.6, midfaceRatio: 0.5,
        lowerThirdWidth: 0.6, gonialAngle: 0.4, ramusLength: 0.6,
        chinProjection: 0.65, browRidge: 0.6, frankfurtRecession: 0.3,
        eyeSpacing: 0.5, canthalTilt: 0.55, eyebrowDensity: 0.6,
        eyebrowPosition: 0.5, eyebrowTilt: 0.5,
        lipFullness: 0.5, vermillionRatio: 0.5, skinTone: 0.5, jawlineVisibility: 0.8,
        eyeColor: 'brown', hairColor: 'brown', eyeShape: 'almond',
      },
      weights: {}, filters: {},
    }),
    soft: () => ({
      target: {
        jawWidth: 0.35, cheekboneProminence: 0.4, fwhr: 0.4, midfaceRatio: 0.55,
        lowerThirdWidth: 0.4, gonialAngle: 0.7, ramusLength: 0.4,
        chinProjection: 0.4, browRidge: 0.3, frankfurtRecession: 0.3,
        eyeSpacing: 0.55, canthalTilt: 0.5, eyebrowDensity: 0.4,
        eyebrowPosition: 0.5, eyebrowTilt: 0.5,
        lipFullness: 0.75, vermillionRatio: 0.5, skinTone: 0.4, jawlineVisibility: 0.3,
        eyeColor: 'hazel', hairColor: 'light-brown', eyeShape: 'round',
      },
      weights: {}, filters: {},
    }),
    hunter: () => ({
      // Preset baked from the user's brief description.
      target: {
        jawWidth: 0.55, cheekboneProminence: 0.7, fwhr: 0.55, midfaceRatio: 0.65,
        lowerThirdWidth: 0.7, gonialAngle: 0.5, ramusLength: 0.35,
        chinProjection: 0.55, browRidge: 0.7, frankfurtRecession: 0.55,
        eyeSpacing: 0.65, canthalTilt: 0.4, eyebrowDensity: 0.7,
        eyebrowPosition: 0.6, eyebrowTilt: 0.6,
        lipFullness: 0.7, vermillionRatio: 0.5, skinTone: 0.45, jawlineVisibility: 0.65,
        eyeColor: 'hunter-green', hairColor: 'dark-brown', eyeShape: 'almond',
      },
      weights: { eyeColor: 1, hairColor: 1, _categorical: 0.4 },
      filters: {},
    }),
  };

  /** Active state. Starts from 'reset' preset. */
  let state = PRESETS.reset();

  // -------- DOM wiring ------------------------------------------------
  const root = document.querySelector('.prefs');
  const resultsGrid = document.getElementById('resultsGrid');
  const resultCount = document.getElementById('resultCount');
  const statusEl = document.getElementById('status');
  const emptyState = document.getElementById('emptyState');
  const indexingBanner = document.getElementById('indexingBanner');
  const indexingMsg = document.getElementById('indexingMsg');

  function applyStateToUI() {
    // Sliders
    root.querySelectorAll('input[type="range"][data-key]').forEach(el => {
      const k = el.dataset.key;
      const v = state.target[k];
      el.value = String(Math.round((v ?? 0.5) * 100));
    });
    // Categorical (swatch + pill rows)
    root.querySelectorAll('.swatch-grid, .pill-row').forEach(grid => {
      const k = grid.dataset.key || grid.dataset.filter;
      if (!k) return;
      const v = grid.dataset.key
        ? state.target[k] ?? ''
        : state.filters[k] ?? '';
      grid.querySelectorAll('button').forEach(btn => {
        btn.classList.toggle('active', String(btn.dataset.value) === String(v ?? ''));
      });
    });
    // Verified checkbox
    const verifiedCb = root.querySelector('input[data-filter="verified"]');
    if (verifiedCb) verifiedCb.checked = !!state.filters.verified;
  }

  function debounce(fn, ms) {
    let t; return (...args) => { clearTimeout(t); t = setTimeout(() => fn(...args), ms); };
  }

  const triggerSearch = debounce(runSearch, 350);

  // Slider changes
  root.querySelectorAll('input[type="range"][data-key]').forEach(el => {
    el.addEventListener('input', () => {
      const k = el.dataset.key;
      state.target[k] = parseInt(el.value, 10) / 100;
      triggerSearch();
    });
  });

  // Swatch + pill (target keys)
  root.querySelectorAll('.swatch-grid[data-key], .pill-row[data-key]').forEach(grid => {
    const k = grid.dataset.key;
    grid.querySelectorAll('button').forEach(btn => {
      btn.addEventListener('click', () => {
        const v = btn.dataset.value;
        if (v) state.target[k] = v;
        else delete state.target[k];
        applyStateToUI();
        triggerSearch();
      });
    });
  });

  // Filter rows
  root.querySelectorAll('.pill-row[data-filter]').forEach(grid => {
    const k = grid.dataset.filter;
    grid.querySelectorAll('button').forEach(btn => {
      btn.addEventListener('click', () => {
        const v = btn.dataset.value;
        if (v === '') delete state.filters[k];
        else state.filters[k] = k === 'maxPrice' ? Number(v) : v;
        applyStateToUI();
        triggerSearch();
      });
    });
  });

  // Verified checkbox
  const verifiedCb = root.querySelector('input[data-filter="verified"]');
  verifiedCb?.addEventListener('change', () => {
    if (verifiedCb.checked) state.filters.verified = true;
    else delete state.filters.verified;
    triggerSearch();
  });

  // Presets
  root.querySelectorAll('[data-preset]').forEach(btn => {
    btn.addEventListener('click', () => {
      const name = btn.dataset.preset;
      const fn = PRESETS[name];
      if (!fn) return;
      state = fn();
      applyStateToUI();
      saveLocal();
      runSearch();
    });
  });

  // -------- persistence ----------------------------------------------
  function saveLocal() {
    try { localStorage.setItem('fbf_preferences', JSON.stringify(state)); } catch {}
  }
  function loadLocal() {
    try {
      const raw = localStorage.getItem('fbf_preferences');
      if (!raw) return null;
      const parsed = JSON.parse(raw);
      if (parsed && parsed.target) return parsed;
    } catch {}
    return null;
  }

  // URL hash takes precedence over localStorage on load.
  function loadFromHash() {
    if (!location.hash || location.hash.length < 2) return null;
    try {
      const decoded = atob(decodeURIComponent(location.hash.slice(1)));
      const parsed = JSON.parse(decoded);
      if (parsed && parsed.target) return parsed;
    } catch {}
    return null;
  }
  function syncHash() {
    try {
      const enc = encodeURIComponent(btoa(JSON.stringify(state)));
      history.replaceState(null, '', '#' + enc);
    } catch {}
  }

  // -------- search ---------------------------------------------------
  let searchSeq = 0;

  async function runSearch() {
    saveLocal();
    syncHash();
    const seq = ++searchSeq;
    statusEl.textContent = 'Searching…';
    try {
      const r = await fetch('/api/visual-search', {
        method: 'POST',
        headers: { 'Content-Type': 'application/json' },
        body: JSON.stringify({
          target: state.target,
          weights: state.weights,
          filters: state.filters,
          limit: 24,
        }),
      });
      if (seq !== searchSeq) return; // a newer request superseded this one
      if (!r.ok) {
        statusEl.textContent = 'Error';
        return;
      }
      const data = await r.json();
      renderResults(data);
    } catch (e) {
      if (seq !== searchSeq) return;
      statusEl.textContent = 'Error';
      console.warn('visual-search failed', e);
    }
  }

  function renderResults(data) {
    const list = data.results || [];
    if (data.mode === 'empty') {
      indexingBanner.style.display = 'block';
      indexingMsg.textContent = data.hint || 'Creator metrics are still being computed.';
      emptyState.style.display = 'none';
      resultsGrid.innerHTML = '';
      resultCount.textContent = 'No metrics indexed yet';
      statusEl.textContent = 'Idle';
      return;
    }
    indexingBanner.style.display = 'none';
    if (list.length === 0) {
      emptyState.style.display = 'block';
      resultsGrid.innerHTML = '';
      resultCount.textContent = '0 matches';
      statusEl.textContent = 'Idle';
      return;
    }
    emptyState.style.display = 'none';
    resultCount.textContent = `${list.length} closest match${list.length === 1 ? '' : 'es'}`;
    statusEl.textContent = data.mode === 'rpc' ? 'Live · RPC' : 'Live · Fallback';
    resultsGrid.innerHTML = list.map((c, i) => cardHtml(c, i)).join('');
  }

  function proxyImg(url, w, h) {
    if (!url) return '/no-image.png';
    if (url.startsWith('/')) return url;
    if (!url.startsWith('http')) return '/no-image.png';
    const stripped = url.replace(/^https?:\/\//, '');
    return `https://images.weserv.nl/?url=${encodeURIComponent(stripped)}&w=${w}&h=${h}&fit=cover&output=webp`;
  }

  function cardHtml(c, i) {
    const name = c.name || c.username || 'Unknown';
    const username = c.username || '';
    const price = c.subscribePrice;
    const priceLabel = (!price || isNaN(Number(price))) ? 'FREE' : `$${parseFloat(String(price)).toFixed(2)}`;
    const priceClass = priceLabel === 'FREE' ? 'price price-free' : 'price';
    const profileUrl = c.profileUrl || `https://onlyfans.com/${encodeURIComponent(username)}`;
    const rel = profileUrl.startsWith('/go/') ? 'noopener nofollow sponsored' : 'noopener nofollow';
    const img = proxyImg(c.avatar || '', 320, 427);
    const eager = i === 0 ? 'eager' : 'lazy';
    const fp = i === 0 ? 'high' : 'auto';
    const match = c.matchPct != null ? `<span class="match-badge">${c.matchPct}% match</span>` : '';
    const cardData = cardDataAttributes(c);
    return `
      <div class="creator-card" data-href="${escapeHtml(profileUrl)}" ${cardData}>
        <div class="card-img-wrap">
          <img src="${img}" alt="${escapeHtml(name)}" loading="${eager}" fetchpriority="${fp}"
               decoding="async" referrerpolicy="no-referrer"
               onerror="this.onerror=null;this.src='/no-image.png';" />
          ${match}
        </div>
        <div class="card-body">
          <p class="creator-name">${escapeHtml(name)}</p>
          <p class="username">@${escapeHtml(username)}</p>
          <p class="${priceClass}">${priceLabel}</p>
          <a href="${profileUrl}" class="view-btn" target="_blank" rel="${rel}">View Profile</a>
        </div>
      </div>`;
  }

  function escapeHtml(s) {
    return String(s).replace(/[&<>"']/g, ch => ({
      '&':'&amp;','<':'&lt;','>':'&gt;','"':'&quot;',"'":'&#39;'
    }[ch]));
  }

  function cardDataAttributes(c) {
    const images = [...new Set([c.avatar, c.header, ...(c.galleryImages || [])].filter(Boolean))];
    return [
      `data-card-username="${escapeHtml(c.username || '')}"`,
      `data-card-images="${escapeHtml(JSON.stringify(images))}"`,
      `data-card-sponsored="${c.sponsored ? 'true' : 'false'}"`,
      `data-card-tags="${escapeHtml(JSON.stringify(c.tags || []))}"`,
      `data-card-extra-tags="${c.additionalTagCount || 0}"`,
      `data-card-verified="${c.isVerified || c.isverified ? 'true' : 'false'}"`,
    ].join(' ');
  }

  // -------- init -----------------------------------------------------
  const fromHash = loadFromHash();
  const fromLocal = loadLocal();
  if (fromHash) state = fromHash;
  else if (fromLocal) state = fromLocal;

  // Merge missing numeric defaults so partial saved state still works.
  NUMERIC_KEYS.forEach(k => { if (state.target[k] == null) state.target[k] = 0.5; });

  applyStateToUI();
  runSearch();
</script>

<style>
  .hero {
    padding: 100px 20px 32px;
    text-align: center;
  }
  .hero-inner { max-width: 760px; margin: 0 auto; }
  .hero h1 {
    font-family: 'Manrope', sans-serif;
    font-weight: 800;
    font-size: clamp(2rem, 5vw, 3.2rem);
    margin-bottom: 14px;
    line-height: 1.1;
  }
  .hero h1 .grad {
    background: linear-gradient(135deg, #7c3aed, #ec4899);
    -webkit-background-clip: text;
    -webkit-text-fill-color: transparent;
    background-clip: text;
  }
  .hero .lede {
    font-size: 1.05rem;
    color: var(--text-muted);
    max-width: 560px;
    margin: 0 auto;
  }

  .page-grid {
    max-width: 1280px;
    margin: 0 auto;
    padding: 16px 20px 80px;
    display: grid;
    grid-template-columns: 320px 1fr;
    gap: 24px;
    align-items: start;
  }
  @media (max-width: 900px) {
    .page-grid { grid-template-columns: 1fr; }
  }

  .results-pane { min-width: 0; }
  .results-header {
    display: flex; justify-content: space-between; align-items: baseline;
    margin-bottom: 16px;
    gap: 12px; flex-wrap: wrap;
  }
  .results-header h2 {
    font-family: 'Manrope', sans-serif;
    font-size: 1.25rem;
  }
  .status {
    font-size: 12px; color: var(--text-muted);
    text-transform: uppercase; letter-spacing: 0.05em;
  }

  .results-grid {
    display: grid;
    grid-template-columns: repeat(4, 1fr);
    gap: 20px;
  }
  @media (max-width: 1100px) { .results-grid { grid-template-columns: repeat(3, 1fr); } }
  @media (max-width: 700px)  { .results-grid { grid-template-columns: repeat(2, 1fr); gap: 12px; } }

  .empty, .indexing-banner {
    background: var(--surface);
    border: 1px solid var(--border);
    border-radius: var(--radius);
    padding: 20px;
    text-align: center;
    color: var(--text-muted);
    margin-top: 12px;
  }
  .indexing-banner { text-align: left; color: var(--text); }
  .indexing-banner strong { color: var(--accent-light); }

  /* Card styles (mirrors CreatorCard.astro for client-rendered nodes) */
  .creator-card {
    background: var(--surface);
    border-radius: var(--radius-lg);
    overflow: hidden;
    border: 1px solid var(--border);
    transition: transform 0.2s, box-shadow 0.2s;
  }
  .creator-card:hover { transform: translateY(-4px); box-shadow: 0 8px 32px var(--accent-glow); }
  .card-img-wrap {
    aspect-ratio: 3/4; overflow: hidden; position: relative;
    background: var(--surface-raised);
  }
  .card-img-wrap img { width: 100%; height: 100%; object-fit: cover; display: block; }
  .match-badge {
    position: absolute; top: 8px; right: 8px;
    background: rgba(124,58,237,0.9); color: #fff;
    font-size: 11px; font-weight: 700;
    padding: 3px 8px; border-radius: 20px;
  }
  .card-body { padding: 12px 14px; }
  .creator-name {
    font-family: 'Manrope', sans-serif; font-weight: 700; font-size: 14px;
    margin-bottom: 2px; white-space: nowrap; overflow: hidden; text-overflow: ellipsis;
  }
  .verified { color: var(--accent); }
  .username { color: var(--text-muted); font-size: 12px; margin-bottom: 6px; }
  .price { font-weight: 700; font-size: 15px; margin-bottom: 10px; color: var(--text-muted); }
  .price-free { color: var(--success); }
  .view-btn {
    display: block; text-align: center;
    background: var(--accent); color: #fff;
    border-radius: 8px; padding: 8px;
    font-size: 13px; font-weight: 600;
    transition: background 0.2s;
  }
  .view-btn:hover { background: var(--accent-light); }
</style>
