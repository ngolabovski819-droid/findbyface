---
{/* i18n-twin: src/pages/es/promociona-tu-onlyfans.astro — mirror copy/structure changes */}
import Base from '../layouts/Base.astro';

const APPLY_URL = 'https://tally.so/r/kd16Xe';

const faqJsonLd = JSON.stringify({
  '@context': 'https://schema.org',
  '@type': 'FAQPage',
  mainEntity: [
    {
      '@type': 'Question',
      name: 'Is promoting on findbyface safe and OnlyFans ToS-compliant?',
      acceptedAnswer: {
        '@type': 'Answer',
        text: 'Yes. We only feature your public profile in our search results and category pages — the same way a search engine lists a website. We never post on your behalf, never touch your account, and never do anything that violates OnlyFans terms of service.',
      },
    },
    {
      '@type': 'Question',
      name: 'Do you need my OnlyFans password?',
      acceptedAnswer: {
        '@type': 'Answer',
        text: 'Never. We only need your public profile link and a few details about your niche. You keep full control of your account at all times.',
      },
    },
    {
      '@type': 'Question',
      name: 'How fast will my profile go live?',
      acceptedAnswer: {
        '@type': 'Answer',
        text: 'Within 24 hours of your application being approved, your profile is live and featured across findbyface search results, category pages, and AI face-match results.',
      },
    },
    {
      '@type': 'Question',
      name: 'Is this the same as buying followers?',
      acceptedAnswer: {
        '@type': 'Answer',
        text: 'No — the opposite. Bought followers are bots that never spend a cent. findbyface sends you real people who searched for creators with your exact look and niche, and arrive ready to subscribe.',
      },
    },
    {
      '@type': 'Question',
      name: 'What results can I expect?',
      acceptedAnswer: {
        '@type': 'Answer',
        text: 'Results vary by niche and profile quality, but featured creators typically see a steady stream of high-intent visitors from day one. Search traffic converts far better than social media because visitors are actively looking for a creator like you.',
      },
    },
    {
      '@type': 'Question',
      name: 'Do you work with agencies or multiple accounts?',
      acceptedAnswer: {
        '@type': 'Answer',
        text: 'Yes. If you manage multiple creators, mention it in your application and we will set up bulk placement with priority support.',
      },
    },
  ],
});
---

<Base
  title="Promote Your OnlyFans — Get Real Paying Fans | findbyface"
  description="Get your OnlyFans featured on findbyface and reach thousands of high-intent fans searching by face, niche, and category every day. Go live in 24 hours — no password required."
  canonical="https://findbyface.org/promote/"
>
  <Fragment slot="head">
    <script type="application/ld+json" set:html={faqJsonLd} />
  </Fragment>

  <!-- Hero -->
  <div class="hero">
    <div class="hero-badge">
      <span class="badge-dot"></span>
      3 spots left this week — filling fast
    </div>
    <h1><span class="h1-white">Promote Your</span> <span class="gradient-text">OnlyFans</span><br /><span class="h1-white">and get real paying fans</span></h1>
    <p class="hero-sub">findbyface reaches thousands of fans searching for creators by face, niche, and category every day. Get your profile featured in front of high-intent audiences who are ready to subscribe.</p>
    <div class="section-cta hero-cta-wrap">
      <a href={APPLY_URL} target="_blank" rel="noopener" class="hero-cta">
        <span class="cta-icon">🚀</span>
        Claim Your Spot — Go Live in 24h
      </a>
    </div>
    <ul class="hero-trust">
      <li><span class="trust-ico">🔒</span> No password required</li>
      <li><span class="trust-ico">✓</span> Free to apply</li>
      <li><span class="trust-ico">⚡</span> Real search traffic</li>
    </ul>
  </div>

  <!-- Stats -->
  <section class="promo-stats">
    <div class="stat">
      <span class="stat-num">2.4M+</span>
      <span class="stat-label">Profiles indexed</span>
    </div>
    <div class="stat">
      <span class="stat-num">1000s</span>
      <span class="stat-label">Daily face searches</span>
    </div>
    <div class="stat">
      <span class="stat-num">24h</span>
      <span class="stat-label">To go live</span>
    </div>
  </section>

  <!-- How it works -->
  <section class="home-section">
    <div class="section-head">
      <span class="eyebrow">Simple &amp; fast</span>
      <h2 class="section-title-lg">How promoting on findbyface works</h2>
      <p class="section-lead">Four steps from application to a steady stream of new subscribers — with zero ongoing work on your side.</p>
    </div>
    <div class="steps-grid">
      <div class="step-card">
        <span class="step-num">1</span>
        <span class="step-emoji">📝</span>
        <h3>Submit your profile</h3>
        <p>Fill out a short application with your OnlyFans link and niche. Takes under two minutes — no password, no account access.</p>
      </div>
      <div class="step-card">
        <span class="step-num">2</span>
        <span class="step-emoji">✨</span>
        <h3>We optimize your listing</h3>
        <p>Our team crafts your featured listing — photos, tags, and copy tuned so you show up for the searches that match your look and niche.</p>
      </div>
      <div class="step-card">
        <span class="step-num">3</span>
        <span class="step-emoji">⚡</span>
        <h3>Go live in 24 hours</h3>
        <p>Your profile is featured across face-search results, category pages, and AI discovery — everywhere fans are already looking.</p>
      </div>
      <div class="step-card">
        <span class="step-num">4</span>
        <span class="step-emoji">📈</span>
        <h3>Watch subscribers grow</h3>
        <p>High-intent fans find you, click through, and subscribe. Traffic keeps flowing month after month with no extra effort from you.</p>
      </div>
    </div>
  </section>

  <!-- Why it works -->
  <section class="home-section">
    <div class="section-head">
      <span class="eyebrow">Built different</span>
      <h2 class="section-title-lg">Why search traffic converts better than social media</h2>
      <p class="section-lead">Social posts disappear in hours. Search visibility compounds — the fans who find you here were already looking for someone exactly like you.</p>
    </div>
    <div class="why-grid">
      <article class="why-card">
        <span class="why-emoji">🎯</span>
        <h3>High-intent audience</h3>
        <p>Every visitor searched for a creator with your look or niche. They arrive ready to subscribe — not scrolling past like on social feeds.</p>
      </article>
      <article class="why-card">
        <span class="why-emoji">📈</span>
        <h3>Consistent, predictable traffic</h3>
        <p>No algorithm roulette. Search demand is steady month after month, so your featured spot keeps sending fans long after social posts die.</p>
      </article>
      <article class="why-card">
        <span class="why-emoji">🛡️</span>
        <h3>100% safe &amp; compliant</h3>
        <p>We feature your public profile — nothing more. No account access, no posting on your behalf, no risk to your OnlyFans standing.</p>
      </article>
      <article class="why-card">
        <span class="why-emoji">👥</span>
        <h3>Fans who stick around</h3>
        <p>Subscribers who chose you deliberately rebill longer and spend more on PPV than impulse clicks from shoutouts and drops.</p>
      </article>
      <article class="why-card">
        <span class="why-emoji">📍</span>
        <h3>Niche &amp; look targeting</h3>
        <p>Fans search by face, category, and type. Your listing is matched to your exact niche, so the traffic you get actually fits your content.</p>
      </article>
      <article class="why-card">
        <span class="why-emoji">⏰</span>
        <h3>No ongoing work required</h3>
        <p>Apply once and you're done. No daily posting, no engagement grind, no DMs to strangers — the traffic comes to you.</p>
      </article>
    </div>
  </section>

  <!-- Comparison -->
  <section class="home-section">
    <div class="section-head">
      <span class="eyebrow">The honest math</span>
      <h2 class="section-title-lg">findbyface vs other promotion channels</h2>
      <p class="section-lead">Where does a promo dollar actually turn into subscribers?</p>
    </div>
    <div class="compare-wrap">
      <table class="compare-table">
        <thead>
          <tr>
            <th>Channel</th>
            <th>Visitor intent</th>
            <th>Traffic quality</th>
            <th>Longevity</th>
          </tr>
        </thead>
        <tbody>
          <tr class="highlight-row">
            <td><strong>findbyface featured spot</strong></td>
            <td><span class="pill pill-good">High — actively searching</span></td>
            <td>Real fans ready to spend</td>
            <td>Consistent, month after month</td>
          </tr>
          <tr>
            <td>Reddit promotion</td>
            <td><span class="pill pill-mid">Mixed</span></td>
            <td>Hit or miss by subreddit</td>
            <td>Spiky, fades in days</td>
          </tr>
          <tr>
            <td>Twitter/X drops</td>
            <td><span class="pill pill-mid">Low</span></td>
            <td>Mostly passive scrollers</td>
            <td>Hours, then gone</td>
          </tr>
          <tr>
            <td>Instagram shoutouts</td>
            <td><span class="pill pill-mid">Low–mixed</span></td>
            <td>Depends on the page</td>
            <td>A few weeks at best</td>
          </tr>
          <tr>
            <td>Bought followers</td>
            <td><span class="pill pill-bad">None — bots</span></td>
            <td>Zero spenders</td>
            <td>Negative ROI</td>
          </tr>
        </tbody>
      </table>
    </div>
  </section>

  <!-- Mid-page CTA banner -->
  <section class="home-section">
    <div class="free-card">
      <span class="free-badge">LIMITED SPOTS</span>
      <h2>Your future subscribers are searching right now</h2>
      <p>Every day your profile isn't featured, fans searching for your exact look are finding someone else. Applications take under two minutes, and approved profiles go live within 24 hours.</p>
      <div class="section-cta">
        <a href={APPLY_URL} target="_blank" rel="noopener" class="hero-cta light">
          <span class="cta-icon">🚀</span>
          Claim Your Spot — Go Live in 24h
        </a>
      </div>
    </div>
  </section>

  <!-- FAQ -->
  <section class="home-section">
    <div class="section-head">
      <h2 class="section-title-lg">Frequently asked questions</h2>
    </div>
    <div class="faq-list">
      <details class="faq-item">
        <summary>Is this safe and OnlyFans ToS-compliant?</summary>
        <p>Yes. We only feature your public profile in our search results and category pages — the same way a search engine lists a website. We never post on your behalf, never touch your account, and never do anything that violates OnlyFans terms of service.</p>
      </details>
      <details class="faq-item">
        <summary>Do you need my OnlyFans password?</summary>
        <p>Never. We only need your public profile link and a few details about your niche. You keep full control of your account at all times.</p>
      </details>
      <details class="faq-item">
        <summary>How fast will my profile go live?</summary>
        <p>Within 24 hours of your application being approved. Your profile gets featured across findbyface search results, category pages, and AI face-match results.</p>
      </details>
      <details class="faq-item">
        <summary>Is this the same as buying followers?</summary>
        <p>No — the opposite. Bought followers are bots that never spend a cent. findbyface sends you real people who searched for creators with your exact look and niche, and arrive ready to subscribe.</p>
      </details>
      <details class="faq-item">
        <summary>What results can I expect?</summary>
        <p>Results vary by niche and profile quality, but featured creators typically see a steady stream of high-intent visitors from day one. Search traffic converts far better than social media because visitors are actively looking for a creator like you.</p>
      </details>
      <details class="faq-item">
        <summary>Do you work with agencies or multiple accounts?</summary>
        <p>Yes. If you manage multiple creators, mention it in your application and we'll set up bulk placement with priority support.</p>
      </details>
    </div>
  </section>

  <!-- Closing CTA -->
  <section class="home-section closing-section">
    <div class="section-head">
      <h2 class="section-title-lg">Ready to grow your <span class="gradient-text">OnlyFans</span>?</h2>
      <p class="section-lead">Join the creators already getting discovered by high-intent fans on findbyface every day.</p>
    </div>
    <div class="section-cta closing-cta">
      <a href={APPLY_URL} target="_blank" rel="noopener" class="hero-cta">
        <span class="cta-icon">🚀</span>
        Claim Your Spot — Go Live in 24h
      </a>
    </div>
  </section>
</Base>

<style>
  /* ── Hero ─────────────────────────────────────────────── */
  .hero {
    text-align: center;
    padding: 110px 20px 28px;
    max-width: 780px;
    margin: 0 auto;
  }

  .hero-badge {
    display: inline-flex;
    align-items: center;
    gap: 8px;
    background: rgba(236,72,153,0.12);
    border: 1px solid rgba(236,72,153,0.35);
    border-radius: 999px;
    padding: 6px 16px;
    font-size: 13px;
    color: var(--accent-pink);
    margin-bottom: 18px;
    font-weight: 600;
  }

  .badge-dot {
    width: 6px; height: 6px;
    background: var(--accent-pink);
    border-radius: 50%;
    animation: pulse 2s infinite;
  }

  @keyframes pulse {
    0%, 100% { opacity: 1; }
    50% { opacity: 0.3; }
  }

  .hero h1 {
    font-size: clamp(2rem, 4.5vw, 3rem);
    line-height: 1.12;
    margin-bottom: 14px;
  }

  .h1-white { color: #ffffff; }

  .gradient-text {
    background: linear-gradient(135deg, #7c3aed, #ec4899);
    -webkit-background-clip: text;
    -webkit-text-fill-color: transparent;
    background-clip: text;
  }

  .hero-sub {
    color: var(--text-muted);
    font-size: 0.98rem;
    line-height: 1.6;
    max-width: 600px;
    margin: 0 auto;
  }

  .hero-cta-wrap { margin-top: 30px; }

  .hero-trust {
    list-style: none;
    display: flex;
    flex-wrap: wrap;
    justify-content: center;
    gap: 10px;
    margin: 22px 0 0;
    padding: 0;
  }
  .hero-trust li {
    display: inline-flex;
    align-items: center;
    gap: 7px;
    font-size: 0.82rem;
    font-weight: 600;
    color: var(--text);
    padding: 7px 14px;
    border-radius: 999px;
    background: linear-gradient(135deg, rgba(124,58,237,0.12), rgba(236,72,153,0.10));
    border: 1px solid var(--border);
    backdrop-filter: blur(6px);
  }
  .hero-trust .trust-ico {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    width: 18px; height: 18px;
    font-size: 0.72rem;
    border-radius: 50%;
    background: linear-gradient(135deg, #7c3aed, #ec4899);
    color: #fff;
  }

  /* ── Stats ────────────────────────────────────────────── */
  .promo-stats {
    max-width: 760px;
    margin: 48px auto 0;
    padding: 0 20px;
    display: grid;
    grid-template-columns: repeat(3, 1fr);
    gap: 16px;
  }
  .stat {
    text-align: center;
    background: var(--surface);
    border: 1px solid var(--border);
    border-radius: var(--radius-lg);
    padding: 24px 16px;
  }
  .stat-num {
    display: block;
    font-family: 'Manrope', sans-serif;
    font-weight: 800;
    font-size: 1.8rem;
    background: linear-gradient(135deg, #7c3aed, #ec4899);
    -webkit-background-clip: text;
    -webkit-text-fill-color: transparent;
    background-clip: text;
  }
  .stat-label {
    color: var(--text-muted);
    font-size: 0.85rem;
    font-weight: 500;
  }

  /* ── Shared section scaffolding ───────────────────────── */
  .home-section { max-width: 1100px; margin: 88px auto 0; padding: 0 20px; }
  .section-head { text-align: center; max-width: 680px; margin: 0 auto 40px; }
  .eyebrow {
    display: inline-block; font-size: 0.78rem; font-weight: 700;
    letter-spacing: 0.08em; text-transform: uppercase;
    color: var(--accent-light); margin-bottom: 12px;
  }
  .section-title-lg { font-size: clamp(1.6rem, 3.5vw, 2.3rem); line-height: 1.15; margin-bottom: 14px; }
  .section-lead { color: var(--text-muted); font-size: 1rem; line-height: 1.6; }
  .section-cta { display: flex; justify-content: center; margin-top: 40px; }

  /* ── CTA button ───────────────────────────────────────── */
  .hero-cta {
    display: inline-flex; align-items: center; gap: 10px;
    background: linear-gradient(135deg, #7c3aed, #ec4899);
    color: #fff; border: none; cursor: pointer;
    font-family: 'Manrope', sans-serif; font-weight: 800;
    font-size: 1.05rem; padding: 16px 34px; border-radius: 999px;
    box-shadow: 0 10px 30px rgba(124,58,237,0.4);
    transition: transform 0.15s, box-shadow 0.2s;
  }
  .hero-cta:hover { transform: translateY(-2px) scale(1.02); box-shadow: 0 14px 40px rgba(236,72,153,0.45); }
  .hero-cta:active { transform: translateY(0) scale(0.99); }
  .hero-cta.light { box-shadow: 0 10px 30px rgba(0,0,0,0.3); }
  .cta-icon { font-size: 1.1rem; }

  /* ── Steps ────────────────────────────────────────────── */
  .steps-grid {
    display: grid; grid-template-columns: repeat(4, 1fr); gap: 20px;
    margin-top: 28px;
  }
  .step-card {
    position: relative; background: var(--surface);
    border: 1px solid var(--border); border-radius: var(--radius-lg);
    padding: 32px 22px 26px; text-align: center;
    transition: transform 0.2s, box-shadow 0.2s, border-color 0.2s;
  }
  .step-card:hover { transform: translateY(-4px); border-color: var(--accent); box-shadow: 0 12px 36px var(--accent-glow); }
  .step-num {
    position: absolute; top: -16px; left: 50%; transform: translateX(-50%);
    width: 34px; height: 34px; border-radius: 50%;
    background: linear-gradient(135deg, #7c3aed, #ec4899);
    color: #fff; font-family: 'Manrope', sans-serif; font-weight: 800;
    display: flex; align-items: center; justify-content: center;
    box-shadow: 0 6px 18px rgba(124,58,237,0.4);
  }
  .step-emoji { font-size: 2rem; display: block; margin: 8px 0 14px; }
  .step-card h3 { font-size: 1.08rem; margin-bottom: 10px; }
  .step-card p { color: var(--text-muted); font-size: 0.9rem; line-height: 1.6; }

  /* ── Why cards ────────────────────────────────────────── */
  .why-grid {
    display: grid; grid-template-columns: repeat(3, 1fr); gap: 18px;
  }
  .why-card {
    background: var(--surface); border: 1px solid var(--border);
    border-radius: var(--radius-lg); padding: 26px 22px;
    transition: transform 0.2s, box-shadow 0.2s, border-color 0.2s;
  }
  .why-card:hover { transform: translateY(-4px); border-color: var(--accent); box-shadow: 0 12px 36px var(--accent-glow); }
  .why-emoji { font-size: 1.8rem; display: block; margin-bottom: 14px; }
  .why-card h3 { font-size: 1.08rem; margin-bottom: 8px; }
  .why-card p { color: var(--text-muted); font-size: 0.9rem; line-height: 1.6; }

  /* ── Comparison table ─────────────────────────────────── */
  .compare-wrap {
    overflow-x: auto;
    border: 1px solid var(--border);
    border-radius: var(--radius-lg);
    background: var(--surface);
  }
  .compare-table {
    width: 100%;
    border-collapse: collapse;
    min-width: 640px;
    font-size: 0.92rem;
  }
  .compare-table th {
    text-align: left;
    font-family: 'Manrope', sans-serif;
    font-weight: 800;
    font-size: 0.82rem;
    letter-spacing: 0.04em;
    text-transform: uppercase;
    color: var(--text-muted);
    padding: 16px 20px;
    border-bottom: 1px solid var(--border);
  }
  .compare-table td {
    padding: 16px 20px;
    border-bottom: 1px solid rgba(124,58,237,0.1);
    color: var(--text-muted);
    line-height: 1.5;
  }
  .compare-table tbody tr:last-child td { border-bottom: none; }
  .compare-table td strong { color: var(--text); }
  .highlight-row {
    background: linear-gradient(135deg, rgba(124,58,237,0.14), rgba(236,72,153,0.10));
  }
  .highlight-row td { color: var(--text); }

  .pill {
    display: inline-block;
    padding: 3px 12px;
    border-radius: 999px;
    font-size: 0.78rem;
    font-weight: 700;
    white-space: nowrap;
  }
  .pill-good { background: rgba(34,197,94,0.15); color: var(--success); }
  .pill-mid { background: rgba(251,191,36,0.12); color: #fbbf24; }
  .pill-bad { background: rgba(248,113,113,0.12); color: #f87171; }

  /* ── Mid-page banner ──────────────────────────────────── */
  .free-card {
    text-align: center; border-radius: var(--radius-lg);
    padding: 48px 32px;
    background: linear-gradient(135deg, rgba(124,58,237,0.18), rgba(236,72,153,0.14));
    border: 1px solid rgba(124,58,237,0.35);
  }
  .free-badge {
    display: inline-block;
    background: linear-gradient(135deg, #7c3aed, #ec4899);
    color: #fff;
    font-weight: 800; font-size: 0.78rem; letter-spacing: 0.06em;
    padding: 5px 14px; border-radius: 999px; margin-bottom: 18px;
  }
  .free-card h2 { font-size: clamp(1.5rem, 3vw, 2.1rem); margin-bottom: 16px; }
  .free-card > p { color: var(--text); opacity: 0.85; max-width: 720px; margin: 0 auto; line-height: 1.7; font-size: 0.98rem; }

  /* ── FAQ ──────────────────────────────────────────────── */
  .faq-list { max-width: 760px; margin: 0 auto; display: flex; flex-direction: column; gap: 12px; }
  .faq-item {
    background: var(--surface); border: 1px solid var(--border);
    border-radius: var(--radius); padding: 4px 20px;
  }
  .faq-item summary {
    cursor: pointer; padding: 16px 0; font-family: 'Manrope', sans-serif;
    font-weight: 700; font-size: 1rem; list-style: none;
    display: flex; justify-content: space-between; align-items: center;
    gap: 12px;
  }
  .faq-item summary::-webkit-details-marker { display: none; }
  .faq-item summary::after { content: '+'; color: var(--accent-light); font-size: 1.4rem; font-weight: 400; transition: transform 0.2s; flex-shrink: 0; }
  .faq-item[open] summary::after { transform: rotate(45deg); }
  .faq-item p { color: var(--text-muted); font-size: 0.93rem; line-height: 1.65; padding: 0 0 18px; }

  /* ── Closing ──────────────────────────────────────────── */
  .closing-section { margin-bottom: 20px; }
  .closing-section .section-head { margin-bottom: 0; }
  .closing-cta { margin-top: 28px; }

  /* ── Responsive ───────────────────────────────────────── */
  @media (max-width: 980px) {
    .steps-grid { grid-template-columns: 1fr 1fr; row-gap: 32px; }
  }
  @media (max-width: 880px) {
    .why-grid { grid-template-columns: 1fr 1fr; }
  }
  @media (max-width: 600px) {
    .home-section { margin-top: 64px; }
    .hero { padding-top: 96px; }
    .steps-grid, .why-grid { grid-template-columns: 1fr; }
    .steps-grid { row-gap: 32px; }
    .promo-stats { grid-template-columns: 1fr 1fr 1fr; gap: 10px; }
