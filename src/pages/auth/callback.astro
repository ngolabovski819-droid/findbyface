---
// SSR — must NOT be prerendered so it works on any host (localhost dev or production)
---
<!DOCTYPE html>
<html lang="en">
<head>
  <meta charset="UTF-8" />
  <meta name="viewport" content="width=device-width, initial-scale=1.0" />
  <title>Signing in — findbyface</title>
  <style>
    body {
      background: #0a0a0f; color: #f0f0f5;
      font-family: 'DM Sans', sans-serif;
      display: flex; align-items: center; justify-content: center;
      min-height: 100vh; margin: 0; flex-direction: column; gap: 16px;
    }
    .logo { font-size: 1.5rem; font-weight: 800; }
    .logo span { background: linear-gradient(135deg, #7c3aed, #ec4899); -webkit-background-clip: text; -webkit-text-fill-color: transparent; background-clip: text; }
    p { color: #8888aa; font-size: 14px; }
    .spinner { width: 36px; height: 36px; border: 3px solid rgba(124,58,237,0.2); border-top-color: #7c3aed; border-radius: 50%; animation: spin 0.8s linear infinite; }
    @keyframes spin { to { transform: rotate(360deg); } }
  </style>
</head>
<body>
  <div class="logo">find<span>byface</span></div>
  <div class="spinner"></div>
  <p id="statusMsg">Signing you in...</p>

  <script>
    async function handleCallback() {
      const statusMsg = document.getElementById('statusMsg')!;
      try {
        // Implicit auth normally returns tokens in the fragment. Accept query values
        // too so older/custom email templates cannot strand a verified user.
        const hashParams = new URLSearchParams(window.location.hash.substring(1));
        const queryParams = new URLSearchParams(window.location.search);
        const readParam = (name) => hashParams.get(name) || queryParams.get(name);
        const accessToken = readParam('access_token');
        const refreshToken = readParam('refresh_token');
        const expiresIn = Number(readParam('expires_in') || 3600);
        const authError = readParam('error_description') || readParam('error');

        if (!accessToken) {
          const requestedReturn = localStorage.getItem('fbf_auth_return') || '/dashboard/';
          const returnTo = requestedReturn.startsWith('/') && !requestedReturn.startsWith('//')
            ? requestedReturn
            : '/dashboard/';
          const status = authError ? 'confirmation_failed' : 'verified';
          statusMsg.textContent = authError
            ? 'Verification failed — taking you to login...'
            : 'Email verified — finish by logging in...';
          setTimeout(() => {
            window.location.href = `/login/?status=${status}&next=${encodeURIComponent(returnTo)}`;
          }, 900);
          return;
        }

        // Call our server-side session endpoint (keeps service key server-side)
        const resp = await fetch('/api/auth/session', {
          method: 'POST',
          headers: { 'Content-Type': 'application/json' },
          body: JSON.stringify({ access_token: accessToken }),
        });

        if (!resp.ok) throw new Error('Session verification failed');

        const user = await resp.json();
        localStorage.setItem('fbf_user', JSON.stringify({
          ...user,
          access_token: accessToken,
          refresh_token: refreshToken,
          expires_at: Date.now() + expiresIn * 1000,
        }));
        // Clear search count — signed-in users get unlimited
        localStorage.removeItem('fbf_searches');
        localStorage.removeItem('fbf_pornstar_guest_search_day');
        localStorage.removeItem('fbf_pending_email');

        const requestedReturn = localStorage.getItem('fbf_auth_return') || '/';
        localStorage.removeItem('fbf_auth_return');
        const returnTo = requestedReturn.startsWith('/') && !requestedReturn.startsWith('//')
          ? requestedReturn
          : '/';

        statusMsg.textContent = `Welcome, ${user.name?.split(' ')[0] || user.email}!`;
        setTimeout(() => { window.location.href = returnTo; }, 800);
      } catch (err) {
        statusMsg.textContent = 'Sign-in failed — taking you to login...';
        setTimeout(() => { window.location.href = '/login/?status=confirmation_failed'; }, 1200);
      }
    }

    handleCallback();
  </script>
</body>
</html>
