---
import Base from '../layouts/Base.astro';
import VideoFaceSearch from '../components/VideoFaceSearch.astro';

const canonical = 'https://findbyface.org/pornstar-finder-by-face/';
const title = 'Pornstar Finder by Face or Photo | Free AI Search';
const description =
  'Use our free AI pornstar finder to search by face, photo, picture, or video screenshot. Get ranked matching appearances from a growing private beta index.';

const faqs = [
  {
    question: 'How does the AI pornstar finder search by face?',
    answer:
      'It detects the face in an uploaded photo, creates a numerical face vector, and compares that vector with sampled faces from indexed adult videos. Results are grouped by video and ranked by visual similarity.',
  },
  {
    question: 'Can I find a pornstar from a video screenshot?',
    answer:
      'Yes. Copy a clear screenshot and press Ctrl+V or Command+V anywhere on the search page, or upload the saved image. Crop away player controls, subtitles, borders, and unrelated people before searching.',
  },
  {
    question: 'Is this the same as reverse image search?',
    answer:
      'No. Traditional reverse image search looks for copies of the same picture. This tool searches the face itself, so it can find matching appearances in different frames, scenes, lighting, and camera angles.',
  },
  {
    question: 'How accurate are the matches?',
    answer:
      'Accuracy depends on photo quality, pose, index coverage, and how often a face appears clearly in a video. Similarity scores are useful ranking signals, not proof of identity. Review the linked source before reaching a conclusion.',
  },
  {
    question: 'Is my uploaded image stored?',
    answer:
      'No. The uploaded file is processed in a temporary directory and deleted when the search finishes. The query image is not uploaded to Supabase or added to the video index.',
  },
  {
    question: 'Why did my search return no results?',
    answer:
      'The face may be too small, blurred, covered, heavily filtered, or absent from the current beta index. Try a sharper front-facing frame, crop to one face, or test a second screenshot from the same video.',
  },
  {
    question: 'What does beta mean for this tool?',
    answer:
      'The search works, but the video index is still growing and ranking thresholds are still being calibrated. Coverage, speed, and result grouping will continue to improve before the full launch.',
  },
  {
    question: 'Is the pornstar face finder free?',
    answer:
      'The tool is free during beta. Limits or account features may change later, but any future changes will be shown clearly before they affect a search.',
  },
  {
    question: 'Can this work as a pornstar name finder?',
    answer:
      'It can help when matching video titles or source pages contain a performer name. The primary result is a ranked list of matching video appearances, so a name is not guaranteed and every source should be reviewed.',
  },
  {
    question: 'Is this a pornstar lookalike finder?',
    answer:
      'Not primarily. A lookalike finder recommends different people with similar features. This tool is designed to retrieve appearances of the same face across indexed videos, although visually similar people can still produce false matches.',
  },
];

const structuredData = JSON.stringify([
  {
    '@context': 'https://schema.org',
    '@type': 'WebApplication',
    name: 'findbyface AI Pornstar Finder by Face and Photo',
    alternateName: [
      'Pornstar Face Finder',
      'Pornstar Image Finder',
      'Pornstar Name Finder',
    ],
    url: canonical,
    description,
    applicationCategory: 'SearchApplication',
    operatingSystem: 'Any',
    browserRequirements: 'Requires JavaScript and image upload support',
    isAccessibleForFree: true,
    audience: {
      '@type': 'PeopleAudience',
      requiredMinAge: 18,
    },
    featureList: [
      'Free AI face search by photo, picture, or screenshot',
      'Ranked video matches',
      'Source thumbnails and links',
      'Temporary image processing',
    ],
  },
  {
    '@context': 'https://schema.org',
    '@type': 'FAQPage',
    mainEntity: faqs.map((item) => ({
      '@type': 'Question',
      name: item.question,
      acceptedAnswer: {
        '@type': 'Answer',
        text: item.answer,
      },
    })),
  },
  {
    '@context': 'https://schema.org',
    '@type': 'BreadcrumbList',
    itemListElement: [
      {
        '@type': 'ListItem',
        position: 1,
        name: 'Home',
        item: 'https://findbyface.org/',
      },
      {
        '@type': 'ListItem',
        position: 2,
        name: 'Pornstar Finder by Face',
        item: canonical,
      },
    ],
  },
]);
---

<Base title={title} description={description} canonical={canonical}>
  <Fragment slot="head">
    <meta name="robots" content="index,follow,max-image-preview:large,max-snippet:-1,max-video-preview:-1" />
    <meta name="rating" content="adult" />
    <script type="application/ld+json" set:html={structuredData} />
  </Fragment>

  <VideoFaceSearch />

  <div class="content-shell">
    <section class="content-section how-section" id="how-it-works">
      <div class="section-heading">
        <span class="eyebrow">From photo to video evidence</span>
        <h2>How the AI pornstar face finder works</h2>
        <p>
          One search follows the same face pipeline used to build the video
          index, keeping the query and catalog vectors directly comparable.
        </p>
      </div>

      <div class="steps-grid">
        <article class="step-card">
          <span class="step-number">01</span>
          <div class="step-icon" aria-hidden="true">
            <svg viewBox="0 0 24 24" fill="none">
              <path d="M12 16V4m0 0L7.5 8.5M12 4l4.5 4.5" />
              <path d="M5 13v5a2 2 0 0 0 2 2h10a2 2 0 0 0 2-2v-5" />
            </svg>
          </div>
          <h3>Upload one useful face</h3>
          <p>
            Choose a portrait or screenshot with one clear adult performer.
            The file is decoded in temporary storage and deleted after search.
          </p>
        </article>

        <article class="step-card featured">
          <span class="step-number">02</span>
          <div class="step-icon" aria-hidden="true">
            <svg viewBox="0 0 24 24" fill="none">
              <circle cx="12" cy="10" r="4" />
              <path d="M5 21c.6-4 2.9-6 7-6s6.4 2 7 6M3 7V3h4M17 3h4v4" />
            </svg>
          </div>
          <h3>Create a face vector</h3>
          <p>
            The same recognition model converts the query face into a
            normalized 512-dimensional embedding. The image itself is not
            added to the index.
          </p>
        </article>

        <article class="step-card">
          <span class="step-number">03</span>
          <div class="step-icon" aria-hidden="true">
            <svg viewBox="0 0 24 24" fill="none">
              <path d="M4 5h16M4 12h10M4 19h7" />
              <circle cx="18" cy="16" r="3" />
              <path d="m20.2 18.2 2 2" />
            </svg>
          </div>
          <h3>Review ranked videos</h3>
          <p>
            Vector search finds nearby sampled faces, groups evidence by video,
            and returns thumbnails, similarity scores, and source links.
          </p>
        </article>
      </div>
    </section>

    <section class="content-section technology-section" id="technology">
      <div class="technology-copy">
        <span class="eyebrow">Built for face-to-video retrieval</span>
        <h2>The technology behind the search</h2>
        <p>
          This is not a generic image-search wrapper. It is a purpose-built
          pipeline that samples video, filters face detections, stores compact
          vectors, and retrieves evidence at video level.
        </p>
        <a class="text-link" href="#videoSearchForm">
          Test the beta with a clear photo
          <span aria-hidden="true">↑</span>
        </a>
      </div>

      <div class="technology-stack">
        <article class="tech-layer">
          <div class="layer-index">01</div>
          <div>
            <span>Detect + encode</span>
            <h3>InsightFace · 512D embeddings</h3>
            <p>
              Buffalo_L face detection and recognition create normalized
              vectors for both indexed frames and search images.
            </p>
          </div>
          <code>float[512]</code>
        </article>

        <div class="stack-connector" aria-hidden="true"></div>

        <article class="tech-layer">
          <div class="layer-index">02</div>
          <div>
            <span>Sample + deduplicate</span>
            <h3>Temporal video face indexing</h3>
            <p>
              Frames are sampled at intervals, low-quality detections are
              rejected, similar faces are clustered, and intro/outro segments
              are excluded by skipping the first and last 20 seconds.
            </p>
          </div>
          <code>8s · max 120</code>
        </article>

        <div class="stack-connector" aria-hidden="true"></div>

        <article class="tech-layer">
          <div class="layer-index">03</div>
          <div>
            <span>Retrieve + group</span>
            <h3>Supabase Postgres · pgvector HNSW</h3>
            <p>
              Half-precision vectors use cosine similarity and an HNSW index.
              Nearby faces are grouped into useful video-level results.
            </p>
          </div>
          <code>halfvec · cosine</code>
        </article>
      </div>
    </section>

    <section class="content-section comparison-section">
      <div class="section-heading">
        <span class="eyebrow">Know what you are searching</span>
        <h2>Pornstar image finder vs. reverse image search</h2>
        <p>
          The difference matters when your screenshot does not exist elsewhere
          as the same exact image.
        </p>
      </div>

      <div class="comparison-grid">
        <article class="comparison-card muted-card">
          <span class="comparison-label">Traditional reverse image search</span>
          <h3>Looks for the same picture</h3>
          <ul>
            <li>Matches duplicate or near-duplicate files</li>
            <li>Depends on the exact frame being published</li>
            <li>Often fails after cropping, overlays, or compression</li>
          </ul>
        </article>

        <article class="comparison-card accent-card">
          <span class="comparison-label">findbyface video search</span>
          <h3>Looks for the same face</h3>
          <ul>
            <li>Compares facial structure across different frames</li>
            <li>Can retrieve other scenes and camera angles</li>
            <li>Groups multiple supporting faces into one video result</li>
          </ul>
        </article>
      </div>
    </section>

    <section class="content-section photo-section">
      <div class="photo-guide">
        <div class="section-heading align-left">
          <span class="eyebrow">Better input, better ranking</span>
          <h2>How to find a pornstar by photo or screenshot</h2>
          <p>
            A saved picture, uploaded photo, or pasted video screenshot all use
            the same face-matching pipeline. The face should be visible,
            reasonably large, and not heavily edited.
          </p>
        </div>

        <div class="guide-columns">
          <div class="guide-column good">
            <span class="guide-title">
              <span class="guide-symbol">✓</span>
              Works best
            </span>
            <ul>
              <li>One face in the image</li>
              <li>Front-facing or mild three-quarter angle</li>
              <li>Sharp eyes and visible facial outline</li>
              <li>Even light without strong color filters</li>
              <li>Crop out subtitles and player controls</li>
            </ul>
          </div>

          <div class="guide-column avoid">
            <span class="guide-title">
              <span class="guide-symbol">×</span>
              Try to avoid
            </span>
            <ul>
              <li>Group shots or background faces</li>
              <li>Motion blur and very small faces</li>
              <li>Masks, sunglasses, or heavy obstruction</li>
              <li>Extreme profile angles</li>
              <li>AI filters that reshape facial features</li>
            </ul>
          </div>
        </div>
      </div>

      <aside class="interpretation-card">
        <span class="eyebrow">Read results responsibly</span>
        <h3>A match is a lead, not identity proof</h3>
        <p>
          People can share similar facial proportions. Scores rank the closest
          faces in the current index; they do not establish someone’s identity
          or prove that a private person appears in adult content.
        </p>
        <div class="score-key">
          <div>
            <strong>Best cosine</strong>
            <span>Strongest sampled-face similarity</span>
          </div>
          <div>
            <strong>Supporting faces</strong>
            <span>Additional matching evidence in that video</span>
          </div>
          <div>
            <strong>Source video</strong>
            <span>The page you should review for context</span>
          </div>
        </div>
      </aside>
    </section>

    <section class="content-section beta-section">
      <div class="beta-orbit" aria-hidden="true">
        <span></span><span></span><span></span>
        <div>BETA</div>
      </div>

      <div class="beta-copy">
        <span class="eyebrow">Transparent by design</span>
        <h2>This pornstar finder is in active beta</h2>
        <p>
          The core search is working, but we are still expanding the indexed
          library and measuring real-world ranking quality. Some searches will
          be excellent; others may miss a performer who has not been indexed
          yet or appears only in difficult frames.
        </p>

        <div class="beta-roadmap">
          <div>
            <span>Now</span>
            <strong>Face-to-video retrieval</strong>
          </div>
          <div>
            <span>Improving</span>
            <strong>Coverage + threshold calibration</strong>
          </div>
          <div>
            <span>Next</span>
            <strong>Better grouping + search feedback</strong>
          </div>
        </div>
      </div>
    </section>

    <section class="content-section trust-section">
      <div class="section-heading">
        <span class="eyebrow">Private, limited, responsible</span>
        <h2>What happens to your photo</h2>
        <p>
          The search needs the face for a few seconds—not a permanent copy of
          your image.
        </p>
      </div>

      <div class="trust-grid">
        <article>
          <span class="trust-icon">01</span>
          <h3>Temporary file</h3>
          <p>
            The upload is written to a temporary request folder only long
            enough to detect and encode the face.
          </p>
        </article>
        <article>
          <span class="trust-icon">02</span>
          <h3>Transient query vector</h3>
          <p>
            A normalized face vector is compared with the index. The query
            image is not uploaded to Supabase or added as searchable content.
          </p>
        </article>
        <article>
          <span class="trust-icon">03</span>
          <h3>Automatic deletion</h3>
          <p>
            The temporary upload directory is removed after success, error, or
            timeout. The tool does not generate deepfakes or synthetic media.
          </p>
        </article>
      </div>

      <p class="responsible-note">
        Adults only. Upload images you own or are permitted to use. Do not use
        results to harass, expose, track, threaten, or make decisions about a
        private person. Review our <a href="/privacy-policy/">Privacy Policy</a>,
        <a href="/terms-of-use/">Terms</a>, and <a href="/dmca/">DMCA process</a>.
      </p>
    </section>

    <section class="content-section faq-section">
      <div class="section-heading align-left">
        <span class="eyebrow">Pornstar finder questions</span>
        <h2>Frequently asked questions</h2>
        <p>
          Clear answers about how face search works, what the scores mean, and
          what to expect during beta.
        </p>
      </div>

      <div class="faq-list">
        {faqs.map((item, index) => (
          <details open={index === 0}>
            <summary>
              <span>{item.question}</span>
              <span class="faq-plus" aria-hidden="true"></span>
            </summary>
            <p>{item.answer}</p>
          </details>
        ))}
      </div>
    </section>

    <section class="final-cta">
      <span class="eyebrow">One photo is enough to start</span>
      <h2>Search the growing video index</h2>
      <p>
        Use a clear performer portrait or crop a sharp frame from the video you
        are trying to identify.
      </p>
      <a href="#videoSearchForm">
        Try the beta face search
        <span aria-hidden="true">↑</span>
      </a>
      <small>
        Looking for creator profiles instead?
        <a href="/onlyfans-finder-by-face/">Try the OnlyFans face finder.</a>
      </small>
    </section>
  </div>
</Base>

<style>
  :global(html) {
    scroll-behavior: smooth;
  }

  :global(body) {
    overflow-x: clip;
    background:
      radial-gradient(circle at 50% 4%, rgba(91, 33, 182, 0.2), transparent 36rem),
      radial-gradient(circle at 5% 48%, rgba(236, 72, 153, 0.055), transparent 28rem),
      #09090e;
  }

  :global(#videoSearchForm),
  .content-section {
    scroll-margin-top: 92px;
  }

  .content-shell {
    width: min(1180px, calc(100% - 40px));
    margin: 0 auto;
  }

  .content-shell *,
  .content-shell *::before,
  .content-shell *::after {
    min-width: 0;
  }

  .content-shell :is(h2, h3, h4) {
    font-family: 'Manrope', sans-serif;
  }

  .content-section {
    margin-top: 118px;
  }

  .section-heading {
    max-width: 720px;
    margin: 0 auto 42px;
    text-align: center;
  }

  .section-heading.align-left {
    margin-right: 0;
    margin-left: 0;
    text-align: left;
  }

  .eyebrow {
    display: inline-block;
    margin-bottom: 12px;
    color: #a78bfa;
    font-size: 11px;
    font-weight: 700;
    letter-spacing: 0.13em;
    text-transform: uppercase;
  }

  .section-heading h2,
  .technology-copy h2,
  .beta-copy h2,
  .final-cta h2 {
    font-size: clamp(2rem, 4.5vw, 3.55rem);
    line-height: 1.05;
    letter-spacing: -0.04em;
  }

  .section-heading p,
  .technology-copy > p,
  .beta-copy > p,
  .final-cta > p {
    margin-top: 18px;
    color: #9494ad;
    font-size: 15px;
    line-height: 1.8;
  }

  .steps-grid {
    display: grid;
    grid-template-columns: repeat(3, minmax(0, 1fr));
    gap: 16px;
  }

  .step-card {
    position: relative;
    min-height: 330px;
    padding: 28px;
    overflow: hidden;
    border: 1px solid rgba(255, 255, 255, 0.075);
    border-radius: 22px;
    background:
      linear-gradient(145deg, rgba(22, 21, 33, 0.94), rgba(13, 13, 21, 0.98));
    transition: transform 180ms ease, border-color 180ms ease, box-shadow 180ms ease;
  }

  .step-card:hover {
    transform: translateY(-4px);
    border-color: rgba(168, 85, 247, 0.25);
    box-shadow: 0 18px 50px rgba(0, 0, 0, 0.2);
  }

  .step-card.featured {
    border-color: rgba(168, 85, 247, 0.32);
    background:
      radial-gradient(circle at 82% 12%, rgba(124, 58, 237, 0.19), transparent 48%),
      linear-gradient(145deg, rgba(27, 24, 42, 0.98), rgba(13, 13, 21, 0.98));
  }

  .step-number {
    position: absolute;
    top: 22px;
    right: 24px;
    color: rgba(255, 255, 255, 0.13);
    font-family: 'Manrope', sans-serif;
    font-size: 2.6rem;
    font-weight: 800;
  }

  .step-icon {
    display: grid;
    width: 48px;
    height: 48px;
    margin-bottom: 68px;
    place-items: center;
    border: 1px solid rgba(168, 85, 247, 0.25);
    border-radius: 14px;
    background: rgba(124, 58, 237, 0.11);
    color: #c4b5fd;
  }

  .step-icon svg {
    width: 23px;
    stroke: currentColor;
    stroke-width: 1.6;
    stroke-linecap: round;
    stroke-linejoin: round;
  }

  .step-card h3 {
    font-size: 1.15rem;
  }

  .step-card p {
    margin-top: 11px;
    color: #85859c;
    font-size: 13px;
    line-height: 1.75;
  }

  .technology-section {
    display: grid;
    grid-template-columns: minmax(260px, 0.66fr) minmax(0, 1.34fr);
    gap: 48px;
    align-items: center;
    padding: 56px;
    border: 1px solid rgba(139, 92, 246, 0.21);
    border-radius: 28px;
    background:
      radial-gradient(circle at 5% 15%, rgba(124, 58, 237, 0.14), transparent 40%),
      rgba(17, 16, 26, 0.86);
  }

  .technology-copy {
    min-width: 0;
  }

  .technology-copy h2 {
    max-width: 10ch;
    font-size: clamp(2rem, 3.25vw, 3rem);
    line-height: 1.04;
    overflow-wrap: anywhere;
  }

  .text-link {
    display: inline-flex;
    gap: 8px;
    align-items: center;
    margin-top: 26px;
    color: #d8b4fe;
    font-size: 13px;
    font-weight: 700;
  }

  .text-link:hover {
    color: #f0abfc;
  }

  .technology-stack {
    position: relative;
    z-index: 1;
    min-width: 0;
  }

  .tech-layer {
    display: grid;
    grid-template-columns: 42px minmax(0, 1fr) auto;
    gap: 18px;
    align-items: center;
    padding: 22px;
    border: 1px solid rgba(255, 255, 255, 0.075);
    border-radius: 16px;
    background: rgba(7, 7, 12, 0.6);
    transition: transform 180ms ease, border-color 180ms ease, background 180ms ease;
  }

  .tech-layer:hover {
    transform: translateX(4px);
    border-color: rgba(168, 85, 247, 0.25);
    background: rgba(10, 9, 18, 0.82);
  }

  .layer-index {
    display: grid;
    width: 36px;
    height: 36px;
    place-items: center;
    border-radius: 10px;
    background: rgba(124, 58, 237, 0.14);
    color: #c4b5fd;
    font-size: 11px;
    font-weight: 800;
  }

  .tech-layer span {
    color: #707089;
    font-size: 9px;
    font-weight: 700;
    letter-spacing: 0.1em;
    text-transform: uppercase;
  }

  .tech-layer h3 {
    margin-top: 2px;
    font-family: 'Inter', sans-serif;
    font-size: 14px;
  }

  .tech-layer p {
    margin-top: 5px;
    color: #7f7f97;
    font-size: 11px;
    line-height: 1.6;
  }

  .tech-layer code {
    padding: 6px 8px;
    border: 1px solid rgba(168, 85, 247, 0.18);
    border-radius: 7px;
    background: rgba(124, 58, 237, 0.08);
    color: #b8a6d9;
    font-size: 9px;
    white-space: nowrap;
  }

  .stack-connector {
    width: 1px;
    height: 13px;
    margin-left: 40px;
    background: linear-gradient(#7c3aed, rgba(124, 58, 237, 0.15));
  }

  .comparison-grid {
    display: grid;
    grid-template-columns: repeat(2, minmax(0, 1fr));
    gap: 18px;
  }

  .comparison-card {
    padding: 34px;
    border-radius: 22px;
  }

  .muted-card {
    border: 1px solid rgba(255, 255, 255, 0.07);
    background: rgba(18, 18, 27, 0.72);
  }

  .accent-card {
    border: 1px solid rgba(168, 85, 247, 0.32);
    background:
      radial-gradient(circle at 90% 5%, rgba(236, 72, 153, 0.12), transparent 40%),
      rgba(25, 20, 38, 0.9);
  }

  .comparison-label {
    color: #8d8da5;
    font-size: 10px;
    font-weight: 700;
    letter-spacing: 0.1em;
    text-transform: uppercase;
  }

  .comparison-card h3 {
    margin-top: 10px;
    font-size: 1.3rem;
  }

  .comparison-card ul {
    display: grid;
    gap: 11px;
    margin-top: 24px;
    padding: 0;
    list-style: none;
  }

  .comparison-card li {
    position: relative;
    padding-left: 20px;
    color: #8d8da5;
    font-size: 13px;
  }

  .comparison-card li::before {
    position: absolute;
    top: 0.46rem;
    left: 0;
    width: 6px;
    height: 6px;
    border-radius: 50%;
    background: #7c3aed;
    content: '';
  }

  .photo-section {
    display: grid;
    grid-template-columns: minmax(0, 1.18fr) minmax(320px, 0.82fr);
    gap: 20px;
  }

  .photo-guide,
  .interpretation-card {
    padding: 42px;
    border: 1px solid rgba(255, 255, 255, 0.075);
    border-radius: 24px;
    background: rgba(17, 17, 25, 0.82);
  }

