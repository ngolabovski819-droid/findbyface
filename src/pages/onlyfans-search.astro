---
import Base from '../layouts/Base.astro';
import { SEARCH_SEO } from '../config/seo-meta';

const q        = Astro.url.searchParams.get('q') ?? '';
const verified = Astro.url.searchParams.get('verified') ?? '';
const price    = Astro.url.searchParams.get('price') ?? '';
const sort     = Astro.url.searchParams.get('sort') ?? '';
---

<Base title={SEARCH_SEO.title} description={SEARCH_SEO.description}>
  <div class="search-page">

    <div class="search-header">
      <h1>OnlyFans Search Engine</h1>
      <p class="search-sub">Search and filter from millions of creators</p>
    </div>

    <!-- Search bar with history dropdown -->
    <div class="search-hero" id="searchHero">
      <div class="search-wrap" id="searchWrap">
        <svg class="search-icon" width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><circle cx="11" cy="11" r="8"/><path d="M21 21l-4.35-4.35"/></svg>
        <input
          type="text"
          id="searchInput"
          class="search-main-input"
          placeholder="Search creators..."
          value={q}
          autocomplete="off"
          aria-label="Search creators"
          aria-autocomplete="list"
          aria-controls="searchDropdown"
          aria-expanded="false"
        />
        <button class="search-clear-btn" id="searchClearBtn" aria-label="Clear search" style="display:none">
          <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round"><line x1="18" y1="6" x2="6" y2="18"/><line x1="6" y1="6" x2="18" y2="18"/></svg>
        </button>
      </div>

      <!-- Dropdown -->
      <div class="search-dropdown" id="searchDropdown" style="display:none">
        <div class="dd-ad-slot" id="ddAdSlot" style="display:none"></div>
        <div class="dd-header">
          <span class="dd-label">Recent searches</span>
          <button class="dd-clear-all" id="clearAllBtn" type="button" style="display:none">Clear all</button>
        </div>
        <div class="dd-history" id="historyList"></div>
      </div>
    </div>

    <!-- Mode tab -->
    <div class="mode-tabs">
      <a href="/" class="mode-tab">
        <svg width="15" height="15" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><rect x="3" y="3" width="18" height="18" rx="2"/><circle cx="8.5" cy="8.5" r="1.5"/><path d="M21 15l-5-5L5 21"/></svg>
        Face Match
      </a>
    </div>

    <div class="search-layout">
      <button class="filters-backdrop" id="filtersBackdrop" type="button" aria-label="Close filters" tabindex="-1"></button>

      <aside class="filters" id="filtersPanel">
        <div class="filters-title-row">
          <h3 class="filters-title">Filters</h3>
          <button class="filters-close-btn" id="filtersCloseBtn" type="button" aria-label="Close filters">×</button>
        </div>

        <div class="filter-group">
          <label class="filter-label toggle-label">
            <span>Verified only</span>
            <label class="toggle">
              <input type="checkbox" id="verifiedToggle" checked={verified === 'true'} />
              <span class="toggle-slider"></span>
            </label>
          </label>
        </div>

        <div class="filter-group">
          <span class="filter-label">Price</span>
          <div class="pill-group" id="priceOptions">
            {(['', '0', '5', '10'] as const).map(p => (
              <button class={`pill ${price === p ? 'active' : ''}`} data-price={p}>
                {p === '' ? 'Any' : p === '0' ? 'Free' : `Under $${p}`}
              </button>
            ))}
          </div>
        </div>

        <div class="filter-group">
          <span class="filter-label">Sort</span>
          <div class="pill-group" id="sortOptions">
            <button class={`pill ${sort !== 'newest' ? 'active' : ''}`} data-sort="">Popular</button>
            <button class={`pill ${sort === 'newest' ? 'active' : ''}`} data-sort="newest">Newest</button>
          </div>
        </div>

        <div class="filter-group">
          <label class="filter-label toggle-label">
            <span>Has bundles</span>
            <label class="toggle">
              <input type="checkbox" id="bundlesToggle" />
              <span class="toggle-slider"></span>
            </label>
          </label>
        </div>

        <button class="apply-btn" id="applyBtn">Apply Filters</button>
      </aside>

      <div class="results-area">
        <div class="results-top-bar">
          <p class="results-meta" id="resultsCount">Loading...</p>
          <button class="filters-toggle-btn" id="filtersToggleBtn" type="button" aria-expanded="false" aria-controls="filtersPanel">
            <svg width="15" height="15" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><line x1="4" y1="6" x2="20" y2="6"/><line x1="4" y1="12" x2="20" y2="12"/><line x1="4" y1="18" x2="20" y2="18"/><circle cx="9" cy="6" r="1.6" fill="currentColor" stroke="none"/><circle cx="16" cy="12" r="1.6" fill="currentColor" stroke="none"/><circle cx="10" cy="18" r="1.6" fill="currentColor" stroke="none"/></svg>
            Filters
          </button>
        </div>
        <div class="results-grid" id="resultsGrid"></div>
        <div class="load-more-wrap" id="loadMoreWrap" style="display:none">
          <button class="load-more-btn" id="loadMoreBtn">Load More</button>
        </div>
      </div>
    </div>
  </div>
</Base>

<script>
  import { pushHistory } from '../lib/searchHistory';
  import { initSearchDropdown } from '../lib/searchDropdown';
  import { initCardClickThrough } from '../lib/cardClickThrough';
  import { creatorCardDataAttributes } from '../lib/creatorCardUi';

  // ── DOM refs ──────────────────────────────────────────────────────────────
  const searchHero     = document.getElementById('searchHero')!;
  const searchInput    = document.getElementById('searchInput') as HTMLInputElement;
  const searchClearBtn = document.getElementById('searchClearBtn') as HTMLButtonElement;
  const dropdown       = document.getElementById('searchDropdown')!;
  const ddAdSlot       = document.getElementById('ddAdSlot')!;
  const historyList    = document.getElementById('historyList')!;
  const clearAllBtn    = document.getElementById('clearAllBtn') as HTMLButtonElement;

  initCardClickThrough();
  initSearchDropdown({
    wrapper: searchHero,
    input: searchInput,
    dropdown,
    adSlot: ddAdSlot,
    historyList,
    clearAllBtn,
    onSelect(q) {
      searchInput.value = q;
      activeFilters.q = q;
      fetchCreators(false);
    },
  });

  // ── Clear button ──────────────────────────────────────────────────────────
  searchInput.addEventListener('input', () => {
    searchClearBtn.style.display = searchInput.value ? 'flex' : 'none';
  });
  if (searchInput.value) searchClearBtn.style.display = 'flex';

  searchClearBtn.addEventListener('click', () => {
    searchInput.value = '';
    searchClearBtn.style.display = 'none';
    searchInput.focus();
    activeFilters.q = '';
    doSearch();
  });

  // ── Search / filter logic ─────────────────────────────────────────────────
  let currentPage = 1;
  let isLoading = false;
  let hasMoreResults = false;

  const qs = new URLSearchParams(window.location.search);
  let activeFilters = {
    q:        qs.get('q') ?? '',
    verified: qs.get('verified') ?? '',
    price:    qs.get('price') ?? '',
    sort:     qs.get('sort') ?? '',
    bundles:  '',
  };

  const verifiedToggle = document.getElementById('verifiedToggle') as HTMLInputElement;
  const bundlesToggle  = document.getElementById('bundlesToggle') as HTMLInputElement;
  const resultsGrid    = document.getElementById('resultsGrid')!;
  const resultsCount   = document.getElementById('resultsCount')!;
  const loadMoreWrap   = document.getElementById('loadMoreWrap')!;
  const loadMoreBtn    = document.getElementById('loadMoreBtn') as HTMLButtonElement;
  const applyBtn       = document.getElementById('applyBtn')!;

  // ── Mobile filters drawer — desktop keeps the sticky sidebar untouched; these buttons
  // only render (via CSS) under the 1000px breakpoint. ────────────────────────────────
  const filtersPanel      = document.getElementById('filtersPanel')!;
  const filtersBackdrop   = document.getElementById('filtersBackdrop')!;
  const filtersToggleBtn  = document.getElementById('filtersToggleBtn') as HTMLButtonElement;
  const filtersCloseBtn   = document.getElementById('filtersCloseBtn') as HTMLButtonElement;

  function openFilters(): void {
    filtersPanel.classList.add('filters-open');
    filtersBackdrop.classList.add('filters-open');
    filtersToggleBtn.setAttribute('aria-expanded', 'true');
  }
  function closeFilters(): void {
    filtersPanel.classList.remove('filters-open');
    filtersBackdrop.classList.remove('filters-open');
    filtersToggleBtn.setAttribute('aria-expanded', 'false');
  }
  filtersToggleBtn.addEventListener('click', openFilters);
  filtersCloseBtn.addEventListener('click', closeFilters);
  filtersBackdrop.addEventListener('click', closeFilters);
  document.addEventListener('keydown', e => { if (e.key === 'Escape') closeFilters(); });

  document.querySelectorAll('#priceOptions .pill').forEach(btn => {
    btn.addEventListener('click', () => {
      document.querySelectorAll('#priceOptions .pill').forEach(b => b.classList.remove('active'));
      btn.classList.add('active');
      activeFilters.price = (btn as HTMLElement).dataset.price ?? '';
    });
  });

  document.querySelectorAll('#sortOptions .pill').forEach(btn => {
    btn.addEventListener('click', () => {
      document.querySelectorAll('#sortOptions .pill').forEach(b => b.classList.remove('active'));
      btn.classList.add('active');
      activeFilters.sort = (btn as HTMLElement).dataset.sort ?? '';
    });
  });

  let debounceTimer: ReturnType<typeof setTimeout>;
  searchInput.addEventListener('input', () => {
    clearTimeout(debounceTimer);
    debounceTimer = setTimeout(() => {
      activeFilters.q = searchInput.value.trim();
      // Debounce auto-search does NOT save to history — only explicit submits do
      fetchCreators(false);
    }, 350);
  });

  // Enter key = explicit submit → save to history
  searchInput.addEventListener('keydown', e => {
    if (e.key === 'Enter') {
      clearTimeout(debounceTimer);
      const q = searchInput.value.trim();
      activeFilters.q = q;
      if (q) pushHistory(q);
      dropdown.style.display = 'none';
      fetchCreators(false);
    }
  });

  applyBtn.addEventListener('click', () => {
    clearTimeout(debounceTimer);
    const q = searchInput.value.trim();
    activeFilters.q        = q;
    activeFilters.verified = verifiedToggle.checked ? 'true' : '';
    activeFilters.bundles  = bundlesToggle.checked ? 'true' : '';
    if (q) pushHistory(q);
    dropdown.style.display = 'none';
    closeFilters();
    fetchCreators(false);
  });

  loadMoreBtn.addEventListener('click', () => fetchCreators(true));

  function proxyImg(url: string, w: number, h: number): string {
    if (!url || url.startsWith('/')) return url;
    return `https://images.weserv.nl/?url=${encodeURIComponent(url.replace(/^https?:\/\//, ''))}&w=${w}&h=${h}&fit=cover&output=webp`;
  }

  function renderCard(c: any, index: number): string {
    const imgSrc = c.avatar?.startsWith('/') ? c.avatar : c.avatar?.startsWith('http') ? proxyImg(c.avatar, 320, 427) : '/no-image.png';
    const price = c.subscribePrice ?? c.subscribeprice;
    const priceLabel = (!price || isNaN(price)) ? 'FREE' : `$${parseFloat(price).toFixed(2)}`;
    const profileUrl = c.profileUrl || `https://onlyfans.com/${encodeURIComponent(c.username)}`;
    const isSponsored = profileUrl.startsWith('/go/');
    const rel = isSponsored ? 'noopener nofollow sponsored' : 'noopener nofollow';
    const cardData = creatorCardDataAttributes(c);
    return `<div class="creator-card" data-href="${profileUrl}" ${cardData}>
      <div class="card-img-wrap">
        <img src="${imgSrc}" alt="${c.name || c.username}" loading="${index < 8 ? 'eager' : 'lazy'}"
          decoding="async" referrerpolicy="no-referrer"
          onerror="if(this.src!=='/no-image.png'){this.removeAttribute('srcset');this.src='/no-image.png';}">
      </div>
      <div class="card-body">
        <p class="creator-name">${c.name || c.username}</p>
        <p class="username">@${c.username}</p>
        <p class="price ${priceLabel === 'FREE' ? 'price-free' : ''}">${priceLabel}</p>
        <a href="${profileUrl}" class="view-btn" target="_blank" rel="${rel}">View Profile</a>
      </div>
    </div>`;
  }

  async function fetchCreators(append = false) {
    if (isLoading) return;
    isLoading = true;

    if (!append) {
      currentPage = 1;
      resultsGrid.innerHTML = '<p class="loading-msg">Loading...</p>';
    }

    loadMoreBtn.textContent = 'Loading...';
    loadMoreBtn.disabled = true;

    const params = new URLSearchParams();
    params.set('scope', 'onlyfans-search'); // pins the 3 sponsored creators — see src/config/placements.ts
    if (activeFilters.q)        params.set('q',        activeFilters.q);
    if (activeFilters.verified) params.set('verified',  activeFilters.verified);
    if (activeFilters.price)    params.set('price',     activeFilters.price);
    if (activeFilters.sort)     params.set('sort',      activeFilters.sort);
    if (activeFilters.bundles)  params.set('bundles',   activeFilters.bundles);
    params.set('page',      String(currentPage));
    params.set('page_size', '20');

    try {
      const resp = await fetch(`/api/search?${params}`);
      const data = await resp.json();

      if (!append) resultsGrid.innerHTML = '';
      if (!data.creators?.length && !append) {
        resultsGrid.innerHTML = '<p class="loading-msg">No creators found.</p>';
      } else {
        data.creators?.forEach((c: any, i: number) =>
          resultsGrid.insertAdjacentHTML('beforeend', renderCard(c, append ? 999 : i))
        );
      }

      hasMoreResults = data.hasMore;
      currentPage++;

      resultsCount.textContent = data.total
        ? `${data.total.toLocaleString()} creators found`
        : `${data.creators?.length ?? 0} results`;

      loadMoreWrap.style.display = hasMoreResults ? 'flex' : 'none';
      loadMoreBtn.textContent = 'Load More';
      loadMoreBtn.disabled = false;

      const urlObj = new URL(window.location.href);
      if (activeFilters.q) urlObj.searchParams.set('q', activeFilters.q);
      else urlObj.searchParams.delete('q');
      if (activeFilters.sort) urlObj.searchParams.set('sort', activeFilters.sort);
      else urlObj.searchParams.delete('sort');
      window.history.replaceState({}, '', urlObj.toString());
    } catch {
      resultsGrid.innerHTML = '<p class="loading-msg">Error loading results — please try again.</p>';
      loadMoreBtn.textContent = 'Load More';
      loadMoreBtn.disabled = false;
    }

    isLoading = false;
  }

  fetchCreators(false);
</script>

<style>
  .mode-tabs {
    display: flex;
    justify-content: flex-end;
    max-width: 720px;
    margin: 14px auto 0;
  }

  .mode-tab {
    display: inline-flex;
    align-items: center;
    gap: 7px;
    padding: 8px 18px;
    border-radius: 999px;
    border: 1px solid var(--border);
    background: rgba(124,58,237,0.1);
    color: var(--text);
    font-size: 13px;
    font-weight: 600;
    transition: border-color 0.2s, background 0.2s;
  }
  .mode-tab:hover {
    border-color: var(--accent);
    background: rgba(124,58,237,0.18);
  }
  .mode-tab svg { color: var(--accent-light); }

  .search-page {
    max-width: 1200px;
    margin: 0 auto;
    padding: 80px 20px 60px; /* top clears the 64px fixed nav */
  }

  .search-header {
    text-align: center;
    margin: 12px 0 22px;
  }
  .search-header h1 { font-size: clamp(1.8rem, 4vw, 2.6rem); margin-bottom: 8px; }
  .search-sub { color: var(--text-muted); }

  /* ── Hero search bar ──────────────────────────────────────────────────────── */
  .search-hero {
    position: relative;
    max-width: 720px;
    margin: 0 auto;
  }

  .search-wrap {
    display: flex;
    align-items: center;
    background: var(--surface);
    border: 1px solid var(--border);
    border-radius: 999px;
    padding: 0 18px;
    gap: 10px;
    transition: border-color 0.2s, box-shadow 0.2s;
  }
  .search-wrap:focus-within {
    border-color: var(--accent);
    box-shadow: 0 0 0 3px var(--accent-glow);
  }

  .search-icon { color: var(--text-muted); flex-shrink: 0; }

  .search-main-input {
    flex: 1;
    background: transparent;
    border: none;
    outline: none;
    padding: 14px 0;
    font-size: 15px;
    color: var(--text);
    font-family: 'Inter', sans-serif;
  }
  .search-main-input::placeholder { color: var(--text-muted); }

  .search-clear-btn {
    display: flex;
    align-items: center;
    justify-content: center;
    background: rgba(255,255,255,0.08);
    border: none;
    border-radius: 50%;
    width: 22px;
    height: 22px;
    flex-shrink: 0;
    cursor: pointer;
    color: var(--text-muted);
    transition: background 0.15s, color 0.15s;
  }
  .search-clear-btn:hover { background: rgba(255,255,255,0.15); color: var(--text); }

  /* ── Dropdown ─────────────────────────────────────────────────────────────── */
  .search-dropdown {
    position: absolute;
    top: calc(100% + 8px);
    left: 0; right: 0;
    background: #13132a;
    border: 1px solid rgba(124,58,237,0.22);
    border-radius: 16px;
    box-shadow: 0 20px 60px rgba(0,0,0,0.65), 0 0 0 1px rgba(124,58,237,0.06);
    padding: 8px 0 10px;
    z-index: 300;
    animation: ddIn 0.15s cubic-bezier(0.22,1,0.36,1);
    overflow: hidden;
  }
  @keyframes ddIn { from { opacity:0; transform:translateY(-6px) scale(0.99); } to { opacity:1; transform:none; } }

  .dd-header {
    display: flex;
    align-items: center;
    justify-content: space-between;
    padding: 4px 16px 8px;
    border-bottom: 1px solid rgba(255,255,255,0.05);
    margin-bottom: 4px;
  }

  .dd-label {
    font-size: 11px;
    font-weight: 700;
    letter-spacing: 0.08em;
    text-transform: uppercase;
    color: var(--text-muted);
    opacity: 0.6;
  }

  .dd-clear-all {
    -webkit-appearance: none;
    appearance: none;
    background: none;
    border: none;
    outline: none;
    color: var(--text-muted);
    font-size: 12px;
    font-weight: 500;
    font-family: 'Inter', sans-serif;
    cursor: pointer;
    padding: 2px 6px;
    border-radius: 6px;
    transition: color 0.15s, background 0.15s;
  }
  .dd-clear-all:hover { color: #f87171; background: rgba(248,113,113,0.08); }

  .dd-history {
    padding: 4px 6px 0;
    max-height: 148px; /* ~3 rows (44px each) + breathing room; rest scrolls */
    overflow-y: auto;
  }
  /* NOTE: .dd-row and .dd-ad-row live in the is:global block below — they're injected by
     src/lib/searchDropdown.ts via innerHTML, so Astro's scoped styles would never match
     them (scoping only tags elements present in the template at build time). */

  /* ── Filters + results (unchanged from before) ───────────────────────────── */
  .search-layout {
    display: grid;
    grid-template-columns: 260px 1fr;
    gap: 32px;
    margin-top: 36px;
  }

  .filters {
    background: var(--surface);
    border: 1px solid var(--border);
    border-radius: var(--radius-lg);
    padding: 24px;
    height: fit-content;
    position: sticky;
    top: 80px;
  }

  .filters-title-row {
    display: flex;
    align-items: center;
    justify-content: space-between;
    margin-bottom: 24px;
  }
  .filters-title { font-size: 1rem; margin-bottom: 0; }

  .filters-close-btn, .filters-toggle-btn { display: none; }

  .filters-close-btn {
    align-items: center;
    justify-content: center;
    width: 32px;
    height: 32px;
    border: 0;
    border-radius: 50%;
    background: transparent;
    color: var(--text-muted);
    font-size: 22px;
    line-height: 1;
    cursor: pointer;
  }
  .filters-close-btn:hover { background: rgba(255,255,255,0.08); color: var(--text); }

  .filters-toggle-btn {
    align-items: center;
    gap: 7px;
    padding: 9px 16px;
    border: 1px solid var(--border);
    border-radius: 999px;
    background: var(--surface);
    color: var(--text);
    font-size: 13px;
    font-weight: 600;
    font-family: 'Inter', sans-serif;
    cursor: pointer;
    white-space: nowrap;
    transition: border-color 0.2s, background 0.2s;
  }
  .filters-toggle-btn:hover { border-color: var(--accent); }

  .filters-backdrop {
    display: none;
    position: fixed;
    inset: 0;
    z-index: 499;
    border: 0;
    background: rgba(3, 3, 8, 0.7);
    backdrop-filter: blur(2px);
    opacity: 0;
    pointer-events: none;
    transition: opacity 0.25s ease;
  }
  .filters-backdrop.filters-open { opacity: 1; pointer-events: auto; }

  .results-top-bar {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 12px;
  }

  .filter-group { margin-bottom: 22px; }

  .filter-label {
    display: block;
    font-size: 12px;
    font-weight: 600;
    color: var(--text-muted);
    margin-bottom: 8px;
    text-transform: uppercase;
    letter-spacing: 0.06em;
  }

  .toggle-label {
    display: flex;
    align-items: center;
    justify-content: space-between;
    cursor: pointer;
    margin-bottom: 0;
  }

  .pill-group { display: flex; flex-wrap: wrap; gap: 6px; }

  .pill {
    padding: 6px 12px;
    background: var(--surface-raised);
    border: 1px solid var(--border);
    border-radius: 999px;
    font-size: 12px;
    color: var(--text-muted);
    cursor: pointer;
    font-family: 'Inter', sans-serif;
    transition: all 0.2s;
  }
  .pill.active { background: var(--accent); border-color: var(--accent); color: #fff; }

  .toggle { position: relative; display: inline-block; width: 40px; height: 22px; flex-shrink: 0; }
  .toggle input { opacity: 0; width: 0; height: 0; }
  .toggle-slider { position: absolute; inset: 0; background: var(--surface-raised); border-radius: 999px; cursor: pointer; transition: 0.3s; border: 1px solid var(--border); }
  .toggle-slider::before { content: ''; position: absolute; width: 14px; height: 14px; left: 3px; bottom: 3px; background: var(--text-muted); border-radius: 50%; transition: 0.3s; }
  .toggle input:checked + .toggle-slider { background: var(--accent); border-color: var(--accent); }
  .toggle input:checked + .toggle-slider::before { transform: translateX(18px); background: #fff; }

  .apply-btn {
    width: 100%;
    background: var(--accent);
    color: #fff;
    border: none;
    border-radius: var(--radius);
    padding: 12px;
    font-size: 14px;
    font-weight: 600;
    cursor: pointer;
    font-family: 'Inter', sans-serif;
    transition: background 0.2s;
  }
  .apply-btn:hover { background: var(--accent-light); }

  .results-top-bar { margin-bottom: 20px; }
  .results-meta { color: var(--text-muted); font-size: 14px; }

  .results-grid {
    display: grid;
    grid-template-columns: repeat(4, minmax(0, 1fr));
    gap: 20px;
    align-items: start;
  }

  .loading-msg { grid-column: 1 / -1; text-align: center; color: var(--text-muted); padding: 60px 0; }

  .load-more-wrap { display: flex; justify-content: center; margin-top: 40px; }

  .load-more-btn {
