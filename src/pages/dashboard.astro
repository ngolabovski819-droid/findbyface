---
import Base from '../layouts/Base.astro';
---

<Base
  title="Search Dashboard | FindByFace"
  description="Manage your FindByFace searches, revisit creator and video matches, and access every face-search tool from one private dashboard."
  canonical="https://findbyface.org/dashboard/"
  robots="noindex,follow"
>
  <section class="dashboard-page">
    <div class="dashboard-gate" id="dashGate">
      <div class="gate-glow" aria-hidden="true"></div>
      <div class="gate-card">
        <span class="gate-icon" aria-hidden="true">
          <svg viewBox="0 0 24 24" fill="none"><rect x="4" y="10" width="16" height="11" rx="3"/><path d="M8 10V7a4 4 0 0 1 8 0v3M12 14v3"/></svg>
        </span>
        <span class="gate-kicker">Your private search workspace</span>
        <h1 id="gateTitle">Sign in to open your dashboard</h1>
        <p id="gateMessage">Revisit recent matches, see your search activity, and launch every FindByFace tool from one place.</p>
        <a href="/login/?next=/dashboard/" class="primary-button" id="gateButton">Log in to continue <span>→</span></a>
        <p class="gate-signup">New to FindByFace? <a href="/signup/?next=/dashboard/">Create a free account</a></p>
        <a href="/signup/?next=/dashboard/" class="gate-secondary" id="gateSecondary" hidden>Use a different email address</a>
      </div>
    </div>

    <div class="dashboard-main" id="dashMain" hidden>
      <header class="dashboard-header">
        <div>
          <span class="page-kicker"><i></i> Your FindByFace workspace</span>
          <h1><span id="greeting">Welcome back</span>, <span class="gradient-text" id="dashName">there</span></h1>
          <p>Search, revisit matches, and manage your private activity from one place.</p>
        </div>
        <div class="header-actions">
          <a href="/settings/" class="secondary-button">
            <svg viewBox="0 0 24 24" fill="none"><circle cx="12" cy="12" r="3"/><path d="M19.4 15a1.7 1.7 0 0 0 .34 1.86l.03.03-2.88 2.88-.03-.03A1.7 1.7 0 0 0 15 19.4a1.7 1.7 0 0 0-1 1.55V21h-4v-.05a1.7 1.7 0 0 0-1-1.55 1.7 1.7 0 0 0-1.86.34l-.03.03-2.88-2.88.03-.03A1.7 1.7 0 0 0 4.6 15a1.7 1.7 0 0 0-1.55-1H3v-4h.05A1.7 1.7 0 0 0 4.6 9a1.7 1.7 0 0 0-.34-1.86l-.03-.03 2.88-2.88.03.03A1.7 1.7 0 0 0 9 4.6a1.7 1.7 0 0 0 1-1.55V3h4v.05A1.7 1.7 0 0 0 15 4.6a1.7 1.7 0 0 0 1.86-.34l.03-.03 2.88 2.88-.03.03A1.7 1.7 0 0 0 19.4 9a1.7 1.7 0 0 0 1.55 1H21v4h-.05a1.7 1.7 0 0 0-1.55 1Z"/></svg>
            Settings
          </a>
          <a href="/" class="primary-button">New face search <span>＋</span></a>
        </div>
      </header>

      <section class="overview-grid" aria-label="Account and search overview">
        <article class="account-overview">
          <div class="account-avatar" id="accountAvatar">F</div>
          <div class="account-copy">
            <span class="account-label">Signed-in account</span>
            <strong id="accountEmail">—</strong>
            <div class="account-badges"><span>Free plan</span><span class="active-badge"><i></i> Unlimited searches</span></div>
          </div>
          <a href="/settings/" aria-label="Manage account">→</a>
        </article>

        <article class="metric-card">
          <span class="metric-icon purple"><svg viewBox="0 0 24 24" fill="none"><circle cx="11" cy="11" r="7"/><path d="m16 16 4 4M8 11h6M11 8v6"/></svg></span>
          <div><span>Total searches</span><strong id="totalSearches">0</strong><small id="searchMix">No activity yet</small></div>
        </article>
        <article class="metric-card">
          <span class="metric-icon pink"><svg viewBox="0 0 24 24" fill="none"><path d="M4 5h16v14H4zM8 9h8M8 13h5"/><circle cx="17.5" cy="15.5" r="2.5"/></svg></span>
          <div><span>Matches returned</span><strong id="totalMatches">0</strong><small>Across saved searches</small></div>
        </article>
        <article class="metric-card">
          <span class="metric-icon green"><svg viewBox="0 0 24 24" fill="none"><path d="M4 19V9M10 19V5M16 19v-7M22 19H2"/></svg></span>
          <div><span>Last 7 days</span><strong id="weeklySearches">0</strong><small id="lastActivity">No recent activity</small></div>
        </article>
      </section>

      <section class="quick-start-section">
        <div class="section-heading-row">
          <div><span class="section-kicker">Quick start</span><h2>What would you like to find?</h2></div>
          <span class="section-note">All signed-in searches are unlimited</span>
        </div>
        <div class="tool-grid">
          <a href="/" class="tool-card featured">
            <span class="tool-icon"><svg viewBox="0 0 24 24" fill="none"><path d="M12 16V4m0 0L7.5 8.5M12 4l4.5 4.5M5 14v5h14v-5"/></svg></span>
            <div><span class="tool-status live"><i></i> All indexes</span><h3>Search everywhere</h3><p>Upload once and compare creator and video results.</p></div><b>→</b>
          </a>
          <a href="/onlyfans-finder-by-face/" class="tool-card">
            <span class="tool-icon heart"><svg viewBox="0 0 24 24" fill="none"><path d="M20.8 4.6a5.4 5.4 0 0 0-7.7 0L12 5.7l-1.1-1.1a5.4 5.4 0 0 0-7.7 7.7L12 21l8.8-8.7a5.4 5.4 0 0 0 0-7.7Z"/></svg></span>
            <div><span class="tool-status live"><i></i> Live</span><h3>OnlyFans Finder</h3><p>Find visually similar creator profiles by photo.</p></div><b>→</b>
          </a>
          <a href="/pornstar-finder-by-face/" class="tool-card">
            <span class="tool-icon video"><svg viewBox="0 0 24 24" fill="none"><rect x="3" y="5" width="18" height="14" rx="3"/><path d="m10 9 5 3-5 3Z"/></svg></span>
            <div><span class="tool-status beta">Beta</span><h3>Pornstar Finder</h3><p>Search indexed video appearances by face.</p></div><b>→</b>
          </a>
          <a href="/onlyfans-search/" class="tool-card">
            <span class="tool-icon search"><svg viewBox="0 0 24 24" fill="none"><circle cx="10.5" cy="10.5" r="6.5"/><path d="m15.5 15.5 5 5"/></svg></span>
            <div><span class="tool-status">Directory</span><h3>Search by name</h3><p>Browse creators when you know a name or username.</p></div><b>→</b>
          </a>
        </div>
      </section>

      <div class="workspace-grid">
        <section class="activity-panel">
          <div class="activity-head">
            <div><span class="section-kicker">Your activity</span><h2>Search history <span id="historyTotalBadge">0</span></h2><p>Saved privately in this browser for your account.</p></div>
            <div class="activity-actions">
              <button type="button" id="exportHistoryBtn" class="icon-button" title="Export history">
                <svg viewBox="0 0 24 24" fill="none"><path d="M12 4v11m0 0 4-4m-4 4-4-4M5 18v2h14v-2"/></svg><span>Export</span>
              </button>
              <button type="button" id="clearHistoryBtn" class="icon-button danger-action" title="Clear history">
                <svg viewBox="0 0 24 24" fill="none"><path d="M4 7h16M9 7V4h6v3M7 7l1 13h8l1-13M10 11v5M14 11v5"/></svg><span>Clear</span>
              </button>
            </div>
          </div>

          <div class="activity-toolbar">
            <div class="history-tabs" role="tablist" aria-label="Filter search history">
              <button class="history-tab active" type="button" data-filter="all">All <span id="allTabCount">0</span></button>
              <button class="history-tab" type="button" data-filter="onlyfans">Creators <span id="creatorTabCount">0</span></button>
              <button class="history-tab" type="button" data-filter="pornstar">Videos <span id="videoTabCount">0</span></button>
            </div>
            <label class="history-search">
              <svg viewBox="0 0 24 24" fill="none"><circle cx="10.5" cy="10.5" r="6.5"/><path d="m15.5 15.5 5 5"/></svg>
              <input type="search" id="historySearch" placeholder="Search history" autocomplete="off" />
            </label>
          </div>

          <div class="history-list" id="historyList"></div>
          <div class="history-empty" id="historyEmpty">
            <span><svg viewBox="0 0 24 24" fill="none"><circle cx="11" cy="11" r="7"/><path d="m16 16 4 4M8 11h6"/></svg></span>
            <h3 id="emptyTitle">Your search history starts here</h3>
            <p id="emptyMessage">Run a creator or video face search and your recent matches will appear here.</p>
            <a href="/" class="primary-button">Start your first search <span>→</span></a>
          </div>
        </section>

        <aside class="dashboard-sidebar">
          <section class="side-card usage-card">
            <div class="side-card-head"><span class="side-icon"><svg viewBox="0 0 24 24" fill="none"><path d="M4 19V9M10 19V5M16 19v-7M22 19H2"/></svg></span><div><span>Tool usage</span><strong>Your search mix</strong></div></div>
            <div class="usage-bar"><span id="creatorUsageBar"></span><span id="videoUsageBar"></span></div>
            <div class="usage-legend"><span><i class="creator-dot"></i>Creator searches <b id="creatorUsageValue">0%</b></span><span><i class="video-dot"></i>Video searches <b id="videoUsageValue">0%</b></span></div>
          </section>

          <section class="side-card privacy-card">
            <div class="privacy-status"><i></i><span>Private workspace</span></div>
            <h3>Your query photos are not added to the index</h3>
            <p>History previews stay in this browser. You can export or delete them whenever you want.</p>
            <div class="privacy-links"><a href="/settings/">Manage saved data <span>→</span></a><a href="/privacy-policy/">Read privacy policy <span>→</span></a></div>
          </section>

          <section class="side-card tips-card">
            <span class="section-kicker">Better results</span><h3>Photo checklist</h3>
            <ul><li><span>✓</span>Use one clearly visible adult face</li><li><span>✓</span>Choose a sharp, well-lit image</li><li><span>✓</span>Crop out borders and player controls</li><li><span>✓</span>Treat similarity as a lead, not proof</li></ul>
            <a href="/onlyfans-finder-by-face/#how-it-works">See how face search works →</a>
          </section>
        </aside>
      </div>
    </div>

    <div class="dashboard-toast" id="dashboardToast" role="status" aria-live="polite" hidden>
      <span id="toastMessage">History item removed</span><button type="button" id="undoDeleteBtn">Undo</button>
    </div>
  </section>
</Base>

<script>
  const CREATOR_HISTORY_KEY = 'fbf_history';
  const VIDEO_HISTORY_KEY = 'fbf_pornstar_history';
  let creatorHistory = [];
  let videoHistory = [];
  let activeFilter = 'all';
  let historyQuery = '';
  let lastDeleted = null;
  let toastTimer;
  const expandedEntries = new Set();

  function escapeHtml(value) {
    return String(value ?? '').replace(/[&<>"']/g, character => ({ '&': '&amp;', '<': '&lt;', '>': '&gt;', '"': '&quot;', "'": '&#39;' }[character]));
  }

  function proxyImg(url, width, height) {
    if (!url || String(url).startsWith('/')) return url || '/no-image.png';
    return `https://images.weserv.nl/?url=${encodeURIComponent(String(url).replace(/^https?:\/\//, ''))}&w=${width}&h=${height}&fit=cover&output=webp`;
  }

  function relativeTime(iso) {
    const timestamp = new Date(iso).getTime();
    if (!Number.isFinite(timestamp)) return 'Unknown date';
    const minutes = Math.max(0, Math.floor((Date.now() - timestamp) / 60000));
    if (minutes < 1) return 'Just now';
    if (minutes < 60) return `${minutes} min ago`;
    const hours = Math.floor(minutes / 60);
    if (hours < 24) return `${hours} hour${hours === 1 ? '' : 's'} ago`;
    const days = Math.floor(hours / 24);
    if (days < 7) return `${days} day${days === 1 ? '' : 's'} ago`;
    return new Date(iso).toLocaleDateString(undefined, { month: 'short', day: 'numeric', year: 'numeric' });
  }

  function exactDate(iso) {
    const date = new Date(iso);
    return Number.isFinite(date.getTime())
      ? date.toLocaleString(undefined, { month: 'short', day: 'numeric', year: 'numeric', hour: 'numeric', minute: '2-digit' })
      : 'Unknown date';
  }

  function duration(value) {
    if (!value || value < 0) return '';
    const total = Math.round(value);
    const hours = Math.floor(total / 3600);
    const minutes = Math.floor((total % 3600) / 60);
    const seconds = total % 60;
    return hours ? `${hours}:${String(minutes).padStart(2, '0')}:${String(seconds).padStart(2, '0')}` : `${minutes}:${String(seconds).padStart(2, '0')}`;
  }

  function readArray(key) {
    try {
      const value = JSON.parse(localStorage.getItem(key) || '[]');
      return Array.isArray(value) ? value : [];
    } catch { return []; }
  }

  function saveHistories() {
    localStorage.setItem(CREATOR_HISTORY_KEY, JSON.stringify(creatorHistory));
    localStorage.setItem(VIDEO_HISTORY_KEY, JSON.stringify(videoHistory));
  }

  function combinedHistory() {
    return [
      ...creatorHistory.map((entry, originIndex) => ({ ...entry, source: 'onlyfans', originIndex, key: `onlyfans-${entry.id || entry.date || originIndex}` })),
      ...videoHistory.map((entry, originIndex) => ({ ...entry, source: 'pornstar', originIndex, key: `pornstar-${entry.date || originIndex}` })),
    ].sort((a, b) => new Date(b.date || 0).getTime() - new Date(a.date || 0).getTime());
  }

  function renderCreatorResults(results) {
    if (!results.length) return '<p class="preview-unavailable">This older search does not include a saved preview. Start a new search to generate fresh matches.</p>';
    return `<div class="saved-result-grid creator-result-grid">${results.slice(0, 10).map((result, index) => {
      const image = proxyImg(result.avatar, 220, 293);
      const priceValue = result.subscribePrice ?? result.subscribeprice;
      const price = !priceValue || Number.isNaN(Number(priceValue)) ? 'FREE' : `$${Number(priceValue).toFixed(2)}`;
      const profileUrl = result.profileUrl || `https://onlyfans.com/${encodeURIComponent(result.username || '')}`;
      return `<a class="saved-creator-card" href="${escapeHtml(profileUrl)}" target="_blank" rel="noopener nofollow">
        <span class="saved-media"><img src="${escapeHtml(image)}" alt="" loading="lazy" decoding="async" referrerpolicy="no-referrer" onerror="if(this.src!=='/no-image.png'){this.src='/no-image.png';}"><b>#${index + 1}</b>${result.matchPct ? `<em>${Number(result.matchPct)}% match</em>` : ''}</span>
        <span class="saved-card-body"><strong>${escapeHtml(result.name || result.username || 'Creator')}</strong><small class="${price === 'FREE' ? 'free-price' : ''}">${price}</small></span>
      </a>`;
    }).join('')}</div>`;
  }

  function renderVideoResults(results) {
    if (!results.length) return '<p class="preview-unavailable">This older search does not include a saved preview. Start a new search to generate fresh matches.</p>';
    return `<div class="saved-result-grid video-result-grid">${results.slice(0, 10).map((result, index) => {
      const href = String(result.sourceUrl || '');
      const match = Math.round(Math.max(0, Math.min(1, Number(result.similarity || 0))) * 100);
      const videoDuration = duration(Number(result.durationSeconds || 0));
      const tag = href.startsWith('https://') ? 'a' : 'div';
      const link = href.startsWith('https://') ? ` href="${escapeHtml(href)}" target="_blank" rel="noopener nofollow"` : '';
      return `<${tag} class="saved-video-card"${link}><span class="saved-video-media">${String(result.thumbnailUrl || '').startsWith('http') ? `<img src="${escapeHtml(result.thumbnailUrl)}" alt="" loading="lazy" referrerpolicy="origin">` : ''}<b>#${index + 1}</b>${videoDuration ? `<small>${videoDuration}</small>` : ''}<em>${match}% match</em></span><strong>${escapeHtml(result.title || 'Video match')}</strong></${tag}>`;
    }).join('')}</div>`;
  }

  function historyPreview(entry) {
    const results = Array.isArray(entry.results) ? entry.results : [];
    if (!results.length) return '<span class="preview-placeholder">No preview</span>';
    if (entry.source === 'onlyfans') {
      return `<span class="preview-stack">${results.slice(0, 3).map(result => `<img src="${escapeHtml(proxyImg(result.avatar, 72, 72))}" alt="" loading="lazy" referrerpolicy="no-referrer" onerror="this.src='/no-image.png'">`).join('')}</span>`;
    }
    return `<span class="preview-stack video-preview-stack">${results.slice(0, 3).map(result => String(result.thumbnailUrl || '').startsWith('http') ? `<img src="${escapeHtml(result.thumbnailUrl)}" alt="" loading="lazy" referrerpolicy="origin">` : '<span></span>').join('')}</span>`;
  }

  function renderHistoryEntry(entry) {
    const isCreator = entry.source === 'onlyfans';
    const results = Array.isArray(entry.results) ? entry.results : [];
    const open = expandedEntries.has(entry.key);
    const sourceLabel = isCreator ? 'OnlyFans creators' : 'Pornstar videos';
    const title = isCreator ? (entry.label || 'Creator face search') : 'Pornstar face search';
    const detail = isCreator ? renderCreatorResults(results) : renderVideoResults(results);
    return `<article class="history-entry ${open ? 'open' : ''}" data-key="${escapeHtml(entry.key)}">
      <div class="history-row">
        <button class="history-expand" type="button" data-expand="${escapeHtml(entry.key)}" aria-expanded="${open}">
          <span class="history-source-icon ${isCreator ? 'creator' : 'video'}">${isCreator
            ? '<svg viewBox="0 0 24 24" fill="none"><path d="M20.8 4.6a5.4 5.4 0 0 0-7.7 0L12 5.7l-1.1-1.1a5.4 5.4 0 0 0-7.7 7.7L12 21l8.8-8.7a5.4 5.4 0 0 0 0-7.7Z"/></svg>'
            : '<svg viewBox="0 0 24 24" fill="none"><rect x="3" y="5" width="18" height="14" rx="3"/><path d="m10 9 5 3-5 3Z"/></svg>'}</span>
          <span class="history-main"><span class="history-title-line"><strong>${escapeHtml(title)}</strong><i class="source-chip ${isCreator ? 'creator' : 'video'}">${sourceLabel}</i></span><span class="history-meta"><time title="${escapeHtml(exactDate(entry.date))}">${relativeTime(entry.date)}</time><i></i><span>${Number(entry.count || 0).toLocaleString()} matches</span>${!isCreator && entry.elapsedSeconds ? `<i></i><span>${Number(entry.elapsedSeconds).toFixed(1)}s</span>` : ''}</span></span>
          ${historyPreview(entry)}
          <span class="expand-chevron"><svg viewBox="0 0 24 24" fill="none"><path d="m7 9 5 5 5-5"/></svg></span>
        </button>
        <button class="delete-entry" type="button" data-delete-source="${entry.source}" data-delete-index="${entry.originIndex}" title="Remove this history item" aria-label="Remove this history item"><svg viewBox="0 0 24 24" fill="none"><path d="M4 7h16M9 7V4h6v3M7 7l1 13h8l1-13M10 11v5M14 11v5"/></svg></button>
      </div>
      <div class="history-details" ${open ? '' : 'hidden'}><div class="history-details-head"><span>Saved result preview</span><small>${results.length ? `Showing top ${Math.min(results.length, 10)}` : 'Preview unavailable'}</small></div>${detail}</div>
    </article>`;
  }

  function updateOverview() {
    const entries = combinedHistory();
    const totalMatches = entries.reduce((sum, entry) => sum + Number(entry.count || 0), 0);
    const weekAgo = Date.now() - 7 * 24 * 60 * 60 * 1000;
    const weekly = entries.filter(entry => new Date(entry.date || 0).getTime() >= weekAgo).length;
    document.getElementById('totalSearches').textContent = entries.length.toLocaleString();
    document.getElementById('totalMatches').textContent = totalMatches.toLocaleString();
    document.getElementById('weeklySearches').textContent = weekly.toLocaleString();
    document.getElementById('searchMix').textContent = entries.length ? `${creatorHistory.length} creator · ${videoHistory.length} video` : 'No activity yet';
    document.getElementById('lastActivity').textContent = entries.length ? `Last search ${relativeTime(entries[0].date)}` : 'No recent activity';
    document.getElementById('historyTotalBadge').textContent = entries.length.toLocaleString();
    document.getElementById('allTabCount').textContent = entries.length.toLocaleString();
    document.getElementById('creatorTabCount').textContent = creatorHistory.length.toLocaleString();
    document.getElementById('videoTabCount').textContent = videoHistory.length.toLocaleString();
    const creatorPercent = entries.length ? Math.round((creatorHistory.length / entries.length) * 100) : 0;
    const videoPercent = entries.length ? 100 - creatorPercent : 0;
    document.getElementById('creatorUsageBar').style.width = `${creatorPercent}%`;
    document.getElementById('videoUsageBar').style.width = `${videoPercent}%`;
    document.getElementById('creatorUsageValue').textContent = `${creatorPercent}%`;
    document.getElementById('videoUsageValue').textContent = `${videoPercent}%`;
  }

  function renderHistory() {
    const allEntries = combinedHistory();
    const visibleEntries = allEntries.filter(entry => {
      if (activeFilter !== 'all' && entry.source !== activeFilter) return false;
      if (!historyQuery) return true;
      const searchable = `${entry.label || ''} ${entry.source === 'onlyfans' ? 'creator onlyfans' : 'pornstar video'} ${exactDate(entry.date)}`.toLowerCase();
      return searchable.includes(historyQuery);
    });
    const list = document.getElementById('historyList');
    const empty = document.getElementById('historyEmpty');
    list.innerHTML = visibleEntries.map(renderHistoryEntry).join('');
    list.hidden = visibleEntries.length === 0;
    empty.hidden = visibleEntries.length > 0;
    if (allEntries.length && !visibleEntries.length) {
      document.getElementById('emptyTitle').textContent = 'No matching history';
      document.getElementById('emptyMessage').textContent = 'Try another keyword or switch to a different history filter.';
    } else {
      document.getElementById('emptyTitle').textContent = 'Your search history starts here';
      document.getElementById('emptyMessage').textContent = 'Run a creator or video face search and your recent matches will appear here.';
    }
    updateOverview();
  }

  function showToast(message, allowUndo = false) {
    const toast = document.getElementById('dashboardToast');
    document.getElementById('toastMessage').textContent = message;
    document.getElementById('undoDeleteBtn').hidden = !allowUndo;
    toast.hidden = false;
    window.clearTimeout(toastTimer);
    toastTimer = window.setTimeout(() => { toast.hidden = true; lastDeleted = null; }, 5000);
  }

  function deleteHistoryEntry(source, index) {
    const collection = source === 'onlyfans' ? creatorHistory : videoHistory;
    const removed = collection.splice(Number(index), 1)[0];
    if (!removed) return;
    lastDeleted = { source, index: Number(index), entry: removed };
    saveHistories();
    renderHistory();
    showToast('History item removed', true);
  }

  function initDashboard() {
    let user = null;
    try { user = JSON.parse(localStorage.getItem('fbf_user') || 'null'); } catch { /* noop */ }
    const gate = document.getElementById('dashGate');
    const main = document.getElementById('dashMain');
    if (!user) {
      let pendingEmail = null;
      try { pendingEmail = localStorage.getItem('fbf_pending_email'); } catch { /* noop */ }
      const pendingCookie = document.cookie.split(';').some(value => value.trim() === 'fbf_pending_signup=1');
      const pendingStatus = new URLSearchParams(window.location.search).get('status') === 'pending' || pendingCookie;
      if (pendingEmail || pendingStatus) {
        document.getElementById('gateTitle').textContent = 'Confirm your email address';
        document.getElementById('gateMessage').textContent = pendingEmail
          ? `We sent a verification link to ${pendingEmail}. Open it to activate your account, then return here.`
          : 'Open the verification link we sent to activate your account, then return here.';
        const gateButton = document.getElementById('gateButton');
        gateButton.textContent = "I've verified — continue to login";
        gateButton.href = '/login/?status=pending&next=/dashboard/';
        const secondary = document.getElementById('gateSecondary');
        secondary.hidden = false;
        secondary.addEventListener('click', () => {
          localStorage.removeItem('fbf_pending_email');
          document.cookie = 'fbf_pending_signup=; Path=/; Max-Age=0; SameSite=Lax; Secure';
        });
      }
      gate.hidden = false;
      main.hidden = true;
      return;
    }

    gate.hidden = true;
    main.hidden = false;
    creatorHistory = readArray(CREATOR_HISTORY_KEY);
    videoHistory = readArray(VIDEO_HISTORY_KEY);
    const displayName = String(user.name || user.email || 'there');
    const firstName = displayName.includes('@') ? displayName.split('@')[0] : displayName.split(' ')[0];
    const hour = new Date().getHours();
    document.getElementById('greeting').textContent = hour < 12 ? 'Good morning' : hour < 18 ? 'Good afternoon' : 'Good evening';
    document.getElementById('dashName').textContent = firstName;
    document.getElementById('accountEmail').textContent = user.email || 'Signed-in user';
    const avatar = document.getElementById('accountAvatar');
    if (user.avatar) avatar.innerHTML = `<img src="${escapeHtml(user.avatar)}" alt="" referrerpolicy="no-referrer">`;
    else avatar.textContent = firstName.charAt(0).toUpperCase();
    renderHistory();

    document.querySelectorAll('.history-tab').forEach(button => button.addEventListener('click', () => {
      activeFilter = button.getAttribute('data-filter') || 'all';
      document.querySelectorAll('.history-tab').forEach(tab => tab.classList.toggle('active', tab === button));
      renderHistory();
    }));
    document.getElementById('historySearch').addEventListener('input', event => {
      historyQuery = event.currentTarget.value.trim().toLowerCase();
      renderHistory();
    });
    document.getElementById('historyList').addEventListener('click', event => {
      const target = event.target instanceof Element ? event.target : null;
      const deleteButton = target?.closest('[data-delete-source]');
      if (deleteButton) {
        deleteHistoryEntry(deleteButton.getAttribute('data-delete-source'), deleteButton.getAttribute('data-delete-index'));
        return;
      }
      const expandButton = target?.closest('[data-expand]');
      if (!expandButton) return;
      const key = expandButton.getAttribute('data-expand');
      if (expandedEntries.has(key)) expandedEntries.delete(key); else expandedEntries.add(key);
      renderHistory();
      requestAnimationFrame(() => document.querySelector(`[data-key="${CSS.escape(key)}"]`)?.scrollIntoView({ behavior: 'smooth', block: 'nearest' }));
    });
    document.getElementById('exportHistoryBtn').addEventListener('click', () => {
      const payload = { exportedAt: new Date().toISOString(), creatorSearches: creatorHistory, videoSearches: videoHistory };
      const blob = new Blob([JSON.stringify(payload, null, 2)], { type: 'application/json' });
      const url = URL.createObjectURL(blob);
      const link = document.createElement('a');
      link.href = url;
      link.download = `findbyface-history-${new Date().toISOString().slice(0, 10)}.json`;
      link.click();
      URL.revokeObjectURL(url);
      showToast('History export downloaded');
    });
    document.getElementById('clearHistoryBtn').addEventListener('click', () => {
      if (!creatorHistory.length && !videoHistory.length) { showToast('Your history is already empty'); return; }
      if (!window.confirm('Clear all saved creator and video search history from this browser?')) return;
      creatorHistory = [];
      videoHistory = [];
      saveHistories();
      expandedEntries.clear();
      renderHistory();
      showToast('All search history cleared');
    });
    document.getElementById('undoDeleteBtn').addEventListener('click', () => {
      if (!lastDeleted) return;
      const collection = lastDeleted.source === 'onlyfans' ? creatorHistory : videoHistory;
      collection.splice(lastDeleted.index, 0, lastDeleted.entry);
      saveHistories();
      lastDeleted = null;
      renderHistory();
      document.getElementById('dashboardToast').hidden = true;
    });
  }

  initDashboard();
</script>

