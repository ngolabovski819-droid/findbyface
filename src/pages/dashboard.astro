---
import Base from '../layouts/Base.astro';
---

<Base
  title="Dashboard — findbyface"
  description="Your findbyface dashboard: image search usage, recent searches, and account details."
  canonical="https://findbyface.org/dashboard/"
>
  <section class="dash">
    <!-- Signed-out gate (shown until JS confirms auth) -->
    <div class="dash-gate" id="dashGate">
      <div class="gate-card">
        <h1 id="gateTitle">Sign in to view your dashboard</h1>
        <p id="gateMessage">Track your searches, manage your account, and unlock more — all in one place.</p>
        <a href="/login/?next=/dashboard/" class="gate-btn" id="gateButton">Log in or create account</a>
        <a href="/signup/" class="gate-secondary" id="gateSecondary" hidden>Use a different email</a>
      </div>
    </div>

    <!-- Dashboard (revealed when signed in) -->
    <div class="dash-main" id="dashMain" style="display:none">
      <header class="dash-head">
        <div>
          <h1>Welcome back, <span class="gradient-text" id="dashName">there</span>!</h1>
          <p class="dash-account">Account type: <span class="plan-badge">FREE</span></p>
        </div>
        <a href="/" class="dash-cta">＋ New photo search</a>
      </header>

      <!-- Stat cards -->
      <div class="dash-cards">
        <div class="dash-card">
          <div class="card-top">
            <span class="card-ico">
              <svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><rect x="3" y="3" width="18" height="18" rx="2"></rect><circle cx="8.5" cy="8.5" r="1.5"></circle><path d="M21 15l-5-5L5 21"></path></svg>
            </span>
            <div>
              <p class="card-label">IMAGE SEARCH</p>
              <p class="card-value">Unlimited</p>
            </div>
          </div>
          <div class="card-bar"><span style="width:100%"></span></div>
          <p class="card-sub">Free, unlimited face searches — no credits needed</p>
        </div>

        <div class="dash-card pro-card">
          <div class="card-top">
            <span class="card-ico pro-ico">
              <svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><polygon points="12 2 15.09 8.26 22 9.27 17 14.14 18.18 21.02 12 17.77 5.82 21.02 7 14.14 2 9.27 8.91 8.26 12 2"></polygon></svg>
            </span>
            <div>
              <p class="card-label">FINDBYFACE PRO</p>
              <p class="card-value">Coming soon</p>
            </div>
          </div>
          <p class="card-sub">Higher-accuracy AI matching, no ads, full search history with export &amp; more.</p>
          <button class="pro-btn" id="proNotifyBtn">Notify me</button>
        </div>
      </div>

      <!-- Latest searches -->
      <div class="dash-panel">
        <div class="panel-head">
          <h2>Latest Searches</h2>
          <span class="panel-count" id="searchCount">0</span>
        </div>
        <div class="search-list" id="searchList"></div>
        <div class="search-empty" id="searchEmpty">
          <svg width="40" height="40" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round"><circle cx="11" cy="11" r="8"></circle><path d="M21 21l-4.35-4.35"></path></svg>
          <p>No searches yet</p>
          <span>Upload a photo on the homepage to find lookalikes.</span>
          <a href="/" class="empty-btn">Start a search</a>
        </div>
      </div>

      <div class="dash-panel pornstar-history-panel">
        <div class="panel-head">
          <h2>Pornstar Finder History</h2>
          <span class="panel-count" id="pornstarSearchCount">0</span>
          <a class="panel-action" href="/pornstar-finder-by-face/">New search</a>
        </div>
        <div class="pornstar-history-list" id="pornstarSearchList"></div>
        <div class="search-empty" id="pornstarSearchEmpty">
          <svg width="40" height="40" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round"><rect x="3" y="5" width="18" height="14" rx="2"></rect><path d="m10 9 5 3-5 3z"></path></svg>
          <p>No Pornstar Finder searches yet</p>
          <span>Your recent video-face matches will appear here.</span>
          <a href="/pornstar-finder-by-face/" class="empty-btn">Find a pornstar</a>
        </div>
      </div>
    </div>
  </section>
</Base>

<script>
  function relTime(iso) {
    const then = new Date(iso).getTime();
    const diff = Date.now() - then;
    const m = Math.floor(diff / 60000);
    if (m < 1) return 'just now';
    if (m < 60) return `${m} min ago`;
    const h = Math.floor(m / 60);
    if (h < 24) return `${h} hour${h > 1 ? 's' : ''} ago`;
    const d = Math.floor(h / 24);
    if (d < 30) return `${d} day${d > 1 ? 's' : ''} ago`;
    return new Date(iso).toLocaleDateString(undefined, { month: 'short', day: 'numeric', year: 'numeric' });
  }

  function escapeHtml(s) {
    return String(s).replace(/[&<>"']/g, c => ({ '&': '&amp;', '<': '&lt;', '>': '&gt;', '"': '&quot;', "'": '&#39;' }[c]));
  }

  function proxyImg(url, w, h) {
    if (!url || String(url).startsWith('/')) return url;
    return `https://images.weserv.nl/?url=${encodeURIComponent(String(url).replace(/^https?:\/\//, ''))}&w=${w}&h=${h}&fit=cover&output=webp`;
  }

  function videoDuration(value) {
    if (!value || value < 0) return '';
    const total = Math.round(value);
    const hours = Math.floor(total / 3600);
    const minutes = Math.floor((total % 3600) / 60);
    const seconds = total % 60;
    return hours > 0
      ? `${hours}:${String(minutes).padStart(2, '0')}:${String(seconds).padStart(2, '0')}`
      : `${minutes}:${String(seconds).padStart(2, '0')}`;
  }

  function renderPornstarHistory() {
    let history = [];
    try {
      const stored = JSON.parse(localStorage.getItem('fbf_pornstar_history') || '[]');
      history = Array.isArray(stored) ? stored : [];
    } catch { /* noop */ }

    const list = document.getElementById('pornstarSearchList');
    const empty = document.getElementById('pornstarSearchEmpty');
    const count = document.getElementById('pornstarSearchCount');
    count.textContent = String(history.length);

    if (!history.length) {
      list.style.display = 'none';
      empty.style.display = 'flex';
      return;
    }

    empty.style.display = 'none';
    list.style.display = 'flex';
    list.innerHTML = history.map((entry, index) => {
      const results = (Array.isArray(entry.results) ? entry.results : []).slice(0, 10);
      const cards = results.map((result, rank) => {
        const href = String(result.sourceUrl || '');
        const clickable = href.startsWith('https://');
        const tag = clickable ? 'a' : 'div';
        const linkAttrs = clickable ? ` href="${escapeHtml(href)}" target="_blank" rel="noopener nofollow"` : '';
        const thumbnail = String(result.thumbnailUrl || '');
        const similarity = Number(result.similarity || 0);
        const match = Math.round(Math.max(0, Math.min(1, similarity)) * 100);
        const duration = videoDuration(Number(result.durationSeconds || 0));
        return `<${tag} class="porn-result-card"${linkAttrs}>
          <span class="porn-result-media">
            ${thumbnail.startsWith('http') ? `<img src="${escapeHtml(thumbnail)}" alt="" loading="lazy" referrerpolicy="origin">` : ''}
            <span class="porn-result-rank">#${rank + 1}</span>
            ${duration ? `<span class="porn-result-duration">${duration}</span>` : ''}
            <span class="porn-result-match">${match}% match</span>
          </span>
          <span class="porn-result-title">${escapeHtml(result.title || 'Video match')}</span>
        </${tag}>`;
      }).join('');
      const hasResults = results.length > 0;
      const panel = hasResults
        ? `<div class="porn-history-results" id="phr-${index}" hidden><div class="mini-grid-head">Top ${results.length} video matches</div><div class="porn-result-grid">${cards}</div></div>`
        : '';
      return `<div class="search-entry porn-history-entry">
        <button class="search-row${hasResults ? '' : ' no-preview'}" type="button" data-porn-idx="${index}" data-has="${hasResults ? '1' : '0'}" aria-expanded="false">
          <span class="search-ico porn-search-ico">
            <svg width="17" height="17" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><rect x="3" y="5" width="18" height="14" rx="2"></rect><path d="m10 9 5 3-5 3z"></path></svg>
          </span>
          <span class="search-meta">
            <span class="search-label">Pornstar face search</span>
            <span class="search-date">${relTime(entry.date)} · ${Number(entry.count || 0)} matches · ${Number(entry.indexedVideos || 0)} indexed</span>
          </span>
          ${hasResults ? `<span class="search-chev"><svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round"><polyline points="6 9 12 15 18 9"></polyline></svg></span>` : `<span class="search-rerun">Search again ›</span>`}
        </button>
        ${panel}
      </div>`;
    }).join('');

    list.querySelectorAll('[data-porn-idx]').forEach(row => {
      row.addEventListener('click', () => {
        if (row.getAttribute('data-has') !== '1') {
          window.location.href = '/pornstar-finder-by-face/';
          return;
        }
        const panel = document.getElementById(`phr-${row.getAttribute('data-porn-idx')}`);
        const open = row.getAttribute('aria-expanded') === 'true';
        row.setAttribute('aria-expanded', String(!open));
        if (panel) panel.hidden = open;
      });
    });
  }

  function init() {
    let user = null;
    try { user = JSON.parse(localStorage.getItem('fbf_user') || 'null'); } catch { /* noop */ }

    const gate = document.getElementById('dashGate');
    const main = document.getElementById('dashMain');

    if (!user) {
      const pendingEmail = localStorage.getItem('fbf_pending_email');
      const pendingStatus = new URLSearchParams(window.location.search).get('status') === 'pending';
      if (pendingEmail || pendingStatus) {
        const gateTitle = document.getElementById('gateTitle');
        const gateMessage = document.getElementById('gateMessage');
        const gateButton = document.getElementById('gateButton');
        const gateSecondary = document.getElementById('gateSecondary');
        gateTitle.textContent = 'Confirm your email address';
        gateMessage.textContent = pendingEmail
          ? `We sent a verification link to ${pendingEmail}. Open it to activate your account. If you don't see it, check your spam or junk folder.`
          : `Open the verification link we sent to activate your account. If you don't see it, check your spam or junk folder.`;
        gateButton.textContent = `I've verified — continue to login`;
        gateButton.href = '/login/?status=pending&next=/dashboard/';
        gateSecondary.hidden = false;
        gateSecondary.addEventListener('click', () => localStorage.removeItem('fbf_pending_email'));
      }
      gate.style.display = 'flex';
      main.style.display = 'none';
      return;
    }

    gate.style.display = 'none';
    main.style.display = 'block';

    const firstName = (user.name || user.email || 'there').split(' ')[0];
    document.getElementById('dashName').textContent = firstName;
    renderPornstarHistory();

    // History
    let history = [];
    try { history = JSON.parse(localStorage.getItem('fbf_history') || '[]'); } catch { /* noop */ }

    const list = document.getElementById('searchList');
    const empty = document.getElementById('searchEmpty');
    const countEl = document.getElementById('searchCount');
    countEl.textContent = String(history.length);

    if (!history.length) {
      empty.style.display = 'flex';
      list.style.display = 'none';
    } else {
      empty.style.display = 'none';
      list.style.display = 'flex';
      list.innerHTML = history.map((h, i) => {
        const results = (Array.isArray(h.results) ? h.results : []).slice(0, 10);
        const cards = results.map((r, ci) => {
          const img = r.avatar && String(r.avatar).startsWith('http')
            ? proxyImg(r.avatar, 180, 240) : '/no-image.png';
          const price = (!r.subscribePrice || isNaN(Number(r.subscribePrice)))
            ? 'FREE' : `$${parseFloat(String(r.subscribePrice)).toFixed(2)}`;
          const matchTag = r.matchPct ? `<span class="mini-match">${r.matchPct}% match</span>` : '';
          const profileUrl = r.profileUrl || `https://onlyfans.com/${encodeURIComponent(r.username)}`;
          const isSponsored = profileUrl.startsWith('/go/');
          const rel = isSponsored ? 'noopener nofollow sponsored' : 'noopener nofollow';
          const adTag = r.sponsored ? '<span class="mini-ad">Ad</span>' : '';
          return `<a class="mini-card" href="${profileUrl}" target="_blank" rel="${rel}">
            <span class="mini-rank">${ci + 1}</span>
            <span class="mini-img"><img src="${img}" alt="" loading="lazy" decoding="async" referrerpolicy="no-referrer" onerror="if(this.src!=='/no-image.png'){this.src='/no-image.png';}">${matchTag}${adTag}</span>
            <span class="mini-body">
              <span class="mini-name">${escapeHtml(r.name || r.username)}</span>
              <span class="mini-price ${price === 'FREE' ? 'free' : ''}">${price}</span>
            </span>
          </a>`;
        }).join('');

        const panel = results.length
          ? `<div class="search-results" id="sr-${i}" hidden><div class="mini-grid-head">Top ${results.length} matches</div><div class="mini-grid">${cards}</div></div>`
          : '';

        const hasResults = results.length > 0;
        return `<div class="search-entry">
          <button class="search-row${hasResults ? '' : ' no-preview'}" type="button" data-idx="${i}" data-has="${hasResults ? '1' : '0'}" aria-expanded="false">
            <span class="search-ico">
              <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><rect x="3" y="3" width="18" height="18" rx="2"></rect><circle cx="8.5" cy="8.5" r="1.5"></circle><path d="M21 15l-5-5L5 21"></path></svg>
            </span>
            <span class="search-meta">
              <span class="search-label">${escapeHtml(h.label || 'Photo search')}</span>
              <span class="search-date">${relTime(h.date)} · ${Number(h.count || 0)} matches${hasResults ? '' : ' · preview unavailable'}</span>
            </span>
            ${hasResults
              ? `<span class="search-chev"><svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round"><polyline points="6 9 12 15 18 9"></polyline></svg></span>`
              : `<span class="search-rerun">Search again ›</span>`}
          </button>
          ${panel}
        </div>`;
      }).join('');

      // Toggle expand/collapse
      list.querySelectorAll('.search-row').forEach(row => {
        row.addEventListener('click', () => {
          // Legacy entries without cached results → go run a fresh search
          if (row.getAttribute('data-has') !== '1') {
            window.location.href = '/';
            return;
          }
          const idx = row.getAttribute('data-idx');
          const panel = document.getElementById('sr-' + idx);
          const open = row.getAttribute('aria-expanded') === 'true';
          row.setAttribute('aria-expanded', String(!open));
          if (panel) panel.hidden = open;
        });
      });
    }

    const notify = document.getElementById('proNotifyBtn');
    notify?.addEventListener('click', () => {
      notify.textContent = "You're on the list ✓";
      notify.disabled = true;
    });
  }

  init();
</script>

<style>
  .dash {
    max-width: 980px;
    margin: 0 auto;
    padding: 100px 20px 80px;
    min-height: 70vh;
  }

  /* Gate */
  .dash-gate { display: flex; justify-content: center; padding: 40px 0; }
  .gate-card {
    text-align: center; max-width: 440px;
    background: var(--surface); border: 1px solid var(--border);
    border-radius: var(--radius-lg); padding: 40px 32px;
  }
  .gate-card h1 { font-size: 1.5rem; margin-bottom: 12px; }
  .gate-card p { color: var(--text-muted); margin-bottom: 24px; }
  .gate-btn {
    display: inline-block; background: linear-gradient(135deg, var(--accent), var(--accent-light));
    color: #fff; padding: 11px 26px; border-radius: 999px; font-weight: 700;
    box-shadow: 0 6px 20px rgba(124,58,237,0.3);
  }

  /* Header */
  .dash-head {
    display: flex; align-items: flex-start; justify-content: space-between;
    gap: 18px; flex-wrap: wrap; margin-bottom: 28px;
  }
  .dash-head h1 { font-size: clamp(1.5rem, 3.5vw, 2.1rem); margin-bottom: 8px; }
  .gradient-text {
    background: linear-gradient(135deg, var(--accent), var(--accent-pink));
    -webkit-background-clip: text; -webkit-text-fill-color: transparent; background-clip: text;
  }
  .dash-account { color: var(--text-muted); font-size: 14px; display: flex; align-items: center; gap: 8px; }
  .plan-badge {
    background: rgba(124,58,237,0.15); color: var(--accent-light);
    border: 1px solid var(--border);
    font-size: 12px; font-weight: 800; letter-spacing: 0.05em;
    padding: 3px 10px; border-radius: 6px;
  }
  .dash-cta {
    background: linear-gradient(135deg, var(--accent), var(--accent-light));
    color: #fff; padding: 10px 20px; border-radius: 999px;
    font-size: 14px; font-weight: 700; white-space: nowrap;
    box-shadow: 0 6px 20px rgba(124,58,237,0.28);
    transition: transform 0.2s, box-shadow 0.2s;
  }
  .dash-cta:hover { transform: translateY(-1px); box-shadow: 0 8px 26px rgba(124,58,237,0.42); }

  /* Cards */
  .dash-cards {
    display: grid; grid-template-columns: repeat(2, 1fr);
    gap: 16px; margin-bottom: 28px;
  }
  .dash-card {
    background: var(--surface); border: 1px solid var(--border);
    border-radius: var(--radius-lg); padding: 20px;
  }
  .card-top { display: flex; align-items: center; gap: 14px; margin-bottom: 14px; }
  .card-ico {
    width: 44px; height: 44px; border-radius: 12px; flex-shrink: 0;
    display: flex; align-items: center; justify-content: center;
    background: rgba(124,58,237,0.14); color: var(--accent-light);
  }
  .pro-ico { background: rgba(236,72,153,0.14); color: var(--accent-pink); }
  .card-label { font-size: 11px; font-weight: 700; letter-spacing: 0.06em; color: var(--text-muted); margin-bottom: 2px; }
  .card-value { font-family: 'Syne', sans-serif; font-size: 1.4rem; font-weight: 800; }
  .card-bar { height: 5px; border-radius: 99px; background: var(--surface-raised); overflow: hidden; margin-bottom: 10px; }
  .card-bar span { display: block; height: 100%; background: linear-gradient(90deg, var(--accent), var(--accent-pink)); }
  .card-sub { color: var(--text-muted); font-size: 13px; }
  .pro-card { background: linear-gradient(135deg, rgba(124,58,237,0.08), rgba(236,72,153,0.06)); }
  .pro-btn {
    margin-top: 14px; width: 100%;
    background: linear-gradient(135deg, var(--accent), var(--accent-pink));
    color: #fff; border: none; border-radius: 10px; padding: 10px;
    font-size: 13px; font-weight: 700; cursor: pointer; font-family: inherit;
    transition: filter 0.2s;
  }
  .pro-btn:hover { filter: brightness(1.08); }
  .pro-btn:disabled { opacity: 0.7; cursor: default; }

  /* Panel */
  .dash-panel {
    background: var(--surface); border: 1px solid var(--border);
    border-radius: var(--radius-lg); padding: 20px 22px;
  }
  .panel-head { display: flex; align-items: center; gap: 10px; margin-bottom: 16px; }
  .panel-head h2 { font-size: 1.1rem; }
  .pornstar-history-panel { margin-top: 20px; }
  .panel-action {
    margin-left: auto;
    color: var(--accent-light);
    font-size: 12px;
    font-weight: 700;
  }
  .gate-secondary { display: block; margin-top: 14px; color: var(--text-muted); font-size: 12px; font-weight: 700; }
  .gate-secondary:hover { color: var(--accent-light); }
  .gate-secondary[hidden] { display: none; }
  .panel-count {
    background: rgba(124,58,237,0.15); color: var(--accent-light);
    font-size: 12px; font-weight: 700; padding: 2px 9px; border-radius: 999px;
  }

  .search-empty {
    display: flex; flex-direction: column; align-items: center; text-align: center;
    padding: 36px 20px; color: var(--text-muted); gap: 4px;
  }
  .search-empty svg { color: var(--accent); opacity: 0.6; margin-bottom: 8px; }
  .search-empty p { font-size: 15px; font-weight: 700; color: var(--text); }
  .search-empty span { font-size: 13px; }
  .empty-btn {
    margin-top: 14px;
    background: linear-gradient(135deg, var(--accent), var(--accent-light));
    color: #fff; padding: 9px 22px; border-radius: 999px; font-weight: 700; font-size: 13px;
  }

  @media (max-width: 640px) {
    .dash-cards { grid-template-columns: 1fr; }
    .dash-cta { width: 100%; text-align: center; }
  }
</style>

<!-- Global styles: the Latest Searches list is injected via innerHTML, so its
     styles must be global (scoped styles don't reach innerHTML-injected nodes). -->
<style is:global>
  .dash .search-list { display: flex; flex-direction: column; gap: 8px; }
  .dash .pornstar-history-list { display: flex; flex-direction: column; gap: 8px; }
  .dash .search-entry {
    border-radius: 14px; overflow: hidden;
    background: var(--surface);
    border: 1px solid var(--border);
    transition: border-color 0.2s, box-shadow 0.2s;
  }
  .dash .search-entry:has(.search-row[aria-expanded="true"]) {
    border-color: rgba(124,58,237,0.45);
    box-shadow: 0 10px 34px rgba(124,58,237,0.16);
  }
  .dash .search-row {
    display: flex; align-items: center; gap: 13px; width: 100%;
    padding: 13px 15px; border-radius: 14px;
    background: none; border: none; cursor: pointer; font-family: inherit; text-align: left;
    transition: background 0.15s;
  }
  .dash .search-row:hover { background: var(--surface-raised); }
  .dash .search-row.no-preview { cursor: pointer; }
  .dash .search-ico {
    width: 38px; height: 38px; border-radius: 11px; flex-shrink: 0;
    display: flex; align-items: center; justify-content: center;
    background: linear-gradient(135deg, rgba(124,58,237,0.22), rgba(236,72,153,0.18));
    color: var(--accent-light);
  }
  .dash .search-meta { display: flex; flex-direction: column; min-width: 0; flex: 1; gap: 2px; }
  .dash .search-label { font-size: 14.5px; font-weight: 700; color: var(--text); white-space: nowrap; overflow: hidden; text-overflow: ellipsis; }
  .dash .search-date { font-size: 12px; color: var(--text-muted); }
  .dash .search-chev {
    width: 30px; height: 30px; border-radius: 50%; flex-shrink: 0;
    display: flex; align-items: center; justify-content: center;
    color: var(--text-muted); background: rgba(255,255,255,0.04);
    transition: transform 0.25s, color 0.2s, background 0.2s;
  }
  .dash .search-row:hover .search-chev { color: var(--accent-light); background: rgba(124,58,237,0.15); }
  .dash .search-row[aria-expanded="true"] .search-chev { transform: rotate(180deg); color: #fff; background: linear-gradient(135deg, var(--accent), var(--accent-pink)); }
  .dash .search-rerun { color: var(--accent-light); font-size: 12.5px; font-weight: 700; flex-shrink: 0; white-space: nowrap; }

