---
import Base from '../layouts/Base.astro';
---

<Base
  title="Dashboard — findbyface"
  description="Your findbyface dashboard: image search usage, recent searches, and account details."
  canonical="https://findbyface.org/dashboard/"
>
  <section class="dash">
    <!-- Signed-out gate (shown until JS confirms auth) -->
    <div class="dash-gate" id="dashGate">
      <div class="gate-card">
        <h1>Sign in to view your dashboard</h1>
        <p>Track your searches, manage your account, and unlock more — all in one place.</p>
        <a href="/" class="gate-btn">Go to homepage</a>
      </div>
    </div>

    <!-- Dashboard (revealed when signed in) -->
    <div class="dash-main" id="dashMain" style="display:none">
      <header class="dash-head">
        <div>
          <h1>Welcome back, <span class="gradient-text" id="dashName">there</span>!</h1>
          <p class="dash-account">Account type: <span class="plan-badge">FREE</span></p>
        </div>
        <a href="/" class="dash-cta">＋ New photo search</a>
      </header>

      <!-- Stat cards -->
      <div class="dash-cards">
        <div class="dash-card">
          <div class="card-top">
            <span class="card-ico">
              <svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><rect x="3" y="3" width="18" height="18" rx="2"></rect><circle cx="8.5" cy="8.5" r="1.5"></circle><path d="M21 15l-5-5L5 21"></path></svg>
            </span>
            <div>
              <p class="card-label">IMAGE SEARCH</p>
              <p class="card-value">Unlimited</p>
            </div>
          </div>
          <div class="card-bar"><span style="width:100%"></span></div>
          <p class="card-sub">Free, unlimited face searches — no credits needed</p>
        </div>

        <div class="dash-card pro-card">
          <div class="card-top">
            <span class="card-ico pro-ico">
              <svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><polygon points="12 2 15.09 8.26 22 9.27 17 14.14 18.18 21.02 12 17.77 5.82 21.02 7 14.14 2 9.27 8.91 8.26 12 2"></polygon></svg>
            </span>
            <div>
              <p class="card-label">FINDBYFACE PRO</p>
              <p class="card-value">Coming soon</p>
            </div>
          </div>
          <p class="card-sub">Higher-accuracy AI matching, no ads, full search history with export &amp; more.</p>
          <button class="pro-btn" id="proNotifyBtn">Notify me</button>
        </div>
      </div>

      <!-- Latest searches -->
      <div class="dash-panel">
        <div class="panel-head">
          <h2>Latest Searches</h2>
          <span class="panel-count" id="searchCount">0</span>
        </div>
        <div class="search-list" id="searchList"></div>
        <div class="search-empty" id="searchEmpty">
          <svg width="40" height="40" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round"><circle cx="11" cy="11" r="8"></circle><path d="M21 21l-4.35-4.35"></path></svg>
          <p>No searches yet</p>
          <span>Upload a photo on the homepage to find lookalikes.</span>
          <a href="/" class="empty-btn">Start a search</a>
        </div>
      </div>
    </div>
  </section>
</Base>

<script>
  function relTime(iso) {
    const then = new Date(iso).getTime();
    const diff = Date.now() - then;
    const m = Math.floor(diff / 60000);
    if (m < 1) return 'just now';
    if (m < 60) return `${m} min ago`;
    const h = Math.floor(m / 60);
    if (h < 24) return `${h} hour${h > 1 ? 's' : ''} ago`;
    const d = Math.floor(h / 24);
    if (d < 30) return `${d} day${d > 1 ? 's' : ''} ago`;
    return new Date(iso).toLocaleDateString(undefined, { month: 'short', day: 'numeric', year: 'numeric' });
  }

  function escapeHtml(s) {
    return String(s).replace(/[&<>"']/g, c => ({ '&': '&amp;', '<': '&lt;', '>': '&gt;', '"': '&quot;', "'": '&#39;' }[c]));
  }

  function proxyImg(url, w, h) {
    if (!url || String(url).startsWith('/')) return url;
    return `https://images.weserv.nl/?url=${encodeURIComponent(String(url).replace(/^https?:\/\//, ''))}&w=${w}&h=${h}&fit=cover&output=webp`;
  }

  function init() {
    let user = null;
    try { user = JSON.parse(localStorage.getItem('fbf_user') || 'null'); } catch { /* noop */ }

    const gate = document.getElementById('dashGate');
    const main = document.getElementById('dashMain');

    if (!user) {
      gate.style.display = 'flex';
      main.style.display = 'none';
      return;
    }

    gate.style.display = 'none';
    main.style.display = 'block';

    const firstName = (user.name || user.email || 'there').split(' ')[0];
    document.getElementById('dashName').textContent = firstName;

    // History
    let history = [];
    try { history = JSON.parse(localStorage.getItem('fbf_history') || '[]'); } catch { /* noop */ }

    const list = document.getElementById('searchList');
    const empty = document.getElementById('searchEmpty');
    const countEl = document.getElementById('searchCount');
    countEl.textContent = String(history.length);

    if (!history.length) {
      empty.style.display = 'flex';
      list.style.display = 'none';
    } else {
      empty.style.display = 'none';
      list.style.display = 'flex';
      list.innerHTML = history.map((h, i) => {
        const results = Array.isArray(h.results) ? h.results : [];
        const cards = results.map(r => {
          const img = r.avatar && String(r.avatar).startsWith('http')
            ? proxyImg(r.avatar, 120, 160) : '/no-image.png';
          const price = (!r.subscribePrice || isNaN(Number(r.subscribePrice)))
            ? 'FREE' : `$${parseFloat(String(r.subscribePrice)).toFixed(2)}`;
          const matchTag = r.matchPct ? `<span class="mini-match">${r.matchPct}%</span>` : '';
          return `<a class="mini-card" href="https://onlyfans.com/${encodeURIComponent(r.username)}" target="_blank" rel="noopener noreferrer">
            <span class="mini-img"><img src="${img}" alt="" loading="lazy" decoding="async" referrerpolicy="no-referrer" onerror="if(this.src!=='/no-image.png'){this.src='/no-image.png';}">${matchTag}</span>
            <span class="mini-name">${escapeHtml(r.name || r.username)}</span>
            <span class="mini-price ${price === 'FREE' ? 'free' : ''}">${price}</span>
          </a>`;
        }).join('');

        const panel = results.length
          ? `<div class="search-results" id="sr-${i}" hidden><div class="mini-grid">${cards}</div></div>`
          : '';

        return `<div class="search-entry">
          <button class="search-row" type="button" data-idx="${i}" aria-expanded="false">
            <span class="search-ico">
              <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><rect x="3" y="3" width="18" height="18" rx="2"></rect><circle cx="8.5" cy="8.5" r="1.5"></circle><path d="M21 15l-5-5L5 21"></path></svg>
            </span>
            <span class="search-meta">
              <span class="search-label">${escapeHtml(h.label || 'Photo search')}</span>
              <span class="search-date">${relTime(h.date)} · ${Number(h.count || 0)} matches</span>
            </span>
            <span class="search-chev">
              <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round"><polyline points="6 9 12 15 18 9"></polyline></svg>
            </span>
          </button>
          ${panel}
        </div>`;
      }).join('');

      // Toggle expand/collapse
      list.querySelectorAll('.search-row').forEach(row => {
        row.addEventListener('click', () => {
          const idx = row.getAttribute('data-idx');
          const panel = document.getElementById('sr-' + idx);
          const open = row.getAttribute('aria-expanded') === 'true';
          row.setAttribute('aria-expanded', String(!open));
          if (panel) panel.hidden = open;
        });
      });
    }

    const notify = document.getElementById('proNotifyBtn');
    notify?.addEventListener('click', () => {
      notify.textContent = "You're on the list ✓";
      notify.disabled = true;
    });
  }

  init();
</script>

<style>
  .dash {
    max-width: 980px;
    margin: 0 auto;
    padding: 100px 20px 80px;
    min-height: 70vh;
  }

  /* Gate */
  .dash-gate { display: flex; justify-content: center; padding: 40px 0; }
  .gate-card {
    text-align: center; max-width: 440px;
    background: var(--surface); border: 1px solid var(--border);
    border-radius: var(--radius-lg); padding: 40px 32px;
  }
  .gate-card h1 { font-size: 1.5rem; margin-bottom: 12px; }
  .gate-card p { color: var(--text-muted); margin-bottom: 24px; }
  .gate-btn {
    display: inline-block; background: linear-gradient(135deg, var(--accent), var(--accent-light));
    color: #fff; padding: 11px 26px; border-radius: 999px; font-weight: 700;
    box-shadow: 0 6px 20px rgba(124,58,237,0.3);
  }

  /* Header */
  .dash-head {
    display: flex; align-items: flex-start; justify-content: space-between;
    gap: 18px; flex-wrap: wrap; margin-bottom: 28px;
  }
  .dash-head h1 { font-size: clamp(1.5rem, 3.5vw, 2.1rem); margin-bottom: 8px; }
  .gradient-text {
    background: linear-gradient(135deg, var(--accent), var(--accent-pink));
    -webkit-background-clip: text; -webkit-text-fill-color: transparent; background-clip: text;
  }
  .dash-account { color: var(--text-muted); font-size: 14px; display: flex; align-items: center; gap: 8px; }
  .plan-badge {
    background: rgba(124,58,237,0.15); color: var(--accent-light);
    border: 1px solid var(--border);
    font-size: 12px; font-weight: 800; letter-spacing: 0.05em;
    padding: 3px 10px; border-radius: 6px;
  }
  .dash-cta {
    background: linear-gradient(135deg, var(--accent), var(--accent-light));
    color: #fff; padding: 10px 20px; border-radius: 999px;
    font-size: 14px; font-weight: 700; white-space: nowrap;
    box-shadow: 0 6px 20px rgba(124,58,237,0.28);
    transition: transform 0.2s, box-shadow 0.2s;
  }
  .dash-cta:hover { transform: translateY(-1px); box-shadow: 0 8px 26px rgba(124,58,237,0.42); }

  /* Cards */
  .dash-cards {
    display: grid; grid-template-columns: repeat(2, 1fr);
    gap: 16px; margin-bottom: 28px;
  }
  .dash-card {
    background: var(--surface); border: 1px solid var(--border);
    border-radius: var(--radius-lg); padding: 20px;
  }
  .card-top { display: flex; align-items: center; gap: 14px; margin-bottom: 14px; }
  .card-ico {
    width: 44px; height: 44px; border-radius: 12px; flex-shrink: 0;
    display: flex; align-items: center; justify-content: center;
    background: rgba(124,58,237,0.14); color: var(--accent-light);
  }
  .pro-ico { background: rgba(236,72,153,0.14); color: var(--accent-pink); }
  .card-label { font-size: 11px; font-weight: 700; letter-spacing: 0.06em; color: var(--text-muted); margin-bottom: 2px; }
  .card-value { font-family: 'Syne', sans-serif; font-size: 1.4rem; font-weight: 800; }
  .card-bar { height: 5px; border-radius: 99px; background: var(--surface-raised); overflow: hidden; margin-bottom: 10px; }
  .card-bar span { display: block; height: 100%; background: linear-gradient(90deg, var(--accent), var(--accent-pink)); }
  .card-sub { color: var(--text-muted); font-size: 13px; }
  .pro-card { background: linear-gradient(135deg, rgba(124,58,237,0.08), rgba(236,72,153,0.06)); }
  .pro-btn {
    margin-top: 14px; width: 100%;
    background: linear-gradient(135deg, var(--accent), var(--accent-pink));
    color: #fff; border: none; border-radius: 10px; padding: 10px;
    font-size: 13px; font-weight: 700; cursor: pointer; font-family: inherit;
    transition: filter 0.2s;
  }
  .pro-btn:hover { filter: brightness(1.08); }
  .pro-btn:disabled { opacity: 0.7; cursor: default; }

  /* Panel */
  .dash-panel {
    background: var(--surface); border: 1px solid var(--border);
    border-radius: var(--radius-lg); padding: 20px 22px;
  }
  .panel-head { display: flex; align-items: center; gap: 10px; margin-bottom: 16px; }
  .panel-head h2 { font-size: 1.1rem; }
  .panel-count {
    background: rgba(124,58,237,0.15); color: var(--accent-light);
    font-size: 12px; font-weight: 700; padding: 2px 9px; border-radius: 999px;
  }
  .search-list { display: flex; flex-direction: column; gap: 6px; }
  .search-entry { border-radius: 10px; overflow: hidden; }
  .search-row {
    display: flex; align-items: center; gap: 12px; width: 100%;
    padding: 12px 12px; border-radius: 10px;
    background: none; border: none; cursor: pointer; font-family: inherit; text-align: left;
    transition: background 0.15s;
  }
  .search-row:hover { background: var(--surface-raised); }
  .search-ico {
    width: 34px; height: 34px; border-radius: 9px; flex-shrink: 0;
    display: flex; align-items: center; justify-content: center;
    background: rgba(124,58,237,0.12); color: var(--accent-light);
  }
  .search-meta { display: flex; flex-direction: column; min-width: 0; flex: 1; }
  .search-label { font-size: 14px; font-weight: 600; color: var(--text); white-space: nowrap; overflow: hidden; text-overflow: ellipsis; }
  .search-date { font-size: 12px; color: var(--text-muted); }
  .search-chev { color: var(--text-muted); flex-shrink: 0; display: flex; transition: transform 0.2s; }
  .search-row[aria-expanded="true"] .search-chev { transform: rotate(180deg); }

  /* Cached results panel */
  .search-results { padding: 4px 6px 14px; }
  .mini-grid {
    display: grid;
    grid-template-columns: repeat(auto-fill, minmax(96px, 1fr));
    gap: 10px;
  }
  .mini-card {
    display: flex; flex-direction: column; gap: 4px;
    background: var(--surface-raised); border: 1px solid var(--border);
    border-radius: 10px; padding: 6px; overflow: hidden;
    transition: border-color 0.2s, transform 0.2s;
  }
  .mini-card:hover { border-color: var(--accent); transform: translateY(-2px); }
  .mini-img { position: relative; aspect-ratio: 3/4; border-radius: 7px; overflow: hidden; background: var(--surface); display: block; }
  .mini-img img { width: 100%; height: 100%; object-fit: cover; display: block; }
  .mini-match {
    position: absolute; top: 4px; left: 4px;
    background: linear-gradient(135deg, var(--accent), var(--accent-pink));
    color: #fff; font-size: 10px; font-weight: 800; padding: 1px 6px; border-radius: 999px;
  }
  .mini-name {
    font-size: 12px; font-weight: 600; color: var(--text);
    white-space: nowrap; overflow: hidden; text-overflow: ellipsis;
  }
  .mini-price { font-size: 11px; font-weight: 700; color: var(--text-muted); }
  .mini-price.free { color: var(--success); }

  .search-empty {
    display: flex; flex-direction: column; align-items: center; text-align: center;
    padding: 36px 20px; color: var(--text-muted); gap: 4px;
  }
  .search-empty svg { color: var(--accent); opacity: 0.6; margin-bottom: 8px; }
  .search-empty p { font-size: 15px; font-weight: 700; color: var(--text); }
  .search-empty span { font-size: 13px; }
  .empty-btn {
    margin-top: 14px;
    background: linear-gradient(135deg, var(--accent), var(--accent-light));
    color: #fff; padding: 9px 22px; border-radius: 999px; font-weight: 700; font-size: 13px;
  }

  @media (max-width: 640px) {
    .dash-cards { grid-template-columns: 1fr; }
    .dash-cta { width: 100%; text-align: center; }
  }
</style>
