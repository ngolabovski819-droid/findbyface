---
import Base from '../../layouts/Base.astro';
import CreatorCard from '../../components/CreatorCard.astro';
import CategoryChips from '../../components/CategoryChips.astro';
import RankingAttributionBar from '../../components/RankingAttributionBar.astro';
import CategoryIntro from '../../components/CategoryIntro.astro';
import CategoryBody from '../../components/CategoryBody.astro';
import { slugToCategory } from '../../config/categories';
import { categorySeo, genericCategoryFaq } from '../../config/seo-meta';
import { getCategoryContent } from '../../config/categoryContent';
import { resolvePlacements } from '../../lib/creatorFetch';
import { applySponsorOverrides } from '../../lib/sponsorOverrides';

const { slug } = Astro.params;
if (!slug) return Astro.redirect('/');

const category = slugToCategory(slug);
if (!category) return Astro.redirect('/');

Astro.response.headers.set('Cache-Control', 'public, s-maxage=300, stale-while-revalidate=86400');

const PAGE_SIZE = 20;
const { creators: placedCreators, total } = await resolvePlacements(`category:${slug}`, {
  page: 1,
  pageSize: PAGE_SIZE,
  termsOr: category.terms,
});
// resolvePlacements already caps `total` to the page size when it had to fall back to
// the unfiltered popular list, so this is always safe to show under the category heading.
const creators = applySponsorOverrides(placedCreators);
const hasMore = creators.length < total;
const seo = categorySeo(slug, category.label, total);
const pageTitle = seo.title;
const pageDesc  = seo.description;
const canonical = `https://findbyface.org/categories/${slug}/`;
// i18n-twin: src/pages/es/categorias/[slug].astro — mirror copy/structure changes
const alternate = `/es/categorias/${category.slugEs ?? category.slug}/`;

// Pilot categories (src/config/categoryContent.ts) supply their own hand-written
// FAQ; everything else falls back to the generic templated one. Either way, this
// same array feeds both the JSON-LD below AND the visible FAQ in CategoryBody —
// single source of truth, so they can't drift apart.
const pilotContent = getCategoryContent(slug, 'en');
const faqItems = pilotContent?.faq ?? genericCategoryFaq(category.label, 'en');

const faqJsonLd = {
  '@type': 'FAQPage',
  mainEntity: faqItems.map(item => ({
    '@type': 'Question',
    name: item.question,
    acceptedAnswer: { '@type': 'Answer', text: item.answer },
  })),
};

const jsonLd = JSON.stringify({
  '@context': 'https://schema.org',
  '@graph': [
    {
      '@type': 'BreadcrumbList',
      itemListElement: [
        { '@type': 'ListItem', position: 1, name: 'Home', item: 'https://findbyface.org/' },
        { '@type': 'ListItem', position: 2, name: category.label, item: canonical },
      ],
    },
    {
      '@type': 'ItemList',
      name: pageTitle,
      url: canonical,
      numberOfItems: creators.length,
      itemListElement: creators.slice(0, 10).map((c, i) => ({
        '@type': 'ListItem',
        position: i + 1,
        name: c.name || c.username,
        url: `https://onlyfans.com/${c.username}`,
      })),
    },
    faqJsonLd,
  ],
});
---

<Base title={pageTitle} description={pageDesc} canonical={canonical} alternate={alternate}>
  <Fragment slot="head">
    <script type="application/ld+json" set:html={jsonLd} />
  </Fragment>

  <div class="category-page">
    <div class="category-header">
      <h1>
        {category.emoji && <span class="cat-emoji">{category.emoji}</span>}
        Best {category.label} OnlyFans Creators
      </h1>
      <p class="category-sub">
        {total ? `${total.toLocaleString()} creators found` : 'Browse top creators'}
      </p>
    </div>

    <CategoryIntro slug={slug} locale="en" />

    <CategoryChips activeSlug={slug} />
    <RankingAttributionBar />

    <div class="category-content">
      {creators.length > 0 ? (
        <>
          <div class="creators-grid" id="creatorsGrid">
            {creators.map((c, i) => <CreatorCard creator={c} index={i} />)}
          </div>
          {hasMore && (
            <div class="load-more-wrap">
              <button class="load-more-btn" id="loadMoreBtn">Load More</button>
            </div>
          )}
        </>
      ) : (
        <div class="empty-state">
          <p>No creators found for this category yet.</p>
          <a href="/" class="back-link">← Back to home</a>
        </div>
      )}
    </div>

    <CategoryBody slug={slug} locale="en" />
  </div>
</Base>

<script define:vars={{ categorySlug: slug, initialHasMore: hasMore }}>
  let currentPage = 2;
  let isLoading = false;
  let hasMoreResults = initialHasMore;

  const loadMoreBtn = document.getElementById('loadMoreBtn');
  const grid = document.getElementById('creatorsGrid');

  function proxyImg(url, w, h) {
    if (!url || url.startsWith('/')) return url;
    return `https://images.weserv.nl/?url=${encodeURIComponent(url.replace(/^https?:\/\//, ''))}&w=${w}&h=${h}&fit=cover&output=webp`;
  }

  function cardDataAttributes(c) {
    const escapeAttribute = value => String(value)
      .replace(/&/g, '&amp;')
      .replace(/"/g, '&quot;')
      .replace(/</g, '&lt;')
      .replace(/>/g, '&gt;');
    const images = [...new Set([c.avatar, c.header, ...(c.galleryImages || [])].filter(Boolean))];
    return [
      `data-card-username="${escapeAttribute(c.username || '')}"`,
      `data-card-images="${escapeAttribute(JSON.stringify(images))}"`,
      `data-card-sponsored="${c.sponsored ? 'true' : 'false'}"`,
      `data-card-tags="${escapeAttribute(JSON.stringify(c.tags || []))}"`,
      `data-card-extra-tags="${c.additionalTagCount || 0}"`,
      `data-card-verified="${c.isVerified || c.isverified ? 'true' : 'false'}"`,
    ].join(' ');
  }

  function renderCard(c) {
    const imgSrc = c.avatar?.startsWith('/') ? c.avatar : c.avatar?.startsWith('http') ? proxyImg(c.avatar, 320, 427) : '/no-image.png';
    const price = c.subscribePrice ?? c.subscribeprice;
    const priceLabel = (!price || isNaN(price)) ? 'FREE' : `$${parseFloat(price).toFixed(2)}`;
    const profileUrl = c.profileUrl || `https://onlyfans.com/${encodeURIComponent(c.username)}`;
    const isSponsored = profileUrl.startsWith('/go/');
    const rel = isSponsored ? 'noopener nofollow sponsored' : 'noopener nofollow';
    const cardData = cardDataAttributes(c);
    return `<div class="creator-card" data-href="${profileUrl}" ${cardData}>
      <div class="card-img-wrap">
        <img src="${imgSrc}" alt="${c.name || c.username}" loading="lazy" decoding="async" referrerpolicy="no-referrer"
          onerror="this.onerror=null;this.removeAttribute('srcset');this.src='/no-image.png';">
      </div>
      <div class="card-body">
        <p class="creator-name">${c.name || c.username}</p>
        <p class="username">@${c.username}</p>
        <p class="price ${priceLabel === 'FREE' ? 'price-free' : ''}">${priceLabel}</p>
        <a href="${profileUrl}" class="view-btn" target="_blank" rel="${rel}">View Profile</a>
      </div>
    </div>`;
  }

  loadMoreBtn?.addEventListener('click', async () => {
    if (isLoading || !hasMoreResults) return;
    isLoading = true;
    loadMoreBtn.textContent = 'Loading...';
    loadMoreBtn.disabled = true;
    try {
      const resp = await fetch(`/api/search?scope=${encodeURIComponent('category:' + categorySlug)}&page=${currentPage}&page_size=20`);
      const data = await resp.json();
      data.creators?.forEach(c => grid?.insertAdjacentHTML('beforeend', renderCard(c)));
      hasMoreResults = data.hasMore;
      currentPage++;
      loadMoreBtn.textContent = 'Load More';
      loadMoreBtn.disabled = false;
      if (!hasMoreResults) loadMoreBtn.style.display = 'none';
    } catch {
      loadMoreBtn.textContent = 'Load More';
      loadMoreBtn.disabled = false;
    }
    isLoading = false;
  });
</script>

<script>
  import { initCardClickThrough } from '../../lib/cardClickThrough';
  initCardClickThrough();
</script>

<style>
  .category-page {
    max-width: 1200px;
    margin: 0 auto;
    padding: 100px 20px 60px;
  }

  .category-header {
    text-align: center;
    margin-bottom: 40px;
  }

  .category-header h1 { font-size: clamp(1.8rem, 4vw, 2.4rem); margin-bottom: 12px; }
  .cat-emoji { margin-right: 8px; }
  .category-sub { color: var(--text-muted); }

  .category-content { margin-top: 40px; }

  .creators-grid {
    display: grid;
    grid-template-columns: repeat(4, minmax(0, 1fr));
    gap: 20px;
  }

  @media (max-width: 900px) { .creators-grid { grid-template-columns: repeat(3, minmax(0, 1fr)); } }
  @media (max-width: 640px) { .creators-grid { grid-template-columns: repeat(2, minmax(0, 1fr)); gap: 12px; } }

  .load-more-wrap { display: flex; justify-content: center; margin-top: 40px; }

  .load-more-btn {
    background: transparent; border: 1px solid var(--border);
    color: var(--text); padding: 12px 44px; border-radius: 999px;
    font-size: 15px; font-weight: 500; cursor: pointer;
    font-family: 'Inter', sans-serif; transition: all 0.2s;
  }
  .load-more-btn:hover { border-color: var(--accent); color: var(--accent); }

  .empty-state { text-align: center; padding: 80px 20px; color: var(--text-muted); }
  .back-link { color: var(--accent); margin-top: 16px; display: inline-block; }
</style>
