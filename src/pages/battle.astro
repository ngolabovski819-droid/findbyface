---
import Base from '../layouts/Base.astro';

const pageTitle = 'Creator Battle: Vote & Rank OnlyFans Creators | findbyface';
const pageDescription = 'Choose between OnlyFans creators in head-to-head battles. Every vote moves the live rankings. Play three Daily rounds or keep voting in Unlimited.';
const pageUrl = 'https://findbyface.org/battle/';
const socialImage = '/creator-battle-share-card.png';

const structuredData = JSON.stringify([
  {
    '@context': 'https://schema.org',
    '@type': ['VideoGame', 'WebApplication'],
    name: 'Creator Battle',
    alternateName: 'findbyface Creator Battle',
    url: pageUrl,
    description: pageDescription,
    applicationCategory: 'GameApplication',
    applicationSubCategory: 'Creator ranking game',
    operatingSystem: 'Any',
    browserRequirements: 'Requires JavaScript and a modern web browser',
    gamePlatform: 'Web browser',
    playMode: 'SinglePlayer',
    genre: ['Voting game', 'Ranking game'],
    isAccessibleForFree: true,
    inLanguage: 'en',
    contentRating: '18+',
    audience: { '@type': 'PeopleAudience', requiredMinAge: 18 },
    image: `https://findbyface.org${socialImage}`,
    offers: { '@type': 'Offer', price: 0, priceCurrency: 'USD' },
    publisher: {
      '@type': 'Organization',
      name: 'findbyface',
      url: 'https://findbyface.org/',
      logo: 'https://findbyface.org/findbyface-logo.png',
    },
  },
  {
    '@context': 'https://schema.org',
    '@type': 'BreadcrumbList',
    itemListElement: [
      { '@type': 'ListItem', position: 1, name: 'Home', item: 'https://findbyface.org/' },
      { '@type': 'ListItem', position: 2, name: 'Creator Battle', item: pageUrl },
    ],
  },
]);
---

<Base
  title={pageTitle}
  description={pageDescription}
  canonical={pageUrl}
  robots="index,follow,max-image-preview:large,max-snippet:-1,max-video-preview:-1"
  image={socialImage}
  imageAlt="Creator Battle by findbyface, showing two creators in a head-to-head points matchup"
>
  <Fragment slot="head">
    <meta name="rating" content="adult" />
    <script type="application/ld+json" set:html={structuredData} />
  </Fragment>
  <section class="battle-page">
    <header class="battle-header">
      <span class="page-kicker">OnlyFans creator ranking game</span>
      <h1>Creator Battle</h1>
      <p class="battle-tagline">Choose your favorite. Move the rankings.</p>
      <p class="battle-intro">Vote in head-to-head creator matchups, reveal the live point swing, and help shape a community-driven ranking with every pick.</p>
    </header>

    <div class="battle-gate" id="battleGate">
      <div class="gate-glow" aria-hidden="true"></div>
      <div class="gate-card">
        <span class="gate-icon" aria-hidden="true">⚔</span>
        <span class="gate-kicker">Daily and Unlimited arenas</span>
        <h2>Sign in to play Creator Battle</h2>
        <p>Choose your favorite, move the live rankings, and build your Daily and Unlimited battle record.</p>
        <a href="/login/?next=/battle/" class="primary-button">Log in to play <span>→</span></a>
        <p class="gate-signup">New to findbyface? <a href="/signup/?next=/battle/">Create a free account</a></p>
      </div>
    </div>

    <div class="battle-main" id="battleMain" hidden>
      <div class="battle-stats-row" aria-label="Your Creator Battle statistics">
        <div class="stat-pill streak"><span class="stat-icon">↯</span><strong id="statStreak">0</strong><span>day streak</span></div>
        <div class="stat-pill"><span class="stat-icon dot">●</span><strong id="statVotesHour">0</strong><span>votes this hour</span></div>
      </div>

      <nav class="battle-tabs" role="tablist" aria-label="Creator Battle mode">
        <button class="battle-tab active" type="button" data-tab="daily" role="tab" aria-selected="true">Daily</button>
        <button class="battle-tab" type="button" data-tab="unlimited" role="tab" aria-selected="false">Unlimited</button>
        <button class="battle-tab" type="button" data-tab="leaderboard" role="tab" aria-selected="false">Rankings</button>
      </nav>

      <section class="battle-panel" id="panelDaily">
        <div class="mode-heading">
          <div><span>Daily arena</span><strong>Three shared matchups</strong></div>
          <small>Choose on instinct — points and live ranks reveal after your vote.</small>
        </div>
        <div class="round-progress" id="roundProgress" aria-label="Daily round progress"></div>
        <div id="dailyArena"></div>
        <div class="share-card" id="dailyShare" hidden>
          <span class="completion-icon" aria-hidden="true">◆</span>
          <span class="completion-kicker">Daily arena complete</span>
          <h3>Three votes. Rankings changed.</h3>
          <p id="shareSummary"></p>
          <button type="button" class="primary-button" id="shareBtn">Share your run <span>↗</span></button>
          <p class="share-hint">Come back tomorrow for three new matchups, or keep the ranking moving in Unlimited.</p>
        </div>
      </section>

      <section class="battle-panel" id="panelUnlimited" hidden>
        <div class="mode-heading">
          <div><span>Unlimited arena</span><strong>Vote as long as you like</strong></div>
          <small>No elimination. Every vote moves the live ranking.</small>
        </div>
        <div id="unlimitedArena"></div>
      </section>

      <section class="battle-panel" id="panelLeaderboard" hidden>
        <div class="lb-tabs" role="tablist" aria-label="Leaderboard type">
          <button class="lb-tab active" type="button" data-lb="users-daily">Daily players</button>
          <button class="lb-tab" type="button" data-lb="users-unlimited">Unlimited players</button>
          <button class="lb-tab" type="button" data-lb="creators">Creators</button>
        </div>
        <p class="lb-caption" id="lbCaption">Today’s players ranked by battles won, then battles played.</p>
        <div class="lb-list" id="lbList"></div>
        <div class="lb-load-more" id="lbLoadMore" role="status" aria-live="polite" hidden>
          <span class="lb-load-spinner" aria-hidden="true"></span>
          <span id="lbLoadMoreText">Loading 50 more creators…</span>
        </div>
      </section>

    </div>

      <section class="battle-guide" id="battleGuide" aria-labelledby="battleGuideTitle">
        <header class="guide-header">
          <span class="guide-kicker">Game rules</span>
          <h2 id="battleGuideTitle">How Creator Battle works</h2>
          <p>Choose on instinct, reveal the result, and move the creator ranking with every vote.</p>
        </header>

        <div class="guide-loop" aria-label="The Creator Battle game loop">
          <article>
            <span class="guide-step">01</span>
            <div><strong>Choose a creator</strong><p>Pick the creator you prefer. Points and rank stay hidden until you vote.</p></div>
          </article>
          <span class="guide-arrow" aria-hidden="true">→</span>
          <article>
            <span class="guide-step">02</span>
            <div><strong>See the impact</strong><p>Both cards reveal their new live rank and the points gained or lost.</p></div>
          </article>
          <span class="guide-arrow" aria-hidden="true">→</span>
          <article>
            <span class="guide-step">03</span>
            <div><strong>Keep the ranking moving</strong><p>The result is saved immediately and the next matchup enters the arena.</p></div>
          </article>
        </div>

        <div class="guide-feature-grid">
          <article class="guide-feature points-rule">
            <span class="guide-card-label">Creator points</span>
            <h3>Every vote moves both creators</h3>
            <p>The creator you select gains points. The other creator loses the exact same amount, so every matchup is one balanced ranked event.</p>
            <div class="points-example" aria-label="Example of creator point movement">
              <span><small>Your pick</small><strong class="example-gain">+ points</strong></span>
              <i aria-hidden="true">⇄</i>
              <span><small>Other creator</small><strong class="example-loss">− points</strong></span>
            </div>
            <ul>
              <li><strong>Upset:</strong> choosing a much lower-ranked creator over a favorite creates a larger swing.</li>
              <li><strong>Expected result:</strong> choosing the stronger favorite creates a smaller swing.</li>
              <li><strong>Close matchup:</strong> similarly ranked creators move by roughly the same middle amount.</li>
            </ul>
          </article>

          <article class="guide-feature player-win-rule">
            <span class="guide-card-label">Player record</span>
            <h3>What “battle won” means</h3>
            <p>Your preference is never marked wrong. A <strong>battle won</strong> is recorded when your pick had more creator points before the vote began.</p>
            <div class="record-example">
              <span><strong>Battle</strong><small>Every vote you cast</small></span>
              <span><strong>Battle won</strong><small>You backed the higher-ranked side</small></span>
            </div>
            <p class="guide-note">An exact pre-vote tie counts as a battle played, but not as a battle won.</p>
          </article>
        </div>

        <div class="guide-rules-grid">
          <article>
            <span class="rule-icon daily-icon" aria-hidden="true">3</span>
            <h3>Daily arena</h3>
            <p>Three shared matchups per calendar day. Every player sees the same three pairs, and each round can be played once.</p>
          </article>
          <article>
            <span class="rule-icon unlimited-icon" aria-hidden="true">∞</span>
            <h3>Unlimited arena</h3>
            <p>Uncapped play with continuously refreshed matchups. There is no elimination, miss, or run-ending vote.</p>
          </article>
          <article>
            <span class="rule-icon" aria-hidden="true">↗</span>
            <h3>Player rankings</h3>
            <p>Daily ranks today’s players; Unlimited tracks lifetime play. Both order players by battles won, then battles played.</p>
          </article>
          <article>
            <span class="rule-icon" aria-hidden="true">★</span>
            <h3>Creator rankings</h3>
            <p>Creators rank by live points; point ties break by selections, then appearances. A selection is a win, and every matchup is an appearance.</p>
          </article>
          <article>
            <span class="rule-icon streak-icon" aria-hidden="true">↯</span>
            <h3>Daily streak</h3>
            <p>Vote in Daily on consecutive calendar days to grow your streak. Multiple Daily votes on one day still count as one streak day.</p>
          </article>
          <article>
            <span class="rule-icon" aria-hidden="true">◎</span>
            <h3>The creator pool</h3>
            <p>The current arena draws from 10,000 eligible database creators, initially selected and seeded by favorited count. Live votes now drive every move.</p>
          </article>
        </div>

        <footer class="guide-footer">
          <p><strong>Live counters:</strong> “votes this hour” shows Creator Battle activity recorded during the rolling last 60 minutes.</p>
          <p><strong>Fair ranking:</strong> sponsored exposure never changes the point formula, a creator’s eligibility, or the value of a vote.</p>
          <p><strong>Profiles:</strong> View profile is available on every matchup card, and your player nickname and avatar can be changed in your profile settings.</p>
          <p><strong>Independent game:</strong> Creator Battle is operated by findbyface and is not affiliated with, endorsed by, or sponsored by OnlyFans.</p>
        </footer>
      </section>

    <div class="battle-toast" id="battleToast" role="status" aria-live="polite" hidden>
      <span id="toastMessage"></span>
    </div>

    <div class="player-profile-modal" id="playerProfileModal" hidden>
      <button class="profile-modal-backdrop" type="button" data-close-profile aria-label="Close profile editor"></button>
      <section class="profile-modal-card" role="dialog" aria-modal="true" aria-labelledby="profileModalTitle">
        <button class="profile-modal-close" type="button" data-close-profile aria-label="Close profile editor">×</button>
        <span class="profile-modal-kicker">Player identity</span>
        <h2 id="profileModalTitle">Edit Creator Battle profile</h2>
        <p>Choose the nickname and avatar shown on Daily and Unlimited leaderboards.</p>
        <form id="playerProfileForm">
          <label class="profile-name-field" for="playerNickname">
            <span>Nickname</span>
            <input id="playerNickname" name="nickname" type="text" minlength="3" maxlength="24" autocomplete="nickname" required />
            <small>3–24 characters. Nicknames are unique.</small>
          </label>
          <fieldset class="avatar-picker">
            <legend>Player avatar</legend>
            <div class="avatar-options">
              {[1,2,3,4,5,6,7,8].map((style) => (
                <label class="avatar-option">
                  <input type="radio" name="avatarStyle" value={style} />
                  <img src={`/api/player-avatar?style=${style}`} alt={`Avatar style ${style}`} />
                  <span aria-hidden="true">✓</span>
                </label>
              ))}
            </div>
          </fieldset>
          <p class="profile-form-error" id="profileFormError" role="alert" hidden></p>
          <button class="primary-button profile-save" id="profileSaveButton" type="submit">Save player profile</button>
        </form>
      </section>
    </div>
  </section>
</Base>

<script>
  import { scopedSearchHistoryKey } from '../lib/accountSearchHistory';

  interface StoredUser {
    id?: string;
    name?: string;
    email: string;
    avatar?: string;
    access_token?: string;
    refresh_token?: string;
    expires_at?: number;
  }

  interface Candidate {
    id: number;
    username: string;
    name: string | null;
    avatar: string | null;
    sponsored?: boolean;
  }

  interface DailyRound {
    roundIndex: number;
    left: Candidate;
    right: Candidate;
    answered: boolean;
    guessedId: number | null;
    ratingDelta: number | null;
    battleWon: boolean | null;
  }

  interface Stats {
    total_battles: number;
    daily_battles: number;
    unlimited_battles: number;
    total_battles_won: number;
    daily_battles_won: number;
    unlimited_battles_won: number;
    current_streak_days: number;
    best_streak_days: number;
  }

  interface VoteResult extends Stats {
    selected_id: number;
    other_id: number;
    rating_delta: number;
    selected_rating: number;
    other_rating: number;
    selected_rank: number | null;
    other_rank: number | null;
    battle_won: boolean;
    votes_this_hour: number;
  }

  let currentUser: StoredUser | null = null;
  let myUserId: string | null = null;
  let latestStats: Stats | null = null;
  let dailyRounds: DailyRound[] = [];
  let dailyDate = '';
  let activeRoundIndex = 0;
  let unlimitedPair: { left: Candidate; right: Candidate; sponsoredSlot: boolean } | null = null;
  let unlimitedBusy = false;
  let toastTimer = 0;
  const CREATOR_PAGE_SIZE = 50;
  let activeLeaderboardScope = 'users-daily';
  let leaderboardRequestId = 0;
  let creatorLeaderboardOffset = 0;
  let creatorLeaderboardHasMore = false;
  let creatorLeaderboardLoading = false;
  let creatorLeaderboardObserver: IntersectionObserver | null = null;
  let selectedAvatarStyle = 1;

  const reducedMotion = window.matchMedia('(prefers-reduced-motion: reduce)');

  function escapeHtml(value: unknown): string {
    return String(value ?? '').replace(/[&<>"']/g, (character) => ({
      '&': '&amp;',
      '<': '&lt;',
      '>': '&gt;',
      '"': '&quot;',
      "'": '&#39;',
    }[character] as string));
  }

  function proxyImg(url: string | null | undefined, width: number, height: number): string {
    if (!url) return '/no-image.png';
    if (url.startsWith('/')) return url;
    return `https://images.weserv.nl/?url=${encodeURIComponent(url.replace(/^https?:\/\//, ''))}&w=${width}&h=${height}&fit=cover&output=webp`;
  }

  function defaultPlayerAvatarStyle(seed: string): number {
    const uuidHex = seed.replace(/-/g, '');
    if (/^[a-f\d]{32}$/i.test(uuidHex)) return Number.parseInt(uuidHex.slice(0, 2), 16) % 8 + 1;
    let hash = 2166136261;
    for (let index = 0; index < seed.length; index += 1) {
      hash ^= seed.charCodeAt(index);
      hash = Math.imul(hash, 16777619);
    }
    return (hash >>> 0) % 8 + 1;
  }

  function playerAvatarUrl(userId: string, avatarUrl?: string | null): string {
    if (avatarUrl && /^\/api\/player-avatar\?style=[1-8]$/.test(avatarUrl)) return avatarUrl;
    return `/api/player-avatar?style=${defaultPlayerAvatarStyle(userId)}`;
  }

  function avatarStyleFromUrl(avatarUrl: string | null | undefined, fallbackSeed: string): number {
    const style = Number(new URL(avatarUrl || '', window.location.origin).searchParams.get('style'));
    return Number.isInteger(style) && style >= 1 && style <= 8
      ? style
      : defaultPlayerAvatarStyle(fallbackSeed);
  }

  function creatorProfileUrl(candidate: Pick<Candidate, 'username' | 'sponsored'>): string {
    return candidate.sponsored
      ? `/go/${encodeURIComponent(candidate.username)}?slot=battle`
      : `https://onlyfans.com/${encodeURIComponent(candidate.username)}`;
  }

  function formatDelta(value: number): string {
    const rounded = Math.round(Math.abs(Number(value)) * 10) / 10;
    return Number.isInteger(rounded) ? String(rounded) : rounded.toFixed(1);
  }

  function showToast(message: string, duration = 3200): void {
    const toast = document.getElementById('battleToast')!;
    document.getElementById('toastMessage')!.textContent = message;
    toast.hidden = false;
    window.clearTimeout(toastTimer);
    toastTimer = window.setTimeout(() => { toast.hidden = true; }, duration);
  }

  function renderArenaError(container: HTMLElement, message: string, onRetry: () => void): void {
    container.innerHTML = `<div class="arena-error"><p>${escapeHtml(message)}</p><button type="button" class="primary-button arena-retry">Try again</button></div>`;
    container.querySelector<HTMLButtonElement>('.arena-retry')?.addEventListener('click', onRetry, { once: true });
  }

  function tokenExpiry(token?: string): number {
    if (!token) return 0;
    try {
      const encoded = token.split('.')[1].replace(/-/g, '+').replace(/_/g, '/');
      const payload = JSON.parse(atob(encoded)) as { exp?: number };
      return Number(payload.exp || 0) * 1000;
    } catch {
      return 0;
    }
  }

  function decodeUserId(token?: string): string | null {
    if (!token) return null;
    try {
      const encoded = token.split('.')[1].replace(/-/g, '+').replace(/_/g, '/');
      const payload = JSON.parse(atob(encoded)) as { sub?: string };
      return payload.sub || null;
    } catch {
      return null;
    }
  }

  function readStoredUser(): StoredUser | null {
    try {
      const value = JSON.parse(localStorage.getItem('fbf_user') || 'null');
      return value && typeof value === 'object' ? value as StoredUser : null;
    } catch {
      return null;
    }
  }

  async function refreshStoredUser(user: StoredUser): Promise<StoredUser | null> {
    const ownerId = user.id || decodeUserId(user.access_token) || undefined;
    const refreshToken = user.refresh_token;
    if (!ownerId || !refreshToken) return null;
    try {
      const response = await fetch('/api/auth/refresh', {
        method: 'POST',
        headers: { 'Content-Type': 'application/json' },
        body: JSON.stringify({ refresh_token: refreshToken }),
      });
      const payload = await response.json();
      const current = readStoredUser();
      if (current?.id !== ownerId || current.refresh_token !== refreshToken) {
        return current?.access_token ? current : null;
      }
      if (!response.ok || !payload.access_token || payload.user?.id !== ownerId) return null;
      const refreshed: StoredUser = {
        ...current,
        ...payload.user,
        access_token: payload.access_token,
        refresh_token: payload.refresh_token || refreshToken,
        expires_at: Date.now() + Number(payload.expires_in || 3600) * 1000,
      };
      localStorage.setItem('fbf_user', JSON.stringify(refreshed));
      return refreshed;
    } catch {
      const current = readStoredUser();
      return current?.id !== ownerId || current.refresh_token !== refreshToken
        ? current
        : null;
    }
  }

  async function getValidUser(): Promise<StoredUser | null> {
    let raw: string | null;
    try { raw = localStorage.getItem('fbf_user'); } catch { return null; }
    if (!raw) return null;

    let user: StoredUser;
    try { user = JSON.parse(raw); } catch { return null; }
    const expiresAt = Number(user.expires_at || tokenExpiry(user.access_token));
    if (!user.access_token || expiresAt <= Date.now() + 60_000) {
      const refreshed = await refreshStoredUser(user);
      if (!refreshed) {
        localStorage.removeItem('fbf_user');
        if (user.id) {
          localStorage.removeItem(scopedSearchHistoryKey('fbf_history', user.id));
          localStorage.removeItem(scopedSearchHistoryKey('fbf_pornstar_history', user.id));
          localStorage.removeItem(scopedSearchHistoryKey('fbf_search_queries', user.id));
        }
        return null;
      }
      return refreshed;
    }
    return user;
  }

  async function api(path: string, options: RequestInit = {}): Promise<any> {
    const headers = new Headers(options.headers);
    if (currentUser?.access_token) headers.set('Authorization', `Bearer ${currentUser.access_token}`);
    if (options.body) headers.set('Content-Type', 'application/json');
    const response = await fetch(path, { ...options, headers });
    const data = await response.json().catch(() => ({}));
    if (!response.ok) {
      throw Object.assign(new Error(data.error || `Request failed (${response.status})`), { status: response.status });
    }
    return data;
  }

  function renderStats(stats: Stats, votesThisHour?: number): void {
    latestStats = stats;
    document.getElementById('statStreak')!.textContent = String(stats.current_streak_days || 0);
    if (votesThisHour != null) {
      document.getElementById('statVotesHour')!.textContent = Number(votesThisHour).toLocaleString();
    }
  }

  function cardMarkup(candidate: Candidate, side: 'left' | 'right'): string {
    const name = candidate.name || candidate.username;
    const profileUrl = creatorProfileUrl(candidate);
    const rel = candidate.sponsored ? 'noopener nofollow sponsored' : 'noopener nofollow';
    return `<div class="vs-card-shell" data-side="${side}">
      <button class="vs-card" type="button" data-side="${side}" data-id="${candidate.id}" aria-label="Vote for ${escapeHtml(name)}">
        <span class="vs-media">
          <img src="${escapeHtml(proxyImg(candidate.avatar, 520, 680))}" alt="" loading="eager" referrerpolicy="no-referrer" onerror="this.onerror=null;this.src='/no-image.png';" />
          <span class="card-shade" aria-hidden="true"></span>
          ${candidate.sponsored ? '<span class="vs-ad-badge">Sponsored</span>' : ''}
          <span class="points-burst" aria-live="polite"></span>
        </span>
        <span class="vs-info">
          <span class="creator-copy">
            <span class="vs-name">${escapeHtml(name)}</span>
            <span class="vs-handle">@${escapeHtml(candidate.username)}</span>
          </span>
          <span class="vote-cta">Choose</span>
        </span>
        <span class="rating-reveal" aria-live="polite"></span>
      </button>
      <a class="profile-link" href="${escapeHtml(profileUrl)}" target="_blank" rel="${rel}">
        <svg viewBox="0 0 24 24" aria-hidden="true"><path d="M12 12a4 4 0 1 0 0-8 4 4 0 0 0 0 8Zm7 8a7 7 0 0 0-14 0" /></svg>
        View profile
      </a>
    </div>`;
  }

  function renderArena(container: HTMLElement, left: Candidate, right: Candidate): void {
    container.innerHTML = `<div class="vs-arena">
      ${cardMarkup(left, 'left')}
      <div class="vs-medallion" aria-hidden="true"><span>VS</span></div>
      ${cardMarkup(right, 'right')}
    </div>`;
    const arena = container.querySelector<HTMLElement>('.vs-arena');
    if (arena && !reducedMotion.matches) {
      arena.classList.add('is-entering');
      window.requestAnimationFrame(() => window.requestAnimationFrame(() => arena.classList.remove('is-entering')));
    }
  }

  function revealVote(container: HTMLElement, result: VoteResult): void {
    const arena = container.querySelector<HTMLElement>('.vs-arena');
    if (!arena) return;
    const delta = Number(result.rating_delta || 0);
    const upset = delta > 16.05;
    arena.classList.remove('is-submitting');
    arena.classList.add('is-resolving');
    if (upset) arena.classList.add('is-upset');

    arena.querySelectorAll<HTMLButtonElement>('.vs-card').forEach((card) => {
      const id = Number(card.dataset.id);
      const selected = id === Number(result.selected_id);
      const rank = Number(selected ? result.selected_rank : result.other_rank);
      const rankLabel = Number.isInteger(rank) && rank > 0 ? `#${rank.toLocaleString()}` : 'Updating…';
      card.disabled = true;
      card.classList.remove('is-pending-pick', 'is-pending-other');
      card.classList.add(selected ? 'is-selected' : 'is-other');
      const burst = card.querySelector<HTMLElement>('.points-burst')!;
      burst.innerHTML = `<strong>${selected ? '+' : '−'}${formatDelta(delta)}</strong><span>${selected && upset ? 'UPSET · POINTS' : 'POINTS'}</span>`;
      const reveal = card.querySelector<HTMLElement>('.rating-reveal')!;
      reveal.classList.remove('is-pending');
      reveal.innerHTML = `<span class="result-label">${selected ? 'Your pick' : 'Opponent'}</span>
        <span class="result-metric rank-metric"><strong>${rankLabel}</strong><small>Live rank</small></span>
        <span class="result-metric points-metric"><span class="points-change ${selected ? 'gain' : 'loss'}"><strong>${selected ? '+' : '−'}${formatDelta(delta)}</strong><small>points</small></span></span>`;
      const callToAction = card.querySelector<HTMLElement>('.vote-cta');
      if (callToAction) callToAction.textContent = selected ? 'Picked' : 'Result';
    });
  }

  function beginVote(container: HTMLElement, selectedId: number): void {
    const arena = container.querySelector<HTMLElement>('.vs-arena');
    if (!arena) return;
    arena.classList.add('is-submitting');
    navigator.vibrate?.(18);
    arena.querySelectorAll<HTMLButtonElement>('.vs-card').forEach((card) => {
      const selected = Number(card.dataset.id) === selectedId;
      card.disabled = true;
      card.classList.add(selected ? 'is-pending-pick' : 'is-pending-other');
      const callToAction = card.querySelector<HTMLElement>('.vote-cta');
      if (callToAction) callToAction.textContent = selected ? 'Picked' : 'Locked';
      if (!selected) return;
      const reveal = card.querySelector<HTMLElement>('.rating-reveal')!;
      reveal.classList.add('is-pending');
      reveal.innerHTML = `<span class="result-label">Your pick is locked</span>
        <span class="result-resolving"><i aria-hidden="true"></i><strong>Moving the rankings…</strong></span>`;
    });
  }

  function resetVoteState(container: HTMLElement): void {
    const arena = container.querySelector<HTMLElement>('.vs-arena');
    if (!arena) return;
    arena.classList.remove('is-submitting');
    arena.querySelectorAll<HTMLButtonElement>('.vs-card').forEach((card) => {
      card.disabled = false;
      card.classList.remove('is-pending-pick', 'is-pending-other');
      const callToAction = card.querySelector<HTMLElement>('.vote-cta');
      if (callToAction) callToAction.textContent = 'Choose';
      const reveal = card.querySelector<HTMLElement>('.rating-reveal');
      if (reveal) {
        reveal.classList.remove('is-pending');
        reveal.innerHTML = '';
      }
    });
  }

  function voteMessage(result: VoteResult): string {
    const delta = Number(result.rating_delta || 0);
    if (delta > 16.05) return `Upset! The underdog gained ${formatDelta(delta)} points`;
    if (result.battle_won) return `Battle won — you backed the higher-ranked creator`;
    return `Vote counted — both creators were evenly matched`;
  }

  function transitionDelay(): number {
    return reducedMotion.matches ? 2100 : 2600;
  }

  function transitionToNext(container: HTMLElement, renderNext: () => void | Promise<void>): void {
    window.setTimeout(() => {
      const arena = container.querySelector<HTMLElement>('.vs-arena');
      if (!arena || reducedMotion.matches) {
        void renderNext();
        return;
      }
      arena.classList.add('is-leaving');
      window.setTimeout(() => { void renderNext(); }, 220);
    }, transitionDelay());
  }

  function bindVoteCards(container: HTMLElement, handler: (id: number) => void): void {
    container.querySelectorAll<HTMLButtonElement>('.vs-card').forEach((card) => {
      card.addEventListener('click', () => handler(Number(card.dataset.id)), { once: true });
    });
  }

  function renderRoundProgress(): void {
    const progress = document.getElementById('roundProgress')!;
    progress.innerHTML = dailyRounds.map((round) => {
      const state = round.answered ? 'done' : (round.roundIndex === activeRoundIndex ? 'current' : 'upcoming');
      return `<span class="round-step ${state}"><i></i><span>${round.answered ? 'Voted' : `Round ${round.roundIndex}`}</span></span>`;
    }).join('');
  }

  function nextUnansweredRound(): DailyRound | null {
    return dailyRounds.find((round) => !round.answered) ?? null;
  }

  function renderDailyPanel(): void {
    const arena = document.getElementById('dailyArena')!;
    const share = document.getElementById('dailyShare')!;
    const next = nextUnansweredRound();

    if (!next) {
      activeRoundIndex = 0;
      renderRoundProgress();
      arena.innerHTML = '';
      share.hidden = false;
      document.getElementById('shareSummary')!.textContent = `3 battles completed · ${latestStats?.current_streak_days || 0}-day streak`;
      return;
    }

    share.hidden = true;
    activeRoundIndex = next.roundIndex;
    renderRoundProgress();
    renderArena(arena, next.left, next.right);
    bindVoteCards(arena, (id) => handleDailyVote(next, id));
  }

  async function handleDailyVote(round: DailyRound, selectedId: number): Promise<void> {
    const arena = document.getElementById('dailyArena')!;
    beginVote(arena, selectedId);
    try {
      const result: VoteResult = await api('/api/battle-guess', {
        method: 'POST',
        body: JSON.stringify({
          mode: 'daily',
          roundIndex: round.roundIndex,
          leftId: round.left.id,
          rightId: round.right.id,
          selectedId,
        }),
      });
      round.answered = true;
      round.guessedId = selectedId;
      round.ratingDelta = result.rating_delta;
      round.battleWon = result.battle_won;
      revealVote(arena, result);
      renderStats(result, result.votes_this_hour);
      showToast(voteMessage(result), Math.max(1800, transitionDelay() - 150));
      transitionToNext(arena, renderDailyPanel);
    } catch (error: any) {
      showToast(error.message || 'Something went wrong');
      resetVoteState(arena);
      bindVoteCards(arena, (id) => handleDailyVote(round, id));
    }
  }

  async function loadDaily(): Promise<void> {
    try {
      const data = await api('/api/battle-daily');
      dailyDate = data.date;
      dailyRounds = data.rounds;
      renderStats(data.stats, data.votesThisHour);
      document.getElementById('dailyShare')!.hidden = true;
      renderDailyPanel();
    } catch (error: any) {
      renderArenaError(document.getElementById('dailyArena')!, error.message || 'Failed to load today’s rounds', loadDaily);
    }
  }

  async function loadUnlimitedPair(): Promise<void> {
    const arena = document.getElementById('unlimitedArena')!;
    arena.innerHTML = '<div class="arena-loading"><span></span><p>Finding the next matchup…</p></div>';
    try {
      const data = await api('/api/battle-unlimited');
      renderUnlimitedPair(data);
    } catch (error: any) {
      unlimitedPair = null;
      renderArenaError(arena, error.message || 'Failed to load the next pair', loadUnlimitedPair);
    }
  }

  function renderUnlimitedPair(pair: { left: Candidate; right: Candidate; sponsoredSlot: boolean }): void {
    unlimitedPair = pair;
    const arena = document.getElementById('unlimitedArena')!;
    renderArena(arena, pair.left, pair.right);
    bindVoteCards(arena, handleUnlimitedVote);
  }

  async function handleUnlimitedVote(selectedId: number): Promise<void> {
    if (!unlimitedPair || unlimitedBusy) return;
    unlimitedBusy = true;
    const pair = unlimitedPair;
    const arena = document.getElementById('unlimitedArena')!;
    beginVote(arena, selectedId);
    try {
      const result: VoteResult = await api('/api/battle-guess', {
        method: 'POST',
        body: JSON.stringify({
          mode: 'unlimited',
          leftId: pair.left.id,
          rightId: pair.right.id,
          selectedId,
          sponsoredSlot: pair.sponsoredSlot,
        }),
      });
      revealVote(arena, result);
      renderStats(result, result.votes_this_hour);
      showToast(voteMessage(result), Math.max(1800, transitionDelay() - 150));

      // Fetch while the player reads the result, so the next pair can cross-fade in without
      // dropping back to a loading screen between every vote.
      const nextPair = api('/api/battle-unlimited')
        .then((pair) => ({ pair, failed: false }))
        .catch(() => ({ pair: null, failed: true }));
      transitionToNext(arena, async () => {
        try {
          const preloaded = await nextPair;
          if (preloaded.failed || !preloaded.pair) await loadUnlimitedPair();
          else renderUnlimitedPair(preloaded.pair);
        } finally {
          unlimitedBusy = false;
        }
      });
    } catch (error: any) {
      showToast(error.message || 'Something went wrong');
      resetVoteState(arena);
      bindVoteCards(arena, handleUnlimitedVote);
      unlimitedBusy = false;
    }
  }

  function renderPlayerLeaderboard(users: any[], scope: string): string {
    return users.map((user, index) => {
      const battles = Number(user.battles_played || 0);
      const wins = Number(user.battles_won || 0);
      const winRate = Number(user.win_rate_percent || 0);
      const isMe = user.user_id === myUserId;
      const avatarUrl = playerAvatarUrl(String(user.user_id || ''), user.avatar_url);
      return `<div class="lb-row ${isMe ? 'is-me' : ''}">
        <span class="lb-rank">#${index + 1}</span>
        <span class="lb-avatar"><img src="${escapeHtml(avatarUrl)}" alt="" loading="lazy" /></span>
        <span class="lb-identity">
          <span class="lb-name-line"><span class="lb-name">${escapeHtml(user.display_name || 'Player')}</span>${isMe ? ' <i class="lb-you">You</i><button class="lb-edit-profile" type="button">Edit</button>' : ''}</span>
          <span class="lb-meta">${battles.toLocaleString()} battles · ${winRate}% win rate${scope === 'users-daily' ? ` · ${Number(user.current_streak_days || 0)} day streak` : ''}</span>
        </span>
        <span class="lb-score"><strong>${wins.toLocaleString()}</strong><small>wins</small></span>
      </div>`;
    }).join('') || '<p class="lb-empty">No battles yet — take the first spot.</p>';
  }

  function selectAvatarStyle(style: number): void {
    selectedAvatarStyle = Math.min(Math.max(Math.trunc(style), 1), 8);
    document.querySelectorAll<HTMLInputElement>('input[name="avatarStyle"]').forEach((input) => {
      input.checked = Number(input.value) === selectedAvatarStyle;
    });
  }

  function closePlayerProfileEditor(): void {
    document.getElementById('playerProfileModal')!.hidden = true;
    document.body.style.removeProperty('overflow');
  }

  async function openPlayerProfileEditor(): Promise<void> {
    const modal = document.getElementById('playerProfileModal')!;
    const input = document.getElementById('playerNickname') as HTMLInputElement;
    const error = document.getElementById('profileFormError')!;
    error.hidden = true;
    input.value = currentUser?.name || '';
    selectAvatarStyle(avatarStyleFromUrl(currentUser?.avatar, myUserId || currentUser?.email || 'player'));
    modal.hidden = false;
    document.body.style.overflow = 'hidden';
    window.setTimeout(() => input.focus(), 0);

    try {
      const profile = await api('/api/battle-profile');
      input.value = profile.displayName || input.value;
      selectAvatarStyle(Number(profile.avatarStyle || selectedAvatarStyle));
      input.select();
    } catch (profileError: any) {
      error.textContent = profileError.message || 'Could not load your player profile';
      error.hidden = false;
    }
  }

  function syncStoredPlayerProfile(displayName: string, avatarUrl: string): void {
    if (currentUser) {
      currentUser.name = displayName;
      currentUser.avatar = avatarUrl;
      try { localStorage.setItem('fbf_user', JSON.stringify(currentUser)); } catch { /* noop */ }
    }
    window.dispatchEvent(new CustomEvent('fbf:profile-updated', {
      detail: { name: displayName, avatar: avatarUrl },
    }));
  }

  function initPlayerProfileEditor(): void {
    const modal = document.getElementById('playerProfileModal')!;
    const form = document.getElementById('playerProfileForm') as HTMLFormElement;
    const input = document.getElementById('playerNickname') as HTMLInputElement;
    const error = document.getElementById('profileFormError')!;
    const saveButton = document.getElementById('profileSaveButton') as HTMLButtonElement;

    document.getElementById('lbList')!.addEventListener('click', (event) => {
      if ((event.target as HTMLElement).closest('.lb-edit-profile')) openPlayerProfileEditor();
    });
    modal.querySelectorAll<HTMLElement>('[data-close-profile]').forEach((button) => {
      button.addEventListener('click', closePlayerProfileEditor);
    });
    document.addEventListener('keydown', (event) => {
      if (event.key === 'Escape' && !modal.hidden) closePlayerProfileEditor();
    });
    document.querySelectorAll<HTMLInputElement>('input[name="avatarStyle"]').forEach((radio) => {
      radio.addEventListener('change', () => selectAvatarStyle(Number(radio.value)));
    });

    form.addEventListener('submit', async (event) => {
      event.preventDefault();
      error.hidden = true;
      const displayName = input.value.trim().replace(/\s+/g, ' ');
      if (!form.reportValidity()) return;
      saveButton.disabled = true;
      saveButton.textContent = 'Saving…';
      try {
        const profile = await api('/api/battle-profile', {
          method: 'POST',
          body: JSON.stringify({ displayName, avatarStyle: selectedAvatarStyle }),
        });
        syncStoredPlayerProfile(profile.displayName, profile.avatarUrl);
        closePlayerProfileEditor();
        showToast('Creator Battle profile updated');
        await loadLeaderboard(activeLeaderboardScope);
      } catch (saveError: any) {
        error.textContent = saveError.message || 'Could not save your player profile';
        error.hidden = false;
      } finally {
        saveButton.disabled = false;
        saveButton.textContent = 'Save player profile';
      }
    });
  }

  function renderCreatorLeaderboard(creators: any[], startRank: number): string {
    return creators.map((creator, index) => {
      const rating = Math.round(Number(creator.rating || 1500));
      const wins = Number(creator.votes_received || 0);
      const appearances = Number(creator.appearances || 0);
      const losses = Number(creator.losses || 0);
      const winRate = Number(creator.win_rate_percent || 0);
      const rank = Number(creator.rank_position || startRank + index + 1);
      const profileUrl = `https://onlyfans.com/${encodeURIComponent(creator.username || '')}`;
      return `<div class="lb-row lb-creator-row">
        <span class="lb-rank">#${rank.toLocaleString()}</span>
        <span class="lb-avatar"><img src="${escapeHtml(proxyImg(creator.avatar_url, 96, 96))}" alt="" loading="lazy" referrerpolicy="no-referrer" onerror="this.onerror=null;this.src='/no-image.png';" /></span>
        <span class="lb-identity">
          <span class="lb-name">${escapeHtml(creator.display_name || creator.username || 'Creator')}</span>
          <span class="lb-meta">${wins.toLocaleString()} selections · ${appearances.toLocaleString()} battles · ${wins}–${losses} · ${winRate}%</span>
          <a class="lb-profile-link" href="${escapeHtml(profileUrl)}" target="_blank" rel="noopener nofollow">@${escapeHtml(creator.username || 'creator')} ↗</a>
        </span>
        <span class="lb-score elo"><strong>${rating.toLocaleString()}</strong><small>points</small></span>
      </div>`;
    }).join('') || '<p class="lb-empty">No creator rankings yet — cast the first vote.</p>';
  }

  function setCreatorLoadState(message: string, spinning: boolean, hidden: boolean): void {
    const loadMore = document.getElementById('lbLoadMore')!;
    document.getElementById('lbLoadMoreText')!.textContent = message;
    loadMore.classList.toggle('is-complete', !spinning);
    loadMore.classList.remove('has-error');
    loadMore.onclick = null;
    loadMore.querySelector<HTMLElement>('.lb-load-spinner')!.hidden = !spinning;
    loadMore.hidden = hidden;
  }

  function observeCreatorLoadMore(): void {
    if (!creatorLeaderboardHasMore || creatorLeaderboardLoading || activeLeaderboardScope !== 'creators') return;
    const loadMore = document.getElementById('lbLoadMore')!;
    creatorLeaderboardObserver?.disconnect();
    creatorLeaderboardObserver = new IntersectionObserver((entries) => {
      if (entries.some((entry) => entry.isIntersecting)) loadMoreCreators(leaderboardRequestId);
    }, { rootMargin: '650px 0px' });
    creatorLeaderboardObserver.observe(loadMore);
  }

  async function loadMoreCreators(requestId: number): Promise<void> {
    if (creatorLeaderboardLoading || !creatorLeaderboardHasMore || activeLeaderboardScope !== 'creators') return;
    creatorLeaderboardLoading = true;
    creatorLeaderboardObserver?.disconnect();
    setCreatorLoadState('Loading 50 more creators…', true, false);

    try {
      const startOffset = creatorLeaderboardOffset;
      const data = await api(`/api/battle-leaderboard?scope=creators&limit=${CREATOR_PAGE_SIZE}&offset=${startOffset}`);
      if (requestId !== leaderboardRequestId || activeLeaderboardScope !== 'creators') return;

      const creators = Array.isArray(data.creators) ? data.creators : [];
      const list = document.getElementById('lbList')!;
      if (creators.length) {
        list.insertAdjacentHTML('beforeend', renderCreatorLeaderboard(creators, startOffset));
      } else if (startOffset === 0) {
        list.innerHTML = '<p class="lb-empty">No creator rankings yet — cast the first vote.</p>';
      }

      creatorLeaderboardOffset = Number(data.nextOffset ?? startOffset + creators.length);
      creatorLeaderboardHasMore = Boolean(data.hasMore) && creators.length > 0;
      if (creatorLeaderboardHasMore) {
        setCreatorLoadState('Scroll to load 50 more creators', false, false);
      } else if (creatorLeaderboardOffset > 0) {
        setCreatorLoadState(`All ${creatorLeaderboardOffset.toLocaleString()} ranked creators loaded`, false, false);
      } else {
        setCreatorLoadState('', false, true);
      }
    } catch (error: any) {
      if (requestId !== leaderboardRequestId || activeLeaderboardScope !== 'creators') return;
      const loadMore = document.getElementById('lbLoadMore')!;
      creatorLeaderboardHasMore = false;
      setCreatorLoadState(error.message || 'Could not load more creators', false, false);
      loadMore.classList.add('has-error');
      loadMore.onclick = () => {
        loadMore.onclick = null;
        creatorLeaderboardHasMore = true;
        loadMoreCreators(requestId);
      };
    } finally {
      if (requestId === leaderboardRequestId) {
        creatorLeaderboardLoading = false;
        window.requestAnimationFrame(observeCreatorLoadMore);
      }
    }
  }

  async function loadLeaderboard(scope: string): Promise<void> {
    const list = document.getElementById('lbList')!;
    const caption = document.getElementById('lbCaption')!;
    const requestId = ++leaderboardRequestId;
    activeLeaderboardScope = scope;
    creatorLeaderboardObserver?.disconnect();
    creatorLeaderboardLoading = false;
    setCreatorLoadState('', false, true);

    if (scope === 'creators') {
      caption.textContent = 'Creators ranked by live points. Every selection moves both competitors.';
      list.innerHTML = '';
      creatorLeaderboardOffset = 0;
      creatorLeaderboardHasMore = true;
      await loadMoreCreators(requestId);
      return;
    }

    list.innerHTML = '<p class="lb-loading">Loading rankings…</p>';
    try {
      const data = await api(`/api/battle-leaderboard?scope=${encodeURIComponent(scope)}&limit=50`);
      if (requestId !== leaderboardRequestId || activeLeaderboardScope !== scope) return;
      if (scope === 'creators') {
        caption.textContent = 'Creators ranked by live points. Every selection moves both competitors.';
        list.innerHTML = renderCreatorLeaderboard(data.creators, 0);
      } else {
        caption.textContent = scope === 'users-daily'
          ? 'Today’s players ranked by battles won, then battles played.'
          : 'Unlimited players ranked by lifetime battles won, then battles played.';
        list.innerHTML = renderPlayerLeaderboard(data.users, scope);
      }
    } catch (error: any) {
      if (requestId !== leaderboardRequestId || activeLeaderboardScope !== scope) return;
      list.innerHTML = `<p class="lb-empty">${escapeHtml(error.message || 'Failed to load rankings')}</p>`;
    }
  }

  function initTabs(): void {
    document.querySelectorAll<HTMLButtonElement>('.battle-tab').forEach((tab) => {
      tab.addEventListener('click', () => {
        document.querySelectorAll('.battle-tab').forEach((item) => {
          item.classList.remove('active');
          item.setAttribute('aria-selected', 'false');
        });
        tab.classList.add('active');
        tab.setAttribute('aria-selected', 'true');
        const target = tab.dataset.tab;
        document.getElementById('panelDaily')!.hidden = target !== 'daily';
        document.getElementById('panelUnlimited')!.hidden = target !== 'unlimited';
        document.getElementById('panelLeaderboard')!.hidden = target !== 'leaderboard';
        document.getElementById('battleGuide')!.hidden = target === 'leaderboard';
        if (target === 'unlimited' && !unlimitedPair) loadUnlimitedPair();
        if (target === 'leaderboard' && !document.getElementById('lbList')!.childElementCount) {
          loadLeaderboard('users-daily');
        }
      });
    });

    document.querySelectorAll<HTMLButtonElement>('.lb-tab').forEach((tab) => {
      tab.addEventListener('click', () => {
        document.querySelectorAll('.lb-tab').forEach((item) => item.classList.remove('active'));
        tab.classList.add('active');
        loadLeaderboard(tab.dataset.lb!);
      });
    });

    document.getElementById('shareBtn')!.addEventListener('click', async () => {
      const streak = latestStats?.current_streak_days || 0;
      const text = `Creator Battle by findbyface — ${dailyDate}\n3 creator battles completed · ${streak}-day streak\nfindbyface.org/battle/`;
      if (navigator.share) {
        try {
          await navigator.share({ text });
          return;
        } catch {
          // A cancelled native share falls back to copying only when permission allows it.
        }
      }
      try {
        await navigator.clipboard.writeText(text);
        showToast('Result copied to clipboard');
      } catch {
        showToast('Could not copy — take a screenshot instead');
      }
    });
  }

  async function init(): Promise<void> {
    const gate = document.getElementById('battleGate')!;
    const main = document.getElementById('battleMain')!;
    currentUser = await getValidUser();
    if (!currentUser) {
      gate.hidden = false;
      main.hidden = true;
      return;
    }

    myUserId = decodeUserId(currentUser.access_token);
    gate.hidden = true;
    main.hidden = false;
    initTabs();
    initPlayerProfileEditor();
    try {
      const playerProfile = await api('/api/battle-profile');
      syncStoredPlayerProfile(playerProfile.displayName, playerProfile.avatarUrl);
    } catch {
      // The game remains playable if optional profile hydration is temporarily unavailable.
    }
    await loadDaily();
  }

  init();
</script>

