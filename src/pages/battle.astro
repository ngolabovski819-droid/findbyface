  .battle-header .battle-tagline { color: #d4d9ea; font-size: clamp(.92rem,2vw,1.05rem); font-weight: 760; }
  .battle-header .battle-intro { max-width: 630px; margin: 7px auto 0; color: var(--text-muted); font-size: .76rem; line-height: 1.65; }
  .battle-stats-row { display: flex; justify-content: center; gap: 9px; margin-bottom: 20px; flex-wrap: wrap; }
  .stat-pill { display: flex; min-width: 142px; min-height: 39px; padding: 0 14px; align-items: center; justify-content: center; gap: 7px; border: 1px solid rgba(139,151,190,.2); border-radius: 999px; background: rgba(18,19,28,.84); box-shadow: 0 8px 24px rgba(0,0,0,.16); }
  .stat-pill strong { color: #fff; font-size: .84rem; font-weight: 850; }
  .stat-pill > span:last-child { color: #85899a; font-size: .6rem; font-weight: 700; white-space: nowrap; }
  .stat-icon { color: #7da1ff; font-size: .85rem; }
  .stat-icon.dot { color: #3bb7ff; font-size: .55rem; text-shadow: 0 0 9px rgba(59,183,255,.8); }
  .stat-pill.streak .stat-icon { color: #ff9f45; }

  .battle-tabs { display: flex; width: max-content; margin: 0 auto 25px; padding: 4px; gap: 3px; border: 1px solid var(--border); border-radius: 13px; background: #0d0d14; }
  .battle-tab { min-height: 38px; padding: 0 22px; border: 0; border-radius: 9px; background: transparent; color: #77798a; cursor: pointer; font: 750 .76rem 'Inter',sans-serif; transition: color .18s,background .18s,transform .18s; }
  .battle-tab:hover { color: #c8cad3; }
  .battle-tab.active { background: linear-gradient(130deg,rgba(68,106,230,.27),rgba(141,69,201,.2)); color: #f3f5ff; box-shadow: inset 0 0 0 1px rgba(127,153,255,.12); }

  .mode-heading { display: flex; justify-content: space-between; margin: 0 auto 17px; align-items: end; gap: 18px; }
  .mode-heading > div { display: grid; gap: 3px; }
  .mode-heading span { color: #7d98e7; font-size: .62rem; font-weight: 800; letter-spacing: .1em; text-transform: uppercase; }
  .mode-heading strong { color: #e9eaf0; font-size: .9rem; }
  .mode-heading small { color: var(--text-muted); font-size: .7rem; }
  #panelUnlimited .mode-heading { width: min(100%,680px); margin-bottom: 10px; }
  #panelUnlimited .mode-heading small { text-align: right; }

  .round-progress { display: grid; grid-template-columns: repeat(3,1fr); gap: 9px; margin-bottom: 14px; }
  .round-step { display: flex; padding: 7px 10px; align-items: center; gap: 7px; border: 1px solid var(--border); border-radius: 9px; background: rgba(18,18,26,.66); color: #6f7282; font-size: .61rem; font-weight: 750; }
  .round-step i { width: 7px; height: 7px; border-radius: 50%; background: #454857; }
  .round-step.current { border-color: rgba(117,151,255,.4); color: #cbd7ff; }
  .round-step.current i { background: #6b96ff; box-shadow: 0 0 0 4px rgba(87,126,255,.13),0 0 10px rgba(87,126,255,.5); }
  .round-step.done { color: #9ea4b8; }
  .round-step.done i { background: #8d69df; }

  .vs-arena { position: relative; display: grid; width: min(100%,680px); margin-inline: auto; grid-template-columns: 1fr 1fr; gap: 26px; align-items: start; opacity: 1; transform: translateY(0) scale(1); transition: opacity .22s ease,transform .28s cubic-bezier(.2,.8,.2,1); }
  .vs-arena.is-entering { opacity: 0; transform: translateY(8px) scale(.992); }
  .vs-arena.is-leaving { opacity: 0; transform: translateY(-7px) scale(.994); pointer-events: none; }
  .vs-card-shell { min-width: 0; }
  .vs-card { position: relative; display: grid; width: 100%; padding: 0; overflow: hidden; border: 1px solid rgba(124,137,176,.25); border-radius: 18px; background: #13141d; color: var(--text); cursor: pointer; text-align: left; box-shadow: 0 15px 38px rgba(0,0,0,.22); transition: transform .2s cubic-bezier(.2,.8,.2,1),border-color .2s,box-shadow .2s,filter .35s,opacity .35s; }
  .vs-card:hover:not(:disabled) { transform: translateY(-5px); border-color: rgba(119,153,255,.66); box-shadow: 0 22px 50px rgba(0,0,0,.32),0 0 0 3px rgba(85,122,235,.08); }
  .vs-card:focus-visible, .profile-link:focus-visible { outline: 3px solid rgba(112,151,255,.72); outline-offset: 3px; }
  .vs-card:disabled { cursor: default; }
  .vs-media { position: relative; display: block; aspect-ratio: 4/5; overflow: hidden; background: #191a24; }
  .vs-media img { width: 100%; height: 100%; display: block; object-fit: cover; transition: transform .75s cubic-bezier(.2,.75,.2,1),filter .35s; }
  .vs-card:hover:not(:disabled) .vs-media img { transform: scale(1.025); }
  .card-shade { position: absolute; inset: auto 0 0; height: 22%; background: linear-gradient(transparent,rgba(7,8,13,.46)); pointer-events: none; }
  .vs-ad-badge { position: absolute; top: 11px; left: 11px; padding: 4px 8px; border: 1px solid rgba(255,255,255,.17); border-radius: 999px; background: rgba(10,10,16,.76); color: #e9c4ff; font-size: .5rem; font-weight: 800; letter-spacing: .06em; text-transform: uppercase; backdrop-filter: blur(8px); }
  .vs-info { display: flex; min-height: 72px; padding: 14px 16px; align-items: center; justify-content: space-between; gap: 10px; }
  .creator-copy { display: grid; min-width: 0; gap: 3px; }
  .vs-name { overflow: hidden; color: #f1f2f6; font-size: .92rem; font-weight: 800; text-overflow: ellipsis; white-space: nowrap; }
  .vs-handle { overflow: hidden; color: #777b8d; font-size: .66rem; text-overflow: ellipsis; white-space: nowrap; }
  .vote-cta { flex: 0 0 auto; padding: 6px 9px; border: 1px solid rgba(121,147,222,.22); border-radius: 999px; color: #91abf7; font-size: .58rem; font-weight: 800; letter-spacing: .06em; text-transform: uppercase; transition: background .2s,color .2s; }
  .vs-card:hover:not(:disabled) .vote-cta { background: #7295f0; color: #0b1020; }
  .profile-link { display: flex; min-height: 38px; margin-top: 8px; align-items: center; justify-content: center; gap: 7px; border: 1px solid rgba(124,137,176,.22); border-radius: 999px; background: rgba(15,16,23,.64); color: #858999; font-size: .65rem; font-weight: 650; text-decoration: none; transition: color .18s,border-color .18s,background .18s; }
  .profile-link:hover { border-color: rgba(123,151,231,.42); background: rgba(32,38,57,.72); color: #ccd7f9; }
  .profile-link svg { width: 13px; height: 13px; fill: none; stroke: currentColor; stroke-linecap: round; stroke-width: 1.6; }
  .vs-medallion { position: absolute; z-index: 5; top: 40%; left: 50%; display: grid; width: 58px; height: 58px; transform: translate(-50%,-50%); place-items: center; border: 5px solid #10111a; border-radius: 50%; background: linear-gradient(145deg,#4f83ff,#a751dc); color: #fff; box-shadow: 0 10px 30px rgba(49,93,222,.42); }
  .vs-medallion span { font: 900 .88rem 'Manrope',sans-serif; font-style: italic; letter-spacing: -.05em; }

  .points-burst { position: absolute; z-index: 4; top: 50%; left: 50%; display: grid; opacity: 0; transform: translate(-50%,-25%) scale(.72); place-items: center; pointer-events: none; text-shadow: 0 5px 22px rgba(0,0,0,.78); }
  .points-burst strong { color: #78f3b2; font: 950 clamp(2.25rem,6vw,3.8rem) 'Manrope',sans-serif; letter-spacing: -.065em; line-height: .95; }
  .points-burst span { margin-top: 5px; padding: 4px 10px; border: 1px solid rgba(255,255,255,.14); border-radius: 999px; background: rgba(7,10,15,.86); color: #edf3ff; font-size: .58rem; font-weight: 950; letter-spacing: .14em; }
  .is-other .points-burst strong { color: #ff8ca3; }
  .rating-reveal { position: absolute; z-index: 3; right: 10px; bottom: 82px; left: 10px; display: grid; grid-template-columns: 1fr 1fr; padding: 10px 12px; opacity: 0; column-gap: 12px; row-gap: 7px; border: 1px solid rgba(255,255,255,.17); border-radius: 12px; background: rgba(9,10,16,.9); box-shadow: 0 10px 28px rgba(0,0,0,.28); backdrop-filter: blur(10px); transform: translateY(8px); }
  .rating-reveal .result-label { grid-column: 1/-1; color: #aab1c5; font-size: .53rem; font-weight: 900; letter-spacing: .1em; text-transform: uppercase; }
  .result-metric { display: grid; min-width: 0; gap: 1px; }
  .rating-reveal .result-metric strong { overflow: hidden; color: #fff; font-size: .93rem; line-height: 1.1; text-overflow: ellipsis; white-space: nowrap; }
  .rating-reveal .rank-metric strong { color: #c6d4ff; font-size: 1.36rem; font-weight: 950; letter-spacing: -.045em; }
  .rating-reveal .result-metric small { color: #858a9b; font-size: .5rem; font-weight: 800; letter-spacing: .04em; text-transform: uppercase; }
  .points-metric { align-content: center; justify-items: end; }
  .points-change { display: inline-flex; min-height: 34px; padding: 5px 11px; align-items: baseline; gap: 5px; border: 1px solid transparent; border-radius: 999px; line-height: 1; text-transform: uppercase; }
  .rating-reveal .points-change strong { color: #fff; font-size: 1.24rem; font-weight: 950; letter-spacing: -.045em; }
  .rating-reveal .points-change small { color: inherit; font-size: .49rem; font-weight: 950; letter-spacing: .09em; }
  .points-change.gain { border-color: rgba(83,255,169,.68); background: linear-gradient(135deg,#079b54,#17cf74); box-shadow: 0 6px 20px rgba(23,207,116,.34),inset 0 1px rgba(255,255,255,.2); color: #f3fff8; }
  .points-change.loss { border-color: rgba(255,116,139,.68); background: linear-gradient(135deg,#ca2947,#f24762); box-shadow: 0 6px 20px rgba(242,71,98,.32),inset 0 1px rgba(255,255,255,.18); color: #fff7f8; }
  .vs-card.is-selected { border-color: rgba(78,226,153,.72); box-shadow: 0 20px 55px rgba(22,165,105,.18),0 0 0 3px rgba(59,221,147,.11); animation: selected-card .7s cubic-bezier(.18,.9,.25,1); }
  .vs-card.is-other { opacity: .72; border-color: rgba(239,96,124,.36); animation: other-card .55s ease; }
  .vs-card.is-other .vs-media img { filter: saturate(.7) brightness(.76); }
  .vs-card.is-pending-pick { border-color: rgba(78,226,153,.72); box-shadow: 0 20px 55px rgba(22,165,105,.18),0 0 0 3px rgba(59,221,147,.11); animation: vote-lock .28s cubic-bezier(.18,.9,.25,1); }
  .vs-card.is-pending-other { opacity: .68; filter: saturate(.72) brightness(.8); }
  .vs-card.is-pending-pick .vote-cta { border-color: rgba(78,226,153,.5); background: rgba(25,174,107,.18); color: #79efb4; }
  .vs-card.is-pending-pick .rating-reveal { opacity: 1; transform: translateY(0); transition: opacity .12s ease,transform .2s cubic-bezier(.18,.9,.25,1); }
  .rating-reveal.is-pending { grid-template-columns: 1fr; }
  .result-resolving { display: flex; grid-column: 1/-1; min-height: 30px; align-items: center; gap: 8px; color: #effff7; }
  .result-resolving i { width: 14px; height: 14px; flex: 0 0 auto; border: 2px solid rgba(93,239,173,.24); border-top-color: #6ceaae; border-radius: 50%; animation: spin .6s linear infinite; }
  .result-resolving strong { font-size: .72rem !important; letter-spacing: -.01em !important; }
  .vs-card.is-selected .points-burst, .vs-card.is-other .points-burst { animation: points-burst 1.15s .05s cubic-bezier(.18,.9,.25,1) both; }
  .vs-card.is-selected .rating-reveal, .vs-card.is-other .rating-reveal { opacity: 1; transform: translateY(0); transition: opacity .28s .12s ease,transform .36s .12s cubic-bezier(.18,.9,.25,1); }
  .vs-card.is-selected .points-change, .vs-card.is-other .points-change { animation: points-chip .52s .2s cubic-bezier(.18,.9,.25,1) both; }
  .vs-arena.is-upset .vs-card.is-selected { animation: upset-card .8s cubic-bezier(.18,.9,.25,1); box-shadow: 0 22px 65px rgba(151,79,235,.3),0 0 0 3px rgba(172,95,244,.2); }
  .vs-arena.is-upset .vs-card.is-selected .points-burst strong { color: #ddb0ff; }
  .vs-arena.is-resolving .vs-medallion { animation: medallion-pulse .55s ease; }
  .vs-arena.is-submitting .vs-medallion { animation: medallion-wait .8s ease-in-out infinite alternate; }

  .arena-loading, .arena-error { display: grid; min-height: 430px; padding: 50px 30px; place-items: center; align-content: center; gap: 14px; border: 1px dashed var(--border); border-radius: 18px; background: rgba(18,18,26,.48); color: var(--text-muted); text-align: center; }
  .arena-loading span { width: 26px; height: 26px; border: 2px solid rgba(113,145,238,.2); border-top-color: #789cff; border-radius: 50%; animation: spin .75s linear infinite; }
  .arena-loading p, .arena-error p { color: var(--text-muted); font-size: .78rem; }

  .battle-guide { width: min(960px,calc(100% - 36px)); margin: 64px auto 0; padding-top: 52px; border-top: 1px solid rgba(124,137,176,.18); }
  .guide-header { max-width: 620px; margin: 0 auto 28px; text-align: center; }
  .guide-kicker, .guide-card-label { color: #849ff0; font-size: .6rem; font-weight: 900; letter-spacing: .13em; text-transform: uppercase; }
  .guide-header h2 { margin: 5px 0 7px; color: #f2f3f8; font-size: clamp(1.45rem,3vw,2rem); letter-spacing: -.045em; }
  .guide-header p { color: #898da0; font-size: .78rem; }
  .guide-loop { display: grid; grid-template-columns: 1fr auto 1fr auto 1fr; align-items: stretch; gap: 10px; }
  .guide-loop article { display: flex; min-width: 0; padding: 16px; align-items: flex-start; gap: 12px; border: 1px solid rgba(126,145,198,.18); border-radius: 15px; background: linear-gradient(145deg,rgba(24,26,38,.82),rgba(14,15,23,.92)); }
  .guide-step { display: grid; width: 29px; height: 29px; flex: 0 0 29px; place-items: center; border: 1px solid rgba(119,151,255,.32); border-radius: 9px; background: rgba(73,105,210,.14); color: #9eb6ff; font-size: .56rem; font-weight: 900; }
  .guide-loop article > div { display: grid; gap: 3px; }
  .guide-loop strong { color: #eef0f6; font-size: .73rem; }
  .guide-loop p { color: #868a9b; font-size: .62rem; line-height: 1.55; }
  .guide-arrow { display: grid; place-items: center; color: #4c5266; font-size: .85rem; }

  .guide-feature-grid { display: grid; margin-top: 14px; grid-template-columns: 1.25fr .85fr; gap: 14px; }
  .guide-feature { position: relative; padding: 25px; overflow: hidden; border: 1px solid rgba(126,145,198,.2); border-radius: 18px; background: #11121b; }
  .guide-feature::before { position: absolute; top: -90px; right: -65px; width: 220px; height: 220px; border-radius: 50%; background: rgba(82,115,225,.1); content: ''; filter: blur(18px); pointer-events: none; }
  .guide-feature h3 { position: relative; margin: 5px 0 7px; color: #f1f2f7; font-size: 1.02rem; letter-spacing: -.025em; }
  .guide-feature > p { position: relative; color: #9296a7; font-size: .7rem; line-height: 1.65; }
  .points-example { position: relative; display: grid; margin: 18px 0 17px; grid-template-columns: 1fr auto 1fr; align-items: center; gap: 10px; }
  .points-example > span { display: grid; padding: 11px 13px; gap: 2px; border: 1px solid rgba(255,255,255,.08); border-radius: 12px; background: rgba(6,8,13,.58); }
  .points-example > span:last-child { text-align: right; }
  .points-example small { color: #74798c; font-size: .5rem; font-weight: 850; letter-spacing: .08em; text-transform: uppercase; }
  .points-example strong { font: 900 1.05rem 'Manrope',sans-serif; letter-spacing: -.035em; }
  .points-example i { color: #626a80; font-style: normal; }
  .example-gain { color: #45e693; }
  .example-loss { color: #ff6f88; }
  .guide-feature ul { display: grid; padding: 0; gap: 7px; list-style: none; }
  .guide-feature li { position: relative; padding-left: 14px; color: #8d91a2; font-size: .65rem; line-height: 1.55; }
  .guide-feature li::before { position: absolute; top: .58em; left: 0; width: 5px; height: 5px; border-radius: 50%; background: #7798f4; content: ''; box-shadow: 0 0 9px rgba(119,152,244,.55); }
  .guide-feature li strong { color: #cdd6f4; }
  .record-example { position: relative; display: grid; margin: 18px 0 13px; gap: 8px; }
  .record-example span { display: grid; padding: 11px 13px; gap: 1px; border: 1px solid rgba(129,146,198,.14); border-radius: 11px; background: rgba(8,9,15,.58); }
  .record-example strong { color: #dfe5f8; font-size: .69rem; }
  .record-example small { color: #7f8394; font-size: .57rem; }
  .guide-feature .guide-note { padding: 10px 11px; border-left: 2px solid #6e8fe9; border-radius: 0 8px 8px 0; background: rgba(70,98,181,.09); color: #aab5d7; font-size: .61rem; }

  .guide-rules-grid { display: grid; margin-top: 14px; grid-template-columns: repeat(3,1fr); gap: 10px; }
  .guide-rules-grid article { min-width: 0; padding: 18px; border: 1px solid rgba(126,145,198,.16); border-radius: 15px; background: rgba(16,17,26,.78); }
  .rule-icon { display: grid; width: 28px; height: 28px; margin-bottom: 10px; place-items: center; border: 1px solid rgba(118,151,247,.28); border-radius: 9px; background: rgba(72,105,207,.13); color: #9cb5ff; font-size: .73rem; font-weight: 900; }
  .daily-icon { color: #d5b3ff; }
  .unlimited-icon { color: #73d5ff; font-size: 1rem; }
  .streak-icon { color: #ffaf5e; }
  .guide-rules-grid h3 { margin-bottom: 4px; color: #e7e9f1; font-size: .78rem; }
  .guide-rules-grid p { color: #85899a; font-size: .62rem; line-height: 1.6; }
  .guide-footer { display: grid; margin-top: 14px; padding: 16px 18px; grid-template-columns: repeat(2,1fr); gap: 12px 22px; border: 1px solid rgba(126,145,198,.14); border-radius: 14px; background: rgba(10,11,18,.7); }
  .guide-footer p { color: #777c8e; font-size: .58rem; line-height: 1.6; }
  .guide-footer strong { color: #aeb8d7; }

  .share-card { padding: 43px 30px; border: 1px solid rgba(112,147,255,.28); border-radius: 20px; background: radial-gradient(circle at 50% 0,rgba(74,111,223,.15),transparent 48%),linear-gradient(150deg,rgba(24,27,42,.94),rgba(14,14,21,.98)); text-align: center; }
  .completion-icon { display: grid; width: 48px; height: 48px; margin: 0 auto 15px; place-items: center; border: 1px solid rgba(126,155,255,.3); border-radius: 15px; background: rgba(73,104,211,.16); color: #91adff; }
  .share-card h3 { margin: 8px 0 8px; color: #f3f4f8; font-size: 1.35rem; }
  .share-card > p:not(.share-hint) { margin-bottom: 22px; color: #b6bac8; font-size: .82rem; font-weight: 700; }
  .share-hint { max-width: 480px; margin: 16px auto 0; color: var(--text-muted); font-size: .7rem; line-height: 1.55; }

  .primary-button { display: inline-flex; min-height: 43px; padding: 0 22px; align-items: center; justify-content: center; gap: 9px; border: 0; border-radius: 999px; background: linear-gradient(120deg,#537fea,#a449cf); color: #fff; box-shadow: 0 10px 28px rgba(71,93,208,.25); cursor: pointer; font-size: .79rem; font-weight: 800; text-decoration: none; }
  .primary-button:hover { filter: brightness(1.08); }

  .lb-tabs { display: flex; justify-content: center; gap: 7px; margin-bottom: 18px; flex-wrap: wrap; }
  .lb-tab { min-height: 34px; padding: 0 15px; border: 1px solid var(--border); border-radius: 999px; background: rgba(18,18,26,.84); color: var(--text-muted); cursor: pointer; font: 700 .69rem 'Inter',sans-serif; }
  .lb-tab.active { border-color: rgba(117,150,244,.5); background: rgba(77,107,203,.18); color: #f1f4ff; }
  .lb-caption { max-width: 580px; margin: 0 auto 18px; color: var(--text-muted); font-size: .72rem; line-height: 1.5; text-align: center; }
  .lb-list { display: grid; gap: 8px; }
  .lb-row { display: grid; grid-template-columns: 42px 44px minmax(0,1fr) auto; min-height: 68px; padding: 10px 14px; align-items: center; gap: 12px; border: 1px solid var(--border); border-radius: 14px; background: rgba(18,18,26,.84); transition: border-color .18s,transform .18s; }
  .lb-row:hover { border-color: rgba(116,143,220,.35); transform: translateY(-1px); }
  .lb-row.is-me { border-color: rgba(116,149,245,.56); background: rgba(62,88,170,.12); }
  .lb-rank { color: #737789; font-size: .74rem; font-weight: 850; }
  .lb-row:nth-child(1) .lb-rank { color: #f3c85e; }
  .lb-row:nth-child(2) .lb-rank { color: #c7cede; }
  .lb-row:nth-child(3) .lb-rank { color: #cf956f; }
  .lb-avatar { width: 44px; height: 44px; overflow: hidden; border: 1px solid rgba(255,255,255,.08); border-radius: 50%; background: var(--surface-raised); }
  .lb-avatar img { width: 100%; height: 100%; object-fit: cover; }
  .lb-identity { display: grid; min-width: 0; gap: 3px; }
  .lb-name-line { display: flex; min-width: 0; align-items: center; gap: 6px; }
  .lb-name { overflow: hidden; color: var(--text); font-size: .8rem; font-weight: 760; text-overflow: ellipsis; white-space: nowrap; }
  .lb-meta { overflow: hidden; color: #777b8c; font-size: .62rem; text-overflow: ellipsis; white-space: nowrap; }
  .lb-you { margin-left: 4px; padding: 2px 6px; border-radius: 999px; background: rgba(92,126,229,.2); color: #b9caff; font-size: .5rem; font-style: normal; font-weight: 850; text-transform: uppercase; }
  .lb-edit-profile { flex: 0 0 auto; padding: 2px 7px; border: 1px solid rgba(128,153,230,.3); border-radius: 999px; background: rgba(76,102,181,.12); color: #aebfff; cursor: pointer; font: 800 .5rem 'Inter',sans-serif; text-transform: uppercase; }
  .lb-edit-profile:hover { border-color: rgba(144,168,244,.62); background: rgba(76,102,181,.24); color: #e1e7ff; }
  .lb-profile-link { width: max-content; color: #899fdc; font-size: .59rem; font-weight: 700; text-decoration: none; }
  .lb-profile-link:hover { color: #c7d4ff; }
  .lb-score { display: grid; min-width: 54px; justify-items: end; }
  .lb-score strong { color: #eef1f8; font-size: .87rem; }
