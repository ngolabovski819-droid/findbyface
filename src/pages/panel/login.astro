---
import PanelLayout from '../../layouts/PanelLayout.astro';
---
<PanelLayout title="Client Panel Login — findbyface">
  <main class="panel-login-page">
    <div class="login-glow" aria-hidden="true"></div>
    <section class="login-card">
      <header>
        <h1>Client Panel</h1>
        <p>Sign in to view your performance dashboard.</p>
      </header>
      {import.meta.env.DEV && (
        <button type="button" id="panelLocalAdminLogin" class="local-admin-login">
          Open local admin queue
        </button>
      )}
      <button type="button" id="panelGoogleLogin" class="google-login">
        <svg viewBox="0 0 24 24" aria-hidden="true"><path fill="currentColor" d="M21.6 12.2c0-.7-.1-1.4-.2-2H12v3.9h5.4a4.6 4.6 0 0 1-2 3v2.5h3.3c1.9-1.8 2.9-4.4 2.9-7.4Z"/><path fill="currentColor" d="M12 22c2.7 0 5-.9 6.7-2.4l-3.3-2.5c-.9.6-2.1 1-3.4 1-2.6 0-4.8-1.8-5.6-4.1H3v2.6A10 10 0 0 0 12 22Z"/><path fill="currentColor" d="M6.4 14a6 6 0 0 1 0-3.9V7.4H3a10 10 0 0 0 0 9.2L6.4 14Z"/><path fill="currentColor" d="M12 5.9c1.5 0 2.8.5 3.8 1.5l2.9-2.8A9.7 9.7 0 0 0 3 7.4l3.4 2.7C7.2 7.7 9.4 5.9 12 5.9Z"/></svg>
        <span id="panelGoogleLabel">Continue with Google</span>
      </button>
      <div class="login-divider"><span>or use a panel password</span></div>
      <form id="panelLoginForm" novalidate>
        <label>
          <span>Email address</span>
          <input id="panelEmail" name="email" type="email" autocomplete="email" required />
        </label>
        <label>
          <span>Password</span>
          <input id="panelPassword" name="password" type="password" autocomplete="current-password" required />
        </label>
        <div class="login-message" id="loginMessage" role="alert" hidden></div>
        <div id="loginTurnstile"></div>
        <button type="submit" id="loginSubmit">Log in</button>
      </form>
    </section>
  </main>
</PanelLayout>

<script is:inline>
  // See src/pages/contact.astro for why this ready-queue exists instead of an immediate call
  // or a DOMContentLoaded listener — Cloudflare's async script isn't guaranteed to be loaded
  // by either point, so onload=onTurnstileLoad (Cloudflare's own ready-signal) is what's used.
  window.__turnstileReady = window.__turnstileReady || [];
  window.onTurnstileLoad = window.onTurnstileLoad || function () {
    window.__turnstileReady.splice(0).forEach(function (fn) { fn(); });
  };
</script>
<script is:inline src="https://challenges.cloudflare.com/turnstile/v0/api.js?render=explicit&onload=onTurnstileLoad" async defer></script>
<script>
  const TURNSTILE_SITE_KEY = import.meta.env.PUBLIC_TURNSTILE_SITE_KEY;

  const form = document.getElementById('panelLoginForm') as HTMLFormElement;
  const message = document.getElementById('loginMessage')!;
  const submitBtn = document.getElementById('loginSubmit') as HTMLButtonElement;
  const googleBtn = document.getElementById('panelGoogleLogin') as HTMLButtonElement;
  const googleLabel = document.getElementById('panelGoogleLabel')!;
  const localAdminBtn = document.getElementById('panelLocalAdminLogin') as HTMLButtonElement | null;

  let turnstileWidgetId: string | undefined;
  function renderTurnstile(): void {
    const turnstile = (window as typeof window & { turnstile?: any }).turnstile;
    if (!turnstile || !TURNSTILE_SITE_KEY || turnstileWidgetId) return;
    turnstileWidgetId = turnstile.render('#loginTurnstile', { sitekey: TURNSTILE_SITE_KEY });
  }
  if ((window as typeof window & { turnstile?: any }).turnstile) renderTurnstile();
  else (window as any).__turnstileReady.push(renderTurnstile);

  function showError(text: string): void {
    message.textContent = text;
    message.hidden = false;
  }

  function panelDestination(): string {
    const host = window.location.hostname;
    const onPanelHost = host === 'panel.findbyface.org' || host === 'panel.localhost';
    return onPanelHost ? '/comments/' : '/panel/comments/';
  }

  function beginGoogleLogin(): void {
    if (window.location.hostname === 'panel.findbyface.org') {
      window.location.href = 'https://findbyface.org/panel/login/?google=1';
      return;
    }
    if (window.location.hostname === 'panel.localhost') {
      const port = window.location.port ? `:${window.location.port}` : '';
      window.location.href = `${window.location.protocol}//localhost${port}/panel/login/?google=1`;
      return;
    }
    const returnTo = '/panel/login/?connect=1';
    try { localStorage.setItem('fbf_auth_return', returnTo); } catch { /* storage unavailable */ }
    const callbackUrl = `${window.location.origin}/auth/callback`;
    window.location.href = `https://sirudrqheimbgpkchtwi.supabase.co/auth/v1/authorize?provider=google&redirect_to=${encodeURIComponent(callbackUrl)}`;
  }

  async function continueWithGoogle(returnedFromOAuth = false): Promise<void> {
    message.hidden = true;
    googleBtn.disabled = true;
    googleLabel.textContent = 'Connecting...';
    try {
      let saved: { access_token?: string; refresh_token?: string } | null = null;
      try { saved = JSON.parse(localStorage.getItem('fbf_user') || 'null'); } catch { /* invalid storage */ }
      if (!saved?.access_token || !saved.refresh_token) {
        if (!returnedFromOAuth) return beginGoogleLogin();
        showError('Google sign-in did not complete. Please try again.');
        return;
      }

      const response = await fetch('/api/panel/session', {
        method: 'POST',
        headers: { 'Content-Type': 'application/json' },
        body: JSON.stringify({ access_token: saved.access_token, refresh_token: saved.refresh_token }),
      });
      const payload = await response.json();
      if (!response.ok) {
        if (response.status === 401 && !returnedFromOAuth) return beginGoogleLogin();
        showError(payload.error || 'Could not open the admin panel.');
        return;
      }
      if (payload.consumerSession?.access_token && payload.consumerSession?.refresh_token) {
        try {
          localStorage.setItem('fbf_user', JSON.stringify({
            ...saved,
            access_token: payload.consumerSession.access_token,
            refresh_token: payload.consumerSession.refresh_token,
            expires_at: Date.now() + Number(payload.consumerSession.expires_in || 3600) * 1000,
          }));
        } catch { /* panel cookies are already set; consumer storage is best-effort */ }
      }
      window.location.href = panelDestination();
    } catch {
      showError('Something went wrong. Try again.');
    } finally {
      googleBtn.disabled = false;
      googleLabel.textContent = 'Continue with Google';
    }
  }

  async function openLocalAdmin(): Promise<void> {
    if (!localAdminBtn) return;
    message.hidden = true;
    localAdminBtn.disabled = true;
    localAdminBtn.textContent = 'Opening admin queue...';
    try {
      const response = await fetch('/api/panel/dev-login', {
        method: 'POST',
        headers: { 'Content-Type': 'application/json' },
        body: '{}',
      });
      const payload = await response.json();
      if (!response.ok) {
        showError(payload.error || 'Could not open the local admin panel.');
        return;
      }
      window.location.href = panelDestination();
    } catch {
      showError('Something went wrong. Try again.');
    } finally {
      localAdminBtn.disabled = false;
      localAdminBtn.textContent = 'Open local admin queue';
    }
  }

  googleBtn.addEventListener('click', () => { void continueWithGoogle(false); });
  localAdminBtn?.addEventListener('click', () => { void openLocalAdmin(); });
  const panelLoginParams = new URLSearchParams(window.location.search);
  if (panelLoginParams.get('local') === '1' && localAdminBtn) {
    void openLocalAdmin();
  } else if (panelLoginParams.get('google') === '1') {
    void continueWithGoogle(false);
  } else if (panelLoginParams.get('connect') === '1') {
    void continueWithGoogle(true);
  }

  form.addEventListener('submit', async (event) => {
    event.preventDefault();
    message.hidden = true;
    submitBtn.disabled = true;
    submitBtn.textContent = 'Signing in…';
    try {
      const email = (document.getElementById('panelEmail') as HTMLInputElement).value.trim();
      const password = (document.getElementById('panelPassword') as HTMLInputElement).value;
      const turnstileToken = turnstileWidgetId
        ? (window as typeof window & { turnstile?: any }).turnstile?.getResponse(turnstileWidgetId)
        : undefined;
      const response = await fetch('/api/panel/login', {
        method: 'POST',
        headers: { 'Content-Type': 'application/json' },
        body: JSON.stringify({ email, password, turnstileToken }),
      });
      const payload = await response.json();
      if (!response.ok) {
        showError(payload.error || 'Could not sign in.');
        if (turnstileWidgetId) (window as typeof window & { turnstile?: any }).turnstile?.reset(turnstileWidgetId);
        return;
      }
      window.location.href = panelDestination();
    } catch {
      showError('Something went wrong. Try again.');
    } finally {
      submitBtn.disabled = false;
      submitBtn.textContent = 'Log in';
    }
  });
</script>

<style>
  .panel-login-page { position: relative; min-height: calc(100vh - 60px); display: grid; place-items: center; padding: 40px 20px; overflow: hidden; }
  .login-glow { position: absolute; width: 420px; height: 420px; border-radius: 50%; background: radial-gradient(circle, rgba(139,64,225,.22), transparent 68%); filter: blur(16px); }
  .login-card { position: relative; width: min(400px, 100%); padding: 36px 32px; border: 1px solid var(--border); border-radius: var(--radius-lg); background: linear-gradient(150deg, rgba(31,20,47,.96), rgba(15,14,22,.96)); box-shadow: 0 35px 100px rgba(0,0,0,.42); }
  .login-card h1 { font-size: 1.6rem; margin-bottom: 6px; }
  .login-card > header p { color: var(--text-muted); font-size: 0.85rem; margin-bottom: 26px; }
  #panelLoginForm { display: grid; gap: 16px; }
  .local-admin-login {
    width: 100%; height: 46px; margin-bottom: 12px; border-radius: 999px;
    border: 1px solid rgba(87,238,163,.35); background: rgba(87,238,163,.1);
    color: #8ff4bd; font-family: inherit; font-size: .9rem; font-weight: 800; cursor: pointer;
  }
  .local-admin-login:hover:not(:disabled) { background: rgba(87,238,163,.16); }
  .local-admin-login:disabled { opacity: .7; cursor: default; }
  .google-login {
    width: 100%; height: 46px; display: flex; align-items: center; justify-content: center; gap: 10px;
    border-radius: 999px; border: 1px solid rgba(255,255,255,.16); background: #fff;
    color: #17131f; font-family: inherit; font-size: .9rem; font-weight: 800; cursor: pointer;
    transition: transform .2s, box-shadow .2s;
  }
  .google-login svg { width: 19px; height: 19px; color: #4285f4; }
  .google-login:hover:not(:disabled) { transform: translateY(-1px); box-shadow: 0 8px 24px rgba(0,0,0,.25); }
  .google-login:disabled { opacity: .7; cursor: default; }
  .login-divider { display: flex; align-items: center; gap: 10px; margin: 18px 0; color: var(--text-muted); font-size: .72rem; }
  .login-divider::before, .login-divider::after { content: ''; height: 1px; flex: 1; background: var(--border); }
  label { display: grid; gap: 6px; font-size: 0.8rem; font-weight: 600; color: var(--text-muted); }
  input {
    height: 44px; padding: 0 14px; border-radius: 10px;
    border: 1px solid var(--border); background: rgba(255,255,255,0.03);
    color: var(--text); font-size: 0.9rem; font-family: inherit;
  }
  input:focus { outline: none; border-color: var(--accent-light); }
  .login-message { padding: 10px 12px; border-radius: 8px; background: rgba(244,63,94,0.12); border: 1px solid rgba(244,63,94,0.3); color: #fca5a5; font-size: 0.8rem; }
  button[type="submit"] {
    height: 46px; border-radius: 999px; border: none; margin-top: 4px;
    background: linear-gradient(135deg, var(--accent), var(--accent-pink));
    color: #fff; font-weight: 800; font-size: 0.9rem; cursor: pointer; font-family: inherit;
    transition: transform 0.2s, box-shadow 0.2s;
  }
  button[type="submit"]:hover:not(:disabled) { transform: translateY(-1px); box-shadow: 0 8px 24px rgba(124,58,237,.35); }
  button[type="submit"]:disabled { opacity: 0.7; cursor: default; }
</style>
