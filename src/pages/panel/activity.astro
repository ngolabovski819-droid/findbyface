---
import PanelLayout from '../../layouts/PanelLayout.astro';
import { getActivityLog } from '../../lib/panelStats';
import { resolveClientSlug } from '../../lib/panelAuth';
import { getPanelClient, panelClients, DEFAULT_CLIENT_SLUG, type ModelOption } from '../../config/panelClients';

const session = Astro.locals.panelUser!;
const isAdmin = session.role === 'admin';
// 'all' is an admin-only sentinel meaning "every configured client, combined" — resolveClientSlug
// lets it through unvalidated for admin (it doesn't check against panelClients), and a guest can
// never land on it since resolveClientSlug only ever returns a slug from their own clientSlugs.
const clientSlug = resolveClientSlug(session, Astro.url.searchParams.get('client'), DEFAULT_CLIENT_SLUG);
const isAllModels = isAdmin && clientSlug === 'all';
const client = isAllModels ? null : getPanelClient(clientSlug);

// Admin gets an explicit switcher (every configured client + "All models") since, unlike a
// guest, admin isn't scoped to a fixed clientSlugs list for PanelLayout to derive tabs from.
const adminSwitcherOptions: ModelOption[] | undefined = isAdmin
  ? [{ slug: 'all', displayName: 'All models' }, ...Object.entries(panelClients).map(([slug, c]) => ({ slug, displayName: c.displayName }))]
  : undefined;

const log = await getActivityLog(
  isAllModels ? Object.keys(panelClients) : clientSlug,
  { includeIp: isAdmin, includeLocation: isAdmin, includeSignals: isAdmin },
);

function formatLocation(city: string | null, country: string | null): string {
  if (city && country) return `${city}, ${country}`;
  return city || country || '—';
}

function modelDisplayName(slug: string): string {
  return getPanelClient(slug)?.displayName ?? slug;
}

// A raw UA string is 100-150+ characters — never going to fit a table cell. Parses out just
// "Browser X on OS Y" for the visible cell; the full raw string stays available via the title
// attribute (native hover tooltip) for when the exact detail matters — e.g. spotting a
// specific outdated-OS pattern repeating suspiciously across many rows, the way the
// iPhone-OS-13_2_3 bot cluster got caught. Best-effort, not exhaustive — falls back to
// "Browser" / "OS" rather than guessing wrong on an unrecognized string.
function parseUserAgent(ua: string | null): string {
  if (!ua) return '—';

  let os = 'OS';
  const ios = ua.match(/(?:iPhone|iPad|iPod).*?OS (\d+[_.]\d+)/);
  const android = ua.match(/Android (\d+(?:\.\d+)?)/);
  const mac = ua.match(/Mac OS X (\d+[_.]\d+)/);
  if (ios) os = `iOS ${ios[1].replace('_', '.')}`;
  else if (android) os = `Android ${android[1]}`;
  else if (/Windows NT 10\.0/.test(ua)) os = 'Windows 10/11';
  else if (/Windows NT/.test(ua)) os = 'Windows';
  else if (mac) os = `macOS ${mac[1].replace('_', '.')}`;
  else if (/Linux/.test(ua)) os = 'Linux';

  let browser = 'Browser';
  const crIos = ua.match(/CriOS\/(\d+)/);
  const fxIos = ua.match(/FxiOS\/(\d+)/);
  const edgIos = ua.match(/EdgiOS\/(\d+)/);
  const gsa = ua.match(/GSA\/([\d.]+)/);
  const edg = ua.match(/Edg\/(\d+)/);
  const opr = ua.match(/OPR\/(\d+)/);
  const samsung = ua.match(/SamsungBrowser\/(\d+)/);
  const oem = ua.match(/(HeyTapBrowser|MiuiBrowser|YaBrowser)\/(\d+)/);
  const firefox = ua.match(/Firefox\/(\d+)/);
  const chrome = ua.match(/Chrome\/(\d+)/);
  const safari = ua.match(/Version\/(\d+).*Safari/);

  if (crIos) browser = `Chrome ${crIos[1]}`;
  else if (fxIos) browser = `Firefox ${fxIos[1]}`;
  else if (edgIos) browser = `Edge ${edgIos[1]}`;
  else if (gsa) browser = `Google App ${gsa[1]}`;
  else if (edg) browser = `Edge ${edg[1]}`;
  else if (opr) browser = `Opera ${opr[1]}`;
  else if (samsung) browser = `Samsung Internet ${samsung[1]}`;
  else if (oem) browser = `${oem[1]} ${oem[2]}`;
  else if (firefox) browser = `Firefox ${firefox[1]}`;
  else if (safari && !chrome) browser = `Safari ${safari[1]}`;
  else if (chrome) browser = `Chrome ${chrome[1]}`;
  else if (/Safari/.test(ua)) browser = 'Safari';

  return `${browser} on ${os}`;
}
---
<PanelLayout title={`Activity log — ${isAllModels ? 'All models' : (client?.displayName ?? 'Client')} — findbyface Panel`} accountName={session.name} role={session.role} clientSlugs={session.clientSlugs} activeModelSlug={clientSlug} modelSwitcherOptions={adminSwitcherOptions} nav>
  <div class="activity-page">
    <header class="page-head">
      <span class="kicker">Since day one</span>
      <h1>Activity log</h1>
      <p>
        {log.entries.length
          ? `Every recorded click ${isAllModels ? 'across every model and site' : 'across the network'}, most recent first — ${log.entries.length.toLocaleString()} total.`
          : "Nothing recorded yet — this fills in once your link starts getting traffic."}
        {log.truncated && ' Showing the most recent history; a very high-volume source may have older rows beyond this.'}
      </p>
    </header>

    {log.entries.length > 0 && (
      <label class="log-search">
        <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><circle cx="10.5" cy="10.5" r="6.5"></circle><path d="m15.5 15.5 5 5"></path></svg>
        <input type="search" id="logFilter" placeholder={isAdmin ? "Filter by site, placement, or location" : "Filter by site or placement"} autocomplete="off" />
        <span id="logFilterCount"></span>
      </label>
    )}

    <article class="panel-card">
      {log.entries.length ? (
        <table class="recent-table" id="logTable">
          <thead>
            <tr>
              <th>When</th>{isAllModels && <th>Model</th>}<th>Site</th><th>Placement</th>{isAdmin && <th>Location</th>}<th>Referrer</th><th>User agent</th>
              {isAdmin && <><th>Datacenter</th><th>Link verified</th><th>IP</th></>}
            </tr>
          </thead>
          <tbody>
            {log.entries.map((entry) => (
              <tr data-filter-text={`${entry.site} ${modelDisplayName(entry.model)} ${entry.placementLabel} ${entry.city ?? ''} ${entry.country ?? ''}`.toLowerCase()}>
                <td>{new Date(entry.createdAt).toLocaleString(undefined, { month: 'short', day: 'numeric', year: 'numeric', hour: 'numeric', minute: '2-digit' })}</td>
                {isAllModels && <td>{modelDisplayName(entry.model)}</td>}
                <td>{entry.site}</td>
                <td>{entry.placementLabel}</td>
                {isAdmin && <td>{formatLocation(entry.city, entry.country)}</td>}
                <td class="referrer-cell">{entry.referrer || '—'}</td>
                <td class="ua-cell" title={entry.userAgent || ''}>{parseUserAgent(entry.userAgent)}</td>
                {isAdmin && (
                  <>
                    <td>{entry.isDatacenterIp ? <span class="flag-warn">Datacenter</span> : '—'}</td>
                    <td>
                      {entry.linkVerified === true && <span class="flag-ok">Verified</span>}
                      {entry.linkVerified === false && <span class="flag-warn">Unverified</span>}
                      {entry.linkVerified === null && '—'}
                    </td>
                    <td class="ip-cell">{entry.ipAddress || '—'}</td>
                  </>
                )}
              </tr>
            ))}
          </tbody>
        </table>
      ) : (
        <p class="empty-note">Clicks will show up here once your link starts getting traffic.</p>
      )}
    </article>
  </div>
</PanelLayout>

<script>
  const input = document.getElementById('logFilter') as HTMLInputElement | null;
  const countEl = document.getElementById('logFilterCount');
  const rows = Array.from(document.querySelectorAll<HTMLTableRowElement>('#logTable tbody tr'));

  function applyFilter(): void {
    const query = (input?.value ?? '').trim().toLowerCase();
    let visible = 0;
    for (const row of rows) {
      const match = !query || (row.dataset.filterText ?? '').includes(query);
      row.hidden = !match;
      if (match) visible++;
    }
    if (countEl) countEl.textContent = query ? `${visible.toLocaleString()} of ${rows.length.toLocaleString()}` : '';
  }

  input?.addEventListener('input', applyFilter);
</script>

<style>
  .activity-page { width: min(1300px, calc(100% - 40px)); margin: 0 auto; padding: 40px 0 80px; }
  .referrer-cell { max-width: 220px; overflow: hidden; text-overflow: ellipsis; white-space: nowrap; }
  .ua-cell {
    max-width: 190px; overflow: hidden; text-overflow: ellipsis; white-space: nowrap;
    color: var(--text-muted); font-size: 0.74rem; cursor: help;
    border-bottom: 1px dotted var(--border); /* hints there's more on hover, without a full underline */
  }
  .ip-cell { font: 500 0.78rem 'SF Mono', 'Consolas', monospace; color: var(--text-muted); white-space: nowrap; }
  .flag-ok, .flag-warn {
    display: inline-block; padding: 2px 8px; border-radius: 999px;
    font-size: 0.68rem; font-weight: 700; white-space: nowrap;
  }
  .flag-ok { background: rgba(34,197,94,0.14); color: var(--success); }
  .flag-warn { background: rgba(248,113,113,0.14); color: #f87171; }
  .log-search {
    display: flex; align-items: center; gap: 9px; width: min(320px, 100%);
    margin-bottom: 14px; padding: 0 12px; height: 40px;
    border: 1px solid var(--border); border-radius: 10px; background: #0d0c13;
  }
  .log-search svg { width: 16px; height: 16px; stroke: var(--text-muted); flex-shrink: 0; }
  .log-search input { flex: 1; height: 100%; border: 0; outline: 0; background: transparent; color: var(--text); font: 500 0.82rem 'Inter', sans-serif; }
  .log-search input::placeholder { color: var(--text-muted); }
  .log-search #logFilterCount { color: var(--text-muted); font-size: 0.68rem; font-weight: 700; white-space: nowrap; }
</style>
