---
import Base from '../layouts/Base.astro';
import UploadBox from '../components/UploadBox.astro';
import StatsBar from '../components/StatsBar.astro';
import CategoryChips from '../components/CategoryChips.astro';
import CreatorCard from '../components/CreatorCard.astro';
import { HOME_SEO } from '../config/seo-meta';

Astro.response.headers.set('Cache-Control', 'public, s-maxage=300, stale-while-revalidate=86400');

const SUPABASE_URL = import.meta.env.SUPABASE_URL?.replace(/\/+$/, '');
const SUPABASE_KEY = import.meta.env.SUPABASE_KEY;

let initialCreators: any[] = [];
let hasMore = false;

if (SUPABASE_URL && SUPABASE_KEY) {
  try {
    const params = new URLSearchParams({
      select: 'id,username,name,avatar,isverified,subscribeprice,favoritedcount',
      order:  'favoritedcount.desc',
      limit:  '20',
    });
    const resp = await fetch(`${SUPABASE_URL}/rest/v1/onlyfans_profiles?${params}`, {
      headers: {
        apikey: SUPABASE_KEY,
        Authorization: `Bearer ${SUPABASE_KEY}`,
        'Accept-Profile': 'public',
        Prefer: 'count=estimated',
      },
    });
    if (resp.ok) {
      const raw = await resp.json();
      const cr = resp.headers.get('Content-Range') ?? '';
      const total = parseInt(cr.split('/')[1] ?? '0') || 0;
      hasMore = total > 20;
      initialCreators = raw.map((c: Record<string, unknown>) => ({
        id:             c.id,
        username:       c.username,
        name:           c.name,
        avatar:         c.avatar,
        isVerified:     c.isverified,
        subscribePrice: c.subscribeprice,
      }));
    }
  } catch { /* serve page without initial creators */ }
}

const faqJsonLd = JSON.stringify({
  '@context': 'https://schema.org',
  '@type': 'FAQPage',
  mainEntity: [
    {
      '@type': 'Question',
      name: 'Is FindByFace really free?',
      acceptedAnswer: { '@type': 'Answer', text: 'Yes. You can upload a photo and get lookalike OnlyFans matches for free — no credits or per-search fees. Signing in (also free) unlocks unlimited searches and reveals every match.' },
    },
    {
      '@type': 'Question',
      name: 'How accurate is the face matching?',
      acceptedAnswer: { '@type': 'Answer', text: 'Our AI analyzes dozens of facial features for high-precision matching. Accuracy is best with clear, well-lit photos where the person faces the camera.' },
    },
    {
      '@type': 'Question',
      name: 'What photo works best?',
      acceptedAnswer: { '@type': 'Answer', text: 'A sharp, front-facing photo of a single face with good lighting. Avoid sunglasses, heavy filters, group shots, and extreme angles for the strongest results.' },
    },
    {
      '@type': 'Question',
      name: 'Is my upload stored or shared?',
      acceptedAnswer: { '@type': 'Answer', text: 'No. Your photo is processed to generate matches and is not stored or shared. The search is private.' },
    },
    {
      '@type': 'Question',
      name: "Can I find a specific person's OnlyFans?",
      acceptedAnswer: { '@type': 'Answer', text: 'FindByFace surfaces creators who visually resemble the uploaded face. Results are based on visual similarity and are intended for discovery and entertainment, not identity confirmation.' },
    },
  ],
});
---

<Base title={HOME_SEO.title} description={HOME_SEO.description}>
  <Fragment slot="head">
    <script type="application/ld+json" set:html={faqJsonLd} />
  </Fragment>
  <div class="hero">
    <div class="hero-badge">
      <span class="badge-dot"></span>
      AI-powered face matching · 100% free
    </div>
    <h1><span class="h1-white">Find her</span> <span class="gradient-text">OnlyFans</span><br /><span class="h1-white">by photo in seconds</span></h1>
    <p class="hero-sub">Upload any clear photo of a face and our AI instantly finds OnlyFans creators who look just like them — free, private, and unlimited.</p>
    <ul class="hero-trust">
      <li><span class="trust-ico">⚡</span> Results in under 2 seconds</li>
      <li><span class="trust-ico">🔒</span> Your photo is never stored</li>
      <li><span class="trust-ico">✓</span> No sign-up to start</li>
    </ul>
  </div>

  <UploadBox />

  <StatsBar />

  <section class="browse-section">
    <h2 class="section-title">Browse by Category</h2>
    <CategoryChips />
  </section>

  {initialCreators.length > 0 && (
    <section class="creators-section">
      <h2 class="section-title">Popular Creators</h2>
      <div class="creators-grid" id="creatorsGrid">
        {initialCreators.map((c, i) => <CreatorCard creator={c} index={i} />)}
      </div>
      {hasMore && (
        <div class="load-more-wrap">
          <button class="load-more-btn" id="loadMoreBtn">Load More</button>
        </div>
      )}
    </section>
  )}

  <!-- How It Works -->
  <section class="home-section how-section">
    <div class="section-head">
      <span class="eyebrow">Simple &amp; instant</span>
      <h2 class="section-title-lg">How FindByFace works</h2>
      <p class="section-lead">Three steps, a few seconds, zero cost. No account required to run your first searches.</p>
    </div>
    <div class="steps-grid">
      <div class="step-card">
        <span class="step-num">1</span>
        <span class="step-emoji">📤</span>
        <h3>Upload a photo</h3>
        <p>Drag &amp; drop, click, or paste any clear image of a face. JPG, PNG and WEBP all work. The sharper the photo and the more they face the camera, the better the match.</p>
      </div>
      <div class="step-card">
        <span class="step-num">2</span>
        <span class="step-emoji">🧠</span>
        <h3>AI maps the face</h3>
        <p>Our facial-recognition engine reads dozens of unique facial features and compares them against millions of indexed OnlyFans profiles in real time.</p>
      </div>
      <div class="step-card">
        <span class="step-num">3</span>
        <span class="step-emoji">💜</span>
        <h3>Get ranked matches</h3>
        <p>See the closest lookalike creators ranked by similarity, with prices and direct profile links. Click through and discover someone new.</p>
      </div>
    </div>
    <div class="section-cta">
      <button type="button" class="hero-cta" id="howCtaBtn">
        <span class="cta-icon">📸</span>
        Try it free now
      </button>
    </div>
  </section>

  <!-- Why Use FindByFace -->
  <section class="home-section why-section">
    <div class="section-head">
      <span class="eyebrow">Built for real searches</span>
      <h2 class="section-title-lg">Why people use FindByFace</h2>
      <p class="section-lead">However you found her, if you have a photo we can help you find her OnlyFans and creators who look just like her.</p>
    </div>
    <div class="why-grid">
      <article class="why-card">
        <span class="why-emoji">📱</span>
        <h3>Found her on social media</h3>
        <p>Spotted a stunning girl on Instagram, TikTok or X? Screenshot her face and find her OnlyFans — or creators with the same look.</p>
      </article>
      <article class="why-card">
        <span class="why-emoji">🏡</span>
        <h3>The girl next door</h3>
        <p>That barista, gym regular or college crush who's out of reach? Upload a clear photo and discover lookalike creators you can actually subscribe to.</p>
      </article>
      <article class="why-card">
        <span class="why-emoji">⭐</span>
        <h3>Celebrity &amp; influencer lookalikes</h3>
        <p>Got a celebrity crush? Upload their photo and find OnlyFans creators who could be their twin — same eyes, same smile, same vibe.</p>
      </article>
      <article class="why-card">
        <span class="why-emoji">🔎</span>
        <h3>Is my partner on OnlyFans?</h3>
        <p>Curious whether your boyfriend or girlfriend has a profile? Run a discreet face search and get your answer in seconds.</p>
      </article>
      <article class="why-card">
        <span class="why-emoji">🛡️</span>
        <h3>Spot deepfakes &amp; fakes</h3>
        <p>Worried a profile is AI-generated or a catfish? Compare faces to verify whether a creator is the real person before you subscribe.</p>
      </article>
      <article class="why-card">
        <span class="why-emoji">🎯</span>
        <h3>Find exactly your type</h3>
        <p>Stop endless scrolling. Upload a face that matches your taste and instantly surface creators who fit your exact preferences.</p>
      </article>
    </div>
  </section>

  <!-- 100% Free banner -->
  <section class="home-section free-section">
    <div class="free-card">
      <span class="free-badge">100% FREE</span>
      <h2>Free OnlyFans face search — no credits, no catch</h2>
      <p>Unlike paid OnlyFans finders that charge per search, FindByFace lets you run face searches for free. No credit packages, no per-search fees, no subscription to view matches. Upload a photo, get instant lookalike results, and browse millions of indexed creators without paying a cent. Sign in free to unlock unlimited searches.</p>
      <div class="section-cta">
        <button type="button" class="hero-cta light" id="freeCtaBtn">
          <span class="cta-icon">📸</span>
          Start your free search
        </button>
      </div>
    </div>
  </section>

  <!-- Testimonials -->
  <section class="home-section trust-section">
    <div class="section-head">
      <span class="eyebrow">★ 4.9 / 5 from thousands of searches</span>
      <h2 class="section-title-lg">Trust what our users say</h2>
      <p class="section-lead">Real feedback from people who found exactly who they were looking for.</p>
    </div>
    <div class="testimonials-grid">
      <figure class="testimonial">
        <div class="stars">★★★★★</div>
        <blockquote>"Thought it was too good to be true. Uploaded a photo of a girl from my feed and found three creators who look just like her in seconds. Insanely accurate."</blockquote>
        <figcaption>Brandon L. · <span>verified user</span></figcaption>
      </figure>
      <figure class="testimonial">
        <div class="stars">★★★★★</div>
        <blockquote>"I've had a crush on the same celebrity for years. Found a creator who is legitimately her twin — same eyes, same smile. Best free tool I've used."</blockquote>
        <figcaption>Jake M. · <span>verified user</span></figcaption>
      </figure>
      <figure class="testimonial">
        <div class="stars">★★★★★</div>
        <blockquote>"Matched with someone online that seemed off. Reverse-searched her pics and confirmed it fast. Saved me a ton of time — and it cost nothing."</blockquote>
        <figcaption>David R. · <span>verified user</span></figcaption>
      </figure>
    </div>
  </section>

  <!-- Reddit / community -->
  <section class="home-section reddit-section">
    <div class="reddit-card">
      <span class="reddit-emoji">👽</span>
      <div class="reddit-copy">
        <h2>Share your OnlyFans lookalike finds</h2>
        <p>Found an amazing match? Post it, swap search tips, and see what the community is discovering. Join the conversation and help others find their type.</p>
      </div>
      <a href="https://www.reddit.com/r/OnlyfansReviewsCenter/" target="_blank" rel="noopener noreferrer" class="reddit-btn">
        Join r/OnlyfansReviewsCenter →
      </a>
    </div>
  </section>

  <!-- FAQ for SEO -->
  <section class="home-section faq-section">
    <div class="section-head">
      <h2 class="section-title-lg">Frequently asked questions</h2>
    </div>
    <div class="faq-list">
      <details class="faq-item">
        <summary>Is FindByFace really free?</summary>
        <p>Yes. You can upload a photo and get lookalike OnlyFans matches for free — no credits or per-search fees. Signing in (also free) unlocks unlimited searches and reveals every match.</p>
      </details>
      <details class="faq-item">
        <summary>How accurate is the face matching?</summary>
        <p>Our AI analyzes dozens of facial features for high-precision matching. Accuracy is best with clear, well-lit photos where the person faces the camera. Blurry or angled photos return looser matches.</p>
      </details>
      <details class="faq-item">
        <summary>What photo works best?</summary>
        <p>A sharp, front-facing photo of a single face with good lighting. Avoid sunglasses, heavy filters, group shots, and extreme angles for the strongest results.</p>
      </details>
      <details class="faq-item">
        <summary>Is my upload stored or shared?</summary>
        <p>No. Your photo is processed to generate matches and is not stored or shared. The search is private.</p>
      </details>
      <details class="faq-item">
        <summary>Can I find a specific person's OnlyFans?</summary>
        <p>FindByFace surfaces creators who visually resemble the uploaded face. Results are based on visual similarity and are intended for discovery and entertainment, not identity confirmation.</p>
      </details>
    </div>
    <div class="section-cta">
      <button type="button" class="hero-cta" id="faqCtaBtn">
        <span class="cta-icon">📸</span>
        Upload a photo &amp; find lookalikes
      </button>
    </div>
  </section>
</Base>

<script>
  let currentPage = 2;
  let isLoading = false;
  let hasMoreResults = true;

  const loadMoreBtn = document.getElementById('loadMoreBtn');
  const grid = document.getElementById('creatorsGrid');

  function proxyImg(url: string, w: number, h: number): string {
    if (!url || url.startsWith('/')) return url;
    return `https://images.weserv.nl/?url=${encodeURIComponent(url.replace(/^https?:\/\//, ''))}&w=${w}&h=${h}&fit=cover&output=webp`;
  }

  function renderCard(c: any): string {
    const imgSrc = c.avatar?.startsWith('http') ? proxyImg(c.avatar, 320, 427) : '/no-image.png';
    const price = c.subscribePrice ?? c.subscribeprice;
    const priceLabel = (!price || isNaN(price)) ? 'FREE' : `$${parseFloat(price).toFixed(2)}`;
    const profileUrl = `https://onlyfans.com/${encodeURIComponent(c.username)}`;
    return `<div class="creator-card">
      <div class="card-img-wrap">
        <img src="${imgSrc}" alt="${c.name || c.username}" loading="lazy" decoding="async"
          referrerpolicy="no-referrer"
          onerror="if(this.src!=='/no-image.png'){this.removeAttribute('srcset');this.src='/no-image.png';}">
      </div>
      <div class="card-body">
        <p class="creator-name">${c.name || c.username}</p>
        <p class="username">@${c.username}</p>
        <p class="price ${priceLabel === 'FREE' ? 'price-free' : ''}">${priceLabel}</p>
        <a href="${profileUrl}" class="view-btn" target="_blank" rel="noopener">View Profile</a>
      </div>
    </div>`;
  }

  loadMoreBtn?.addEventListener('click', async () => {
    if (isLoading || !hasMoreResults) return;
    isLoading = true;
    loadMoreBtn.textContent = 'Loading...';
    (loadMoreBtn as HTMLButtonElement).disabled = true;

    try {
      const resp = await fetch(`/api/search?page=${currentPage}&page_size=20`);
      const data = await resp.json();
      data.creators?.forEach((c: any) => grid?.insertAdjacentHTML('beforeend', renderCard(c)));
      hasMoreResults = data.hasMore;
      currentPage++;
      loadMoreBtn.textContent = 'Load More';
      (loadMoreBtn as HTMLButtonElement).disabled = false;
      if (!hasMoreResults) (loadMoreBtn as HTMLElement).style.display = 'none';
    } catch {
      loadMoreBtn.textContent = 'Load More';
      (loadMoreBtn as HTMLButtonElement).disabled = false;
    }
    isLoading = false;
  });

  // CTA buttons scroll to the upload box and nudge the file picker open.
  function focusUpload() {
    const box = document.getElementById('uploadBox');
    if (!box) return;
    box.scrollIntoView({ behavior: 'smooth', block: 'center' });
    box.classList.add('cta-pulse');
    setTimeout(() => box.classList.remove('cta-pulse'), 1400);
  }
  ['heroCtaBtn', 'howCtaBtn', 'freeCtaBtn', 'faqCtaBtn'].forEach(id => {
    document.getElementById(id)?.addEventListener('click', focusUpload);
  });
</script>

<style>
  .hero {
    text-align: center;
    padding: 70px 20px 28px;
    max-width: 760px;
    margin: 0 auto;
  }

  .hero-badge {
    display: inline-flex;
    align-items: center;
    gap: 8px;
    background: rgba(124,58,237,0.15);
    border: 1px solid rgba(124,58,237,0.3);
    border-radius: 999px;
    padding: 6px 16px;
    font-size: 13px;
    color: var(--accent-light);
    margin-bottom: 18px;
  }

  .badge-dot {
    width: 6px; height: 6px;
    background: var(--accent-light);
    border-radius: 50%;
    animation: pulse 2s infinite;
  }

  @keyframes pulse {
    0%, 100% { opacity: 1; }
    50% { opacity: 0.3; }
  }

  .hero h1 {
    font-size: clamp(2rem, 4.5vw, 3rem);
    line-height: 1.12;
    margin-bottom: 14px;
  }

  .h1-white {
    color: #ffffff;
  }

  .gradient-text {
    background: linear-gradient(135deg, #7c3aed, #ec4899);
    -webkit-background-clip: text;
    -webkit-text-fill-color: transparent;
    background-clip: text;
  }

  .hero-sub {
    color: var(--text-muted);
    font-size: 0.98rem;
    line-height: 1.6;
    max-width: 580px;
    margin: 0 auto;
  }

  /* Fancy trust badges */
  .hero-trust {
    list-style: none;
    display: flex;
    flex-wrap: wrap;
    justify-content: center;
    gap: 10px;
    margin: 20px 0 0;
    padding: 0;
  }
  .hero-trust li {
    display: inline-flex;
    align-items: center;
    gap: 7px;
    font-size: 0.82rem;
    font-weight: 600;
    color: var(--text);
    padding: 7px 14px;
    border-radius: 999px;
    background: linear-gradient(135deg, rgba(124,58,237,0.12), rgba(236,72,153,0.10));
    border: 1px solid var(--border);
    backdrop-filter: blur(6px);
  }
  .hero-trust .trust-ico {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    width: 18px; height: 18px;
    font-size: 0.72rem;
    border-radius: 50%;
    background: linear-gradient(135deg, #7c3aed, #ec4899);
    color: #fff;
  }

  .discover-chip {
    display: inline-flex;
    align-items: center;
    gap: 8px;
    margin-top: 18px;
    padding: 8px 18px;
    border-radius: 999px;
    background: rgba(124,58,237,0.1);
    border: 1px solid var(--border);
    color: var(--text);
    font-size: 0.92rem;
    font-weight: 500;
    transition: all 0.2s;
  }
  .discover-chip:hover {
    border-color: var(--accent);
    background: rgba(124,58,237,0.18);
    transform: translateY(-1px);
  }
  .chip-spark { font-size: 0.95rem; }
  .chip-arrow {
    background: linear-gradient(135deg, #7c3aed, #ec4899);
    -webkit-background-clip: text;
    -webkit-text-fill-color: transparent;
    background-clip: text;
    font-weight: 700;
  }

  .browse-section,
  .creators-section {
    max-width: 1200px;
    margin: 64px auto 0;
    padding: 0 20px;
  }

  .section-title {
    font-size: 1.4rem;
    margin-bottom: 24px;
  }

  .creators-grid {
    display: grid;
    grid-template-columns: repeat(4, 1fr);
    gap: 20px;
  }

  @media (max-width: 900px) { .creators-grid { grid-template-columns: repeat(3, 1fr); } }
  @media (max-width: 600px) { .creators-grid { grid-template-columns: repeat(2, 1fr); gap: 12px; } }

  .load-more-wrap {
    display: flex;
    justify-content: center;
    margin-top: 40px;
  }

  .load-more-btn {
    background: transparent;
    border: 1px solid var(--border);
    color: var(--text);
    padding: 12px 44px;
    border-radius: 999px;
    font-size: 15px;
    font-weight: 500;
    cursor: pointer;
    font-family: 'Inter', sans-serif;
    transition: all 0.2s;
  }

  .load-more-btn:hover { border-color: var(--accent); color: var(--accent); }

  /* Card styles for JS load-more */
  .creator-card { background: var(--surface); border-radius: var(--radius-lg); overflow: hidden; border: 1px solid var(--border); transition: transform 0.2s, box-shadow 0.2s; }
  .creator-card:hover { transform: translateY(-4px); box-shadow: 0 8px 32px var(--accent-glow); }
  .card-img-wrap { aspect-ratio: 3/4; overflow: hidden; background: var(--surface-raised); }
  .card-img-wrap img { width: 100%; height: 100%; object-fit: cover; display: block; }
  .card-body { padding: 12px 14px; }
  .creator-name { font-family: 'Syne', sans-serif; font-weight: 700; font-size: 14px; margin-bottom: 2px; white-space: nowrap; overflow: hidden; text-overflow: ellipsis; }
  .username { color: var(--text-muted); font-size: 12px; margin-bottom: 6px; }
  .price { font-weight: 700; font-size: 15px; margin-bottom: 10px; color: var(--text-muted); }
  .price-free { color: var(--success); }
  .view-btn { display: block; text-align: center; background: var(--accent); color: #fff; border-radius: 8px; padding: 8px; font-size: 13px; font-weight: 600; transition: background 0.2s; }
  .view-btn:hover { background: var(--accent-light); }

  /* ── Hero CTA ─────────────────────────────────────────── */
  .hero-cta-row {
    display: flex; flex-direction: column; align-items: center;
    gap: 14px; margin-top: 30px;
  }
  .hero-cta {
    display: inline-flex; align-items: center; gap: 10px;
    background: linear-gradient(135deg, #7c3aed, #ec4899);
    color: #fff; border: none; cursor: pointer;
    font-family: 'Syne', sans-serif; font-weight: 800;
    font-size: 1.05rem; padding: 16px 34px; border-radius: 999px;
    box-shadow: 0 10px 30px rgba(124,58,237,0.4);
    transition: transform 0.15s, box-shadow 0.2s;
  }
  .hero-cta:hover { transform: translateY(-2px) scale(1.02); box-shadow: 0 14px 40px rgba(236,72,153,0.45); }
  .hero-cta:active { transform: translateY(0) scale(0.99); }
  .hero-cta.light { box-shadow: 0 10px 30px rgba(0,0,0,0.3); }
  .cta-icon { font-size: 1.1rem; }
  .hero-trust { margin-top: 18px; font-size: 0.82rem; color: var(--text-muted); }

  /* Pulse the upload box when a CTA is clicked */
  :global(.upload-box.cta-pulse) {
    animation: cta-pulse 1.4s ease-out;
  }
  @keyframes cta-pulse {
    0%   { box-shadow: 0 0 0 0 rgba(124,58,237,0.5); }
    70%  { box-shadow: 0 0 0 18px rgba(124,58,237,0); }
    100% { box-shadow: 0 0 0 0 rgba(124,58,237,0); }
  }

  /* ── Shared section scaffolding ───────────────────────── */
  .home-section { max-width: 1100px; margin: 88px auto 0; padding: 0 20px; }
  .section-head { text-align: center; max-width: 680px; margin: 0 auto 40px; }
  .eyebrow {
    display: inline-block; font-size: 0.78rem; font-weight: 700;
    letter-spacing: 0.08em; text-transform: uppercase;
    color: var(--accent-light); margin-bottom: 12px;
  }
  .section-title-lg { font-size: clamp(1.6rem, 3.5vw, 2.3rem); line-height: 1.15; margin-bottom: 14px; }
  .section-lead { color: var(--text-muted); font-size: 1rem; line-height: 1.6; }
  .section-cta { display: flex; justify-content: center; margin-top: 40px; }

  /* ── How it works ─────────────────────────────────────── */
  .steps-grid {
    display: grid; grid-template-columns: repeat(3, 1fr); gap: 20px;
  }
  .step-card {
    position: relative; background: var(--surface);
    border: 1px solid var(--border); border-radius: var(--radius-lg);
    padding: 32px 24px 26px; text-align: center;
    transition: transform 0.2s, box-shadow 0.2s, border-color 0.2s;
  }
  .step-card:hover { transform: translateY(-4px); border-color: var(--accent); box-shadow: 0 12px 36px var(--accent-glow); }
