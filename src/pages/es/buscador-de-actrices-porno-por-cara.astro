          <span class="step-number">03</span>
          <div class="step-icon" aria-hidden="true">
            <svg viewBox="0 0 24 24" fill="none">
              <path d="M4 5h16M4 12h10M4 19h7" />
              <circle cx="18" cy="16" r="3" />
              <path d="m20.2 18.2 2 2" />
            </svg>
          </div>
