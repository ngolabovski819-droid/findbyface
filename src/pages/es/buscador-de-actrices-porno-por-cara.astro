const structuredData = JSON.stringify([
  {
    '@context': 'https://schema.org',
    '@type': 'WebApplication',
    '@id': `${canonical}#web-application`,
    name: 'findbyface Buscador de Actrices Porno por Cara y Foto con IA',
    alternateName: [
      'Buscador Facial de Actrices Porno',
      'Buscador de Actrices por Imagen',
      'Buscador de Nombres de Actrices Porno',
    ],
    url: canonical,
    inLanguage: 'es',
    description,
    applicationCategory: 'SearchApplication',
    operatingSystem: 'Any',
    browserRequirements: 'Requiere JavaScript y soporte de subida de imágenes',
    isAccessibleForFree: true,
    audience: {
      '@type': 'PeopleAudience',
      requiredMinAge: 18,
    },
    featureList: [
      'Búsqueda facial con IA gratis por foto, imagen o captura',
      'Coincidencias de video clasificadas',
      'Miniaturas y enlaces a la fuente',
      'Procesamiento temporal de imágenes',
    ],
  },
  {
    '@context': 'https://schema.org',
    '@type': 'FAQPage',
    inLanguage: 'es',
    mainEntity: faqs.map((item) => ({
      '@type': 'Question',
      name: item.question,
      acceptedAnswer: {
        '@type': 'Answer',
        text: item.answer,
      },
    })),
  },
  {
    '@context': 'https://schema.org',
    '@type': 'BreadcrumbList',
    itemListElement: [
      {
        '@type': 'ListItem',
        position: 1,
        name: 'Inicio',
        item: 'https://findbyface.org/es/',
      },
      {
        '@type': 'ListItem',
        position: 2,
        name: 'Buscador de Actrices Porno por Cara',
        item: canonical,
      },
    ],
  },
]);
---

<Base title={title} description={description} canonical={canonical}>
  <Fragment slot="head">
    <meta name="robots" content="index,follow,max-image-preview:large,max-snippet:-1,max-video-preview:-1" />
    <meta name="rating" content="adult" />
    <script type="application/ld+json" set:html={structuredData} />
  </Fragment>

  <VideoFaceSearch />

  <SearchStories finder="pornstar" />

  <div class="content-shell">
    <section class="content-section how-section" id="how-it-works">
      <div class="section-heading">
        <span class="eyebrow">De la foto a la evidencia en video</span>
