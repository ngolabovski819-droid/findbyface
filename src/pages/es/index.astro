---
{/* i18n-twin: src/pages/index.astro — mirror copy/structure changes. Styles are copied
   verbatim from the English twin; visible FAQ renders from the same `faqs` array that
   feeds the JSON-LD (unlike the EN page, which hand-duplicates it — keep in sync). */}
import Base from '../../layouts/Base.astro';
import UploadBox from '../../components/UploadBox.astro';
import { HOME_SEO_ES } from '../../config/seo-meta';
import { absUrl } from '../../lib/site';

Astro.response.headers.set('Cache-Control', 'public, s-maxage=300, stale-while-revalidate=86400');

const faqs = [
  {
    name: '¿FindByFace es realmente gratis?',
    answer: 'Sí. Puedes iniciar una búsqueda facial de contenido adulto gratis. Algunas herramientas pueden aplicar límites de uso justo o de cuenta, que se muestran antes de afectar una búsqueda.',
  },
  {
    name: '¿Qué puedo buscar con FindByFace?',
    answer: 'FindByFace actualmente busca perfiles de creadoras de OnlyFans y apariciones en videos para adultos indexados. La búsqueda de modelos de cam está planeada pero aún no está disponible.',
  },
  {
    name: '¿Qué foto funciona mejor?',
    answer: 'Usa una imagen nítida y bien iluminada con un solo rostro adulto sin obstrucciones. Los ángulos frontales y de tres cuartos suaves suelen producir las clasificaciones más útiles.',
  },
  {
    name: '¿Mi foto se almacena o se comparte?',
    answer: 'La imagen de búsqueda subida se procesa para generar resultados y no se agrega al índice facial buscable. Consulta la política de privacidad para los detalles sobre procesamiento y registros del servicio.',
  },
  {
    name: '¿Una coincidencia facial prueba la identidad de alguien?',
    answer: 'No. Los resultados son coincidencias visuales clasificadas, no prueba de identidad. Personas parecidas, la calidad de la imagen, la pose y la cobertura del índice pueden afectar la clasificación.',
  },
  {
    name: '¿FindByFace es un buscador de imagen inversa?',
    answer: 'No exactamente. La búsqueda de imagen inversa tradicional busca copias de la misma imagen. FindByFace compara rasgos faciales, lo que puede mostrar perfiles o apariciones relacionadas desde imágenes y fotogramas de video diferentes.',
  },
];

const structuredData = JSON.stringify([
  {
    '@context': 'https://schema.org',
    '@type': 'WebApplication',
    name: 'FindByFace Buscador Facial de Contenido Adulto',
    url: absUrl('/es/'),
    inLanguage: 'es',
    description: HOME_SEO_ES.description,
    applicationCategory: 'SearchApplication',
    operatingSystem: 'Any',
    isAccessibleForFree: true,
    audience: { '@type': 'PeopleAudience', requiredMinAge: 18 },
    featureList: [
      'Búsqueda facial con IA por foto o captura',
      'Coincidencia de perfiles de creadoras de OnlyFans',
      'Coincidencia de apariciones en videos para adultos',
      'Resultados clasificados por similitud visual',
    ],
  },
  {
    '@context': 'https://schema.org',
    '@type': 'FAQPage',
    inLanguage: 'es',
    mainEntity: faqs.map((item) => ({
      '@type': 'Question',
      name: item.name,
      acceptedAnswer: { '@type': 'Answer', text: item.answer },
    })),
  },
]);
---

<Base title={HOME_SEO_ES.title} description={HOME_SEO_ES.description}>
