    animation: pulse 2s infinite;
  }

  @keyframes pulse {
    0%, 100% { opacity: 1; }
    50% { opacity: 0.3; }
  }

  .hero h1 {
    font-size: clamp(2rem, 4.5vw, 3rem);
    line-height: 1.12;
    margin-bottom: 14px;
  }

  .h1-white {
    color: #ffffff;
  }

  .gradient-text {
    background: linear-gradient(135deg, #7c3aed, #ec4899);
    -webkit-background-clip: text;
    -webkit-text-fill-color: transparent;
    background-clip: text;
  }

  .hero-sub {
    color: var(--text-muted);
    font-size: 0.98rem;
    line-height: 1.6;
    max-width: 580px;
    margin: 0 auto;
  }

  /* Fancy trust badges */
  .hero-trust {
    list-style: none;
    display: flex;
    flex-wrap: wrap;
    justify-content: center;
    gap: 10px;
    margin: 20px 0 0;
    padding: 0;
  }
  .hero-trust li {
    display: inline-flex;
    align-items: center;
    gap: 7px;
    font-size: 0.82rem;
    font-weight: 600;
    color: var(--text);
    padding: 7px 14px;
    border-radius: 999px;
    background: linear-gradient(135deg, rgba(124,58,237,0.12), rgba(236,72,153,0.10));
    border: 1px solid var(--border);
    backdrop-filter: blur(6px);
  }
  .hero-trust .trust-ico {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    width: 18px; height: 18px;
    font-size: 0.72rem;
    border-radius: 6px;
    background: rgba(124,58,237,0.16);
    color: var(--accent-light);
  }

  .discover-chip {
    display: inline-flex;
    align-items: center;
    gap: 8px;
    margin-top: 18px;
    padding: 8px 18px;
    border-radius: 999px;
    background: rgba(124,58,237,0.1);
    border: 1px solid var(--border);
    color: var(--text);
    font-size: 0.92rem;
    font-weight: 500;
    transition: all 0.2s;
  }
  .discover-chip:hover {
    border-color: var(--accent);
    background: rgba(124,58,237,0.18);
    transform: translateY(-1px);
  }
  .chip-spark { font-size: 0.95rem; }
  .chip-arrow {
    background: linear-gradient(135deg, #7c3aed, #ec4899);
    -webkit-background-clip: text;
    -webkit-text-fill-color: transparent;
    background-clip: text;
    font-weight: 700;
  }

  .browse-section,
  .creators-section {
    max-width: 1200px;
    margin: 64px auto 0;
    padding: 0 20px;
  }

  .browse-head {
    text-align: center;
    max-width: 620px;
    margin: 0 auto 28px;
  }

  .browse-head .section-title {
    margin: 8px 0 10px;
  }

  .browse-sub {
    color: var(--text-muted);
    font-size: 0.98rem;
    line-height: 1.6;
  }

  .section-title {
    font-size: 1.4rem;
    margin-bottom: 24px;
  }

  .creators-grid {
    display: grid;
    grid-template-columns: repeat(4, minmax(0, 1fr));
    gap: 20px;
  }

  @media (max-width: 900px) { .creators-grid { grid-template-columns: repeat(3, minmax(0, 1fr)); } }
  @media (max-width: 600px) { .creators-grid { grid-template-columns: repeat(2, minmax(0, 1fr)); gap: 12px; } }

  .load-more-wrap {
    display: flex;
    justify-content: center;
    margin-top: 40px;
  }

  .load-more-btn {
    background: transparent;
    border: 1px solid var(--border);
    color: var(--text);
    padding: 12px 44px;
    border-radius: 999px;
    font-size: 15px;
    font-weight: 500;
    cursor: pointer;
    font-family: 'Inter', sans-serif;
    transition: all 0.2s;
  }

  .load-more-btn:hover { border-color: var(--accent); color: var(--accent); }

  /* Card styles for JS load-more */
  .creator-card { background: var(--surface); border-radius: var(--radius-lg); overflow: hidden; border: 1px solid var(--border); transition: transform 0.2s, box-shadow 0.2s; }
  .creator-card:hover { transform: translateY(-4px); box-shadow: 0 8px 32px var(--accent-glow); }
  .card-img-wrap { aspect-ratio: 3/4; overflow: hidden; background: var(--surface-raised); }
  .card-img-wrap img { width: 100%; height: 100%; object-fit: cover; display: block; }
  .card-body { padding: 12px 14px; }
  .creator-name { font-family: 'Manrope', sans-serif; font-weight: 700; font-size: 14px; margin-bottom: 2px; white-space: nowrap; overflow: hidden; text-overflow: ellipsis; }
  .username { color: var(--text-muted); font-size: 12px; margin-bottom: 6px; }
  .price { font-weight: 700; font-size: 15px; margin-bottom: 10px; color: var(--text-muted); }
  .price-free { color: var(--success); }
  .view-btn { display: block; text-align: center; background: var(--accent); color: #fff; border-radius: 8px; padding: 8px; font-size: 13px; font-weight: 600; transition: background 0.2s; }
  .view-btn:hover { background: var(--accent-light); }

  /* ── Hero CTA ─────────────────────────────────────────── */
  .hero-cta-row {
    display: flex; flex-direction: column; align-items: center;
    gap: 14px; margin-top: 30px;
  }
  .hero-cta {
    display: inline-flex; align-items: center; gap: 10px;
    background: linear-gradient(135deg, #7c3aed, #ec4899);
    color: #fff; border: none; cursor: pointer;
    font-family: 'Manrope', sans-serif; font-weight: 800;
    font-size: 1.05rem; padding: 16px 34px; border-radius: 999px;
    box-shadow: 0 10px 30px rgba(124,58,237,0.4);
    transition: transform 0.15s, box-shadow 0.2s;
  }
  .hero-cta:hover { transform: translateY(-2px) scale(1.02); box-shadow: 0 14px 40px rgba(236,72,153,0.45); }
  .hero-cta:active { transform: translateY(0) scale(0.99); }
  .hero-cta.light { box-shadow: 0 10px 30px rgba(0,0,0,0.3); }
  .cta-icon { font-size: 1.1rem; }
  .hero-trust { margin-top: 18px; font-size: 0.82rem; color: var(--text-muted); }

  /* Pulse the upload box when a CTA is clicked */
  :global(.upload-box.cta-pulse) {
    animation: cta-pulse 1.4s ease-out;
  }
  @keyframes cta-pulse {
    0%   { box-shadow: 0 0 0 0 rgba(124,58,237,0.5); }
    70%  { box-shadow: 0 0 0 18px rgba(124,58,237,0); }
    100% { box-shadow: 0 0 0 0 rgba(124,58,237,0); }
  }

  /* ── Shared section scaffolding ───────────────────────── */
  .home-section { max-width: 1100px; margin: 88px auto 0; padding: 0 20px; }
  .section-head { text-align: center; max-width: 680px; margin: 0 auto 40px; }
  .eyebrow {
    display: inline-block; font-size: 0.78rem; font-weight: 700;
    letter-spacing: 0.08em; text-transform: uppercase;
    color: var(--accent-light); margin-bottom: 12px;
  }
  .section-title-lg { font-size: clamp(1.6rem, 3.5vw, 2.3rem); line-height: 1.15; margin-bottom: 14px; }
  .section-lead { color: var(--text-muted); font-size: 1rem; line-height: 1.6; }
  .section-cta { display: flex; justify-content: center; margin-top: 40px; }

  /* ── How it works ─────────────────────────────────────── */
  .steps-grid {
    display: grid; grid-template-columns: repeat(3, 1fr); gap: 20px;
  }
  .step-card {
    position: relative; overflow: hidden; background: var(--surface);
    border: 1px solid var(--border); border-radius: 24px;
    padding: 0 24px 28px; text-align: left;
    transition: transform 0.2s, box-shadow 0.2s, border-color 0.2s;
  }
  .step-card:hover { transform: translateY(-4px); border-color: var(--accent); box-shadow: 0 12px 36px var(--accent-glow); }
  .step-num {
    display: inline-flex; align-items: center; justify-content: center;
    width: 38px; height: 38px; margin: -19px 0 20px;
    border: 1px solid rgba(168,85,247,0.55); border-radius: 12px;
    background: #171323; color: var(--accent-light);
    font-family: 'Manrope', sans-serif; font-size: 0.76rem; font-weight: 800;
    box-shadow: 0 8px 20px rgba(0,0,0,0.32);
  }
  .step-card h3 { font-size: 1.14rem; margin-bottom: 10px; }
  .step-card p { color: var(--text-muted); font-size: 0.9rem; line-height: 1.68; }
  .step-visual {
    position: relative; isolation: isolate; height: 220px; margin: 0 -24px 0; overflow: hidden;
    border-bottom: 1px solid var(--border);
    background:
      radial-gradient(circle at 50% 43%, rgba(137,61,236,0.22), transparent 42%),
      linear-gradient(155deg, #171322 0%, #0d0d15 64%, #11101a 100%);
  }
  .step-visual::after {
    content: ''; position: absolute; inset: auto 12% -42px; z-index: -1; height: 82px;
    border-radius: 50%; background: rgba(131,55,211,0.18); filter: blur(30px);
  }
  .visual-grid {
    position: absolute; inset: 0; opacity: .22; pointer-events: none;
    background-image: linear-gradient(rgba(177,105,255,.07) 1px,transparent 1px),linear-gradient(90deg,rgba(177,105,255,.07) 1px,transparent 1px);
    background-size: 24px 24px; mask-image: linear-gradient(to bottom,transparent 3%,#000 38%,transparent 98%);
  }
  .upload-visual::before {
    content: ''; position: absolute; width: 150px; height: 150px; left: calc(50% - 75px); top: 26px;
    border: 1px solid rgba(168,85,247,.11); border-radius: 50%; box-shadow: 0 0 0 18px rgba(168,85,247,.035),0 0 0 40px rgba(168,85,247,.02);
  }
  .photo-card {
    position: absolute; overflow: hidden; border-radius: 18px;
  }
  .photo-card-back {
    left: calc(50% - 66px); top: 34px; width: 106px; height: 132px;
    border: 1px solid rgba(168,85,247,.22); background: #1b1428; transform: rotate(-8deg) translateX(-14px); opacity: .72;
  }
  .photo-card-main {
    left: calc(50% - 53px); top: 24px; width: 106px; height: 140px;
    border: 1px solid rgba(204,121,255,.58); background: linear-gradient(155deg,#32204b,#20132d 58%,#32112d);
    box-shadow: 0 18px 42px rgba(0,0,0,.48),0 0 28px rgba(134,52,220,.2); animation: upload-card-float 5s ease-in-out infinite;
  }
  .portrait-head {
    position: absolute; left: 50%; top: 19px; transform: translateX(-50%);
    width: 43px; height: 52px; border-radius: 48% 48% 44% 44%;
    background: linear-gradient(145deg,#e0c5ff,#e6a6db); box-shadow: inset -8px -5px 12px rgba(152,85,191,.16);
  }
  .portrait-head::before {
    content: ''; position: absolute; left: -3px; top: -5px; width: 47px; height: 24px; border-radius: 60% 60% 34% 24%;
    background: linear-gradient(130deg,#43215e,#71255e); transform: rotate(-4deg);
  }
  .portrait-neck {
    position: absolute; left: 50%; top: 64px; width: 19px; height: 21px; transform: translateX(-50%); background:#d7a5dc;
  }
  .portrait-body {
    position: absolute; left: 50%; bottom: -24px; transform: translateX(-50%);
    width: 106px; height: 82px; border-radius: 52% 52% 0 0;
    background: linear-gradient(125deg,#7435ed,#dd328e 72%); box-shadow: inset 16px 10px 24px rgba(255,255,255,.08);
  }
  .crop-corner { position:absolute;width:13px;height:13px;border-color:#fff;border-style:solid;filter:drop-shadow(0 0 5px #b55cff) }
  .crop-tl{left:8px;top:8px;border-width:2px 0 0 2px;border-radius:3px 0 0}.crop-tr{right:8px;top:8px;border-width:2px 2px 0 0;border-radius:0 3px 0 0}.crop-bl{left:8px;bottom:8px;border-width:0 0 2px 2px;border-radius:0 0 0 3px}.crop-br{right:8px;bottom:8px;border-width:0 2px 2px 0;border-radius:0 0 3px}
  .face-confirm {
    position:absolute;left:50%;bottom:7px;transform:translateX(-50%);display:flex;align-items:center;gap:4px;white-space:nowrap;
    padding:4px 7px;border:1px solid rgba(74,222,128,.25);border-radius:999px;background:rgba(8,12,14,.82);color:#b8f5cf;font-size:.48rem;letter-spacing:.01em;
  }
  .face-confirm span{display:grid;place-items:center;width:11px;height:11px;border-radius:50%;background:#24b86a;color:#06130c;font-size:.42rem}
  .upload-flight {
    position:absolute;left:calc(50% + 43px);top:27px;display:grid;place-items:center;width:43px;height:43px;border:1px solid rgba(205,139,255,.55);border-radius:14px;
    background:linear-gradient(145deg,#9b48f3,#7030dc);box-shadow:0 10px 28px rgba(124,58,237,.48);animation:upload-flight 3.2s ease-in-out infinite;
  }
  .upload-flight svg{width:22px;height:22px;stroke:#fff;stroke-width:1.8;stroke-linecap:round;stroke-linejoin:round}
  .file-ready {
    position:absolute;left:50%;bottom:14px;transform:translateX(-50%);display:grid;grid-template-columns:28px 1fr auto;align-items:center;gap:8px;width:196px;padding:8px 10px;
    border:1px solid rgba(255,255,255,.09);border-radius:11px;background:rgba(12,11,18,.9);box-shadow:0 12px 25px rgba(0,0,0,.35);backdrop-filter:blur(10px);
  }
  .file-ready>i{display:grid;place-items:center;width:28px;height:28px;border-radius:8px;background:rgba(168,85,247,.17);color:#d7b4ff;font-style:normal;font-size:.48rem;font-weight:900}.file-ready>span{display:grid}.file-ready b{color:#ede9f2;font-size:.55rem}.file-ready small{color:#797486;font-size:.46rem}.file-ready em{color:#76e8a8;font-size:.5rem;font-style:normal;font-weight:800}
  @keyframes upload-card-float{50%{transform:translateY(-3px)}}@keyframes upload-flight{50%{transform:translateY(-5px);box-shadow:0 16px 34px rgba(124,58,237,.58)}}
  .scan-visual{background:radial-gradient(circle at 50% 48%,rgba(112,39,182,.27),transparent 39%),linear-gradient(155deg,#15111f,#0c0c13)}
  .biometric-face {
    position:absolute;left:50%;top:13px;width:140px;height:164px;transform:translateX(-50%);overflow:visible;
    filter:drop-shadow(0 0 11px rgba(177,82,247,.42));
  }
  .face-outline{stroke:#a85af2;stroke-width:1.7;stroke-linecap:round;opacity:.85;stroke-dasharray:5 3;animation:outline-flow 8s linear infinite}.face-mesh{stroke:#8f69e8;stroke-width:.7;opacity:.35}.landmark-dots circle{fill:#fff;stroke:#c564ff;stroke-width:1;filter:drop-shadow(0 0 3px #b54aff);animation:landmark-pulse 2.2s ease-in-out infinite}.landmark-dots circle:nth-child(2n){animation-delay:.5s}.landmark-dots circle:nth-child(3n){animation-delay:1s}
  @keyframes outline-flow{to{stroke-dashoffset:-80}}@keyframes landmark-pulse{50%{opacity:.42;r:1.45px}}
  .hud-corner{position:absolute;width:27px;height:27px;border-color:rgba(169,89,233,.4);border-style:solid}.hud-tl{left:24px;top:20px;border-width:1px 0 0 1px}.hud-tr{right:24px;top:20px;border-width:1px 1px 0 0}.hud-bl{left:24px;bottom:20px;border-width:0 0 1px 1px}.hud-br{right:24px;bottom:20px;border-width:0 1px 1px 0}
  .scan-beam {
    position:absolute;z-index:3;left:11%;right:11%;top:42%;height:1px;background:linear-gradient(90deg,transparent,#974af0 20%,#fff 49%,#ef3d9c 80%,transparent);
    box-shadow:0 0 7px #a64bf4,0 0 18px rgba(236,72,153,.45);animation:scan-sweep 3.2s ease-in-out infinite;
  }
  @keyframes scan-sweep{0%,100%{top:28%;opacity:.65}50%{top:68%;opacity:1}}
  .scan-data{position:absolute;display:grid;gap:1px;padding:6px 8px;border:1px solid rgba(168,85,247,.17);border-radius:8px;background:rgba(12,10,18,.72);backdrop-filter:blur(8px)}.scan-data i{color:#dcb7ff;font-size:.58rem;font-weight:900;font-style:normal}.scan-data small{color:#716b7d;font-size:.42rem;text-transform:uppercase;letter-spacing:.06em}.data-left{left:27px;top:70px}.data-right{right:25px;top:54px}
  .scan-status{position:absolute;left:50%;bottom:12px;transform:translateX(-50%);display:flex;align-items:center;gap:6px;white-space:nowrap;padding:5px 9px;border-radius:999px;background:rgba(10,9,15,.82);color:#aaa4b7;font-size:.49rem}.scan-status i{width:5px;height:5px;border-radius:50%;background:#56e99b;box-shadow:0 0 8px #56e99b;animation:status-pulse 1.3s ease-in-out infinite}@keyframes status-pulse{50%{opacity:.3}}
  .results-visual{display:grid;place-items:center;background:radial-gradient(circle at 50% 55%,rgba(189,47,178,.16),transparent 45%),linear-gradient(155deg,#15111f,#0c0c13)}
  .results-window {
    position:relative;z-index:1;display:grid;width:238px;margin-top:-13px;padding:9px;border:1px solid rgba(171,93,229,.28);border-radius:15px;
    background:rgba(14,12,21,.88);box-shadow:0 18px 42px rgba(0,0,0,.44),0 0 30px rgba(124,58,237,.12);backdrop-filter:blur(12px);
  }
  .results-window-head{display:flex;justify-content:space-between;align-items:center;padding:2px 2px 8px}.results-window-head>b{color:#eeeaf4;font-size:.58rem}.results-window-head>small{display:flex;align-items:center;gap:4px;color:#777181;font-size:.42rem}.results-window-head>small i{width:4px;height:4px;border-radius:50%;background:#55e69a;box-shadow:0 0 6px #55e69a}
  .result-row{display:grid;grid-template-columns:15px 31px 1fr 15px;align-items:center;gap:7px;padding:6px 5px;border-top:1px solid rgba(255,255,255,.055);border-radius:8px;transition:background .2s}.result-row.result-one{background:linear-gradient(90deg,rgba(124,58,237,.15),rgba(236,72,153,.07));border:1px solid rgba(168,85,247,.17)}.result-row>em{color:#81798e;font-size:.43rem;font-style:normal;font-weight:800}.result-avatar{position:relative;width:31px;height:31px;overflow:hidden;border:1px solid rgba(255,255,255,.1);border-radius:9px;background:linear-gradient(145deg,#5b2d79,#bb3f8d)}.result-avatar::before{content:'';position:absolute;left:50%;top:5px;transform:translateX(-50%);width:12px;height:14px;border-radius:48%;background:#ebc7f3}.result-avatar::after{content:'';position:absolute;left:50%;bottom:-6px;transform:translateX(-50%);width:28px;height:19px;border-radius:50% 50% 0 0;background:#8f43d9}.result-two .result-avatar{filter:hue-rotate(35deg);opacity:.91}.result-three .result-avatar{filter:hue-rotate(300deg);opacity:.82}.result-row>span{display:grid;min-width:0}.result-row>span>b{color:#ede9f2;font-size:.52rem}.result-row>span>small{color:#777181;font-size:.42rem}.result-row>span>u{position:relative;width:100%;height:2px;margin-top:4px;border-radius:2px;background:#292331;text-decoration:none;overflow:hidden}.result-row>span>u i{display:block;width:97%;height:100%;background:linear-gradient(90deg,#8b42ee,#ef479e)}.result-two>span>u i{width:94%}.result-three>span>u i{width:91%}.result-row>strong{color:#b86cff;font-size:.62rem}
  .result-source-pills{position:absolute;z-index:2;left:50%;bottom:12px;transform:translateX(-50%);display:flex;gap:5px}.result-source-pills b{padding:4px 7px;border:1px solid rgba(168,85,247,.18);border-radius:999px;background:#151020;color:#a99eb7;font-size:.43rem;white-space:nowrap}.result-source-pills b:first-child{color:#d8b4fe;background:#221333}
  @media (prefers-reduced-motion: reduce) {
    .photo-card-main,.upload-flight,.face-outline,.landmark-dots circle,.scan-beam,.scan-status i{animation:none!important}
  }
  .pro-tip {
    display: flex; align-items: center; gap: 14px; margin-top: 20px; padding: 18px 22px;
    border: 1px solid rgba(168,85,247,0.3); border-radius: 16px;
    background: linear-gradient(135deg, rgba(124,58,237,0.13), rgba(236,72,153,0.07));
  }
  .pro-tip-icon { display: grid; place-items: center; flex: 0 0 38px; width: 38px; height: 38px; border-radius: 12px; background: linear-gradient(135deg, #7c3aed, #ec4899); color: #fff; }
  .pro-tip p { color: var(--text-muted); font-size: 0.88rem; line-height: 1.6; }
  .pro-tip strong { color: #fff; }

  /* ── Search sources ─────────────────────────────────────────────── */
  .source-grid {
    display: grid;
    grid-template-columns: repeat(3, minmax(0, 1fr));
    gap: 18px;
  }
  .source-card {
    position: relative;
    display: flex;
    flex-direction: column;
    min-height: 290px;
    padding: 28px 24px 24px;
    border: 1px solid var(--border);
    border-radius: var(--radius-lg);
    background: var(--surface);
    overflow: hidden;
    transition: transform 0.22s, border-color 0.22s, box-shadow 0.22s;
  }
  a.source-card:hover {
    transform: translateY(-5px);
    border-color: var(--accent);
    box-shadow: 0 16px 42px var(--accent-glow);
  }
  .source-card.featured {
    background: linear-gradient(145deg, rgba(124,58,237,0.19), rgba(236,72,153,0.09) 55%, var(--surface));
    border-color: rgba(168,85,247,0.45);
  }
  .source-card.disabled { opacity: 0.72; }
  .source-status {
    position: absolute;
    top: 18px;
    right: 18px;
    padding: 4px 9px;
    border-radius: 999px;
    font-size: 0.66rem;
    font-weight: 800;
    letter-spacing: 0.06em;
    text-transform: uppercase;
  }
  .source-status.live { color: #86efac; background: rgba(34,197,94,0.12); border: 1px solid rgba(34,197,94,0.25); }
  .source-status.beta { color: #d8b4fe; background: rgba(168,85,247,0.12); border: 1px solid rgba(168,85,247,0.25); }
  .source-status.soon { color: var(--text-muted); background: rgba(255,255,255,0.04); border: 1px solid rgba(255,255,255,0.08); }
  .source-icon {
    display: grid;
    place-items: center;
    width: 54px;
    height: 54px;
    margin-bottom: 24px;
    border-radius: 16px;
    color: #fff;
    font-size: 1.35rem;
    background: linear-gradient(135deg, #7c3aed, #ec4899);
    box-shadow: 0 10px 26px rgba(124,58,237,0.3);
  }
  .source-card h3 { font-size: 1.18rem; margin-bottom: 10px; }
  .source-card p { color: var(--text-muted); font-size: 0.9rem; line-height: 1.65; margin-bottom: 22px; }
  .source-link { margin-top: auto; color: var(--accent-light); font-size: 0.86rem; font-weight: 800; }
  .source-card.disabled .source-link { color: var(--text-muted); }

  /* ── Creator Battle promo ─────────────────────────────────────── */
  .battle-promo-section { margin-top: 30px; }
