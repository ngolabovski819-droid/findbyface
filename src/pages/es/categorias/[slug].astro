---
{/* i18n-twin: src/pages/categories/[slug].astro — mirror copy/structure changes.
   SSR like the English twin (no prerender) with the same cache header. The search
   scope key and `terms` stay ENGLISH — they feed the creator-text search index. */}
import Base from '../../../layouts/Base.astro';
import CreatorCard from '../../../components/CreatorCard.astro';
import CategoryChips from '../../../components/CategoryChips.astro';
import RankingAttributionBar from '../../../components/RankingAttributionBar.astro';
import { esSlugToCategory } from '../../../config/categories';
import { categorySeo } from '../../../config/seo-meta';
import { resolvePlacements } from '../../../lib/creatorFetch';
import { applySponsorOverrides } from '../../../lib/sponsorOverrides';
import { absUrl } from '../../../lib/site';

const { slug } = Astro.params;
if (!slug) return Astro.redirect('/es/');

const category = esSlugToCategory(slug);
if (!category) return Astro.redirect('/es/');

Astro.response.headers.set('Cache-Control', 'public, s-maxage=300, stale-while-revalidate=86400');

const PAGE_SIZE = 20;
const { creators: placedCreators, total } = await resolvePlacements(`category:${category.slug}`, {
  page: 1,
  pageSize: PAGE_SIZE,
  termsOr: category.terms,
});
const creators = applySponsorOverrides(placedCreators);
const hasMore = creators.length < total;
const seo = categorySeo(category.slug, category.labelEs, total, 'es');
const pageTitle = seo.title;
const pageDesc  = seo.description;
const canonical = absUrl(`/es/categorias/${slug}/`);
const alternate = `/categories/${category.slug}/`;

const faqJsonLd = {
  '@type': 'FAQPage',
  inLanguage: 'es',
  mainEntity: [
    {
      '@type': 'Question',
      name: `¿Cómo se clasifica la lista de OnlyFans ${category.labelEs}?`,
      acceptedAnswer: {
        '@type': 'Answer',
        text: `Las creadoras se clasifican por interacción real de fans (número de favoritos y métricas de suscriptores) extraída en vivo de OnlyFans. La lista se actualiza a diario, así que las cuentas ${category.labelEs} recién populares aparecen rápido.`,
      },
    },
    {
      '@type': 'Question',
      name: `¿Estas cuentas de OnlyFans ${category.labelEs} son gratis?`,
      acceptedAnswer: {
        '@type': 'Answer',
        text: `Muchas lo son. Usa el filtro Gratis para mostrar solo creadoras ${category.labelEs} de OnlyFans con suscripción de $0, o el filtro de Packs para encontrar creadoras de pago con ofertas de descuento activas.`,
      },
    },
    {
      '@type': 'Question',
      name: `¿Con qué frecuencia se actualiza la lista de OnlyFans ${category.labelEs}?`,
      acceptedAnswer: {
        '@type': 'Answer',
        text: `A diario. Rastreamos cuentas ${category.labelEs} nuevas, cambios de perfil y actualizaciones de precios cada 24 horas, con el estado de verificación actualizado semanalmente.`,
      },
    },
  ],
};

const jsonLd = JSON.stringify({
  '@context': 'https://schema.org',
  '@graph': [
    {
      '@type': 'BreadcrumbList',
      itemListElement: [
        { '@type': 'ListItem', position: 1, name: 'Inicio', item: absUrl('/es/') },
        { '@type': 'ListItem', position: 2, name: category.labelEs, item: canonical },
      ],
    },
    {
      '@type': 'ItemList',
      name: pageTitle,
      url: canonical,
      numberOfItems: creators.length,
      itemListElement: creators.slice(0, 10).map((c, i) => ({
        '@type': 'ListItem',
        position: i + 1,
        name: c.name || c.username,
        url: `https://onlyfans.com/${c.username}`,
      })),
    },
    faqJsonLd,
  ],
});
---

<Base title={pageTitle} description={pageDesc} canonical={canonical} alternate={alternate}>
  <Fragment slot="head">
    <script type="application/ld+json" set:html={jsonLd} />
  </Fragment>

  <div class="category-page">
    <div class="category-header">
      <h1>
        {category.emoji && <span class="cat-emoji">{category.emoji}</span>}
        Las Mejores Creadoras {category.labelEs} de OnlyFans
      </h1>
      <p class="category-sub">
        {total ? `${total.toLocaleString()} creadoras encontradas` : 'Explorar creadoras top'}
      </p>
    </div>

    <CategoryChips activeSlug={category.slug} />
    <RankingAttributionBar />

    <div class="category-content">
      {creators.length > 0 ? (
        <>
          <div class="creators-grid" id="creatorsGrid">
            {creators.map((c, i) => <CreatorCard creator={c} index={i} />)}
          </div>
          {hasMore && (
            <div class="load-more-wrap">
              <button class="load-more-btn" id="loadMoreBtn">Cargar más</button>
            </div>
          )}
        </>
      ) : (
        <div class="empty-state">
          <p>Todavía no hay creadoras en esta categoría.</p>
          <a href="/es/" class="back-link">← Volver al inicio</a>
        </div>
      )}
    </div>
  </div>
</Base>

<script define:vars={{ categorySlug: category.slug, initialHasMore: hasMore, T: { loading: 'Cargando...', loadMore: 'Cargar más', free: 'GRATIS', viewProfile: 'Ver perfil' } }}>
  let currentPage = 2;
  let isLoading = false;
  let hasMoreResults = initialHasMore;

  const loadMoreBtn = document.getElementById('loadMoreBtn');
  const grid = document.getElementById('creatorsGrid');

  function proxyImg(url, w, h) {
    if (!url || url.startsWith('/')) return url;
    return `https://images.weserv.nl/?url=${encodeURIComponent(url.replace(/^https?:\/\//, ''))}&w=${w}&h=${h}&fit=cover&output=webp`;
  }

  function cardDataAttributes(c) {
    const escapeAttribute = value => String(value)
      .replace(/&/g, '&amp;')
      .replace(/"/g, '&quot;')
      .replace(/</g, '&lt;')
      .replace(/>/g, '&gt;');
    const images = [...new Set([c.avatar, c.header, ...(c.galleryImages || [])].filter(Boolean))];
    return [
      `data-card-username="${escapeAttribute(c.username || '')}"`,
      `data-card-images="${escapeAttribute(JSON.stringify(images))}"`,
      `data-card-sponsored="${c.sponsored ? 'true' : 'false'}"`,
      `data-card-tags="${escapeAttribute(JSON.stringify(c.tags || []))}"`,
      `data-card-extra-tags="${c.additionalTagCount || 0}"`,
      `data-card-verified="${c.isVerified || c.isverified ? 'true' : 'false'}"`,
    ].join(' ');
  }

  function renderCard(c) {
    const imgSrc = c.avatar?.startsWith('/') ? c.avatar : c.avatar?.startsWith('http') ? proxyImg(c.avatar, 320, 427) : '/no-image.png';
    const price = c.subscribePrice ?? c.subscribeprice;
    const priceIsFree = (!price || isNaN(price));
    const priceLabel = priceIsFree ? T.free : `$${parseFloat(price).toFixed(2)}`;
    const profileUrl = c.profileUrl || `https://onlyfans.com/${encodeURIComponent(c.username)}`;
    const isSponsored = profileUrl.startsWith('/go/');
    const rel = isSponsored ? 'noopener nofollow sponsored' : 'noopener nofollow';
    const cardData = cardDataAttributes(c);
    return `<div class="creator-card" data-href="${profileUrl}" ${cardData}>
      <div class="card-img-wrap">
        <img src="${imgSrc}" alt="${c.name || c.username}" loading="lazy" decoding="async" referrerpolicy="no-referrer"
          onerror="this.onerror=null;this.removeAttribute('srcset');this.src='/no-image.png';">
      </div>
      <div class="card-body">
        <p class="creator-name">${c.name || c.username}</p>
        <p class="username">@${c.username}</p>
        <p class="price ${priceIsFree ? 'price-free' : ''}">${priceLabel}</p>
        <a href="${profileUrl}" class="view-btn" target="_blank" rel="${rel}">${T.viewProfile}</a>
      </div>
    </div>`;
  }

  loadMoreBtn?.addEventListener('click', async () => {
    if (isLoading || !hasMoreResults) return;
    isLoading = true;
    loadMoreBtn.textContent = T.loading;
    loadMoreBtn.disabled = true;
    try {
      const resp = await fetch(`/api/search?scope=${encodeURIComponent('category:' + categorySlug)}&page=${currentPage}&page_size=20`);
      const data = await resp.json();
      data.creators?.forEach(c => grid?.insertAdjacentHTML('beforeend', renderCard(c)));
      hasMoreResults = data.hasMore;
      currentPage++;
      loadMoreBtn.textContent = T.loadMore;
      loadMoreBtn.disabled = false;
      if (!hasMoreResults) loadMoreBtn.style.display = 'none';
    } catch {
      loadMoreBtn.textContent = T.loadMore;
      loadMoreBtn.disabled = false;
    }
    isLoading = false;
  });
</script>

<script>
  import { initCardClickThrough } from '../../../lib/cardClickThrough';
  initCardClickThrough();
</script>

<style>
  .category-page {
    max-width: 1200px;
    margin: 0 auto;
    padding: 100px 20px 60px;
  }

  .category-header {
    text-align: center;
    margin-bottom: 40px;
  }

  .category-header h1 { font-size: clamp(1.8rem, 4vw, 2.4rem); margin-bottom: 12px; }
  .cat-emoji { margin-right: 8px; }
  .category-sub { color: var(--text-muted); }

  .category-content { margin-top: 40px; }

  .creators-grid {
    display: grid;
    grid-template-columns: repeat(4, minmax(0, 1fr));
    gap: 20px;
  }

  @media (max-width: 900px) { .creators-grid { grid-template-columns: repeat(3, minmax(0, 1fr)); } }
  @media (max-width: 640px) { .creators-grid { grid-template-columns: repeat(2, minmax(0, 1fr)); gap: 12px; } }

  .load-more-wrap { display: flex; justify-content: center; margin-top: 40px; }

  .load-more-btn {
    background: transparent; border: 1px solid var(--border);
    color: var(--text); padding: 12px 44px; border-radius: 999px;
    font-size: 15px; font-weight: 500; cursor: pointer;
    font-family: 'Inter', sans-serif; transition: all 0.2s;
  }
  .load-more-btn:hover { border-color: var(--accent); color: var(--accent); }

  .empty-state { text-align: center; padding: 80px 20px; color: var(--text-muted); }
  .back-link { color: var(--accent); margin-top: 16px; display: inline-block; }
</style>
