---
{/* i18n-twin: src/pages/contact.astro — mirror copy/structure changes (form logic + styles shared shape) */}
import Base from '../../layouts/Base.astro';
import { absUrl } from '../../lib/site';
---

<Base
  title="Contacta a findbyface — Soporte y Solicitudes"
  description="Ponte en contacto con el equipo de findbyface. Envía preguntas, comentarios, inquietudes de contenido o solicitudes de DMCA y retirada."
  canonical={absUrl('/es/contacto/')}
>
  <article class="prose-page contact-page">
    <div class="page-head">
      <h1>Contácta<span class="gradient-text">nos</span></h1>
      <p>¿Preguntas, comentarios o una inquietud sobre contenido? Envíanos un mensaje y te responderemos.</p>
    </div>

    <div class="contact-grid">
      <aside class="contact-info">
        <div class="info-card">
          <span class="info-emoji">💬</span>
          <h3>General y soporte</h3>
          <p>Ideas, preguntas o algo que no funciona como esperabas — nos encantaría saber de ti.</p>
        </div>
        <div class="info-card">
          <span class="info-emoji">🛡️</span>
          <h3>Retiradas y DMCA</h3>
          <p>¿Quieres que se elimine una imagen o necesitas presentar un aviso de derechos de autor? Incluye "DMCA" o "Retirada" en tu asunto y consulta nuestra <a href="/es/dmca/">política DMCA</a>.</p>
        </div>
        <div class="info-card">
          <span class="info-emoji">🔒</span>
          <h3>Privacidad</h3>
          <p>Lee cómo manejamos tus datos en nuestra <a href="/es/politica-de-privacidad/">Política de Privacidad</a>.</p>
        </div>
      </aside>

      <form class="contact-form" id="contactForm" novalidate>
        <div class="field">
          <label for="cName">Nombre</label>
          <input type="text" id="cName" name="name" maxlength="120" autocomplete="name" required />
        </div>
        <div class="field">
          <label for="cEmail">Correo electrónico</label>
          <input type="email" id="cEmail" name="email" maxlength="200" autocomplete="email" required />
        </div>
        <div class="field">
          <label for="cSubject">Asunto</label>
          <input type="text" id="cSubject" name="subject" maxlength="160" />
        </div>
        <div class="field">
          <label for="cMessage">Mensaje</label>
          <textarea id="cMessage" name="message" rows="6" maxlength="5000" required></textarea>
        </div>
        <!-- Honeypot: hidden from users, catches bots -->
        <div class="hp-field" aria-hidden="true">
          <label for="cCompany">Company</label>
          <input type="text" id="cCompany" name="company" tabindex="-1" autocomplete="off" />
        </div>

        <div id="cTurnstile"></div>

        <button type="submit" class="submit-btn" id="submitBtn">Enviar mensaje</button>
        <p class="form-status" id="formStatus" role="status" aria-live="polite"></p>
      </form>
    </div>
  </article>
</Base>

<script is:inline>
  // Same Turnstile ready-queue as src/pages/contact.astro — see the comment there.
  window.__turnstileReady = window.__turnstileReady || [];
  window.onTurnstileLoad = window.onTurnstileLoad || function () {
    window.__turnstileReady.splice(0).forEach(function (fn) { fn(); });
  };
</script>
<script is:inline src="https://challenges.cloudflare.com/turnstile/v0/api.js?render=explicit&onload=onTurnstileLoad" async defer></script>
<script>
  const TURNSTILE_SITE_KEY = import.meta.env.PUBLIC_TURNSTILE_SITE_KEY;

  const form = document.getElementById('contactForm') as HTMLFormElement;
  const btn = document.getElementById('submitBtn') as HTMLButtonElement;
  const status = document.getElementById('formStatus') as HTMLParagraphElement;

  let turnstileWidgetId: string | undefined;
  function renderTurnstile(): void {
    const turnstile = (window as typeof window & { turnstile?: any }).turnstile;
    if (!turnstile || !TURNSTILE_SITE_KEY || turnstileWidgetId) return;
    turnstileWidgetId = turnstile.render('#cTurnstile', { sitekey: TURNSTILE_SITE_KEY, language: document.documentElement.lang || 'en' });
  }
  if ((window as typeof window & { turnstile?: any }).turnstile) renderTurnstile();
  else (window as any).__turnstileReady.push(renderTurnstile);

  form?.addEventListener('submit', async (e) => {
    e.preventDefault();
    status.textContent = '';
    status.className = 'form-status';

    const data = {
      name: (document.getElementById('cName') as HTMLInputElement).value,
      email: (document.getElementById('cEmail') as HTMLInputElement).value,
      subject: (document.getElementById('cSubject') as HTMLInputElement).value,
      message: (document.getElementById('cMessage') as HTMLTextAreaElement).value,
      company: (document.getElementById('cCompany') as HTMLInputElement).value,
      turnstileToken: turnstileWidgetId
        ? (window as typeof window & { turnstile?: any }).turnstile?.getResponse(turnstileWidgetId)
        : undefined,
    };

    if (!data.name.trim() || !data.email.trim() || data.message.trim().length < 10) {
      status.textContent = 'Completa tu nombre, correo y un mensaje (mínimo 10 caracteres).';
      status.classList.add('error');
      return;
    }

    btn.disabled = true;
    btn.textContent = 'Enviando…';

    try {
      const res = await fetch('/api/contact', {
        method: 'POST',
        headers: { 'Content-Type': 'application/json' },
        body: JSON.stringify(data),
      });
      const out = await res.json().catch(() => ({}));

      if (res.ok && out.ok) {
        form.reset();
        status.textContent = '¡Gracias! Tu mensaje fue enviado. Te responderemos pronto.';
        status.classList.add('success');
      } else {
        status.textContent = out.error || 'Algo salió mal. Inténtalo de nuevo más tarde.';
        status.classList.add('error');
      }
      if (turnstileWidgetId) (window as typeof window & { turnstile?: any }).turnstile?.reset(turnstileWidgetId);
    } catch {
      status.textContent = 'Error de red. Revisa tu conexión e inténtalo de nuevo.';
      status.classList.add('error');
    } finally {
      btn.disabled = false;
      btn.textContent = 'Enviar mensaje';
    }
  });
</script>

<style>
  .contact-grid {
    display: grid;
    grid-template-columns: 1fr 1.4fr;
    gap: 24px;
    align-items: start;
  }

  .contact-info {
    display: flex;
    flex-direction: column;
    gap: 14px;
  }

  .info-card {
    background: var(--surface);
    border: 1px solid var(--border);
    border-radius: var(--radius);
    padding: 18px 20px;
  }

  .info-emoji { font-size: 1.5rem; display: block; margin-bottom: 8px; }
  .info-card h3 { font-size: 1.05rem; margin-bottom: 6px; }
  .info-card p { color: var(--text-muted); font-size: 14px; line-height: 1.6; }
  .info-card a { color: var(--accent-light); text-decoration: underline; }
  .info-card a:hover { color: var(--accent-pink); }

  .contact-form {
    background: var(--surface);
    border: 1px solid var(--border);
    border-radius: var(--radius-lg);
    padding: 28px;
    display: flex;
    flex-direction: column;
    gap: 16px;
  }

  .field { display: flex; flex-direction: column; gap: 6px; }

  .field label {
    font-size: 13px;
    font-weight: 600;
    color: var(--text);
  }

  .field input,
  .field textarea {
    background: var(--bg);
    border: 1px solid var(--border);
    border-radius: var(--radius);
    color: var(--text);
    font-family: inherit;
    font-size: 15px;
    padding: 12px 14px;
    transition: border-color 0.2s, box-shadow 0.2s;
    width: 100%;
  }

  .field textarea { resize: vertical; min-height: 120px; }

  .field input:focus,
  .field textarea:focus {
    outline: none;
    border-color: var(--accent);
    box-shadow: 0 0 0 3px var(--accent-glow);
  }

  .hp-field {
    position: absolute;
    left: -9999px;
    width: 1px;
    height: 1px;
    overflow: hidden;
  }

  .submit-btn {
    margin-top: 4px;
    background: linear-gradient(135deg, #7c3aed, #ec4899);
    color: #fff;
    border: none;
    border-radius: 999px;
    padding: 14px 28px;
    font-size: 15px;
    font-weight: 700;
    font-family: inherit;
    cursor: pointer;
    transition: transform 0.18s ease, box-shadow 0.18s ease, opacity 0.2s;
    box-shadow: 0 8px 24px rgba(124,58,237,0.35);
  }

  .submit-btn:hover:not(:disabled) {
    transform: translateY(-2px);
    box-shadow: 0 12px 32px rgba(124,58,237,0.5);
  }

  .submit-btn:disabled { opacity: 0.6; cursor: not-allowed; }

  .form-status {
    font-size: 14px;
    margin-top: 2px;
    min-height: 20px;
  }

  .form-status.success { color: var(--success); }
  .form-status.error { color: #f87171; }

  @media (max-width: 760px) {
    .contact-grid { grid-template-columns: 1fr; }
  }
</style>
