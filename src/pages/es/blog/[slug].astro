---
{/* i18n-twin: src/pages/blog/[slug].astro — mirror copy/structure changes */}
import Base from '../../../layouts/Base.astro';
import { getCollection, render } from 'astro:content';
import FeaturedVisual from '../../../components/blog/FeaturedVisual.astro';
import SummaryBox from '../../../components/blog/SummaryBox.astro';
import TableOfContents from '../../../components/blog/TableOfContents.astro';
import SearchToolsWidget from '../../../components/blog/SearchToolsWidget.astro';
import ReferencesDisclaimer from '../../../components/blog/ReferencesDisclaimer.astro';
import AuthorBio from '../../../components/blog/AuthorBio.astro';
import { absUrl } from '../../../lib/site';

export const prerender = true;

export async function getStaticPaths() {
  const posts = await getCollection('blogEs');
  return posts.map(post => ({
    params: { slug: post.id.replace(/\.md$/, '') },
    props: { post },
  }));
}

const { post } = Astro.props;
const { Content, headings } = await render(post);
const { title, description, date, updated, author, image, summary, references, disclaimer, translationOf } = post.data;
const slug = post.id.replace(/\.md$/, '');
const canonical = absUrl(`/es/blog/${slug}/`);

// hreflang pairing back to the English original — only if that post really exists.
const enPosts = await getCollection('blog');
const enExists = enPosts.some(p => p.id.replace(/\.md$/, '') === translationOf);
const alternate = enExists ? `/blog/${translationOf}/` : null;

const dateOpts: Intl.DateTimeFormatOptions = { year: 'numeric', month: 'long', day: 'numeric' };
const formattedDate = new Date(date).toLocaleDateString('es', dateOpts);
const formattedUpdated = updated ? new Date(updated).toLocaleDateString('es', dateOpts) : undefined;

const jsonLd = {
  '@context': 'https://schema.org',
  '@graph': [
    {
      '@type': 'BlogPosting',
      headline: title,
      description,
      inLanguage: 'es',
      datePublished: date,
      dateModified: updated || date,
      url: canonical,
      mainEntityOfPage: { '@type': 'WebPage', '@id': canonical },
      image: image || undefined,
      author: { '@type': 'Person', name: author },
      publisher: {
        '@type': 'Organization',
        name: 'findbyface',
        logo: { '@type': 'ImageObject', url: 'https://findbyface.org/findbyface-logo.png' },
      },
    },
    {
      '@type': 'Person',
      name: author,
      description: 'Escribe en findbyface sobre seguridad en línea y búsqueda visual.',
    },
  ],
};
---

<Base title={`${title} | findbyface`} description={description} canonical={canonical} alternate={alternate}>
  <slot name="head" slot="head">
    <script type="application/ld+json" set:html={JSON.stringify(jsonLd)} />
  </slot>

  <div class="post-shell">
    <article class="blog-post">
      <header class="post-header">
        <FeaturedVisual
          image={image}
          title={title}
          publishedLabel={formattedDate}
          updatedLabel={formattedUpdated}
          shareUrl={canonical}
        />
        <h1>{title}</h1>
        {description && <p class="post-desc">{description}</p>}
      </header>

      {summary && <SummaryBox text={summary} />}

      <TableOfContents headings={headings} />

      <div class="post-content prose">
        <Content />
      </div>

      <ReferencesDisclaimer references={references} disclaimer={disclaimer} />

      <AuthorBio name={author} />

      <footer class="post-footer">
        <a href="/es/blog/" class="back-link">← Volver al blog</a>
      </footer>
    </article>

    <aside class="post-sidebar">
      <div class="post-sidebar-sticky">
        <SearchToolsWidget />
      </div>
    </aside>
  </div>
</Base>

<style>
  .post-shell {
    max-width: 1120px;
    margin: 0 auto;
    padding: 60px 24px;
    display: grid;
    grid-template-columns: minmax(0, 1fr) 300px;
    gap: 48px;
  }

  .blog-post { min-width: 0; }

  .post-header {
    margin-bottom: 40px;
    text-align: center;
  }

  .post-header h1 {
    font-size: clamp(1.75rem, 4vw, 2.75rem);
    line-height: 1.2;
    margin-bottom: 16px;
    color: var(--text);
  }

  .post-desc {
    color: var(--text-muted);
    font-size: 18px;
    line-height: 1.6;
    max-width: 600px;
    margin: 0 auto;
  }

  .post-sidebar-sticky {
    position: sticky;
    top: 100px;
  }

  /* Prose styles for markdown content */
  .prose {
    color: var(--text);
    font-size: 16px;
    line-height: 1.8;
  }

  .prose :global(h2) {
    font-family: 'Manrope', sans-serif;
    font-size: 1.5rem;
    font-weight: 700;
    color: var(--accent-light);
    margin: 40px 0 16px;
    scroll-margin-top: 100px;
  }

  .prose :global(h3) {
    font-family: 'Manrope', sans-serif;
    font-size: 1.2rem;
    font-weight: 700;
    margin: 28px 0 12px;
    scroll-margin-top: 100px;
  }

  .prose :global(p) {
    margin-bottom: 20px;
    color: var(--text);
  }

  .prose :global(a) {
    color: var(--accent-light);
    text-decoration: underline;
  }

  .prose :global(ul), .prose :global(ol) {
    padding-left: 24px;
    margin-bottom: 20px;
  }

  .prose :global(li) {
    margin-bottom: 8px;
    color: var(--text);
  }

  .prose :global(table) {
    display: block;
    overflow-x: auto;
    width: 100%;
    margin: 8px 0 24px;
    border-collapse: collapse;
    font-size: 0.9rem;
  }

  .prose :global(th),
  .prose :global(td) {
    padding: 11px 16px;
    border: 1px solid var(--border);
    text-align: left;
    vertical-align: top;
  }

  .prose :global(th) {
    background: var(--surface-raised);
    color: var(--accent-light);
    font-family: 'Manrope', sans-serif;
    font-size: 0.78rem;
    text-transform: uppercase;
    letter-spacing: 0.04em;
    white-space: nowrap;
  }

  .prose :global(td) {
    color: var(--text-muted);
  }

  .prose :global(tr:nth-child(even) td) {
    background: rgba(255, 255, 255, 0.02);
  }

  .prose :global(code) {
    background: var(--surface-raised);
    border: 1px solid var(--border);
    border-radius: 4px;
    font-size: 13px;
    padding: 2px 6px;
  }

  .prose :global(pre) {
    background: var(--surface-raised);
    border: 1px solid var(--border);
    border-radius: var(--radius);
    padding: 20px;
    overflow-x: auto;
    margin-bottom: 24px;
  }

  .prose :global(blockquote) {
    border-left: 3px solid var(--accent);
    padding-left: 20px;
    margin: 24px 0;
    color: var(--text-muted);
    font-style: italic;
  }

  /* ── Reusable post mix-ins — see BLOG-POST-TEMPLATE.md for how to use these ── */

  .prose :global(.bp-pullquote) {
    margin: 36px 0;
    padding: 6px 0 6px 22px;
    border-left: 3px solid var(--accent);
    font-family: 'Manrope', sans-serif;
    font-size: 1.12rem;
    font-weight: 700;
    line-height: 1.55;
    color: var(--text);
  }

  .prose :global(.bp-compare) {
    display: grid;
    grid-template-columns: 1fr 1fr;
    gap: 16px;
    margin: 32px 0;
  }

  .prose :global(.bp-compare-card) {
    padding: 22px 20px;
    border: 1px solid var(--border);
    border-radius: var(--radius-lg);
    background: var(--surface);
  }

  .prose :global(.bp-compare-card.accent) {
    border-color: rgba(168, 85, 247, 0.45);
    background: linear-gradient(145deg, rgba(124, 58, 237, 0.14), rgba(236, 72, 153, 0.06), var(--surface));
  }

  .prose :global(.bp-compare-kicker) {
    display: block;
    font-size: 0.7rem;
    font-weight: 800;
    letter-spacing: 0.08em;
    text-transform: uppercase;
    color: var(--accent-light);
    margin-bottom: 8px;
  }

  .prose :global(.bp-compare-card h4) {
    font-family: 'Manrope', sans-serif;
    font-size: 1rem;
    margin: 0 0 12px;
    color: var(--text);
  }

  .prose :global(.bp-compare-card ul) {
    margin: 0;
    padding-left: 18px;
    color: var(--text-muted);
    font-size: 0.9rem;
    line-height: 1.6;
  }

  .prose :global(.bp-checklist) {
    margin: 32px 0;
    padding: 22px 24px;
    border: 1px solid var(--border);
    border-radius: var(--radius-lg);
    background: var(--surface);
  }

  .prose :global(.bp-checklist h4) {
    margin: 0 0 14px;
    font-family: 'Manrope', sans-serif;
    font-size: 1rem;
    color: var(--text);
  }

  .prose :global(.bp-checklist ul) {
    list-style: none;
    margin: 0;
    padding: 0;
    display: grid;
    gap: 10px;
  }

  .prose :global(.bp-checklist li) {
    display: flex;
    gap: 10px;
    align-items: flex-start;
    color: var(--text-muted);
    font-size: 0.92rem;
    line-height: 1.55;
  }

  .prose :global(.bp-checklist li svg) {
    flex: 0 0 18px;
    margin-top: 3px;
    color: var(--accent-light);
  }

  .prose :global(.bp-steps) {
    position: relative;
    display: grid;
    grid-template-columns: repeat(4, 1fr);
    gap: 18px;
    margin: 32px 0;
  }

  .prose :global(.bp-steps-line) {
    position: absolute;
    left: 12.5%;
    right: 12.5%;
    top: 20px;
    height: 2px;
    background: var(--border);
    z-index: 0;
  }

  .prose :global(.bp-step) {
    position: relative;
    z-index: 1;
    display: grid;
    justify-items: center;
    gap: 6px;
    text-align: center;
  }

  .prose :global(.bp-step-icon) {
    display: grid;
    place-items: center;
    width: 42px;
    height: 42px;
    border-radius: 50%;
    color: #fff;
    background: linear-gradient(135deg, #7c3aed, #ec4899);
    box-shadow: 0 8px 20px var(--accent-glow);
  }

  .prose :global(.bp-step-label) {
    margin: 4px 0 0;
    font-family: 'Manrope', sans-serif;
    font-weight: 700;
    font-size: 0.86rem;
    color: var(--text);
  }

  .prose :global(.bp-step-label a) { color: var(--accent-light); }

  .prose :global(.bp-step-caption) {
    margin: 0;
    color: var(--text-muted);
    font-size: 0.78rem;
    line-height: 1.5;
  }

  @media (max-width: 640px) {
    .prose :global(.bp-compare) { grid-template-columns: 1fr; }
    .prose :global(.bp-steps) { grid-template-columns: 1fr; gap: 22px; justify-items: start; text-align: left; }
    .prose :global(.bp-steps-line) { left: 20px; right: auto; top: 0; bottom: 0; width: 2px; height: auto; }
    .prose :global(.bp-step) { grid-template-columns: 42px 1fr; justify-items: start; text-align: left; }
    .prose :global(.bp-step-icon) { grid-row: 1 / 3; }
    .prose :global(.bp-step-label), .prose :global(.bp-step-caption) { margin-left: 12px; }
  }

  .post-footer {
    margin-top: 44px;
    padding-top: 28px;
    border-top: 1px solid var(--border);
  }

  .back-link {
    color: var(--accent-light);
    font-size: 14px;
    font-weight: 600;
  }

  .back-link:hover {
    color: var(--text);
  }

  @media (max-width: 900px) {
    .post-shell { grid-template-columns: 1fr; gap: 32px; padding: 44px 20px; }
    .post-sidebar-sticky { position: static; }
  }
</style>
