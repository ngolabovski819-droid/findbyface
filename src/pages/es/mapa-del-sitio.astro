---
{/* i18n-twin: src/pages/sitemap.astro — mirror copy/structure changes */}
import Base from '../../layouts/Base.astro';
import { getCollection } from 'astro:content';
import { categories } from '../../config/categories';
import { staticRoutes } from '../../i18n/routes';
import { absUrl } from '../../lib/site';

const canonical = absUrl('/es/mapa-del-sitio/');
const title = 'Mapa del Sitio | findbyface';
const description =
  'Explora las principales herramientas de búsqueda, guías, páginas de categorías y recursos legales disponibles en findbyface.';

const primaryLinks = [
  { href: '/es/', label: 'Inicio' },
  { href: staticRoutes['/onlyfans-search/'], label: 'Búsqueda OnlyFans' },
  { href: staticRoutes['/battle/'], label: 'Batalla de Creadoras' },
  { href: staticRoutes['/onlyfans-finder-by-face/'], label: 'Buscador OnlyFans por Cara' },
  { href: staticRoutes['/pornstar-finder-by-face/'], label: 'Buscador de Actrices por Cara' },
  { href: staticRoutes['/promote/'], label: 'Promociona tu OnlyFans' },
];

// Enumerated from the blogEs collection (Spanish posts carry their own authored
// titles, so no need to cross-reference the English collection). Hand-listing
// went stale here exactly as it did on the English twin.
const posts = (await getCollection('blogEs')).sort(
  (a, b) => new Date(b.data.date).getTime() - new Date(a.data.date).getTime(),
);

const resourceLinks = [
  { href: '/es/blog/', label: 'Blog' },
  ...posts.map((post) => ({
    href: `/es/blog/${post.id.replace(/\.md$/, '')}/`,
    label: post.data.title,
  })),
  { href: '/es/blog/autor/nick/', label: 'Autor: Nick' },
  { href: staticRoutes['/how-our-search-engine-works/'], label: 'Cómo funciona nuestro buscador' },
  { href: staticRoutes['/about/'], label: 'Sobre nosotros' },
  { href: staticRoutes['/contact/'], label: 'Contacto' },
];

const legalLinks = [
  { href: staticRoutes['/privacy-policy/'], label: 'Política de Privacidad' },
  { href: staticRoutes['/terms-of-use/'], label: 'Términos de Uso' },
  { href: staticRoutes['/community-guidelines/'], label: 'Normas de la Comunidad' },
  { href: staticRoutes['/dmca/'], label: 'DMCA' },
];

const categoryLinks = categories.map((c) => ({
  href: `/es/categorias/${c.slugEs ?? c.slug}/`,
  label: c.labelEs,
}));
---

<Base title={title} description={description} canonical={canonical}>
  <section class="sitemap-page">
    <header>
      <span>Directorio del sitio</span>
      <h1>Mapa del Sitio</h1>
      <p>Explora las páginas públicas y herramientas de búsqueda disponibles en findbyface.</p>
    </header>

    <div class="sitemap-grid">
      <section>
        <h2>Herramientas de búsqueda</h2>
        <ul>
          {primaryLinks.map((link) => (
            <li><a href={link.href}>{link.label}</a></li>
          ))}
        </ul>
      </section>

      <section>
        <h2>Recursos</h2>
        <ul>
          {resourceLinks.map((link) => (
            <li><a href={link.href}>{link.label}</a></li>
          ))}
        </ul>
      </section>

      <section>
        <h2>Legal</h2>
        <ul>
          {legalLinks.map((link) => (
            <li><a href={link.href}>{link.label}</a></li>
          ))}
          <li><a href="/sitemap.xml">Sitemap XML</a></li>
        </ul>
      </section>

      <section class="categories">
        <h2>Categorías</h2>
        <ul>
          {categoryLinks.map((link) => (
            <li><a href={link.href}>{link.label}</a></li>
          ))}
        </ul>
      </section>
    </div>
  </section>
</Base>

<style>
  .sitemap-page {
    width: min(1080px, calc(100% - 40px));
    margin: 0 auto;
    padding: 130px 0 50px;
  }

  header {
    max-width: 680px;
    margin-bottom: 48px;
  }

  header > span {
    color: #a78bfa;
    font-size: 11px;
    font-weight: 700;
    letter-spacing: 0.13em;
    text-transform: uppercase;
  }

  h1 {
    margin-top: 10px;
    font-size: clamp(2.4rem, 6vw, 4.5rem);
    line-height: 1;
    letter-spacing: -0.045em;
  }

  header p {
    margin-top: 18px;
    color: var(--text-muted);
  }

  .sitemap-grid {
    display: grid;
    grid-template-columns: repeat(3, minmax(0, 1fr));
    gap: 18px;
  }

  .sitemap-grid section {
    padding: 26px;
    border: 1px solid var(--border);
    border-radius: 18px;
    background: var(--surface);
  }

  .sitemap-grid .categories {
    grid-column: 1 / -1;
  }

  h2 {
    margin-bottom: 18px;
    font-size: 1.1rem;
  }

  ul {
    display: grid;
    gap: 10px;
    padding: 0;
    list-style: none;
  }

  .categories ul {
    grid-template-columns: repeat(4, minmax(0, 1fr));
    gap: 10px 18px;
  }

  a {
    color: var(--text-muted);
    font-size: 14px;
    transition: color 160ms ease;
  }

  a:hover {
    color: #c4b5fd;
  }

  @media (max-width: 760px) {
    .sitemap-grid {
      grid-template-columns: 1fr;
    }

    .sitemap-grid .categories {
      grid-column: auto;
    }

    .categories ul {
      grid-template-columns: repeat(2, minmax(0, 1fr));
    }
  }

  @media (max-width: 440px) {
    .sitemap-page {
      width: min(100% - 24px, 1080px);
      padding-top: 104px;
    }

    .categories ul {
      grid-template-columns: 1fr;
    }
  }
</style>
